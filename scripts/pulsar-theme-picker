#!/usr/bin/python3
"""pulsar-theme-picker -- pick a theme from cards; bound to a GNOME custom shortcut.

A libadwaita window of theme cards, each dressed in its own theme (see
pulsar_theme_cards.py); type to filter. Enter or a
click applies through `pulsar-theme set`; Escape closes. Meant to be bound to
a GNOME custom keybinding (see docs/theming.md). PyGObject ships in the image.
"""
import os
import pathlib
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import pulsar_theme_engine  # noqa: E402

pt = pulsar_theme_engine.load(HERE / "pulsar-theme")

sys.path.insert(0, str(HERE))
import pulsar_theme_cards as cards  # noqa: E402


# The Shell extension's effects (its prefs.js shows the same): key, title,
# subtitle, the key it needs on.
EFFECTS = (
    ("glass", "Glass", "Menus, the top bar, OSDs and banners are translucent over a blur of what is behind them", None),
    ("window-glass", "Glass windows", "App windows are a little translucent too; apps opened afterwards pick it up", "glass"),
    ("lighting", "Lighting", "Menus catch light from the button that opened them; the edge warms when the battery is low", None),
    ("power-on", "Power-on", "The edge traces out from the light as a menu opens", "lighting"),
    ("glow", "Glow", "What is filled with the accent glows softly; apps opened afterwards pick it up", None),
    ("focus-brackets", "Focus brackets", "Corner brackets lock onto the control the keyboard is on", None),
    ("glass-off-gaming", "Disable glass when gaming", "While a game is running", None),
    ("glass-off-power-saver", "Disable glass in Power Saver", "While the power mode is Power Saver", None),
)


class Picker(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Themes", default_width=1080, default_height=760)
        cards.install_css()
        tv = Adw.ToolbarView()
        hb = Adw.HeaderBar()
        hb.set_title_widget(Adw.WindowTitle(title="Themes",
                                            subtitle="Enter to apply · Esc to close · type to search"))
        tv.add_top_bar(hb)
        fx = self._effects()
        if fx:
            hb.pack_end(fx)
        # Type anywhere to filter: the search bar captures keys from the window.
        self.search = Gtk.SearchEntry(placeholder_text="Search themes", hexpand=True)
        sb = Gtk.SearchBar(child=Adw.Clamp(child=self.search, maximum_size=420), show_close_button=False)
        sb.connect_entry(self.search)
        sb.set_key_capture_widget(self)
        self.searchbar = sb
        tv.add_top_bar(sb)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE, max_children_per_line=2,
                           min_children_per_line=2, row_spacing=22, column_spacing=22,
                           margin_top=22, margin_bottom=28, margin_start=28, margin_end=28,
                           activate_on_single_click=True, homogeneous=True, valign=Gtk.Align.START)
        flow.connect("child-activated", self.on_pick)
        flow.set_filter_func(self._match)
        self.search.connect("search-changed", self._searched)
        self.search.connect("activate", lambda *_: self._pick_first(flow))
        self.flow = flow
        cur = pt.current_state().get("theme")
        first = None
        for slug, th in pt.ordered_themes():
            if th is None:
                continue
            card = cards.ThemeCard(pt, th, current=(slug == cur), width=400)
            child = Gtk.FlowBoxChild(child=card, css_classes=["pt-child"])
            child.slug, child.card = slug, card
            child.set_tooltip_text(f"pulsar theme set {slug}")
            if slug == cur:
                first = child
            flow.append(child)
        sc = Gtk.ScrolledWindow(child=flow, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        tv.set_content(sc)
        self.set_content(tv)
        if first:
            flow.select_child(first)
            # once: a callback that returns True runs again, and grab_focus
            # does, which pulled focus back to this card on every idle tick
            GLib.idle_add(lambda: first.grab_focus() and False)
        # test hook for tests/theme-gate: act as if this card were clicked
        auto = os.environ.get("PULSAR_PICKER_AUTOPICK")
        if auto:
            def autopick():
                for ch in list(flow):
                    if getattr(ch, "slug", None) == auto:
                        flow.select_child(ch)
                        self.on_pick(flow, ch)
                return False
            GLib.timeout_add(2500, autopick)
        key = Gtk.EventControllerKey()
        key.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        key.connect("key-pressed", self._key)
        self.add_controller(key)

    def _effects(self):
        """The Shell extension's glass and light switches (the same keys as its
        page in the Extensions app), in a popover off the header bar. None
        when the schema is not installed."""
        sid = "org.gnome.shell.extensions.pulsar-theme"
        if not Gio.SettingsSchemaSource.get_default().lookup(sid, True):
            return None
        self.fx_settings = Gio.Settings(schema_id=sid)
        rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        for key, title, subtitle, needs in EFFECTS:
            row = Adw.SwitchRow(title=title, subtitle=subtitle)
            self.fx_settings.bind(key, row, "active", Gio.SettingsBindFlags.DEFAULT)
            if needs:
                self.fx_settings.bind(needs, row, "sensitive", Gio.SettingsBindFlags.GET)
            rows.append(row)
            if key == "glass":
                rows.append(self._tint_row())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, width_request=360,
                      margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        head = Gtk.Box(spacing=6)
        head.append(Gtk.Label(label="Effects", xalign=0, hexpand=True, css_classes=["heading"]))
        head.append(self._reset_button())
        box.append(head)
        box.append(rows)
        box.append(Gtk.Label(label="High contrast turns them all off.", xalign=0, wrap=True,
                             css_classes=["dim-label", "caption"]))
        return Gtk.MenuButton(icon_name="applications-graphics-symbolic", tooltip_text="Effects",
                              popover=Gtk.Popover(child=box))

    def _reset_button(self):
        """Every effect and the tint back to the defaults; only live while
        something differs from them."""
        s = self.fx_settings
        keys = s.props.settings_schema.list_keys()
        button = Gtk.Button(label="Reset", tooltip_text="Put every effect and the tint back to the defaults",
                            css_classes=["flat"], valign=Gtk.Align.CENTER)
        button.connect("clicked", lambda *_: [s.reset(k) for k in keys])
        changed = lambda *_: button.set_sensitive(any(s.get_user_value(k) is not None for k in keys))
        s.connect("changed", changed)
        changed()
        return button

    def _tint_row(self):
        """Glass tint: clear to fully tinted."""
        row = Adw.ActionRow(title="Glass tint", subtitle="From clear to fully tinted")
        scale = Gtk.Scale(adjustment=Gtk.Adjustment(lower=0, upper=1, step_increment=0.05, page_increment=0.1),
                          draw_value=False, hexpand=True, width_request=160, valign=Gtk.Align.CENTER)
        self.fx_settings.bind("glass-tint", scale.get_adjustment(), "value", Gio.SettingsBindFlags.DEFAULT)
        self.fx_settings.bind("glass", row, "sensitive", Gio.SettingsBindFlags.GET)
        row.add_suffix(scale)
        return row

    def _in_search(self):
        f = self.get_focus()
        return f is not None and f.is_ancestor(self.search)

    def _searched(self, *_):
        self.flow.invalidate_filter()
        # The key capture only forwards the key that starts a search; focus
        # stays on the selected card, so the next keys went nowhere. Once a
        # search is under way, typing (and Enter) belongs to the entry.
        if self.search.get_text() and not self._in_search():
            self.search.grab_focus()
            self.search.set_position(-1)

    def _first_visible(self):
        return next((ch for ch in list(self.flow) if ch.get_child_visible() and self._match(ch)), None)

    def _key(self, _c, kv, *_):
        # Down from the search steps into the filtered cards
        if kv == Gdk.KEY_Down and self._in_search():
            ch = self._first_visible()
            if ch:
                self.flow.select_child(ch)
                ch.grab_focus()
            return True
        if kv != Gdk.KEY_Escape:
            return False
        # Esc clears a search first, then closes
        if self.searchbar.get_search_mode():
            self.search.set_text("")
            self.searchbar.set_search_mode(False)
            sel = self.flow.get_selected_children()
            if sel:
                sel[0].grab_focus()
            return True
        self.close()
        return True

    def _match(self, child):
        q = self.search.get_text().strip().lower()
        if not q:
            return True
        th = child.card.theme
        return q in th.name.lower() or q in child.slug or q in (th.author or "").lower()

    def _pick_first(self, flow):
        ch = self._first_visible()
        if ch:
            flow.select_child(ch)
            self.on_pick(flow, ch)

    def on_pick(self, _flow, child):
        # Everything slow runs off the main thread: `set` is a subprocess we
        # wait on asynchronously, and the scan for open apps (D-Bus calls,
        # seconds on a busy session) runs in a worker thread. The window stays
        # responsive, and a failed switch is shown, not swallowed.
        # One pick at a time, and none once the window is closing: a second
        # pick in the close gap would start a `set` nobody waits for.
        if getattr(self, "_busy", False) or getattr(self, "_closing", False):
            return
        self._busy = True
        self._picked = child
        child.card.set_busy(True)
        self.set_sensitive(False)
        proc = Gio.Subprocess.new([str(HERE / "pulsar-theme"), "set", child.slug, "--no-restart"],
                                  Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        proc.communicate_utf8_async(None, None, self._set_done, child.slug)

    def _set_done(self, proc, res, slug):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(res)
        except GLib.Error as e:
            out = e.message
        if not proc.get_successful():
            self._picked.card.set_busy(False)
            self.set_sensitive(True)
            self._busy = False
            d = Adw.AlertDialog(heading="Could not apply the theme",
                                body=(out or "").strip()[-600:] or f"pulsar-theme set {slug} failed")
            d.add_response("close", "Close")
            d.present(self)
            return
        threading.Thread(target=self._scan, daemon=True).start()

    def _scan(self):
        try:
            restart, manual = pt.open_gtk_apps()
        except Exception:
            restart, manual = [], []
        GLib.idle_add(self._ask, restart, manual)

    def _close_soon(self, ms):
        # stays insensitive (and _busy) until it is gone: nothing can be picked
        self._closing = True
        self.set_sensitive(False)
        GLib.timeout_add(ms, self.close)

    def _ask(self, restart, manual):
        if not restart or pt.conf_get("restart-prompt") != "on":
            if restart or manual:
                self.toast(pt.NOTE)
            self._close_soon(600)
            return False
        # the switch is done and a question is about to be asked: the window
        # (and so the dialog on it) answers again, only while it is shown
        names = ", ".join(a["name"] for a in restart)
        body = f"{names} will quit and reopen. Apps with unsaved work will ask first."
        if manual:
            body += f"\n\nReopen these yourself: {', '.join(a['name'] for a in manual)}."
        d = Adw.AlertDialog(heading=f"Restart {len(restart)} open app{'s' if len(restart) != 1 else ''} to apply the theme?",
                            body=body)
        d.add_response("never", "Don't Ask Again")
        d.add_response("later", "Later")
        d.add_response("restart", "Restart")
        d.set_response_appearance("restart", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("restart")
        d.set_close_response("later")

        def done(_d, resp):
            if resp == "restart":
                # A separate process, so it outlives the picker: restarting
                # waits for each app to exit, and the picker (a libadwaita
                # window holding the old palette itself) closes right away
                # rather than showing a half-switched self.
                # exactly the apps the user just confirmed: no second scan
                Gio.Subprocess.new([str(HERE / "pulsar-theme"), "restart-apps", "--yes",
                                    "--ids", ",".join(a["id"] for a in restart)], Gio.SubprocessFlags.NONE)
            elif resp == "never":
                pt.conf_put("restart-prompt", "off")
            self._close_soon(300)
        d.connect("response", done)
        self.set_sensitive(True)
        d.present(self)
        return False

    def toast(self, text):
        print(f"pulsar-theme: {text}")


def main():
    app = Adw.Application(application_id="digital.arclight.Pulsar.ThemePicker",
                          flags=Gio.ApplicationFlags.NON_UNIQUE)
    app.connect("activate", lambda a: Picker(a).present())
    app.run([])


if __name__ == "__main__":
    main()
