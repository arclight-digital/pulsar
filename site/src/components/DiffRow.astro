---
// One transition in the ledger: what moved, and how far.
//
// The transition itself is Version.astro's job. That rendering is a
// typographic device and reads aloud as noise, so it is hidden from assistive
// tech here and a plain spoken sentence carries the same row instead.
//
// A group of more than one package is a disclosure rather than a bare "+9",
// because "+9" invites exactly one question and the answer is already here.
// <details> is the platform's and keyboard-operable; no script needed. The
// wrapper and its header are dynamic tags so the two shapes -- openable and
// not -- are one piece of markup rather than two that can drift apart.
import Version from './Version.astro';
import type { TransitionGroup } from '../data/digest';

interface Props {
  group: TransitionGroup;
}

const { group } = Astro.props;
const { delta } = group;

const extra = group.members.length - 1;
const others = group.members.filter((name) => name !== group.label);

const Wrap = extra > 0 ? 'details' : 'div';
const Head = extra > 0 ? 'summary' : 'div';

const spoken =
  `${group.label}, ${group.from} to ${group.to}` +
  (extra > 0 ? `, with ${extra} other package${extra === 1 ? '' : 's'}` : '');
---

<li class:list={['drow', { 'is-major': group.reach === 'major', 'is-down': group.downgraded }]}>
  <Wrap>
    <Head class="line">
      <span class="head">
        <span class="name">{group.label}</span>
        {
          extra > 0 && (
            <arc-badge size="sm" class="with">
              +{extra} package{extra === 1 ? '' : 's'}
              <arc-icon name="caret-down" size="xs" class="caret"></arc-icon>
            </arc-badge>
          )
        }
        {group.downgraded && <arc-badge size="sm" variant="warning">downgraded</arc-badge>}
      </span>

      <span class="ver" aria-hidden="true">
        <Version delta={delta} from={group.from} to={group.to} />
      </span>

      <span class="sr-only">{spoken}</span>
    </Head>

    {
      extra > 0 && (
        <ul class="members">
          {others.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
      )
    }
  </Wrap>
</li>

<style>
  .drow {
    border-top: 1px solid var(--border-subtle);
  }
  .line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding: var(--space-sm) 0;
    list-style: none;
  }
  summary.line {
    cursor: pointer;
  }
  summary.line::-webkit-details-marker {
    display: none;
  }
  summary.line:hover .name {
    color: var(--accent-primary);
  }
  .head {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .name {
    font-family: var(--font-mono);
    font-weight: var(--font-mono-weight);
    color: var(--text-primary);
    transition: color 0.2s var(--ease-out);
  }
  .is-major .name {
    color: var(--accent-primary);
    text-shadow: var(--glow-xs);
  }
  .with {
    font-family: var(--font-mono);
  }
  .caret {
    transition: transform 0.25s var(--ease-out);
  }
  details[open] .caret {
    transform: rotate(180deg);
  }
  .ver {
    font-size: var(--text-sm);
  }
  .members {
    list-style: none;
    margin: 0 0 var(--space-sm);
    padding: 0 0 0 var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
</style>
