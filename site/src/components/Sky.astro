---
// The hero background: assets/shaders/pulsar.frag -- the same shader that
// renders the OS wallpapers -- running live in WebGL; src/scripts/sky.ts
// compiles it. The CI-rendered silk still sits underneath as the CSS ground:
// it is the no-WebGL fallback AND the first paint while the bundle loads, so
// the weakest degraded state is another output of the same pipeline.
//
// #skyfade holds a snapshot of the outgoing look so backdrop switches
// crossfade directly instead of sweeping u_look through the intermediate ones.
//
// The deck is the quick way to the live looks. The full wallpaper choice --
// any theme's rendered wallpaper, independent of the theme -- lives in the
// site-wide picker (ThemePicker.astro, scripts/wallpaper.ts), which shows a
// theme's still in the .wallstill layer over the canvas.
//
// Hidden until a GL context actually exists -- a visitor without WebGL must
// never see buttons that silently do nothing. Light/dark is the top bar's
// toggle, not the deck's.
const LOOKS = ['Silk', 'Leak', 'Satin', 'Holo'];

// Hero option (a) trades this deck for its theme deck in the same spot.
interface Props {
  deck?: boolean;
}
const { deck = true } = Astro.props;
---

<canvas id="sky" aria-hidden="true"></canvas>
<canvas id="skyfade" aria-hidden="true"></canvas>
{/* empty until a theme's wallpaper is chosen; wallpaper.ts adds the image */}
<div class="wallstill" aria-hidden="true" data-wallstill-layer></div>

{deck && (
<div class="deck" role="group" aria-label="Backdrop" id="lookSeg" hidden>
  <span class="deck-note">The wallpapers Pulsar ships, live. More in the theme picker.</span>
  <div class="picker">
    {
      LOOKS.map((name, index) => (
        <button type="button" data-look={index} data-wall="pulsar" aria-pressed={index === 0 ? 'true' : 'false'}>
          {name}
        </button>
      ))
    }
  </div>
</div>
)}

<style>
  #sky,
  #skyfade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  #skyfade {
    pointer-events: none;
    opacity: 0;
  }
  .wallstill {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s var(--ease-out);
  }
  .wallstill[data-on] {
    opacity: 1;
  }
  .wallstill :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .deck {
    position: absolute;
    /* above the hero's content block, whose bottom padding reserves this
       room and would otherwise sit on top of the buttons and eat the clicks */
    z-index: 2;
    left: 50%;
    bottom: var(--space-lg);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    white-space: nowrap;
  }
  .deck[hidden] {
    display: none;
  }
  /* on the sky itself, not on the chip below it: it takes the page's text
     color, so a light page's pale sky keeps it readable */
  .deck-note {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .picker {
    display: inline-flex;
    padding: var(--space-xs);
    gap: var(--space-xs);
    border-radius: var(--radius-full);
    background: var(--chip);
    border: 1px solid var(--chip-line);
    backdrop-filter: blur(12px);
  }
  .picker[hidden] {
    display: none;
  }
  .picker button {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--on-chip);
    font: inherit;
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    font-size: var(--label-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  .picker button:hover {
    color: var(--star);
  }
  .picker button[aria-pressed='true'] {
    /* --pulsar-on-accent is set with a theme; Pulsar's own cyan takes ink */
    color: var(--pulsar-on-accent, var(--ink));
    background: var(--cyan);
    box-shadow: var(--glow-sm);
  }
  .picker button:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  /* Too narrow for the picker and the floating theme button to share the
     bottom edge: the picker steps up above the button. */
  @media (max-width: 40rem) {
    .deck {
      bottom: calc(var(--space-lg) + 2.75rem + var(--space-md));
    }
    .deck-note {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wallstill {
      transition: none;
    }
  }
</style>
