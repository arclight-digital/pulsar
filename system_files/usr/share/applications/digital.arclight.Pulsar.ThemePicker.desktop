[Desktop Entry]
Type=Application
Name=Themes
Comment=Recolor the apps, terminal, editor, top bar and wallpaper together
Keywords=theme;colour;color;palette;dark;light;wallpaper;accent;
Exec=/usr/libexec/pulsar/pulsar-theme-picker
Icon=digital.arclight.Pulsar.ThemePicker
Categories=Settings;DesktopSettings;GTK;
StartupNotify=true
X-GNOME-UsesNotifications=false
