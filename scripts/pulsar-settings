#!/usr/bin/python3
"""pulsar-settings -- Pulsar's own settings: what GNOME Settings has no room for.

GNOME Settings takes no panels from outside its own build, so Pulsar's live
here. Stock libadwaita: a sidebar of pages, rows of switches and buttons.
Everything it shows or does goes through the same `pulsar` CLI and GSettings
keys a terminal would; it holds no state of its own. What needs root goes
through pkexec, which asks for the password like any other system change.

`pulsar-settings [appearance | updates | agents]` opens on that page; a second launch
raises the open window and turns to the page asked for.
"""
import datetime
import json
import os
import pathlib
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import pulsar_theme_engine  # noqa: E402

pt = pulsar_theme_engine.load(HERE / "pulsar-theme")

# The CLI. From a checkout, the checkout's own.
PULSAR = os.environ.get("PULSAR_CLI") or (
    str(HERE.parent / "cli" / "pulsar") if (HERE.parent / "cli" / "pulsar").exists() else "/usr/bin/pulsar")
PICKER = str(HERE / "pulsar-theme-picker")
FX_SCHEMA = "org.gnome.shell.extensions.pulsar-theme"

# The Shell extension's effects (its prefs.js shows the same): key, title,
# subtitle, the key it needs on.
EFFECTS = (
    ("glass", "Glass", "The top bar, the dash, menus, dialogs, notifications and on-screen displays blur what is behind them", None),
    ("window-glass", "Glass windows", "GTK 4 app windows are 80% opaque over the same blur. GTK 3 apps and fullscreen windows stay solid, and so does the main area beside a sidebar, except Text Editor's document", "glass"),
    ("lighting", "Lighting", "A menu's edge is lit from the button that opened it, and turns warmer when the battery is low", None),
    ("power-on", "Power-on", "As a menu opens, its lit edge traces out from the button that opened it", "lighting"),
    ("glow", "Glow", "Switches that are on, checked boxes, slider fills, progress bars and default buttons glow in the accent color", None),
    ("focus-brackets", "Focus brackets", "While you use the keyboard, four corner brackets mark the focused button or menu item outside app windows", None),
    ("glass-off-gaming", "Disable glass when gaming", "Glass and lighting turn off while GameMode runs a game (gg, ggm or gamemoderun)", None),
    ("glass-off-power-saver", "Disable glass in Power Saver", "Glass and lighting turn off while the power mode is Power Saver", None),
)

PAGES = (("appearance", "Appearance", "applications-graphics-symbolic"),
         ("updates", "Updates", "software-update-available-symbolic"),
         ("agents", "Agents", "utilities-terminal-symbolic"))

# what `pulsar agent list` calls them
AGENT_NAMES = {"claude": "Claude Code", "codex": "Codex CLI", "gemini": "Gemini CLI",
               "opencode": "opencode", "aider": "aider"}
TMUX_SOCKET = "pulsar-agents"


def run(argv, done, *data):
    """argv in the background; done(ok, output, *data) on the main loop."""
    try:
        proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
    except GLib.Error as e:
        done(False, e.message, *data)
        return

    def finished(p, res):
        try:
            _ok, out, _err = p.communicate_utf8_finish(res)
        except GLib.Error as e:
            out = e.message
        done(p.get_successful(), out or "", *data)
    proc.communicate_utf8_async(None, None, finished)


def parse(text):
    try:
        return json.loads(text)
    except ValueError:
        return None


def day(ts):
    """A timestamp as a date a person reads: "October 3"."""
    try:
        d = datetime.datetime.fromtimestamp(int(ts))
    except (TypeError, ValueError, OverflowError, OSError):
        return None
    return f"{d:%B} {d.day}"


def ago(seconds):
    """How long, the way a person says it: "4 min", "2 h 5 min", "3 days"."""
    m = max(0, int(seconds)) // 60
    if m < 60:
        return f"{m} min"
    if m < 24 * 60:
        return f"{m // 60} h {m % 60} min" if m % 60 else f"{m // 60} h"
    d = m // (24 * 60)
    return "1 day" if d == 1 else f"{d} days"


def tokens(n):
    """950, 12k, 273k, 3.3M"""
    n = int(n or 0)
    if n < 1000:
        return str(n)
    if n < 1_000_000:
        return f"{int(n / 1000 + 0.5)}k"
    return f"{n / 1_000_000:.1f}M"


def home(path):
    h = os.path.expanduser("~")
    return "~" + path[len(h):] if path and (path == h or path.startswith(h + "/")) else (path or "")


def session_subtitle(s, now):
    """One line under a session's name: who, and what it is doing."""
    who = AGENT_NAMES.get(s.get("agent"), s.get("agent") or "Started by hand")
    if s.get("state") == "waiting":
        doing = "Needs you" if s.get("waiting_for") == "Notification" else "Waiting for you"
    elif s.get("state") == "running":
        doing = f"Running for {ago(now - s['started'])}" if s.get("started") else "Running"
    else:
        doing = "Ended"
    return f"{who} · {doing}"


def session_rows(s):
    """(title, subtitle) for what a session's row shows when opened."""
    rows = []
    folder = home(s.get("dir"))
    if folder:
        if s.get("worktree_of"):
            folder += f" (worktree of {home(s['worktree_of'])}, branch {s['name']})"
        rows.append(("Folder", folder))
    u = s.get("usage")
    if u:
        rows.append(("Context", f"{tokens(u.get('context'))} tokens now" + (f" · {u['model']}" if u.get("model") else "")))
        req = f"{u.get('requests', 0)} requests"
        if u.get("subagent_requests"):
            req += f", and {u['subagent_requests']} by subagents"
        rows.append(("Tokens", f"{tokens(u.get('read'))} read ({tokens(u.get('read_cached'))} from the cache) · "
                               f"{tokens(u.get('written'))} written · {req}"))
    return rows


def forget_body(s):
    """The Forget dialog's text. Only a Claude Code session resumes its
    conversation on Start (`agent run` passes --resume), so only it loses that."""
    if s.get("agent") == "claude":
        body = "Start can no longer bring its conversation back, and its undo snapshots are deleted."
    else:
        body = "Its undo snapshots are deleted."
    if s.get("worktree_of"):
        body += " Its worktree is removed if it has no uncommitted changes. The branch is kept."
    return body


def forget_left(r):
    """(heading, body) for what `agent sessions --forget --json` left behind,
    or None when it all went."""
    if not isinstance(r, dict):
        return None
    name, folder = r.get("name", ""), home(r.get("dir"))
    said = []
    if r.get("worktree") == "kept":
        said.append(f"Its worktree {folder} is still there: git won't remove a worktree with uncommitted "
                    f"changes. In a terminal, git worktree remove {r.get('dir')} says why.")
    if r.get("snapshots") == "left":
        said.append(f"{folder} is gone, so its undo snapshots couldn't be deleted. If it was in a git repository, "
                    f"git for-each-ref refs/pulsar/undo/{name}/ there lists them.")
    if not said:
        return None
    heading = "Worktree kept" if r.get("worktree") == "kept" else "Undo snapshots kept"
    return heading, f"{name} is forgotten. " + " ".join(said)


def session_order(s):
    return ({"waiting": 0, "running": 1}.get(s.get("state"), 2), s.get("name", ""))


def button(text, handler, *classes):
    b = Gtk.Button(label=text, valign=Gtk.Align.CENTER, css_classes=list(classes))
    b.connect("clicked", handler)
    return b


class Settings(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Pulsar Settings", default_width=900, default_height=680,
                         width_request=360, height_request=294)
        self.split = Adw.NavigationSplitView()
        self.sidebar = Gtk.ListBox(css_classes=["navigation-sidebar"])
        self.sidebar.connect("row-selected", self._selected)
        self.contents = {}
        for slug, title, icon in PAGES:
            row = Adw.ActionRow(title=title)
            row.add_prefix(Gtk.Image(icon_name=icon))
            row.slug = slug
            self.sidebar.append(row)
        side = Adw.ToolbarView(content=Gtk.ScrolledWindow(child=self.sidebar,
                                                          hscrollbar_policy=Gtk.PolicyType.NEVER))
        side.add_top_bar(Adw.HeaderBar())
        self.split.set_sidebar(Adw.NavigationPage(title="Pulsar Settings", child=side))
        self.content = Adw.NavigationPage(title="")
        self.split.set_content(self.content)
        self.set_content(self.split)

        bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 560sp"))
        bp.add_setter(self.split, "collapsed", True)
        self.add_breakpoint(bp)

        self.pages = {}
        for slug, page in (("appearance", self.appearance()), ("updates", self.updates()),
                           ("agents", self.agents())):
            tv = Adw.ToolbarView(content=page)
            tv.add_top_bar(Adw.HeaderBar())
            self.pages[slug] = tv

    def show_page(self, slug):
        for i, (s, *_r) in enumerate(PAGES):
            if s == slug:
                self.sidebar.select_row(self.sidebar.get_row_at_index(i))
                return True
        return False

    def _selected(self, _box, row):
        if row is None:
            return
        title = next(t for s, t, _i in PAGES if s == row.slug)
        self.content.set_title(title)
        self.content.set_child(self.pages[row.slug])
        self.split.set_show_content(True)
        if row.slug == "updates":
            self.refresh_updates()
        if row.slug == "agents":
            self.refresh_agents()
            if not self._agents_timer:
                self._agents_timer = GLib.timeout_add_seconds(5, self._agents_tick)

    # ------------------------------------------------------- appearance ----

    def appearance(self):
        page = Adw.PreferencesPage()
        themes = Adw.PreferencesGroup()
        self.theme_row = Adw.ActionRow(title="Theme", activatable=True,
                                       tooltip_text="Opens Themes")
        self.theme_row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        self.theme_row.connect("activated", lambda *_: self._open_picker())
        self._theme_subtitle()
        # back from the picker with a new theme: show it
        self.connect("notify::is-active", lambda *_: self.is_active() and self._theme_subtitle())
        themes.add(self.theme_row)
        page.add(themes)

        if not Gio.SettingsSchemaSource.get_default().lookup(FX_SCHEMA, True):
            return page
        self.fx = Gio.Settings(schema_id=FX_SCHEMA)
        fx = Adw.PreferencesGroup(
            title="Effects",
            description="Glass windows and Glow apply to apps opened after you change them. High contrast turns every "
                        "effect off, except in app windows already open. The two Disable glass switches leave app "
                        "windows' glass on.")
        fx.set_header_suffix(self._reset_button())
        for key, title, subtitle, needs in EFFECTS:
            row = Adw.SwitchRow(title=title, subtitle=subtitle)
            self.fx.bind(key, row, "active", Gio.SettingsBindFlags.DEFAULT)
            if needs:
                self.fx.bind(needs, row, "sensitive", Gio.SettingsBindFlags.GET)
            fx.add(row)
            if key == "glass":
                fx.add(self._tint_row())
        page.add(fx)
        return page

    def _theme_subtitle(self):
        cur = pt.current_state().get("theme")
        name = next((th.name for slug, th in pt.ordered_themes() if th is not None and slug == cur), None)
        self.theme_row.set_subtitle(name or "Stock GNOME")

    def _open_picker(self):
        try:
            Gio.Subprocess.new([PICKER], Gio.SubprocessFlags.NONE)
        except GLib.Error as e:
            self.alert("Could not open Themes", e.message)

    def _reset_button(self):
        """Every effect and the tint back to the defaults; only live while
        something differs from them."""
        s = self.fx
        keys = s.props.settings_schema.list_keys()
        b = Gtk.Button(label="Reset", tooltip_text="Put every effect and the tint back to the defaults",
                       css_classes=["flat"], valign=Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: [s.reset(k) for k in keys])
        changed = lambda *_: b.set_sensitive(any(s.get_user_value(k) is not None for k in keys))
        s.connect("changed", changed)
        changed()
        return b

    def _tint_row(self):
        """Glass tint: clear to fully tinted."""
        row = Adw.ActionRow(title="Glass tint", subtitle="From clear to fully tinted")
        scale = Gtk.Scale(adjustment=Gtk.Adjustment(lower=0, upper=1, step_increment=0.05, page_increment=0.1),
                          draw_value=False, hexpand=True, width_request=160, valign=Gtk.Align.CENTER)
        self.fx.bind("glass-tint", scale.get_adjustment(), "value", Gio.SettingsBindFlags.DEFAULT)
        self.fx.bind("glass", row, "sensitive", Gio.SettingsBindFlags.GET)
        row.add_suffix(scale)
        return row

    # ---------------------------------------------------------- updates ----

    def updates(self):
        page = Adw.PreferencesPage()

        system = Adw.PreferencesGroup(title="This computer")
        self.release_row = Adw.ActionRow(title="Pulsar", subtitle_selectable=True)
        self.image_row = Adw.ActionRow(title="System image", subtitle_selectable=True)
        system.add(self.release_row)
        system.add(self.image_row)
        page.add(system)

        upd = Adw.PreferencesGroup(title="Updates")
        self.update_row = Adw.ActionRow(title="Checking for updates")
        self.update_slot = Gtk.Box(valign=Gtk.Align.CENTER)
        self.update_row.add_suffix(self.update_slot)
        upd.add(self.update_row)
        self.auto_row = Adw.ActionRow(
            title="Automatic downloads",
            subtitle="New images download in the background on AC power and unmetered networks. "
                     "Nothing restarts by itself.")
        self.auto_state = Gtk.Label(css_classes=["dim-label"], valign=Gtk.Align.CENTER)
        self.auto_row.add_suffix(self.auto_state)
        upd.add(self.auto_row)
        page.add(upd)

        back = Adw.PreferencesGroup(title="Going back")
        self.prev_row = Adw.ActionRow(title="Previous image")
        self.rollback_button = button("Roll Back…", lambda *_: self._confirm_rollback())
        self.prev_row.add_suffix(self.rollback_button)
        back.add(self.prev_row)
        self.pin_row = Adw.SwitchRow(
            title="Keep this image",
            subtitle="A kept image stays on this computer through later updates")
        self._pin_handler = self.pin_row.connect("notify::active", self._pin_toggled)
        back.add(self.pin_row)
        page.add(back)
        return page

    def refresh_updates(self):
        run([PULSAR, "manifest", "--json"], self._manifest)
        run([PULSAR, "status", "--json"], self._status)
        run(["systemctl", "is-enabled", "pulsar-update-auto.timer"], self._auto)
        self.check_updates()

    def _manifest(self, _ok, out):
        m = parse(out) or {}
        self.release_row.set_subtitle(m.get("release") or "Unknown release")
        built = m.get("built", "")
        try:
            d = datetime.datetime.fromisoformat(built.replace("Z", "+00:00")).astimezone()
            built = f"built {d:%B} {d.day}"
        except ValueError:
            built = ""
        self.image_row.set_subtitle(" · ".join(x for x in (m.get("version"), built) if x) or "Unknown")

    def _status(self, _ok, out):
        deps = (parse(out) or {}).get("deployments") or []
        booted = next((d for d in deps if d.get("booted")), None)
        prev = next((d for d in deps if not d.get("booted") and not d.get("staged")), None)
        # The first deployment is the one the next start boots.
        rolled = bool(deps) and deps[0] is prev
        if prev is None:
            self.prev_row.set_subtitle("There is no previous image on this computer yet")
            self.rollback_button.set_visible(False)
        elif rolled:
            self.prev_row.set_subtitle(f"{prev.get('version', '?')} starts at the next restart")
            self.rollback_button.set_visible(False)
        else:
            when = day(prev.get("timestamp"))
            self.prev_row.set_subtitle(f"{prev.get('version', '?')}" + (f" · built {when}" if when else ""))
            self.rollback_button.set_visible(True)
        self.prev = prev
        self.pin_row.handler_block(self._pin_handler)
        self.pin_row.set_active(bool(booted and booted.get("pinned")))
        self.pin_row.handler_unblock(self._pin_handler)
        self.pin_row.set_sensitive(booted is not None)

    def _auto(self, _ok, out):
        self.auto_state.set_label("On" if out.strip() == "enabled" else "Off")

    def _slot(self, widget):
        while (c := self.update_slot.get_first_child()) is not None:
            self.update_slot.remove(c)
        if widget:
            self.update_slot.append(widget)

    def check_updates(self):
        self.update_row.set_title("Checking for updates")
        self.update_row.set_subtitle("")
        self._slot(Adw.Spinner())
        run([PULSAR, "update", "--check", "--json"], self._checked)

    def _checked(self, _ok, out):
        # exit 10 means an update is out; the JSON says it either way
        r = parse(out.strip().splitlines()[-1] if out.strip() else "") or {}
        s = r.get("status")
        if s == "current":
            self.update_row.set_title("Up to date")
            self.update_row.set_subtitle(f"{r.get('booted', '?')} is the newest image")
            self._slot(button("Check Again", lambda *_: self.check_updates(), "flat"))
        elif s == "available":
            self.update_row.set_title("Update available")
            self.update_row.set_subtitle(f"{r.get('latest', '?')} is out")
            self._slot(button("Download", lambda *_: self._download(), "suggested-action"))
        elif s == "staged":
            self.update_row.set_title("Restart to update")
            self.update_row.set_subtitle(f"{r.get('latest', '?')} is downloaded and starts at the next restart")
            self._slot(button("Restart…", lambda *_: self._restart()))
        else:
            self.update_row.set_title("Could not check for updates")
            self.update_row.set_subtitle(out.strip().splitlines()[-1][:200] if out.strip() else "")
            self._slot(button("Try Again", lambda *_: self.check_updates(), "flat"))

    def _download(self):
        self.update_row.set_title("Downloading the update")
        self.update_row.set_subtitle("You can close this window. A notification says when it's done.")
        self._slot(Adw.Spinner())
        # What the update notification's Update button does: the stage runs
        # in a unit of its own, which posts how it ended (ready, or failed)
        # whether or not this window is still open. This waits for it only
        # to update the row; the notification is the one report.
        run([PULSAR, "update", "--download"], self._downloaded)

    def _downloaded(self, ok, _out):
        if ok:
            self.refresh_updates()
            return
        self.update_row.set_title("Could not download the update")
        self.update_row.set_subtitle("See why: journalctl -u pulsar-update-stage")
        self._slot(button("Try Again", lambda *_: self._download(), "flat"))

    def _restart(self):
        # GNOME's own restart dialog; the user confirms there
        try:
            Gio.Subprocess.new(["gnome-session-quit", "--reboot"], Gio.SubprocessFlags.NONE)
        except GLib.Error as e:
            self.alert("Could not restart", e.message)

    def _confirm_rollback(self):
        version = (self.prev or {}).get("version", "the previous image")
        d = Adw.AlertDialog(heading=f"Roll back to {version}?",
                            body=f"This computer starts {version} at the next restart. Your files and Flatpak apps stay as "
                                 "they are. System-wide settings changed since this image was installed are undone.")
        d.add_response("cancel", "Cancel")
        d.add_response("rollback", "Roll Back")
        d.set_response_appearance("rollback", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_close_response("cancel")
        d.connect("response", lambda _d, r: r == "rollback" and self._rollback())
        d.present(self)

    def _rollback(self):
        self.rollback_button.set_sensitive(False)
        run(["pkexec", PULSAR, "rollback"], self._rolled_back)

    def _rolled_back(self, ok, out):
        self.rollback_button.set_sensitive(True)
        # 126: the password prompt was dismissed, which is an answer, not an error
        if not ok and "dismissed" not in out.lower() and "not authorized" not in out.lower():
            self.alert("Could not roll back", out.strip()[-600:])
        run([PULSAR, "status", "--json"], self._status)

    def _pin_toggled(self, row, _p):
        row.set_sensitive(False)
        run(["pkexec", PULSAR, "pin", "on" if row.get_active() else "off"], self._pinned)

    def _pinned(self, ok, out):
        self.pin_row.set_sensitive(True)
        if not ok and "dismissed" not in out.lower() and "not authorized" not in out.lower():
            self.alert("Could not change whether this image is kept", out.strip()[-600:])
        # read it back either way: a dismissed prompt puts the switch back
        run([PULSAR, "status", "--json"], self._status)

    # ----------------------------------------------------------- agents ----
    # Every session `pulsar agent run <name> --tmux <session>` started, read
    # from `pulsar agent sessions --json` and refreshed while the page shows.
    # Rows are updated in place, so an open row stays open.

    def agents(self):
        page = Adw.PreferencesPage()
        self._agents_timer = 0
        self.session_rows = {}
        self.sessions = Adw.PreferencesGroup(
            title="Sessions",
            description="Each runs one coding agent in a terminal session that keeps going when its window "
                        "closes. You get a notification when an agent rings the terminal bell, which Claude Code "
                        "does when it waits for you.")
        self.sessions_empty = Adw.ActionRow(
            title="No sessions yet", subtitle="Start one in a terminal: pulsar agent run <agent> --tmux <name>",
            subtitle_selectable=True)
        self.sessions.add(self.sessions_empty)
        page.add(self.sessions)
        return page

    def _agents_tick(self):
        row = self.sidebar.get_selected_row()
        if row is None or row.slug != "agents" or not self.get_visible():
            self._agents_timer = 0
            return False
        self.refresh_agents()
        return True

    def refresh_agents(self):
        run([PULSAR, "agent", "sessions", "--json"], self._sessions)

    def _sessions(self, ok, out):
        found = parse(out) if ok else None
        if not isinstance(found, list):
            return
        found.sort(key=session_order)
        names = [s["name"] for s in found]
        for name in list(self.session_rows):
            if name not in names:
                self.sessions.remove(self.session_rows.pop(name).row)
        if [n for n in self.session_rows] != names:
            # new sessions, or a new order: re-add in order, keeping each row
            for r in self.session_rows.values():
                self.sessions.remove(r.row)
            rows = {n: self.session_rows.get(n) or SessionRow(self, n) for n in names}
            for n in names:
                self.sessions.add(rows[n].row)
            self.session_rows = rows
        now = GLib.get_real_time() // 1_000_000
        for s in found:
            self.session_rows[s["name"]].update(s, now)
        self.sessions_empty.set_visible(not found)

    def open_session(self, s):
        if s.get("agent"):
            argv = [PULSAR, "agent", "run", s["agent"], "--tmux", s["name"]]
        else:
            argv = ["tmux", "-L", TMUX_SOCKET, "attach-session", "-t", "=" + s["name"]]
        try:
            Gio.Subprocess.new(["ptyxis", "--new-window", "--", *argv], Gio.SubprocessFlags.NONE)
        except GLib.Error as e:
            self.alert("Could not open a terminal", e.message)
            return
        GLib.timeout_add_seconds(2, lambda: self.refresh_agents() and False)

    def confirm(self, heading, body, action, label, then):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("cancel", "Cancel")
        d.add_response(action, label)
        d.set_response_appearance(action, Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_close_response("cancel")
        d.connect("response", lambda _d, r: r == action and then())
        d.present(self)

    def end_session(self, s):
        back = " Starting it again resumes the conversation." if s.get("agent") == "claude" else ""
        self.confirm(f"End {s['name']}?", f"The agent stops, and the session closes.{back}",
                     "end", "End Session", lambda: self._agent_cmd("Could not end the session",
                                                                    "sessions", "--kill", s["name"]))

    def forget_session(self, s):
        self.confirm(f"Forget {s['name']}?", forget_body(s), "forget", "Forget", lambda: self._forget(s["name"]))

    def _forget(self, name):
        def done(ok, out):
            if not ok:
                self.alert("Could not forget the session", out.strip()[-600:])
            elif (left := forget_left(parse(out.strip().splitlines()[-1] if out.strip() else ""))):
                self.alert(*left)
            self.refresh_agents()
        # --json: whether the worktree and the undo snapshots went too
        run([PULSAR, "agent", "sessions", "--forget", name, "--json"], done)

    def _agent_cmd(self, failure, *args):
        def done(ok, out):
            if not ok:
                self.alert(failure, out.strip()[-600:])
            self.refresh_agents()
        run([PULSAR, "agent", *args], done)

    def undo_session(self, s):
        """What would change first, from the CLI itself; then do it, with a way back."""
        name = s["name"]

        def shown(ok, out):
            text = out.strip()
            if not ok or text.startswith("nothing to do"):
                self.alert("Nothing to undo" if ok else "Could not undo", text[-600:])
                return
            self.confirm(f"Undo what changed in {name}?", text[-1200:], "undo", "Put Files Back",
                         lambda: run([PULSAR, "agent", "undo", name, "--yes"], undone))

        def undone(ok, out):
            if not ok:
                self.alert("Could not undo", out.strip()[-600:])
                return
            d = Adw.AlertDialog(heading="Files put back",
                                body="The listed files are back to how they were when the session started. "
                                     "Redo takes the undo back.")
            d.add_response("close", "Close")
            d.add_response("redo", "Redo…")
            d.connect("response", lambda _d, r: r == "redo" and self.redo_session(name))
            d.present(self)
        run([PULSAR, "agent", "undo", name, "--dry-run"], shown)

    def redo_session(self, name):
        """Like undo: the CLI's list first (what it puts back and any file it
        leaves as it is), then do it."""
        def shown(ok, out):
            text = out.strip()
            if not ok or text.startswith("nothing to do"):
                self.alert("Nothing to redo" if ok else "Could not redo", text[-600:])
                return
            self.confirm(f"Take back the undo in {name}?", text[-1200:], "redo", "Redo",
                         lambda: self._agent_cmd("Could not redo", "undo", name, "--redo", "--yes"))
        run([PULSAR, "agent", "undo", name, "--redo", "--dry-run"], shown)

    def alert(self, heading, body):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("close", "Close")
        d.present(self)


class SessionRow:
    """One session: its name and state, Open or Start, and when opened, where
    it works, what it has used, and Undo, End or Forget."""

    def __init__(self, win, name):
        self.win, self.s = win, {"name": name}
        self.row = Adw.ExpanderRow(title=name)
        self.go = button("Open", lambda *_: win.open_session(self.s))
        self.row.add_suffix(self.go)
        self.info = []
        self.undo_row = Adw.ActionRow(title="Undo the agent's changes")
        self.undo_button = button("Undo…", lambda *_: win.undo_session(self.s))
        self.undo_row.add_suffix(self.undo_button)
        self.end_row = Adw.ActionRow()
        self.end_button = button("End…", lambda *_: self._end(), "destructive-action")
        self.end_row.add_suffix(self.end_button)
        self.row.add_row(self.undo_row)
        self.row.add_row(self.end_row)

    def _end(self):
        (self.win.end_session if self.s.get("state") != "ended" else self.win.forget_session)(self.s)

    def update(self, s, now):
        self.s = s
        live = s.get("state") != "ended"
        self.row.set_subtitle(session_subtitle(s, now))
        self.go.set_label("Open" if live else "Start")
        self.go.set_visible(live or bool(s.get("agent")))
        rows = session_rows(s)
        while len(self.info) < len(rows):
            r = Adw.ActionRow(subtitle_selectable=True, css_classes=["property"])
            self.info.append(r)
            self.row.remove(self.undo_row)
            self.row.remove(self.end_row)
            self.row.add_row(r)
            self.row.add_row(self.undo_row)
            self.row.add_row(self.end_row)
        for r, (title, sub) in zip(self.info, rows + [("", "")] * len(self.info)):
            r.set_title(title)
            r.set_subtitle(sub)
            r.set_visible(bool(title))
        snaps = s.get("snapshots") or 0
        self.undo_row.set_visible(snaps > 0)
        self.undo_button.set_sensitive(not live)
        self.undo_row.set_subtitle("Available once the session has ended, so the agent can't write files during the undo"
                                   if live else "Puts the files back as they were when the session started, "
                                   "except files git ignores")
        self.end_row.set_title("End this session" if live else "Forget this session")
        self.end_row.set_subtitle("" if live else "Stops tracking it, and drops its undo snapshots")
        self.end_button.set_label("End…" if live else "Forget…")


def main(argv):
    app = Adw.Application(application_id="digital.arclight.Pulsar.Settings",
                          flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def command_line(a, cl):
        args = cl.get_arguments()[1:]
        w = a.get_active_window() or Settings(a)
        if not (args and w.show_page(args[0])) and w.sidebar.get_selected_row() is None:
            w.show_page(PAGES[0][0])
        w.present()
        return 0
    app.connect("command-line", command_line)
    return app.run(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
