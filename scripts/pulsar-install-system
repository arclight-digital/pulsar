#!/usr/bin/python3
"""Install Pulsar onto a disk: everything after the user said yes. Root only.

    pulsar-install-system --mode erase|alongside --key-file FILE | --no-encrypt \\
        --source-imgref containers-storage:IMG --target-imgref REGISTRY/IMG \\
        --expect-size BYTES --expect-serial SERIAL DISK

--expect-size and --expect-serial are the disk the person chose, as the
installer's lsblk saw it; the disk tool refuses to write to DISK unless it
is still that drive (a name like /dev/sda can pass to another).

  1. alongside: the disk's EFI system partition must have room for Pulsar's
     boot files (checked before anything is written)
  2. pulsar-install-disk lays out the disk (it refuses any plan but ours)
  3. the root is unlocked with the passphrase in FILE (unless --no-encrypt:
     then it is plain btrfs, and there is nothing to unlock) and mounted,
     with /boot and the ESP under it
  4. bootc installs the image. Its bootupd would delete EVERY firmware boot
     entry named like ours ("Fedora": a Fedora installed beside us lost
     its entry) before adding one, so it runs where efivarfs is read-only,
     which bootupd takes as "leave the firmware alone"
  5. if Windows is on the ESP, GRUB gets an entry for it; so does a
     Fedora-family Linux whose EFI/fedora Pulsar's boot files replace, when
     its /boot and grub.cfg were found (read-only) before anything was
     written
  6. the firmware gets a "Pulsar" entry, replacing only older "Pulsar"
     entries on this same ESP
  7. a finished install keeps this run's log in its own /var/log
     (pulsar-install.log), where it outlives the live session
  8. everything is unmounted and the root locked again, failed or not

Progress goes to stdout as one JSON object per line, for the installer app:
{"stage": "check" | "disk" | "unlock" | "install" | "boot"} as each step
starts ("unlock" only when encrypted), {"log": "..."} for each line bootc
and the disk tool print, then {"stage": "done", ...} or {"stage": "failed", "error": ...,
"restored": true|false, "disk": ..., "esp": ...}. restored is whether the disk
is as it was before: true only if nothing was written to it, or, installing
alongside, every partition this install made was taken back. An erase that
began writing is never restored: what was on the disk is gone. disk and esp
say what is known, for the installer app to tell the person:
  disk  "unchanged"  nothing was written to the disk
        "unknown"    the disk tool stopped without saying it refused (failed
                     while writing, crashed, killed): what is on the disk is
                     unknown
        "removed"    the disk was partitioned, and every partition this install
                     made has been deleted again
        "left"       the disk was partitioned, and some or all of the partitions
                     this install made are still there
  esp   (alongside; null for an erase, whose ESP is Pulsar's own)
        "unchanged"  bootc never ran: nothing was written to the shared ESP
        "boot_files" bootc ran: its boot files (EFI/fedora) may be on the ESP;
                     EFI/BOOT was put back as it was
        "fallback"   bootc ran, and EFI/BOOT could not be put back: the
                     other system's fallback loader may be replaced too
--plan-only prints
{"stage": "plan", "plan": [...], "windows": ..., "fedora_linux": ...,
"other_loaders": [...]} (pulsar-install-disk's dry run; the rest, alongside
only, preflight_alongside's survey of the shared ESP: whether Windows' boot
manager is on it, the Fedora-family Linux whose EFI/fedora Pulsar replaces
and whether it gets a startup menu entry, and other Linux boot loaders the
computer's own boot menu starts) and writes nothing; it needs no key
(--no-encrypt plans the unencrypted layout). The done event repeats
fedora_linux and other_loaders, with linux_entry, the title of the menu
entry made for the Fedora-family Linux (or null).

PULSAR_BOOTC_PREFIX, if set, runs bootc through a wrapper (the test bench
runs it in the image with podman); the default is the live system's own.
"""

import argparse
import glob
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
DISK_TOOL = os.environ.get("PULSAR_INSTALL_DISK", os.path.join(HERE, "pulsar-install-disk"))
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
ESP_MIN_FREE = 32 * 2**20      # the install writes ~13.5 MiB; room for bootupd updates
WINDOWS_LOADER = "EFI/Microsoft/Boot/bootmgfw.efi"
EFIVARS = "/sys/firmware/efi/efivars"
LABEL = "Pulsar"
MAPPER = "pulsar-install-root"
SCRATCH = "/run/pulsar-install"      # mount points for the target


class Failed(Exception):
    def __init__(self, msg, code=None):
        super().__init__(msg)
        self.code = code     # the failed command's exit status, when there was one


class Stopped(Failed):
    """SIGTERM or SIGHUP (the session ending): the step running is stopped,
    its command ended and waited for, then everything is cleaned up as for
    any failure. Never a clean-up while bootc or the disk tool still writes."""


def stop_on_signals():
    def stop(signum, _frame):
        raise Stopped(f"stopped by {signal.Signals(signum).name}")
    for s in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, stop)


def hold_signals():
    """The clean-up runs to its end: a second signal can't cut it short."""
    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(s, signal.SIG_IGN)


# pulsar-install-disk's exits: refused before writing anything, or failed
# with the write begun. Any other failure of it counts as the second.
DISK_REFUSED, DISK_WRITE_FAILED = 2, 3

# Everything this run prints, stdout and stderr, stamped as the installer
# app stamps its log: a finished install keeps it (keep_log). The app's
# own log is in the live session, gone at restart.
RECORD = []
T0 = time.monotonic()
KEPT_LOG = "var/log/pulsar-install.log"     # in the new system's /var


def note(line):
    RECORD.append(f"[{time.monotonic() - T0:7.1f}s] {line}")


def tell(line, stream):
    """A line for the installer app. If the app has gone (its end of the
    pipe closed), the install carries on: a print that failed would
    otherwise end it mid-step, and its clean-up would run while bootc still
    wrote. The line is in RECORD either way, and the stream is pointed at
    /dev/null so later lines, and the flush at exit, go nowhere quietly."""
    try:
        print(line, file=stream, flush=True)
    except (OSError, ValueError):
        try:
            null = os.open(os.devnull, os.O_WRONLY)
            os.dup2(null, stream.fileno())
            os.close(null)
        except (OSError, ValueError, AttributeError):
            pass


def say(msg):
    note("stderr: " + msg)
    tell(msg, sys.stderr)


def emit(**event):
    line = json.dumps(event)
    note(line)
    tell(line, sys.stdout)


def ended(p):
    """Stop p and wait for it: a step cut short (a signal, an error while
    reading its output) never leaves its command running under the clean-up.
    From here the run is failing: a second signal can't cut the wait short."""
    hold_signals()
    if p.poll() is None:
        p.terminate()
        try:
            p.wait(timeout=60)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()


UNITS = {"B": 1, "KB": 10**3, "MB": 10**6, "GB": 10**9, "TB": 10**12}


def payload_bytes(line):
    """The size bootc announces it will copy: "layers needed: 201 (7.8 GB)"."""
    # bootc puts a no-break space (U+00A0) between number and unit
    m = re.search(r"layers needed: \d+ \(([\d.]+)[\s\u00a0]*([KMGT]?B)\)", line)
    return round(float(m.group(1)) * UNITS[m.group(2)]) if m else None


def copied_fraction(used, base, expected):
    """How far the copy has got: what has landed on the new root since it
    started, over what bootc said it needs. The installed root measured
    1.02x the announced size, so this tracks; it stays under 1 until bootc
    itself says it is done."""
    if not expected or used <= base:
        return 0.0
    return min(0.99, (used - base) / expected)


def run_stream(*cmd, watch=None, expected_bytes=None):
    """run(), with each output line passed on as a progress event. watch,
    a mounted path: while it runs, how much of the announced copy has landed
    there, as {"progress": 0..1}."""
    say("+ " + shlex.join(cmd))
    p = subprocess.Popen(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=1)
    tail, expected = [], [expected_bytes]
    try:
        if watch:
            def used():
                st = os.statvfs(watch)
                return (st.f_blocks - st.f_bfree) * st.f_frsize
            base = used()

            def poll():
                last = -1.0
                while p.poll() is None:
                    f = copied_fraction(used(), base, expected[0])
                    if f - last >= 0.005:
                        emit(progress=round(f, 3))
                        last = f
                    time.sleep(1)
            threading.Thread(target=poll, daemon=True).start()
        for line in p.stdout:
            line = line.rstrip()
            if line:
                emit(log=line)
                # the larger of what bootc announces (compressed, from some
                # sources: 3.3 GB for an 8 GB install) and what the ISO measured
                announced = payload_bytes(line)
                if announced:
                    expected[0] = max(announced, expected[0] or 0)
                tail = (tail + [line])[-8:]
        p.wait()
    except BaseException:
        ended(p)
        raise
    if p.returncode != 0:
        raise Failed(f"{cmd[0]} exited {p.returncode}: " + " | ".join(tail)[-500:], p.returncode)


def run_logged(*cmd):
    """run() for a command that logs as it works (the disk tool): each line
    of its stderr is passed on as {"log": ...} the moment it is printed, so
    a slow step shows which part of it is slow. Returns its stdout."""
    say("+ " + shlex.join(cmd))
    p = subprocess.Popen(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, tail = [], []
    try:
        reader = threading.Thread(target=lambda: out.append(p.stdout.read()), daemon=True)
        reader.start()
        for line in p.stderr:
            line = line.rstrip()
            if line:
                emit(log=line)
                tail = (tail + [line])[-8:]
        reader.join()
        p.wait()
    except BaseException:
        ended(p)
        raise
    if p.returncode != 0:
        raise Failed(f"{cmd[0]} exited {p.returncode}: " + " | ".join(tail)[-500:], p.returncode)
    return out[0] if out else ""


def run(*cmd, **kw):
    say("+ " + shlex.join(cmd))
    r = subprocess.run(cmd, text=True, capture_output=True, **kw)
    if r.returncode != 0:
        raise Failed(f"{cmd[0]} exited {r.returncode}: {(r.stderr or r.stdout).strip()[-500:]}", r.returncode)
    return r.stdout


def partitions(disk):
    # lsblk lists flat or as a tree depending on the columns asked for:
    # take every device whose parent is this disk, whichever it gave
    real = os.path.realpath(disk)
    out = json.loads(run("lsblk", "-J", "-p", "-o", "PATH,PKNAME,PARTTYPE,PARTN,PARTUUID,UUID,FSTYPE,LABEL", real))

    def walk(devs):
        for d in devs:
            yield d
            yield from walk(d.get("children", []))
    return [d for d in walk(out["blockdevices"]) if d.get("pkname") == real and d.get("partn")]


def esp_of(disk):
    esps = [p for p in partitions(disk) if (p.get("parttype") or "").lower() == ESP_TYPE]
    if len(esps) != 1:
        raise Failed(f"expected one EFI system partition on {disk}, found {len(esps)}")
    return esps[0]


# Boot loaders another Linux puts in its own EFI/<vendor> directory: that
# directory and its firmware entry are left alone, and the computer's own boot
# menu starts it. (Pulsar's GRUB can't start it under Secure Boot: it only
# trusts kernels signed for Fedora.)
OTHER_LOADERS = ("shimx64.efi", "grubx64.efi", "systemd-bootx64.efi")
# For a Fedora-family /boot: GRUB's module for its filesystem, and how to
# mount it read-only without writing to it (a read-only mount of an ext4 or
# XFS whose journal needs replaying replays it, unless told not to)
GRUB_FS = {"ext4": ("ext2", "ro,noload"), "ext3": ("ext2", "ro,noload"), "ext2": ("ext2", "ro"),
           "xfs": ("xfs", "ro,norecovery"), "btrfs": ("btrfs", "ro,rescue=nologreplay")}
UUID_RE = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"


def fedora_boot_ref(stub, bootuuid):
    """The /boot a Fedora-family Linux's EFI/fedora starts, as its ESP files
    name it: ("uuid", UUID) or ("label", LABEL), or None. Fedora's own stub
    grub.cfg says `search ... --fs-uuid --set=dev UUID`; bootupd's (Fedora
    Atomic, bootc) puts `set BOOT_UUID="UUID"` in bootuuid.cfg, and searches
    by the label "boot" without it."""
    m = re.search(r'BOOT_UUID="?(' + UUID_RE + ')', bootuuid)
    if m:
        return ("uuid", m.group(1).lower())
    for line in stub.splitlines():
        if "search" in line and "--fs-uuid" in line:
            m = re.search(UUID_RE, line)
            if m:
                return ("uuid", m.group(0).lower())
    m = re.search(r"--label\s+([^\s$\"']+)", stub)
    return ("label", m.group(1)) if m else None


def bls_title(boot):
    """The name a Fedora /boot's newest boot entry gives its system, without
    the kernel version or ostree index: "Fedora Linux 42 (Workstation
    Edition)". None when it has no entries."""
    for d in ("loader/entries", "boot/loader/entries"):
        path = os.path.join(boot, d)
        if not os.path.isdir(path):
            continue
        for name in sorted(os.listdir(path), reverse=True):
            if not name.endswith(".conf"):
                continue
            for line in open(os.path.join(path, name), errors="replace"):
                if line.startswith("title "):
                    title = re.sub(r"\s*\((?:\d[^)]*|ostree:\d+)\)", "", line[6:].strip())
                    title = re.sub(r"[^\w .,()+-]", "", title).strip()
                    if title:
                        return title
    return None


def fedora_linux(disk, scratch, stub, bootuuid):
    """The Fedora-family Linux whose boot files are in EFI/fedora, which
    Pulsar's bootupd is about to overwrite: where its /boot is, so Pulsar's
    GRUB can get an entry that starts it through its own GRUB configuration.
    {"menu": True, "title", "uuid", "fs", "grub_dir"}, or {"menu": False,
    "why"} when its /boot or that configuration can't be found."""
    ref = fedora_boot_ref(stub, bootuuid)
    if not ref:
        return {"menu": False, "why": "EFI/fedora names no /boot"}
    kind, value = ref
    found = [p for p in partitions(disk)
             if (kind == "uuid" and (p.get("uuid") or "").lower() == value)
             or (kind == "label" and p.get("label") == value)]
    if len(found) != 1:
        return {"menu": False, "why": f"{len(found)} partitions on {disk} have the {kind} {value}"}
    part = found[0]
    if part.get("fstype") not in GRUB_FS:
        return {"menu": False, "why": f"its /boot is {part.get('fstype') or 'no filesystem'}"}
    mod, opts = GRUB_FS[part["fstype"]]
    mnt = os.path.join(scratch, "linux-boot-check")
    os.makedirs(mnt)
    try:
        run("mount", "-t", part["fstype"], "-o", opts, part["path"], mnt)
    except Failed as e:
        return {"menu": False, "why": f"can't mount its /boot: {e}"}
    try:
        grub_dir = next((d for d in ("grub2", "boot/grub2") if os.path.isfile(os.path.join(mnt, d, "grub.cfg"))), None)
        title = bls_title(mnt)
    finally:
        run("umount", mnt)
    if not grub_dir:
        return {"menu": False, "why": f"no grub2/grub.cfg on {part['path']}"}
    return {"menu": True, "title": title or "Fedora Linux", "uuid": part["uuid"].lower(), "fs": part["fstype"],
            "grub_mod": mod, "grub_dir": grub_dir}


def preflight_alongside(disk, scratch):
    """Check the shared ESP, mounted read-only, before anything is written:
    it must have room for Pulsar's boot files. Returns what starts from it
    besides: whether Windows' boot manager is on it (the test windows_entry
    makes for its menu entry), the Fedora-family Linux whose EFI/fedora
    Pulsar's boot files will replace (fedora_linux, or None), and the other
    vendor directories with a Linux boot loader of their own."""
    esp = esp_of(disk)
    mnt = os.path.join(scratch, "esp-check")
    os.makedirs(mnt)
    run("mount", "-o", "ro", esp["path"], mnt)
    try:
        st = os.statvfs(mnt)
        free = st.f_bavail * st.f_frsize
        windows = os.path.isfile(os.path.join(mnt, WINDOWS_LOADER))
        efi = os.path.join(mnt, "EFI")
        vendors = sorted(d for d in os.listdir(efi) if os.path.isdir(os.path.join(efi, d))) if os.path.isdir(efi) else []
        fedora = next((d for d in vendors if d.lower() == "fedora"), None)

        def text(*path):
            try:
                return open(os.path.join(efi, *path), errors="replace").read()
            except OSError:
                return ""
        stub, bootuuid = (text(fedora, "grub.cfg"), text(fedora, "bootuuid.cfg")) if fedora else ("", "")
        others = [d for d in vendors if d.lower() not in ("boot", "fedora", "microsoft")
                  and any(os.path.isfile(os.path.join(efi, d, f)) for f in OTHER_LOADERS)]
    finally:
        run("umount", mnt)
    if free < ESP_MIN_FREE:
        raise Failed(f"The startup files (EFI) partition has {free // 2**20} MiB free. Pulsar needs "
                     f"{ESP_MIN_FREE // 2**20} MiB free there for its boot files.")
    return {"windows": windows, "fedora_linux": fedora_linux(disk, scratch, stub, bootuuid) if fedora else None,
            "other_loaders": others}


def bootc_install(target, source, target_ref, kargs, expected_bytes=None):
    # bootc mounts efivarfs itself (read-write) when it finds the path empty
    # and leaves it be when it is populated; bootupd skips the firmware when
    # it is read-only. So: mount it here as bootc would, read-write (it is
    # one superblock system-wide, and a read-only mount of it would turn the
    # host's read-only too), then make this one mount read-only with a bind
    # remount, which touches no other.
    v = "/sys/firmware/efi/efivars"
    body = (f"if [ -d /sys/firmware/efi ]; then "
            f"{{ [ -n \"$(ls -A {v} 2>/dev/null)\" ] || mount -t efivarfs efivarfs {v}; }} && "
            f"mount -o remount,bind,ro {v} && [ \"$(findmnt -no OPTIONS {v} | cut -d, -f1)\" = ro ] "
            f"|| {{ echo 'cannot make efivarfs read-only: not installing' >&2; exit 1; }}; fi; "
            'exec "$@"')
    cmd = ["bootc", "install", "to-filesystem", "--source-imgref", source, "--target-imgref", target_ref]
    for k in kargs:
        cmd += ["--karg", k]
    cmd.append(target)
    prefix = os.environ.get("PULSAR_BOOTC_PREFIX")
    if prefix:
        # the wrapper (podman run --privileged IMG) gives bootc its own mount
        # namespace already; the remount happens inside it
        run_stream(*shlex.split(prefix), "sh", "-c", body, "sh", *cmd, watch=target, expected_bytes=expected_bytes)
    else:
        run_stream("unshare", "--mount", "--propagation", "private", "sh", "-c", body, "sh", *cmd, watch=target,
                   expected_bytes=expected_bytes)


def boot_kargs(luks_uuid, keymap, extra=()):
    """The installed system's kernel arguments: the root to unlock, if it is
    encrypted (luks_uuid None: it is not, and bootc's own root=UUID= of the
    btrfs is all it needs); rhgb quiet for the graphical boot and passphrase
    prompt (Silverblue's come from Anaconda's kickstart, not the image); the
    console keymap, so the passphrase typed in the installer's layout
    unlocks in the same one."""
    unlock = [f"rd.luks.uuid={luks_uuid}"] if luks_uuid else []
    return [*unlock, "rhgb", "quiet", f"rd.vconsole.keymap={keymap}", *extra]


def live_setting(path, key, default):
    """KEY's value in a KEY=value file of the live system, else default."""
    try:
        for line in open(path):
            k, _, v = line.strip().partition("=")
            if k == key and v.strip('"'):
                return v.strip('"')
    except OSError:
        pass
    return default


def live_lang(path="/etc/locale.conf"):
    """The language to install with: the live system's, unless that is the
    bare C locale (the live image's default, which GNOME Initial Setup
    shows as "Unspecified"): then en_US.UTF-8."""
    lang = live_setting(path, "LANG", "")
    return "en_US.UTF-8" if lang.split(".")[0] in ("", "C", "POSIX") else lang


def write_locale(target, lang, keymap, xkb_layout=None, xkb_variant=""):
    """The installed system's language and console keyboard, in its
    deployment's /etc: without them it starts with none, and GNOME Initial
    Setup offers "Unspecified". Returns the /etc written to."""
    deploy = os.path.join(target, "ostree/deploy")
    etcs = [os.path.join(deploy, os_, "deploy", d, "etc")
            for os_ in os.listdir(deploy)
            for d in os.listdir(os.path.join(deploy, os_, "deploy"))
            if os.path.isdir(os.path.join(deploy, os_, "deploy", d, "etc"))]
    if len(etcs) != 1:
        raise Failed(f"expected one deployment's /etc under {deploy}, found {len(etcs)}")
    etc = etcs[0]
    with open(os.path.join(etc, "locale.conf"), "w") as f:
        f.write(f'LANG="{lang}"\n')
    with open(os.path.join(etc, "vconsole.conf"), "w") as f:
        f.write(f"KEYMAP={keymap}\n")
        # the desktop's layout too: systemd-localed keeps XKB settings here
        if xkb_layout:
            f.write(f"XKBLAYOUT={xkb_layout}\n")
            if xkb_variant:
                f.write(f"XKBVARIANT={xkb_variant}\n")
    return etc


def keep_log(target, lines):
    """This run's log, into the installed system's /var/log: the stateroot's
    var, which the deployment's /var is. Returns the path written."""
    deploy = os.path.join(target, "ostree/deploy")
    roots = [d for d in os.listdir(deploy) if os.path.isdir(os.path.join(deploy, d, "var"))]
    if len(roots) != 1:
        raise Failed(f"expected one stateroot's /var under {deploy}, found {len(roots)}")
    path = os.path.join(deploy, roots[0], KEPT_LOG)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(f"--- pulsar-install-system, {time.strftime('%Y-%m-%d %H:%M:%S %Z')}\n")
        f.writelines(line + "\n" for line in lines)
    os.chmod(path, 0o644)
    return path


def snapshot_fallback(efi_root):
    """What is in EFI/BOOT before installing beside another system: every
    file, by name, with its bytes (the fallback loader is a few hundred KB)."""
    d = os.path.join(efi_root, "EFI", "BOOT")
    if not os.path.isdir(d):
        return {}
    return {n: open(os.path.join(d, n), "rb").read() for n in os.listdir(d) if os.path.isfile(os.path.join(d, n))}


def restore_fallback(efi_root, snap, saved_dir=None):
    """Put EFI/BOOT back as the other system had it: its files as they were,
    what bootupd added there gone. Installing beside Windows leaves Windows'
    fallback loader alone (Nick, 2026-10-02: Ubuntu's way, not Fedora's).
    A finished install also keeps its BOOTX64.EFI in saved_dir, for
    pulsar-esp-fallback to put back after a bootloader update replaces it
    again; a failed one passes none."""
    d = os.path.join(efi_root, "EFI", "BOOT")
    if os.path.isdir(d):
        for n in os.listdir(d):
            if n not in snap and os.path.isfile(os.path.join(d, n)):
                os.unlink(os.path.join(d, n))
        if not snap:
            os.rmdir(d)
    if snap:
        os.makedirs(d, exist_ok=True)
    for n, data in snap.items():
        with open(os.path.join(d, n), "wb") as f:
            f.write(data)
    if "BOOTX64.EFI" in snap and saved_dir:
        os.makedirs(saved_dir, exist_ok=True)
        with open(os.path.join(saved_dir, "BOOTX64.EFI"), "wb") as f:
            f.write(snap["BOOTX64.EFI"])


def windows_entry(target, esp):
    efi = os.path.join(target, "boot/efi")
    if not os.path.isfile(os.path.join(efi, WINDOWS_LOADER)):
        return False
    with open(os.path.join(target, "boot/grub2/custom.cfg"), "a") as f:
        f.write(f"""
menuentry 'Windows' --class windows --class os {{
\tinsmod part_gpt
\tinsmod fat
\tinsmod chain
\tsearch --no-floppy --fs-uuid --set=root {esp['uuid']}
\tchainloader /{WINDOWS_LOADER}
}}
""")
    return True


def own_shim(target):
    """The ESP directory holding Pulsar's shim: the vendor directory of the
    installed image's own EFI payload (/usr/lib/efi/<component>/<version>/
    EFI/<vendor>), which bootupd has just copied to the ESP. Another system's
    shim beside it (EFI/ubuntu, EFI/debian, EFI/opensuse) is never Pulsar's."""
    payload = glob.glob(os.path.join(target, "ostree/deploy/*/deploy/*/usr/lib/efi/*/*/EFI/*/shimx64.efi"))
    vendors = sorted({os.path.basename(os.path.dirname(p)) for p in payload} - {"BOOT"})
    if len(vendors) != 1:
        raise Failed(f"expected one shim in the installed image's EFI payload, found {vendors}")
    if not os.path.isfile(os.path.join(target, "boot/efi/EFI", vendors[0], "shimx64.efi")):
        raise Failed(f"the image's shim is not on the ESP: no EFI/{vendors[0]}/shimx64.efi")
    return vendors[0]


def linux_entry(target, fedora):
    """Beside a Fedora-family Linux, a startup menu entry that starts it
    through its own GRUB configuration, the way its EFI/fedora stub did
    before Pulsar's boot files replaced it: find its /boot by filesystem
    UUID, point the prefix there, and load its grub.cfg (which lists its BLS
    entries). Kept where windows_entry keeps Windows' entry, in /boot's
    custom.cfg, which bootupd's static config sources and never rewrites.
    Returns the entry's title, or None when there is none to make."""
    if not fedora or not fedora.get("menu"):
        return None
    with open(os.path.join(target, "boot/grub2/custom.cfg"), "a") as f:
        f.write(f"""
menuentry '{fedora['title']}' --class fedora --class gnu-linux --class os {{
\tinsmod part_gpt
\tinsmod {fedora['grub_mod']}
\tsearch --no-floppy --fs-uuid --set=dev {fedora['uuid']}
\tset prefix=($dev)/{fedora['grub_dir']}
\texport prefix
\tconfigfile $prefix/grub.cfg
}}
""")
    return fedora["title"]


def firmware_entry(disk, esp, target):
    if not os.path.isdir(EFIVARS):
        return "not booted via EFI: no firmware entry"
    vendor = own_shim(target)
    partuuid = esp["partuuid"].lower()
    for line in run("efibootmgr", "-v").splitlines():
        m = re.match(r"Boot([0-9A-Fa-f]{4})\*?\s+(.*?)\s+HD\(\d+,GPT,([0-9a-fA-F-]+)", line)
        if m and m.group(2) == LABEL and m.group(3).lower() == partuuid:
            run("efibootmgr", "-b", m.group(1), "-B")
    run("efibootmgr", "--create", "--disk", disk, "--part", str(esp["partn"]),
        "--loader", f"\\EFI\\{vendor}\\shimx64.efi", "--label", LABEL)
    return f"firmware entry {LABEL} -> \\EFI\\{vendor}\\shimx64.efi"


def remove_made(disk, made):
    """Take back the partitions this install made, by the partition UUIDs
    repart reported for them and nothing else: a failed install must leave
    the disk as it found it (alongside) or blank (erase), never half-made,
    since a retry refuses a disk where Pulsar's partitions already exist."""
    if not made:
        return []
    table = json.loads(run("sfdisk", "-J", disk))["partitiontable"]
    gone = []
    for p in table.get("partitions", []):
        if p.get("uuid", "").lower() in made:
            n = re.search(r"(\d+)$", p["node"]).group(1)
            run("sfdisk", "--delete", disk, n)
            gone.append(p["uuid"].lower())
    subprocess.run(["udevadm", "settle"])
    return gone


def main():
    ap = argparse.ArgumentParser(prog="pulsar-install-system")
    ap.add_argument("--mode", required=True, choices=["erase", "alongside"])
    ap.add_argument("--plan-only", action="store_true", help="print the disk plan; write nothing")
    secret = ap.add_mutually_exclusive_group()
    secret.add_argument("--key-file", help="encrypt the root with the passphrase in FILE")
    secret.add_argument("--no-encrypt", action="store_true", help="a plain, unencrypted root")
    ap.add_argument("--source-imgref")
    ap.add_argument("--target-imgref")
    ap.add_argument("--karg", action="append", default=[])
    ap.add_argument("--expected-bytes", type=int, help="the payload's unpacked size, for progress")
    ap.add_argument("--lang", help="the installed system's LANG (default: the live system's)")
    ap.add_argument("--keymap", help="its console keymap (default: the live system's)")
    ap.add_argument("--xkb-layout", help="its desktop keyboard layout (GNOME's), e.g. de")
    ap.add_argument("--xkb-variant", default="", help="and variant, e.g. nodeadkeys")
    ap.add_argument("--expect-size", type=int, help="the chosen disk's size in bytes: refuse any other")
    ap.add_argument("--expect-serial", help="the chosen disk's serial number (may be empty): refuse any other")
    ap.add_argument("disk")
    a = ap.parse_args()
    if os.geteuid() != 0:
        ap.error("needs root")
    if not a.plan_only and not ((a.key_file or a.no_encrypt) and a.source_imgref and a.target_imgref):
        ap.error("installing needs --key-file (or --no-encrypt), --source-imgref and --target-imgref")
    if not a.plan_only and (a.expect_size is None or a.expect_serial is None):
        ap.error("installing needs --expect-size and --expect-serial: the disk that was chosen")
    note("$ " + shlex.join(sys.argv))
    stop_on_signals()
    # what pulsar-install-disk is told: never neither, so it can't default
    plain = ["--no-encrypt"] if a.no_encrypt else []
    # and which drive it must find at a.disk
    ident = [*(["--expect-size", str(a.expect_size)] if a.expect_size is not None else []),
             *(["--expect-serial", a.expect_serial] if a.expect_serial is not None else [])]
    # not /tmp: bootc copies itself there to enter SELinux's install_t, and
    # a wrapper that shares /tmp for the target's sake breaks that
    os.makedirs(SCRATCH, mode=0o700, exist_ok=True)
    scratch = tempfile.mkdtemp(prefix="install-", dir=SCRATCH)
    target = os.path.join(scratch, "target")
    mounted, opened, made, ok, error = [], False, set(), False, None
    # what is known about the disk (the failed event's disk and esp, above):
    # unchanged until the disk tool starts, unknown while it runs and if it
    # stops without refusing, written once it has finished
    disk = "unchanged"
    # the shared ESP, beside another system: what was in EFI/BOOT before
    # bootc (snap), and whether bootc has run and may have written to it
    snap, bootc_ran = None, False
    try:
        emit(stage="check")
        # what else starts from the shared ESP; an erase shares none
        found = (preflight_alongside(a.disk, scratch) if a.mode == "alongside"
                 else {"windows": None, "fedora_linux": None, "other_loaders": []})
        if a.plan_only:
            ok = True
            emit(stage="plan", plan=json.loads(run(DISK_TOOL, "plan", "--mode", a.mode, *plain, *ident, a.disk)),
                 **found)
            return 0
        emit(stage="disk")
        disk = "unknown"
        try:
            out = run_logged(DISK_TOOL, "apply", "--mode", a.mode, *(plain or ["--key-file", a.key_file]),
                             *ident, a.disk)
        except Failed as e:
            # refused: nothing was written. Anything else (failed partway,
            # crashed, killed): the disk may have changed, and how is unknown
            if e.code == DISK_REFUSED:
                disk = "unchanged"
            raise
        disk = "written"
        # the partitions this install made, by the partition UUIDs repart
        # reports: never guessed from labels or order, which another system
        # on the disk could share. Taken now, before anything else can fail,
        # so a failure after this point takes them back
        plan = json.loads(out)
        made_by_type = {p["type"]: p["uuid"].lower() for p in plan if p["activity"] == "create"}
        made = set(made_by_type.values())
        run("udevadm", "settle")
        by_uuid = {(p.get("partuuid") or "").lower(): p for p in partitions(a.disk)}
        root, boot = by_uuid.get(made_by_type.get("root-x86-64")), by_uuid.get(made_by_type.get("xbootldr"))
        if not (root and boot):
            raise Failed(f"cannot find the partitions just made ({made_by_type}) on {a.disk}")
        esp = esp_of(a.disk)
        # the root is what was asked for: never plain when encryption was
        # chosen (an unknown type, udev not caught up, is left to cryptsetup)
        want = "btrfs" if a.no_encrypt else "crypto_LUKS"
        if root.get("fstype") and root["fstype"] != want:
            raise Failed(f"the new root is {root['fstype']}, expected {want}")
        if a.no_encrypt:
            root_dev = root["path"]
        else:
            emit(stage="unlock")
            run("cryptsetup", "open", "--key-file", a.key_file, root["path"], MAPPER)
            opened = True
            root_dev = f"/dev/mapper/{MAPPER}"
        os.makedirs(target)
        for dev, sub in ((root_dev, ""), (boot["path"], "boot"), (esp["path"], "boot/efi")):
            path = os.path.join(target, sub)
            os.makedirs(path, exist_ok=True)
            run("mount", dev, path)
            mounted.append(path)
        if a.mode == "alongside":
            snap = snapshot_fallback(os.path.join(target, "boot/efi"))
        # The passphrase prompt at boot reads the console keymap from the
        # kernel command line: the keys typed into the installer, in the
        # live session's layout, must mean the same there.
        keymap = a.keymap or live_setting("/etc/vconsole.conf", "KEYMAP", "us")
        emit(stage="install")
        bootc_ran = True
        # rhgb quiet: Silverblue's graphical boot (and passphrase prompt)
        # comes from Anaconda's kickstart, not the image; without them the
        # prompt sat in the boot log's text
        bootc_install(target, a.source_imgref, a.target_imgref,
                      boot_kargs(None if a.no_encrypt else root["uuid"], keymap, a.karg), a.expected_bytes)
        # bootc finalizes the root read-only; GRUB's custom.cfg lives on /boot
        emit(stage="boot")
        run("mount", "-o", "remount,rw", os.path.join(target, "boot"))
        # bootc finalizes the root read-only too; its /etc takes the language
        run("mount", "-o", "remount,rw", target)
        write_locale(target, a.lang or live_lang(), keymap, a.xkb_layout, a.xkb_variant)
        if snap is not None:
            restore_fallback(os.path.join(target, "boot/efi"), snap, os.path.join(target, "boot/pulsar/esp-fallback"))
        win = windows_entry(target, esp)
        lin = linux_entry(target, found["fedora_linux"])
        fw = firmware_entry(a.disk, esp, target)
        ok = True
        emit(stage="done", ok=True, windows_entry=win, linux_entry=lin, fedora_linux=found["fedora_linux"],
             other_loaders=found["other_loaders"], firmware=fw)
        return 0
    except Failed as e:
        error = str(e)
        say(f"pulsar-install-system: {e}")
        return 1
    except Exception as e:     # a bug: still unmount, take back, and say so
        error = f"{type(e).__name__}: {e}"
        raise
    finally:
        hold_signals()
        if ok and mounted:
            # the live session's log is gone at restart: the installed
            # system keeps this one. A log that can't be kept fails nothing
            try:
                say(f"pulsar-install-system: keeping this log as /{KEPT_LOG} in the installed system")
                keep_log(target, RECORD)
            except (OSError, Failed) as e:
                say(f"pulsar-install-system: could not keep the log in the installed system: {e}")
        # beside another system, a failed install puts EFI/BOOT back too, as
        # a finished one does: bootupd may have put Pulsar's loader there
        esp_state = None if a.mode != "alongside" else "unchanged" if not bootc_ran else "fallback"
        if not ok and bootc_ran and snap is not None and os.path.join(target, "boot/efi") in mounted:
            try:
                restore_fallback(os.path.join(target, "boot/efi"), snap)
                esp_state = "boot_files"
                say("pulsar-install-system: put EFI/BOOT on the ESP back as it was")
            except OSError as e:
                say(f"pulsar-install-system: could not put EFI/BOOT on the ESP back: {e}")
        for path in reversed(mounted):
            subprocess.run(["umount", path])
        if opened:
            subprocess.run(["cryptsetup", "close", MAPPER])
        all_gone = False
        if not ok and made:
            try:
                gone = remove_made(a.disk, made)
                all_gone = len(gone) == len(made)
                say(f"pulsar-install-system: removed the {len(gone)} partitions this install made")
            except Failed as e:
                say(f"pulsar-install-system: could not remove the partitions this install made: {e}")
        if disk == "written":
            # made is empty only if repart's plan couldn't be read: then
            # which partitions it made is unknown, and they are left
            disk = "removed" if made and all_gone else "left"
        # as it was: nothing written; or, beside another system, everything
        # this install made taken back. An erase that wrote is never undone:
        # what was on the disk is gone, whatever happened to Pulsar's part
        restored = disk == "unchanged" or (a.mode == "alongside" and disk == "removed")
        if not ok:
            emit(stage="failed", error=error or "interrupted", restored=restored, disk=disk, esp=esp_state)


if __name__ == "__main__":
    sys.exit(main())
