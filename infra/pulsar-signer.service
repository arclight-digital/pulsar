[Unit]
Description=Pulsar Secure Boot signing oracle
Documentation=https://github.com/arclight-digital/pulsar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulsar-signer
Group=pulsar-signer
EnvironmentFile=/etc/pulsar-signer/signer.env
ExecStart=/usr/local/bin/pulsar-signer.py
Restart=on-failure
RestartSec=5s

# journald is the audit log. Every signature request is recorded with the
# requesting address and the module name, and that is the record you read
# after a token leaks: journalctl -u pulsar-signer.service --since ...
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pulsar-signer

# This host exists to hold one key. Everything it does not need is off.
# The key is readable only by this user; the service never writes anywhere
# except /tmp, which is private and discarded.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/pulsar-signer
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The service binds the private VPC address; it refuses to start on 0.0.0.0.
# The cloud firewall in front of it is the other half, and the token is the
# third. None of the three is sufficient alone.

[Install]
WantedBy=multi-user.target
