---
// Starting from bare metal: the weekly installers and how to check one.
import DownloadRow from './DownloadRow.astro';
import { COSIGN_PUB, ISOS } from '../data/site';

const SUMS = ['sha256', 'sha256.sig', 'json'];

// The signature covers the checksum manifest, not the 5GB ISO -- verifying
// the manifest and then checking the ISO against it proves the same thing
// without cosign reading five gigabytes. --insecure-ignore-tlog is the
// documented flag for plain key-based verification: the trust anchor here is
// the published key, not a transparency-log entry, and the name is cosign's,
// not a warning about this page.
const VERIFY = [
  `cosign verify-blob ${ISOS.vanilla}.sha256`,
  `--key ${COSIGN_PUB}`,
  `--signature ${ISOS.vanilla}.sha256.sig`,
  '--insecure-ignore-tlog=true',
  `&& sha256sum -c ${ISOS.vanilla}.sha256`,
].join(' ');

const shown = [
  `cosign verify-blob ${ISOS.vanilla}.sha256 \\`,
  `  --key ${COSIGN_PUB} \\`,
  `  --signature ${ISOS.vanilla}.sha256.sig \\`,
  '  --insecure-ignore-tlog=true \\',
  `&& sha256sum -c ${ISOS.vanilla}.sha256`,
].join('\n');
---

<div class="iso" id="iso">
  <p class="lede">
    A weekly installer ISO for each variant, built from the published image itself — the same
    Anaconda installer stock Silverblue uses, landing directly in Pulsar.{' '}
    <span class="sent">Checksummed, and signed with Pulsar's release&nbsp;key.</span>
  </p>

  <div class="grid">
    <div>
      <ul class="isos">
        <DownloadRow which="standard" file={ISOS.vanilla} sums={SUMS} />
        <DownloadRow which="nvidia" file={ISOS.nvidia} sums={SUMS} />
      </ul>
      <p class="hint">
        Write it to a USB&nbsp;stick with GNOME&nbsp;Disks or <code>dd</code>, boot,&nbsp;install.
        The <code>.json</code> sidecar records exactly which image digest the installer carries.
      </p>
    </div>

    <div>
      <p class="cap">
        <span>signed with the release key — it never leaves the signing&nbsp;host</span>
      </p>
      <arc-code-block
        class="theme-fixed-dark"
       
        language="bash"
        filename="verify"
        code={shown}
        data-copy={VERIFY}
      ></arc-code-block>
      <p class="hint">
        The public half of that key is published beside the ISOs and committed to the repo as{' '}
        <code>keys/cosign.pub</code>; the build verifies every signature against the committed copy
        before publishing.
      </p>
    </div>
  </div>
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .isos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cap {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  arc-code-block {
    display: block;
  }
  .hint {
    margin-top: var(--space-md);
    margin-bottom: 0;
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
