[Plymouth Theme]
Name=Pulsar
Description=Pulsar boot splash
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/pulsar
HorizontalAlignment=.5
VerticalAlignment=.5
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000

# watermark.png is the mark+wordmark lockup (see sync-branding.sh). Fedora
# parks its lockup near the bottom edge; same move here. Everything else
# (throbber frames, progress bar) is inherited from Fedora's spinner theme
# at build time.
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.92
UseFirmwareBackground=false

DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
