{
  // Assets-only Worker: no script, just the built one-pager served from
  // Cloudflare's edge. Cloudflare's git integration builds this directory on a
  // push to main (root dir `site`, build `npm run build`) and then deploys
  // this config; the assets directory is relative to this file, so it points
  // at Astro's output. The custom domain is attached in the Cloudflare
  // dashboard under this Worker's Domains & Routes, not here; the origin the
  // site believes it lives at is SITE in src/data/site.ts.
  "name": "pulsar-site",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a real 404 status, rather than an
    // empty 404 that tells a lost visitor (or a crawler) nothing.
    "not_found_handling": "404-page"
  }
}
