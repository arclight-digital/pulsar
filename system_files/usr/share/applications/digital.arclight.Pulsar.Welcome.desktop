[Desktop Entry]
Type=Application
Name=Welcome to Pulsar
Comment=Pick a theme and tour updates, games and coding agents on Pulsar
Keywords=welcome;tour;intro;getting started;
Exec=/usr/libexec/pulsar/pulsar-welcome
Icon=digital.arclight.Pulsar.Welcome
Categories=GTK;System;
StartupNotify=true
X-GNOME-UsesNotifications=false
Actions=whats-new;

[Desktop Action whats-new]
Name=What's New
Exec=/usr/libexec/pulsar/pulsar-welcome --whats-new
