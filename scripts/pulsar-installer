#!/usr/bin/python3
"""Install Pulsar: the app the live ISO opens on.

Pick a disk, choose to install beside what is on it or to erase it (a
deliberate second step), set the passphrase that unlocks the disk at every
start, and watch it install. An empty disk skips the "how" page: there is
one way. The work is pulsar-install-system's, run with pkexec; this app only
asks, shows, and waits. Nothing is written to any disk before the last
page's button, which says "Erase and Install" whenever it deletes anything,
and the window can't be closed while the backend is writing.

For tests and screenshots, each outside piece can be swapped:
  PULSAR_INSTALLER_LSBLK      a file holding `lsblk -J -b -o ...` output
  PULSAR_INSTALL_SYSTEM       the backend (default /usr/libexec/pulsar/...)
  PULSAR_INSTALLER_PKEXEC     how to run it as root ("" to run it directly)
  PULSAR_INSTALLER_PAYLOAD    payload.json (source and target image refs)
and `--shots DIR` walks every page with the disks it was given, saving each
as DIR/NN-name.png, then quits (with a fake backend: for screenshots).
"""

import json
import os
import re
import pathlib
import shlex
import subprocess
import sys
import tempfile
import time

HERE = pathlib.Path(__file__).resolve().parent
BACKEND = os.environ.get("PULSAR_INSTALL_SYSTEM", "/usr/libexec/pulsar/pulsar-install-system")
PKEXEC = shlex.split(os.environ.get("PULSAR_INSTALLER_PKEXEC", "pkexec"))
PAYLOAD = pathlib.Path(os.environ.get("PULSAR_INSTALLER_PAYLOAD", "/usr/share/pulsar/installer/payload.json"))
LIVE_LABEL = "PULSAR-INSTALL"
BRAND = [pathlib.Path("/usr/share/pulsar/brand"), HERE.parent / "system_files" / "usr" / "share" / "pulsar" / "brand"]

GiB = 2**30
# Pulsar's layout: 600M ESP (erase only), 2G /boot, a root of at least 32G
# (system_files/usr/share/pulsar/installer/repart). With room to spare: the
# backend's own plan is the final word, and is asked before Install.
NEEDS_ERASE = 36 * GiB
NEEDS_ALONGSIDE = 36 * GiB
ESP = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
WINDOWS_DATA = "ebd0a0a2-b9e5-4433-87c0-68b6b72699c7"
LINUX_FS = {"ext4", "ext3", "btrfs", "xfs", "crypto_LUKS", "swap", "f2fs"}
LSBLK_COLS = "NAME,PATH,TYPE,SIZE,RO,RM,TRAN,MODEL,VENDOR,SERIAL,FSTYPE,PARTTYPE,PARTLABEL,LABEL,START,MOUNTPOINTS"


# ------------------------------------------------------------- disks ----
# Plain functions over lsblk's JSON, so the tests can feed them disks.

def read_lsblk():
    src = os.environ.get("PULSAR_INSTALLER_LSBLK")
    if src:
        return json.loads(pathlib.Path(src).read_text())
    out = subprocess.run(["lsblk", "-J", "-b", "-o", LSBLK_COLS], capture_output=True, text=True, check=True)
    return json.loads(out.stdout)


def human(n):
    for unit, size in (("TB", 10**12), ("GB", 10**9), ("MB", 10**6)):
        if n >= size:
            v = n / size
            return f"{v:.1f} {unit}" if v < 10 else f"{v:.0f} {unit}"
    return f"{n} B"


def free_gaps(disk):
    """The unpartitioned stretches of a GPT disk, in bytes, largest first.
    lsblk gives each partition's start (512-byte sectors) and size; GPT keeps
    its first MiB and its last 33 sectors, and repart aligns to 1 MiB, so a
    gap is counted from the next MiB after the end of what precedes it."""
    parts = sorted(((p.get("start") or 0) * 512, p["size"]) for p in disk.get("children", []))
    end_usable = disk["size"] - 33 * 512
    cursor, gaps = 2**20, []
    for start, size in parts:
        if start > cursor:
            gaps.append(start - cursor)
        cursor = max(cursor, -(-(start + size) // 2**20) * 2**20)
    if end_usable > cursor:
        gaps.append(end_usable - cursor)
    return sorted(gaps, reverse=True)


def disk_name(disk):
    """The drive as its maker names it. NVMe models come with underscores
    for spaces (SKHynix_HFS001...); a VM's virtio disk has no model and
    a PCI vendor ID for a vendor (0x1af4), which is nobody's name."""
    vendor = (disk.get("vendor") or "").strip()
    if re.fullmatch(r"0x[0-9a-fA-F]+", vendor):
        vendor = ""
    model = (disk.get("model") or "").replace("_", " ").strip()
    name = " ".join(x for x in (vendor, model) if x)
    if name:
        return name
    return "Virtual disk" if disk["name"].startswith(("vd", "xvd")) else disk["name"]


def method_title(d, mode):
    if mode == "erase":
        return "Install Pulsar on this disk" if d["empty"] else "Erase the disk and install Pulsar"
    return f"Install alongside {d['holds']}" if d["holds"] in ("Windows", "Linux") else "Install in the free space"


def install_destroys(mode, d):
    """Whether pressing Install deletes anything: an erase of a disk that
    holds something. Only then is the button the destructive red."""
    return mode == "erase" and not d["empty"]


def install_button(mode, d):
    """The last button says what it does: the words carry the erase, not
    only the red."""
    return "Erase and Install" if install_destroys(mode, d) else "Install"


def needs_erase_confirm(d):
    """An empty disk has nothing to lose: no page asking to erase it."""
    return not d["empty"]


def skips_method(d):
    """An empty disk has one way to install: no page asking how."""
    return d["empty"]


def contents(d):
    """What is on a disk, in a word or two, for the disk list: the system
    it starts, else the names its partitions were given."""
    if d["holds"] in ("Windows", "Linux"):
        return d["holds"]
    if d["empty"]:
        return "Empty"
    names = [p["label"] for p in d["partitions"] if p.get("label")]
    return f"Files ({', '.join(names)})" if names else "Files"


def identity(d):
    """The facts that tell one disk from another: size, what is on it, how
    it is connected. Shown under its name on every page that names it."""
    bits = [human(d["size"]), contents(d)]
    if d["usb"]:
        bits.append("USB")
    return " · ".join(bits)


def tell_apart(found):
    """Two drives of the same model would read the same everywhere: give
    each the end of its serial number (or its device name, without one)."""
    names = [d["name"] for d in found]
    for d in found:
        if names.count(d["name"]) > 1:
            serial = (d.get("serial") or "").strip()
            d["name"] += f" (serial ending {serial[-4:]})" if serial else f" ({d['path']})"
    return found


def failure_state(mode, restored, planning=False):
    """What the disk is like after a failure, said plainly."""
    if planning:
        return "Nothing on the disk was changed."
    if restored:
        return "The disk is as it was before you pressed Install."
    if mode == "alongside":
        return ("Pulsar's new partitions may still be on the disk. "
                "Everything that was on the disk before is untouched.")
    return "The disk was erased, but Pulsar is not fully on it."


def elapsed(secs):
    return f"Time so far: {secs // 60}:{secs % 60:02d}"


def describe(disk):
    """What a person would want to know about one disk before choosing it."""
    parts = disk.get("children", [])
    fs = {(p.get("fstype") or "") for p in parts}
    ptypes = {(p.get("parttype") or "").lower() for p in parts}
    labels = {(p.get("label") or "") for p in parts}
    d = {
        "path": disk["path"],
        "name": disk_name(disk),
        "size": disk["size"],
        "usb": disk.get("tran") == "usb" or bool(disk.get("rm")),
        # a Windows that starts from this disk: its startup files (an ESP)
        # beside NTFS or BitLocker. A lone NTFS disk is data, not Windows.
        "windows": ESP in ptypes and ("ntfs" in fs or "BitLocker" in fs),
        "bitlocker": "BitLocker" in fs,
        "linux": bool(fs & LINUX_FS),
        "esp": ESP in ptypes,
        "empty": not parts,
        "free": (free_gaps(disk) or [0])[0],
        "live": LIVE_LABEL in labels or (disk.get("label") or "") == LIVE_LABEL or any(
            "/run/initramfs/live" in (p.get("mountpoints") or []) for p in parts),
        "partitions": [{"size": p["size"], "what": part_name(p),
                        "label": (p.get("label") or p.get("partlabel") or "").strip()} for p in parts],
        "serial": disk.get("serial") or "",
    }
    d["holds"] = ("Windows" if d["windows"] else "Linux" if d["linux"] else
                  "nothing" if d["empty"] else "other data")
    return d


PART_NAMES = {ESP: "Startup files (EFI)", "e3c9e316-0b5c-4db8-817d-f92df00215ae": "Microsoft reserved",
              "de94bba4-06d1-4d40-a16a-bfd50179d6ac": "Windows recovery"}


def part_name(p):
    """What a partition is, in words, for the page that asks to erase it."""
    t, fs = (p.get("parttype") or "").lower(), p.get("fstype") or ""
    if t in PART_NAMES:
        return PART_NAMES[t]
    name = p.get("label") or p.get("partlabel") or ""
    # a named NTFS partition (Windows, Games) says enough by its name
    kind = {"ntfs": "" if name else "Windows files" if t == WINDOWS_DATA else "NTFS", "BitLocker": "BitLocker (encrypted)",
            "crypto_LUKS": "Linux (encrypted)", "swap": "Linux swap"}.get(fs, "Linux" if fs in LINUX_FS else fs)
    return " · ".join(x for x in (name, kind) if x) or "Unknown"


def disks(tree):
    """The disks Pulsar could go on, live medium and read-only ones out."""
    out = []
    for dev in tree.get("blockdevices", []):
        if dev.get("type") != "disk" or dev.get("ro") or dev["name"].startswith(("zram", "loop", "sr")):
            continue
        d = describe(dev)
        if not d["live"]:
            out.append(d)
    return tell_apart(out)


def options(d):
    """(available, reason) for each way of installing on disk d."""
    if d["size"] < NEEDS_ERASE:
        erase = (False, f"Pulsar needs at least {human(NEEDS_ERASE)}")
    else:
        erase = (True, f"Everything on this disk is deleted: {d['holds']} included." if not d["empty"]
                 else "The disk is empty.")
    if d["empty"]:
        along = (False, "There is nothing on this disk to keep")
    elif d["bitlocker"]:
        along = (False, "BitLocker is on. Turn it off in Windows first, then start the installer again")
    elif not d["esp"]:
        along = (False, "Only possible on a disk that already starts Windows or Linux")
    elif d["free"] < NEEDS_ALONGSIDE:
        along = (False, f"Needs {human(NEEDS_ALONGSIDE)} of free space; {human(d['free'])} is free. "
                        "Shrink a partition from the other system first")
    else:
        along = (True, f"Uses the {human(d['free'])} of free space. {d['holds']} stays as it is."
                 if d["holds"] != "other data" else f"Uses the {human(d['free'])} of free space.")
    return {"alongside": along, "erase": erase}


KBD_MAP = "/usr/share/systemd/kbd-model-map"


def console_keymap(layout, variant="", mapfile=KBD_MAP):
    """The console keymap for an X11/GNOME layout, from systemd's own table
    (the boot passphrase prompt reads console keymaps, not XKB layouts):
    the line whose layout and variant match, else the one for the layout
    with no variant, else the layout's own name."""
    rows = []
    try:
        for line in open(mapfile):
            f = line.split()
            if len(f) >= 4 and not line.startswith("#"):
                rows.append((f[0], f[1], f[3]))
    except OSError:
        pass
    want = variant or "-"
    for console, x11, var in rows:
        if x11 == layout and var == want:
            return console
    for console, x11, var in rows:
        if x11 == layout and var == "-":
            return console
    return layout


def current_layout(sources):
    """GNOME's input source in use, as (layout, variant): the first of its
    sources, e.g. [('xkb', 'de+nodeadkeys')] -> ('de', 'nodeadkeys')."""
    for kind, name in sources or []:
        if kind == "xkb":
            layout, _, variant = name.partition("+")
            return layout, variant
    return "us", ""


XKB_RULES = "/usr/share/X11/xkb/rules/evdev.xml"


def layout_name(layout, variant="", rules=XKB_RULES):
    """A layout as people know it ("German"), from the XKB registry GNOME
    reads; its code when that can't be read."""
    try:
        import xml.etree.ElementTree as ET
        root = ET.parse(rules).getroot()
        for lay in root.iter("layout"):
            ci = lay.find("configItem")
            if ci is None or ci.findtext("name") != layout:
                continue
            if variant:
                for v in lay.iter("variant"):
                    vci = v.find("configItem")
                    if vci is not None and vci.findtext("name") == variant:
                        return vci.findtext("description")
            return ci.findtext("description")
    except Exception:     # noqa: BLE001 -- a name is a nicety
        pass
    return layout + (f" ({variant})" if variant else "")


def install_fraction(copied):
    """The bar during the copy, which is most of the install: from where the
    copy starts (0.12) to where setting up startup begins (0.94)."""
    return 0.12 + max(0.0, min(1.0, copied)) * (0.94 - 0.12)


def passphrase_hint(a, b):
    """What to say under the two entries: nothing about a mismatch until
    the second one has been started."""
    if len(a) < 8:
        return "Use at least 8 characters"
    if b and a != b:
        return "The passphrases don't match"
    return ""


def passphrase_problem(a, b):
    if len(a) < 8:
        return "Use at least 8 characters"
    if a != b:
        return "The passphrases don't match"
    return None


# --------------------------------------------------------------- app ----

def main():
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("Graphene", "1.0")
    from gi.repository import Adw, Gdk, GdkPixbuf, Gio, GLib, Graphene, Gtk

    # The welcome app's type and buttons (pulsar-welcome's wl-* classes), so
    # the installer reads as the same product. The one piece of motion is
    # the mark's entrance, on the first page and the last.
    CSS = """
    .in-display { font-weight: 800; font-size: 2.6em; letter-spacing: -0.02em; }
    .in-title { font-weight: 800; font-size: 1.9em; letter-spacing: -0.015em; }
    .in-lede { font-size: 1.1em; opacity: 0.78; }
    .in-note { opacity: 0.62; font-size: 0.92em; }
    .in-pill { padding: 10px 26px; border-radius: 999px; font-weight: 800; }
    .in-big { padding: 14px 44px; border-radius: 999px; font-weight: 800; font-size: 1.1em; }
    .in-percent { font-weight: 800; font-size: 4.2em; letter-spacing: -0.03em; }
    .in-bar > trough, .in-bar > trough > progress { min-height: 10px; border-radius: 999px; }
    .in-log { font-family: monospace; font-size: 0.85em; opacity: 0.55; }
    .in-warn { color: var(--warning-color); }
    .in-erase .title { color: var(--destructive-color); }
    .in-mark { opacity: 0; transform: translateY(14px) scale(0.96);
               transition: opacity 700ms ease-out, transform 900ms cubic-bezier(0.16, 1, 0.3, 1); }
    .in-mark.in { opacity: 1; transform: none; }
    /* Host Grotesk's contextual alternates make the X in a model number
       (HFS001TEJ9X115N) a multiplication sign */
    window { font-feature-settings: "calt" 0; }
    """

    def label(text, cls, xalign=0.5, **kw):
        lb = Gtk.Label(label=text, css_classes=cls, xalign=xalign, wrap=True, justify=(
            Gtk.Justification.CENTER if xalign == 0.5 else Gtk.Justification.LEFT), **kw)
        return lb

    def column(*children, width=620, spacing=14):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing, valign=Gtk.Align.CENTER,
                      margin_top=24, margin_bottom=24, margin_start=32, margin_end=32)
        for c in children:
            box.append(c)
        return Gtk.ScrolledWindow(child=Adw.Clamp(child=box, maximum_size=width), vexpand=True,
                                  hscrollbar_policy=Gtk.PolicyType.NEVER)

    def nav_page(title, tag, content, back=None, nxt=None, closable=True):
        tv = Adw.ToolbarView(top_bar_style=Adw.ToolbarStyle.FLAT, bottom_bar_style=Adw.ToolbarStyle.FLAT)
        tv.add_top_bar(Adw.HeaderBar(show_title=False, show_back_button=False, show_end_title_buttons=closable))
        tv.set_content(content)
        if back or nxt:
            bar = Gtk.CenterBox(margin_start=22, margin_end=22, margin_top=10, margin_bottom=18)
            if back:
                bar.set_start_widget(back)
            if nxt:
                bar.set_end_widget(nxt)
            tv.add_bottom_bar(bar)
        return Adw.NavigationPage(title=title, tag=tag, child=tv)

    def mark(px=160):
        # an Image, not a Picture: a Picture grows to fill its column
        pic = Gtk.Image(pixel_size=px, halign=Gtk.Align.CENTER, css_classes=["in-mark"])
        # it rises into place each time its page is shown
        pic.connect("map", lambda w: GLib.timeout_add(60, lambda: w.add_css_class("in")))
        pic.connect("unmap", lambda w: w.remove_css_class("in"))
        src = next((d for d in BRAND if (d / "pulsar-mark.svg").exists()), None)
        if not src:
            return pic
        sm = Adw.StyleManager.get_default()

        def draw(*_):
            # at the size shown, in device pixels (an SVG given by path is
            # rasterized at its own size and stretched: soft on HiDPI)
            n = round(px * max(1, pic.get_scale_factor()))
            name = "pulsar-mark.svg" if sm.get_dark() else "pulsar-mark-light.svg"
            pb = GdkPixbuf.Pixbuf.new_from_file_at_size(str(src / name), n, n)
            ok, png = pb.save_to_bufferv("png", [], [])
            pic.set_from_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(png)))
        sm.connect("notify::dark", draw)
        pic.connect("notify::scale-factor", draw)
        draw()
        return pic

    def back_button(nav):
        back = Gtk.Button(label="Back", css_classes=["flat", "in-pill"])
        back.connect("clicked", lambda *_: nav.pop())
        return back

    class Installer(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Install Pulsar", default_width=980, default_height=760)
            prov = Gtk.CssProvider()
            prov.load_from_string(CSS)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            try:
                self.payload = json.loads(PAYLOAD.read_text())
            except (OSError, ValueError):
                self.payload = None
            self.disk = None
            self.mode = None
            self.started = None
            # while the backend is writing, closing the window would stop the
            # install partway: the close button is hidden and a close asked
            # for another way (Alt+F4) is refused, with the reason
            self.installing = False
            self.connect("close-request", self._close_request)
            self.nav = Adw.NavigationView()
            self.set_content(self.nav)
            self.welcome = self.welcome_page()
            self.nav.add(self.welcome)

        def _close_request(self, *_):
            if not self.installing:
                return False
            d = Adw.AlertDialog(heading="Pulsar is still installing",
                                body="Closing the installer now would stop the install partway. "
                                     "Wait for it to finish.")
            d.add_response("ok", "Keep Installing")
            d.present(self)
            return True

        # -------------------------------------------------------- pages

        def welcome_page(self):
            start = Gtk.Button(label="Choose a Disk", css_classes=["suggested-action", "in-big"],
                               halign=Gtk.Align.CENTER)
            start.connect("clicked", lambda *_: self.nav.push(self.disk_page()))
            body = [mark(), label("Install Pulsar", ["in-display"]),
                    label("Nothing on any disk changes until you confirm on the last step.", ["in-lede"]),
                    Gtk.Box(height_request=12), start]
            if not self.payload:
                start.set_sensitive(False)
                body.append(label("This installer is damaged: it has no copy of Pulsar to install. "
                                  "Download the installer again.", ["in-note", "in-warn"]))
            return nav_page("Install Pulsar", "welcome", column(*body))

        def disk_page(self):
            listbox = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
            extra = []
            try:
                found = disks(read_lsblk())
            except Exception as e:     # noqa: BLE001 -- shown, not hidden
                found = None
                listbox.append(Adw.ActionRow(title="The installer couldn't read the disks", subtitle=str(e)))
            for d in sorted(found or [], key=lambda d: (d["usb"], -d["size"])):
                opts = options(d)
                usable = any(ok for ok, _ in opts.values())
                sub = identity(d)
                if not d["empty"] and d["free"] >= GiB:
                    sub += f" · {human(d['free'])} free"
                if not usable:
                    sub += f"\n{opts['erase'][1]}"
                row = Adw.ActionRow(title=d["name"], subtitle=sub, activatable=usable, sensitive=usable)
                row.add_prefix(Gtk.Image(icon_name="drive-removable-media-symbolic" if d["usb"]
                                         else "drive-harddisk-symbolic", pixel_size=32))
                if usable:
                    row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                row.connect("activated", lambda _r, d=d: self.pick_disk(d))
                listbox.append(row)
            if found == [] or (found and not any(any(ok for ok, _ in options(d).values()) for d in found)):
                if found == []:
                    listbox.append(Adw.ActionRow(
                        title="No disk found",
                        subtitle="The USB stick the installer runs from is never offered."))
                extra.append(label(f"Connect a disk of at least {human(NEEDS_ERASE)}, then press Refresh.",
                                   ["in-note"]))
                again = Gtk.Button(label="Refresh", css_classes=["in-pill"], halign=Gtk.Align.CENTER)
                again.connect("clicked", lambda *_: self.nav.replace([self.welcome, self.disk_page()]))
                extra.append(again)
            return nav_page("Disk", "disk", column(label("Choose a disk for Pulsar", ["in-title"]), listbox, *extra),
                            back=back_button(self.nav))

        def pick_disk(self, d):
            self.disk = d
            if skips_method(d):
                self.mode = "erase"
                self.nav.push(self.passphrase_page())
            else:
                self.nav.push(self.method_page(d))

        def method_page(self, d):
            opts = options(d)
            listbox = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
            for mode in ("alongside", "erase"):
                ok, why = opts[mode]
                row = Adw.ActionRow(title=method_title(d, mode), subtitle=why, activatable=ok, sensitive=ok)
                if ok:
                    row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                if mode == "erase":
                    row.add_css_class("in-erase")
                row.connect("activated", lambda _r, m=mode: self.pick_mode(m))
                listbox.append(row)
            if opts["alongside"][0]:
                keep = d["holds"] if d["holds"] in ("Windows", "Linux") else "your files"
                head = f"Keep {keep}, or erase the disk?"
            else:
                head = "How should Pulsar use this disk?"
            return nav_page("How", "method", column(label(head, ["in-title"]),
                                                    label(f"{d['name']} · {identity(d)}", ["in-note"]),
                                                    Gtk.Box(height_request=6), listbox), back=back_button(self.nav))

        def pick_mode(self, mode):
            self.mode = mode
            self.nav.push(self.erase_page() if mode == "erase" and needs_erase_confirm(self.disk)
                          else self.passphrase_page())

        def erase_page(self):
            d = self.disk
            parts = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
            for p in d["partitions"]:
                parts.append(Adw.ActionRow(title=p["what"], subtitle=human(p["size"])))
            sure = Gtk.CheckButton(label=f"Yes, delete everything on {d['name']}", halign=Gtk.Align.CENTER)
            go = Gtk.Button(label="Continue", css_classes=["suggested-action", "in-pill"], sensitive=False)
            sure.connect("toggled", lambda b: go.set_sensitive(b.get_active()))
            go.connect("clicked", lambda *_: self.nav.push(self.passphrase_page()))
            return nav_page("Erase", "erase", column(
                label(f"Erase {d['name']}?", ["in-title"]),
                label(f"{identity(d)} · {d['path']}", ["in-note"]),
                Gtk.Box(height_request=4),
                label("These partitions, and everything in them, will be deleted:", ["in-lede"]),
                parts, sure,
                label("Nothing is deleted until you press Erase and Install on the last step.", ["in-note"])),
                back=back_button(self.nav), nxt=go)

        def passphrase_page(self):
            a = Adw.PasswordEntryRow(title="Passphrase")
            b = Adw.PasswordEntryRow(title="Confirm passphrase")
            group = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
            group.append(a)
            group.append(b)
            hint = label(passphrase_hint("", ""), ["in-note"])
            # the startup screen unlocks with the keys typed here: it must
            # use the same layout (rd.vconsole.keymap), and the page says which
            try:
                src = Gio.Settings.new("org.gnome.desktop.input-sources")
                srcs = src.get_value("mru-sources").unpack() or src.get_value("sources").unpack()
            except Exception:     # noqa: BLE001 -- no schema: the default
                srcs = []
            self.layout, self.variant = current_layout(srcs)
            self.keymap = console_keymap(self.layout, self.variant)
            kbd = label(f"Keyboard layout: {layout_name(self.layout, self.variant)}. "
                        "Pulsar's startup screen uses the same layout.", ["in-note"])
            nxt = Gtk.Button(label="Next", css_classes=["suggested-action", "in-pill"], sensitive=False)

            def check(*_):
                ta, tb = a.get_text(), b.get_text()
                nxt.set_sensitive(passphrase_problem(ta, tb) is None)
                hint.set_label(passphrase_hint(ta, tb))
                (b.add_css_class if tb and ta != tb and len(ta) >= 8 else b.remove_css_class)("error")
            a.connect("changed", check)
            b.connect("changed", check)
            a.connect("entry-activated", lambda *_: b.grab_focus())
            b.connect("entry-activated", lambda *_: nxt.get_sensitive() and nxt.emit("clicked"))
            nxt.connect("clicked", lambda *_: self.plan(a.get_text()))
            page = nav_page("Passphrase", "passphrase", column(
                label("Choose a passphrase", ["in-title"]),
                label("You'll type it every time Pulsar starts. If you forget it, your files can't be recovered.",
                      ["in-lede"]),
                group, hint, kbd), back=back_button(self.nav), nxt=nxt)
            page.connect("shown", lambda *_: a.grab_focus())
            return page

        # ------------------------------------------- plan, then install

        def backend(self, *args):
            return PKEXEC + [BACKEND, "--mode", self.mode, *args, self.disk["path"]]

        def plan(self, passphrase):
            self.passphrase = passphrase
            spin = Adw.Spinner(width_request=48, height_request=48, halign=Gtk.Align.CENTER)
            page = nav_page("Checking", "checking", column(spin, label("Checking the disk…", ["in-lede"])))
            # planned() pops this page itself: a Back here would pop the one under it
            page.set_can_pop(False)
            self.nav.push(page)
            self.run(self.backend("--plan-only"), self.planned)

        def planned(self, events, code):
            self.nav.pop()
            plan = next((e["plan"] for e in events if e.get("stage") == "plan"), None)
            if code != 0 or plan is None:
                self.nav.push(self.failed_page(self.error_of(events), restored=True, planning=True))
                return
            self.nav.push(self.summary_page(plan))

        def summary_page(self, plan):
            d = self.disk
            root = next((p for p in plan if p["type"].startswith("root")), None)
            if self.mode == "alongside":
                what = ("Pulsar goes in the free space. " + (f"{d['holds']} stays as it is."
                        if d["holds"] in ("Windows", "Linux") else "Your files stay as they are."))
            elif d["empty"]:
                what = "Pulsar uses the whole disk."
            elif d["holds"] in ("Windows", "Linux"):
                what = f"Everything on the disk is deleted, including {d['holds']}, and replaced by Pulsar."
            else:
                what = "Everything on the disk is deleted and replaced by Pulsar."
            rows = [("Disk", f"{d['name']}\n{identity(d)} · {d['path']}"),
                    ("What happens", what),
                    ("Space for Pulsar", human(root["raw_size"]) if root else "Decided by the disk's free space"),
                    ("Encryption", "On. Your passphrase unlocks the disk at every start.")]
            listbox = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
            for k, v in rows:
                r = Adw.ActionRow(title=k, subtitle=v, subtitle_selectable=True, css_classes=["property"])
                if k == "What happens" and install_destroys(self.mode, d):
                    r.add_css_class("in-erase")
                listbox.append(r)
            # red only when Install deletes something: never for an empty disk
            go = Gtk.Button(label=install_button(self.mode, d),
                            css_classes=["destructive-action" if install_destroys(self.mode, d)
                                         else "suggested-action", "in-pill"])
            go.connect("clicked", lambda *_: self.install())
            return nav_page("Ready", "summary", column(label("Ready to install", ["in-title"]), listbox),
                            back=back_button(self.nav), nxt=go)

        def install(self):
            fd, self.key_path = tempfile.mkstemp(prefix="pulsar-key-", dir=os.environ.get("XDG_RUNTIME_DIR"))
            os.write(fd, self.passphrase.encode())
            os.close(fd)
            self.passphrase = None
            self.started = time.monotonic()
            self.installing = True
            self.in_install = False
            self.anim = None
            self.percent = label("0%", ["in-percent"])
            self.bar = Gtk.ProgressBar(fraction=0.0, css_classes=["in-bar"])
            self.stage = label("Getting ready", ["in-lede"])
            self.logline = label("", ["in-log"], ellipsize=3, lines=1)
            self.clock = label(elapsed(0), ["in-note"])
            page = nav_page("Installing", "installing", column(
                self.percent, self.bar, self.stage, self.logline, Gtk.Box(height_request=18),
                label("Keep the computer on and the USB stick in until this finishes.", ["in-note"]),
                self.clock), closable=False)
            page.set_can_pop(False)
            self.nav.push(page)
            self.tick = GLib.timeout_add(500, self._tick)
            extra = ["--expected-bytes", str(self.payload["size"])] if self.payload.get("size") else []
            extra += ["--keymap", self.keymap, "--xkb-layout", self.layout]
            if self.variant:
                extra += ["--xkb-variant", self.variant]
            self.run(self.backend("--key-file", self.key_path, "--source-imgref", self.payload["source"],
                                  "--target-imgref", self.payload["target"], *extra), self.installed, self.progress)

        STAGES = {"check": ("Checking the disk", 0.02), "disk": ("Partitioning and encrypting the disk", 0.06),
                  "unlock": ("Unlocking the new partition", 0.10), "install": ("Copying Pulsar to the disk", 0.12),
                  "boot": ("Setting up startup", 0.94)}

        def glide(self, to):
            """The bar moves to `to` over a moment, never back: each step
            of the backend is a slide, not a jump."""
            frm = self.bar.get_fraction()
            if to <= frm:
                return
            if self.anim:
                self.anim.skip()

            def step(v):
                self.bar.set_fraction(v)
                self.percent.set_label(f"{int(v * 100)}%")
            self.anim = Adw.TimedAnimation(widget=self.bar, value_from=frm, value_to=to, duration=600,
                                           target=Adw.CallbackAnimationTarget.new(step))
            self.anim.play()

        def progress(self, ev):
            st = ev.get("stage")
            if st in self.STAGES:
                text, frac = self.STAGES[st]
                self.stage.set_label(text)
                self.glide(frac)
                self.in_install = st == "install"
            elif "progress" in ev and self.in_install:
                self.glide(install_fraction(ev["progress"]))
            elif "log" in ev:
                self.logline.set_label(ev["log"])

        def _tick(self):
            self.clock.set_label(elapsed(int(time.monotonic() - self.started)))
            return True

        def installed(self, events, code):
            GLib.source_remove(self.tick)
            self.installing = False
            try:
                os.unlink(self.key_path)
            except OSError:
                pass
            done = next((e for e in events if e.get("stage") == "done"), None)
            if code == 0 and done:
                self.nav.push(self.done_page(int(time.monotonic() - self.started), done))
            else:
                failed = next((e for e in events if e.get("stage") == "failed"), {})
                self.nav.push(self.failed_page(self.error_of(events), restored=failed.get("restored", False)))

        def done_page(self, secs, done):
            restart = Gtk.Button(label="Restart Now", css_classes=["suggested-action", "in-big"],
                                 halign=Gtk.Align.CENTER)
            restart.connect("clicked", lambda *_: subprocess.Popen(["systemctl", "reboot"]))
            extra = []
            if done.get("windows_entry"):
                extra.append(label("Windows is still on this computer. Choose it in the startup menu.",
                                   ["in-note"]))
            page = nav_page("Done", "done", column(
                mark(120), label("Pulsar is installed", ["in-display"]),
                label("Restart the computer. When the screen goes dark, remove the USB stick.", ["in-lede"]),
                label("When Pulsar starts, type your passphrase to unlock the disk, then create your account.",
                      ["in-note"]),
                *extra, Gtk.Box(height_request=8), restart))
            page.set_can_pop(False)
            page.connect("shown", lambda *_: restart.grab_focus())
            return page

        def failed_page(self, error, restored, planning=False):
            head = "Pulsar can't go on this disk" if planning else "The install didn't finish"
            details = Gtk.Expander(label="Details", halign=Gtk.Align.CENTER,
                                   child=label(error, ["in-log"], 0, selectable=True, max_width_chars=70))
            again = Gtk.Button(label="Start Over", css_classes=["suggested-action", "in-pill"],
                               halign=Gtk.Align.CENTER)
            # the disk list is read again: a failed install may have changed what is on a disk
            again.connect("clicked", lambda *_: self.nav.replace([self.welcome, self.disk_page()]))
            page = nav_page("Problem", "failed", column(
                label(head, ["in-title"]), label(failure_state(self.mode, restored, planning), ["in-lede"]),
                details, Gtk.Box(height_request=8), again))
            page.set_can_pop(False)
            return page

        @staticmethod
        def error_of(events):
            for e in events:
                if e.get("stage") == "failed":
                    return e.get("error") or "unknown error"
            logs = [e["log"] for e in events if "log" in e]
            return (logs[-1] if logs else "") or "The installer's backend stopped without saying why."

        # ------------------------------------------- the backend, async

        def run(self, argv, done, on_event=None):
            """Run argv, read its JSON lines as they come, call done(events,
            exit code). The window stays responsive throughout."""
            proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
            stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
            events = []

            def line(src, res):
                text, _ = src.read_line_finish_utf8(res)
                if text is None:
                    proc.wait_async(None, lambda p, r: (p.wait_finish(r), done(events, p.get_exit_status())))
                    return
                try:
                    ev = json.loads(text)
                except ValueError:
                    ev = {"log": text}
                events.append(ev)
                if on_event:
                    on_event(ev)
                src.read_line_async(GLib.PRIORITY_DEFAULT, None, line)
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, line)

    shots = pathlib.Path(sys.argv[sys.argv.index("--shots") + 1]) if "--shots" in sys.argv else None

    def shoot(win):
        """Each page in turn, saved as it renders. The fake backend's events
        drive the installing page; disks come from PULSAR_INSTALLER_LSBLK."""
        shots.mkdir(parents=True, exist_ok=True)
        win.nav.set_animate_transitions(False)
        found = disks(read_lsblk())
        d = next((x for x in found if x["holds"] == "Windows" and options(x)["alongside"][0]), found[0])
        plan = [{"type": "root-x86-64", "raw_size": d["free"] - 2 * GiB}]

        def summary(mode):
            win.mode = mode
            win.passphrase = "x" * 8
            win.nav.push(win.summary_page(plan))
        steps = [("welcome", lambda: None),
                 ("disks", lambda: win.nav.push(win.disk_page())),
                 ("method", lambda: win.pick_disk(d)),
                 ("erase", lambda: (setattr(win, "mode", "erase"), win.nav.push(win.erase_page()))),
                 ("passphrase", lambda: win.nav.push(win.passphrase_page())),
                 ("summary-erase", lambda: summary("erase")),
                 ("summary", lambda: (win.nav.pop(), summary("alongside"))),
                 ("installing", lambda: win.install()),
                 ("done", lambda: win.nav.push(win.done_page(187, {"windows_entry": True}))),
                 ("failed", lambda: win.nav.push(win.failed_page(
                     "bootc exited 1: error: Installing to filesystem: no space left on device", restored=True)))]
        # the pages whose mark rises in: shot once it has
        slow = {"welcome": 1400, "done": 1400, "installing": 4000}

        def save(name, n):
            w, h = win.get_width(), win.get_height()
            snap = Gtk.Snapshot()
            Gtk.WidgetPaintable.new(win).snapshot(snap, w, h)
            node = snap.to_node()
            if node:
                tex = win.get_renderer().render_texture(node, Graphene.Rect().init(0, 0, w, h))
                tex.save_to_png(str(shots / f"{n:02d}-{name}.png"))

        def step(i=0):
            if i:
                save(steps[i - 1][0], i)
            if i == len(steps):
                win.installing = False
                win.get_application().quit()
                return False
            steps[i][1]()
            # installing: let the fake backend's stages arrive first
            GLib.timeout_add(slow.get(steps[i][0], 700), step, i + 1)
            return False
        GLib.timeout_add(100, step)

    def activate(a):
        win = a.get_active_window() or Installer(a)
        win.present()
        if shots:
            shoot(win)
    app = Adw.Application(application_id="digital.arclight.Pulsar.Installer")
    app.connect("activate", activate)
    return app.run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
