<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">
<!-- Registers the Pulsar wallpaper pairs (one per look) with the Appearance panel.
     filename = light-style cut, filename-dark = dark-style cut; GNOME flips
     between them with the style toggle. The PNGs are rendered in CI from
     assets/shaders/pulsar.frag (see scripts/render-wallpapers.py), so these
     paths must stay in sync with the VARIANTS table there.

     No double hyphen anywhere in this comment. XML forbids it, and a parse
     error here is silent: gnome-control-center drops the whole file and the
     Appearance panel simply shows no Pulsar wallpapers, with the PNGs sitting
     correctly installed the entire time. -->
<wallpapers>
  <wallpaper deleted="false">
    <name>Pulsar Nebula</name>
    <filename>/usr/share/backgrounds/pulsar/pulsar-nebula-light.jxl</filename>
    <filename-dark>/usr/share/backgrounds/pulsar/pulsar-nebula-dark.jxl</filename-dark>
    <options>zoom</options>
    <shade_type>solid</shade_type>
    <pcolor>#0B0E1A</pcolor>
    <scolor>#0B0E1A</scolor>
  </wallpaper>
  <wallpaper deleted="false">
