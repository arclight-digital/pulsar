<?xml version="1.0" encoding="UTF-8"?>
<!-- generated by pulsar-theme -->
<style-scheme id="{{id}}" name="{{name}}" version="1.0">
  <author>{{author}}</author>
  <description>Generated by pulsar-theme</description>
  <metadata>
    <property name="variant">{{mode}}</property>
    <property name="{{pair_key}}">{{pair}}</property>
    <!-- Text Editor recolours its own window from these (supported, not a hack) -->
    <property name="window_bg_color">{{background}}</property>
    <property name="window_fg_color">{{foreground}}</property>
    <property name="headerbar_bg_color">{{headerbar}}</property>
    <property name="headerbar_fg_color">{{foreground}}</property>
    <property name="sidebar_bg_color">{{sidebar}}</property>
    <property name="sidebar_fg_color">{{foreground}}</property>
    <property name="popover_bg_color">{{popover}}</property>
    <property name="popover_fg_color">{{foreground}}</property>
    <property name="accent_bg_color">{{accent}}</property>
    <property name="accent_fg_color">{{accent_fg}}</property>
    <property name="accent_color">{{accent_text}}</property>
  </metadata>
  <style name="text" foreground="{{foreground}}" background="{{background}}"/>
  <style name="cursor" foreground="{{accent}}"/>
  <style name="selection" foreground="{{foreground}}" background="{{selection}}"/>
  <style name="current-line" background="{{background_raised}}"/>
  <style name="current-line-number" foreground="{{accent}}" background="{{background_raised}}"/>
  <style name="line-numbers" foreground="{{muted}}" background="{{background}}"/>
  <style name="right-margin" foreground="{{muted}}" background="{{background_raised}}"/>
  <style name="bracket-match" foreground="{{accent}}" bold="true"/>
  <style name="bracket-mismatch" foreground="{{red}}" underline="true"/>
  <style name="search-match" foreground="{{background}}" background="{{yellow}}"/>
  <style name="draw-spaces" foreground="{{selection}}"/>
  <style name="def:comment" foreground="{{muted}}" italic="true"/>
  <style name="def:shebang" foreground="{{muted}}" bold="true"/>
  <style name="def:doc-comment-element" italic="true"/>
  <style name="def:constant" foreground="{{orange}}"/>
  <style name="def:number" foreground="{{orange}}"/>
  <style name="def:boolean" foreground="{{orange}}"/>
  <style name="def:string" foreground="{{green}}"/>
  <style name="def:special-char" foreground="{{cyan}}"/>
  <style name="def:keyword" foreground="{{magenta}}"/>
  <style name="def:statement" foreground="{{magenta}}"/>
  <style name="def:builtin" foreground="{{cyan}}"/>
  <style name="def:type" foreground="{{yellow}}"/>
  <style name="def:function" foreground="{{blue}}"/>
  <style name="def:identifier" foreground="{{red}}"/>
  <style name="def:preprocessor" foreground="{{cyan}}"/>
  <style name="def:error" foreground="{{red}}" underline="error"/>
  <style name="def:warning" underline="error"/>
  <style name="def:note" foreground="{{background}}" background="{{yellow}}" bold="true"/>
  <style name="def:heading" foreground="{{blue}}" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:link-text" foreground="{{accent_text}}"/>
  <style name="def:net-address" foreground="{{accent_text}}" underline="single"/>
  <style name="diff:added-line" foreground="{{green}}"/>
  <style name="diff:removed-line" foreground="{{red}}"/>
  <style name="diff:changed-line" foreground="{{yellow}}"/>
  <style name="diff:location" foreground="{{blue}}" bold="true"/>
  <style name="diff:special-case" foreground="{{muted}}"/>
</style-scheme>
