---
// A ruled list of facts, each saying what a thing does for you and then how.
// Used by two pillars: gaming, and the base that cannot rot -- where the
// image's own manifest readout sits beside the list as the proof.
import Manifest from './Manifest.astro';

export type Fact = { t: string; d: string };
interface Props {
  facts: Fact[];
  manifest?: boolean;
}
const { facts, manifest = false } = Astro.props;
---

<div class={manifest ? 'inside with-manifest' : 'inside'}>
  <dl class="facts">
    {
      facts.map((f) => (
        <div class="fact">
          <dt>{f.t}</dt>
          <dd set:html={f.d} />
        </div>
      ))
    }
  </dl>
  {manifest && <Manifest />}
</div>

<style>
  .inside {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .with-manifest {
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
  }
  .facts {
    margin: 0;
    max-width: 58ch;
    border-bottom: 1px solid var(--border-subtle);
  }
  .fact {
    padding: var(--space-md) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .fact:first-child {
    border-top: 0;
    padding-top: 0;
  }
  dt {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-md);
    line-height: var(--heading-lh);
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
  }
  dd {
    margin: 0;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  @media (max-width: 56rem) {
    .with-manifest {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
