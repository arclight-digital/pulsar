#!/usr/bin/env bash
# pulsar -- the front door to a Pulsar system.
#
# Every subcommand is a thin wrapper over bootc, ostree, rpm-ostree, systemd or
# jq. That is deliberate: none of this needs logic of its own, and a compiled
# binary would add a build pipeline to hide five lines of shell. What it does
# add is a single place where the RIGHT question gets asked -- see `doctor`.
#
# Reads go through rpm-ostree, writes through bootc. Not a style preference:
# `bootc status` requires root even to READ, and a health check you cannot run
# without sudo is one you will not run. `rpm-ostree status --json` reports the
# same deployments unprivileged, so `pulsar status` and `pulsar doctor` work as
# any user, and only the commands that actually mutate the system ask for root.
#
# The one write that does not always go through bootc is `update` -- bootc owns
# the container image and nothing else, so on a system with layered packages it
# is the wrong tool. See cmd_update.
set -euo pipefail
# Under pipefail, `printf '%s\n' "$x" | grep -q ...` can answer "no" when the
# answer is yes: grep -q exits on its first match, bash's printf writes a line
# at a time, and a printf still writing dies of SIGPIPE, which pipefail
# reports. So text already in a variable is searched with a here-string,
# `grep -q ... <<<"$x"`, which bash writes in full before grep starts.

# A systemd system service, a timer or cron starts this with no HOME at all,
# and under set -u the first path built from it kills the script before
# doctor, status or manifest -- none of which need a home -- print a word.
# The account's own home from passwd, as a login would set it; / if even that
# is missing, so nothing written under it lands in the working directory.
if [ -z "${HOME:-}" ]; then
    HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
    export HOME=${HOME:-/}
fi

# the release (YY.M.N) the image carries; a checkout has none installed
VERSION=$(cat "${PULSAR_RELEASE_FILE:-/usr/share/pulsar/release}" 2>/dev/null || true)
VERSION=${VERSION:-dev}
MANIFEST=${PULSAR_MANIFEST:-/usr/share/pulsar/manifest.json}
SBOM_TOOL=${PULSAR_SBOM_TOOL:-/usr/libexec/pulsar/rpm-sbom.sh}

# ---------------------------------------------------------------------------
# Output. Colour only when stdout is a terminal, so piping into a file or a
# log does not embed escape codes.
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
    C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_FAIL=$'\033[31m'; C_KEY=$'\033[36m'
else
    C_RESET=""; C_DIM=""; C_BOLD=""; C_OK=""; C_WARN=""; C_FAIL=""; C_KEY=""
fi

die() { printf '%spulsar:%s %s\n' "$C_FAIL" "$C_RESET" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

need_root() {
    [ "$(id -u)" -eq 0 ] && return 0
    die "'$1' needs root -- try: sudo pulsar $1"
}

# The mirror image, for setup recipes: they write to $HOME and talk to the
# user session bus, and under sudo both silently target root's. The failure
# that surfaces otherwise is systemd's "Failed to connect to bus", which
# points nowhere near the actual mistake.
need_user() {
    [ "$(id -u)" -ne 0 ] && return 0
    die "'$1' configures your session and must not run as root -- drop the sudo"
}

need() { have "$1" || die "required tool not found: $1"; }

# `--json` is accepted anywhere on the line. A command (or subcommand) that has
# no JSON output calls this, so a script that asked for JSON gets an error, not
# prose it will fail to parse -- or, for `update`, a real upgrade.
no_json() { [ "${JSON:-0}" = 0 ] || die "'$1' has no --json output"; }

# Commands that take no arguments say so, instead of silently ignoring what
# they were given: `pulsar doctor tomorrow` should not run doctor today.
no_args() {
    local c=$1; shift
    case "${1:-}" in -h|--help) usage_for "$c"; exit 0 ;; esac
    [ $# -eq 0 ] || die "'${c}' takes no arguments (got: $*)"
}

# Reads a top-level string out of the baked manifest. Absent manifest is not
# fatal: a system rebased from an older image, or a hand-built one, still gets
# a working doctor and status.
mf() {
    # if-then, not `A && B || C`: in that form C also runs when A succeeds and
    # B fails, which is the same shape as the fallback bug that made the
    # greenboot check report health it could not see.
    [ -r "$MANIFEST" ] || return 0
    jq -r --arg k "$1" '.[$k] // empty' "$MANIFEST" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# doctor -- the reason this CLI exists.
#
# Checks carry a severity, and only `fail` changes the exit code. The
# distinction matters and is the same one greenboot's required.d/wanted.d
# split encodes: a scheduler that did not attach is a performance regression
# on a completely usable machine, so it warns. A boot that greenboot marked
# red is a system that tried to roll itself back, so it fails.
# ---------------------------------------------------------------------------
CHECK_JSON=""
RC=0
RECORDED=0

# record <id> <ok|warn|fail> <headline> [detail]
record() {
    local id=$1 status=$2 head=$3 detail=${4:-}
    local color symbol
    RECORDED=$((RECORDED + 1))
    case "$status" in
        ok)   color=$C_OK;   symbol="ok  " ;;
        warn) color=$C_WARN; symbol="warn" ;;
        fail) color=$C_FAIL; symbol="FAIL"; RC=1 ;;
        # a typo'd severity would otherwise die on an unbound variable three
        # lines down, attributed to nothing
        *)    die "internal error: record() called with status '${status}'" ;;
    esac
    if [ "${JSON:-0}" = 1 ]; then
        CHECK_JSON+=$(jq -n -c --arg i "$id" --arg s "$status" --arg h "$head" --arg d "$detail" \
            '{id:$i, status:$s, summary:$h, detail:$d}'),
    else
        printf '%s%s%s  %-14s %s\n' "$color" "$symbol" "$C_RESET" "$id" "$head"
        [ -n "$detail" ] && printf '                     %s%s%s\n' "$C_DIM" "$detail" "$C_RESET"
    fi
    return 0
}

check_scheduler() {
    local state file=/sys/kernel/sched_ext/state
    if [ ! -e "$file" ]; then
        record scheduler ok "kernel has no sched_ext; stock EEVDF" ; return
    fi
    state=$(cat "$file" 2>/dev/null || echo unknown)
    if [ "$state" = "enabled" ]; then
        local ops; ops=$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || echo unknown)
        record scheduler ok "sched_ext enabled" "root scheduler: ${ops}"
    elif [ ! -e /usr/lib/pulsar/scx-supported ]; then
        # Not a fault: this kernel's BTF cannot load ANY BPF scheduler, the
        # build detected that, and scx.service is skipped rather than failed.
        # Reporting it as a warning forever would be indistinguishable from
        # something the user could fix, and there is nothing to fix here.
        record scheduler ok "stock EEVDF: this kernel cannot load a BPF scheduler" \
               "scx kfuncs carry the implicit prog-aux argument (Fedora kernel BTF)"
    else
        # Warn, not fail. The machine runs fine on EEVDF -- but this is the
        # check that catches the failure `systemctl is-active scx.service`
        # cannot see, where the unit is green and no scheduler ever attached.
        local unit
        # NOT $(cmd || echo fallback): is-active PRINTS "failed" and THEN exits
        # nonzero, so the fallback appends to it and you get "failed\nunknown".
        unit=$(systemctl is-active scx.service 2>/dev/null) || true
        [ -n "$unit" ] || unit=unknown
        # scx.service binds the kernel config into its own /boot, so the
        # missing-/boot/config cause this used to name cannot happen to it any
        # more. What the unit last said is the most useful next clue.
        local last
        last=$(journalctl -u scx.service -b -n 1 -o cat --no-pager 2>/dev/null | head -c 200) || true
        [ -z "$last" ] || unit="${unit}; last: ${last}"
        record scheduler warn "sched_ext is '${state}' -- running stock EEVDF" \
               "scx.service: ${unit}"
    fi
}

check_ntsync() {
    if [ -e /dev/ntsync ]; then
        record ntsync ok "/dev/ntsync present" "$(stat -c '%A %U:%G' /dev/ntsync 2>/dev/null || true)"
    elif grep -q '^ntsync ' /proc/modules 2>/dev/null; then
        record ntsync warn "ntsync module loaded but /dev/ntsync is missing" "check 70-ntsync.rules"
    else
        record ntsync warn "ntsync not available" "Proton falls back to esync/fsync"
    fi
}

check_gamemode() {
    # Paths are overridable for the same reason the rest of the CLI's are:
    # these branches are decisions worth testing, not plumbing worth mocking.
    local ini=${PULSAR_GAMEMODE_INI:-/etc/gamemode.ini} group=gamemode
    local limits_dir=${PULSAR_LIMITS_DIR:-/etc/security/limits.d}
    local limits_conf=${PULSAR_LIMITS_CONF:-/etc/security/limits.conf}

    # Degrade honestly off a Pulsar system: no gamemode, nothing to say.
    if [ ! -f "$ini" ] && ! command -v gamemoded >/dev/null 2>&1; then
        record gamemode ok "gamemode not installed"; return
    fi

    # If renice is not being asked for, membership is irrelevant and a warning
    # about it would be noise. Read the merged intent from our own override.
    local renice
    renice=$(sed -n 's/^renice=\([0-9]\{1,\}\)$/\1/p' "$ini" 2>/dev/null | tail -1) || true
    if [ -z "$renice" ] || [ "$renice" = 0 ]; then
        record gamemode ok "gamemode present; renice not requested"; return
    fi

    if ! getent group "$group" >/dev/null 2>&1; then
        record gamemode warn "no '${group}' group, so renice=${renice} is inert" \
               "the gamemode package normally creates it"
        return
    fi

    # The grant is what makes the priority possible; without it, membership
    # buys nothing and the symptom is silence.
    if ! grep -rqs -- "@${group}" "$limits_dir" "$limits_conf"; then
        record gamemode warn "no '@${group}' nice grant, so renice=${renice} is inert" \
               "expected /etc/security/limits.d/10-gamemode.conf"
        return
    fi

    # Under sudo the interesting account is the human one, not root: root is
    # never in the group and never needs to be.
    local user=${SUDO_USER:-}
    [ -n "$user" ] || user=$(id -un)

    if ! id -nG "$user" 2>/dev/null | tr ' ' '\n' | grep -qx "$group"; then
        record gamemode warn "${user} is not in the ${group} group; renice=${renice} does nothing" \
               "sudo pulsar setup gamemode -- then log out and back in"
        return
    fi

    # Enrolled in /etc/group is not the same as live in THIS session:
    # supplementary groups are fixed by PAM at login, so the session that ran
    # the enrolment still does not have it. That gap is the whole reason this
    # check reports two states instead of one.
    if [ -z "${SUDO_USER:-}" ] && ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$group"; then
        record gamemode warn "${user} is enrolled in ${group}, but this session predates it" \
               "log out and back in; renice=${renice} applies from the next login"
        return
    fi

    record gamemode ok "${user} is in ${group}; renice=${renice} available" \
           "igpu governor demotion disabled (igpu_power_threshold=-1)"
}

check_mangohud() {
    local list=${PULSAR_FLATPAKS_LIST:-/usr/share/pulsar/flatpaks.list}
    local id=org.freedesktop.Platform.VulkanLayer.MangoHud
    local launcher=com.valvesoftware.Steam

    # Degrade honestly off a Pulsar system.
    if [ ! -r "$list" ] || ! command -v flatpak >/dev/null 2>&1; then
        record mangohud ok "no flatpak defaults here"; return
    fi

    # The branch the image pins. No entry means nothing to keep in step.
    local pinned
    pinned=$(sed -e 's/#.*//' "$list" \
             | awk -v i="$id" '$1 ~ "^"i"//" { sub(/.*\/\//, "", $1); print $1; exit }') || true
    if [ -z "$pinned" ]; then
        record mangohud ok "the MangoHud layer is not in the defaults"; return
    fi

    # --columns rather than `flatpak info`, whose labels are translated.
    local installed
    installed=$(flatpak list --columns=application,branch 2>/dev/null \
                | awk -v i="$id" '$1 == i { print $2 }' | paste -sd, -) || true

    if [ -z "$installed" ]; then
        record mangohud warn "MangoHud layer not installed; Flatpak games get no overlay" \
               "sudo flatpak install flathub ${id}//${pinned}"
        return
    fi

    # What the shipped launcher actually runs on. Without it there is nothing
    # to be out of step WITH, so the pin is simply reported.
    local used
    used=$(flatpak list --app --columns=application,runtime 2>/dev/null \
           | awk -v a="$launcher" '$1 == a { n = split($2, p, "/"); print p[n]; exit }') || true
    if [ -z "$used" ]; then
        record mangohud ok "MangoHud layer present (${installed}); no Steam to check against"
        return
    fi

    # THE ROT THIS CHECK EXISTS FOR. An extension is only visible to apps on
    # the matching runtime, so when the launcher moves branch and the pin does
    # not, the overlay stops appearing and nothing anywhere logs a reason.
    if ! grep -q ",${used}," <<<",${installed},"; then
        record mangohud warn "MangoHud layer is ${installed}, but Steam runs on ${used}" \
               "the overlay is invisible to Flatpak games; repin flatpaks.list to //${used}"
        return
    fi

    if [ "$pinned" != "$used" ]; then
        record mangohud warn "flatpaks.list pins //${pinned}, Steam runs on ${used}" \
               "installed (${installed}) still covers it; repin before the old branch goes"
        return
    fi

    record mangohud ok "MangoHud layer ${used} matches Steam's runtime"
}

check_greenboot() {
    local enabled
    # is-enabled prints "not-found" AND exits nonzero. Appending a fallback
    # produced "not-found\nnot-found", which matched nothing, so this check
    # fell through and reported "passed" on a system with no greenboot at all.
    enabled=$(systemctl is-enabled greenboot-healthcheck.service 2>/dev/null) || true
    [ -n "$enabled" ] || enabled=not-found
    if [ "$enabled" = "not-found" ] || [ "$enabled" = "masked" ]; then
        record greenboot warn "greenboot is not installed on this deployment" \
               "automatic rollback is not armed"
        return
    fi
    if [ "$enabled" = "disabled" ]; then
        record greenboot warn "greenboot is installed but disabled" \
               "automatic rollback is not armed: sudo systemctl enable greenboot-healthcheck.service"
        return
    fi
    # Result=success is also what a unit that has NEVER RUN reports, so on
    # its own it read a greenboot that had not run (or was still running,
    # early in boot) as a green boot. The unit is RemainAfterExit, so after a
    # real pass it sits active/exited.
    local result active
    result=$(systemctl show -p Result --value greenboot-healthcheck.service 2>/dev/null) || result=unknown
    active=$(systemctl show -p ActiveState --value greenboot-healthcheck.service 2>/dev/null) || active=unknown
    if [ "$result" = "success" ] && [ "$active" != "active" ]; then
        record greenboot warn "health checks have not finished this boot (${active:-unknown})" \
               "journalctl -u greenboot-healthcheck.service"
    elif [ "$result" = "success" ] || [ "$result" = "" ]; then
        record greenboot ok "health checks passed" "boot marked green"
    else
        # A red boot means greenboot is counting down to a rollback.
        record greenboot fail "last health check result: ${result}" \
               "journalctl -u greenboot-healthcheck.service"
    fi
}

# Is there an NVIDIA display device (vendor 0x10de, PCI class 0x03xxxx) on
# the bus? Read from sysfs, which needs no tools. "Cannot tell" -- no sysfs,
# as in a container -- answers yes, so doctor falls back to the stricter
# reading rather than excusing a missing module on a guess.
# PULSAR_SYS_PCI: the tests' fixture.
nvidia_gpu_present() {
    local bus="${PULSAR_SYS_PCI:-/sys/bus/pci/devices}" d
    [ -d "$bus" ] || return 0
    for d in "$bus"/*; do
        [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] || continue
        case "$(cat "$d/class" 2>/dev/null)" in 0x03*) return 0 ;; esac
    done
    return 1
}

check_nvidia() {
    local variant; variant=$(mf variant)
    case "$variant" in
        *nvidia*) ;;
        "") # No manifest. Only report if the driver is actually present.
            grep -q '^nvidia ' "${PULSAR_PROC_MODULES:-/proc/modules}" 2>/dev/null || return 0 ;;
        *)  # Vanilla image: nvidia absence is correct, say nothing.
            return 0 ;;
    esac
    # /proc/modules and /sys, never lsmod/modinfo: those live in /usr/sbin,
    # which is not on every user's PATH, and under pipefail a missing binary
    # reads as "no nvidia module" -- a false clean bill of health.
    # PULSAR_PROC_MODULES: the tests' fixture; rootless podman shows the
    # HOST's /proc/modules, so without it a GPU-less build host fails here
    # while a developer's nvidia laptop passes.
    if ! grep -q '^nvidia ' "${PULSAR_PROC_MODULES:-/proc/modules}" 2>/dev/null; then
        # No module on a machine with no NVIDIA GPU is not a rejected
        # module, it is the wrong image -- and it is also every VM this image
        # is boot-tested on. Only a GPU that is there and unserved is a fail.
        if ! nvidia_gpu_present; then
            record nvidia warn "nvidia image, but this machine has no NVIDIA GPU" \
                   "the vanilla image fits it: bootc switch ghcr.io/arclight-digital/pulsar:latest"
            return
        fi
        record nvidia fail "nvidia variant but no nvidia module is loaded" \
               "Secure Boot may have rejected an unsigned module: dmesg | grep -i taint"
        return
    fi
    local running expected
    running=$(cat /sys/module/nvidia/version 2>/dev/null) || true
    [ -n "$running" ] || running=unknown
    expected=$(mf nvidia_driver)
    # Only compare against something version-shaped. A manifest once carried
    # nvidia_driver="package kmod-nvidia-open is not installed" -- rpm prints
    # that on stdout and exits 1, so a `$(rpm -q ... || fallback)` captured it
    # as the value, and comparing against it warned on every run, forever.
    # Garbage in the manifest is the manifest's bug to report, not a reason
    # to cry wolf about a driver that is fine.
    case "$expected" in
        *[!0-9.]*|'') expected="" ;;
    esac
    if [ -n "$expected" ] && [ "$running" != "$expected" ]; then
        record nvidia warn "driver ${running}, image expects ${expected}" \
               "a reboot into the staged deployment usually reconciles this"
    else
        record nvidia ok "nvidia-open ${running} loaded"
    fi
}

# Flatpak apps do not see the host's NVIDIA userspace. Each one mounts
# org.freedesktop.Platform.GL.nvidia-<driver version> once, when it starts,
# and keeps whatever it got until it exits. Two ways that goes wrong were
# both seen on cherenkov on 2026-09-26, and neither reports an error:
#
#   - the app started before the matching extension was installed (Steam
#     autostarted at login; GNOME Software installed the extension 16s
#     later), so its sandbox has no NVIDIA driver at all;
#   - the extension was redeployed under a running app, which kept the
#     directory name and lost the files: every game launch after that logged
#     "nvidia_icd.json: No such file or directory".
#
# Either way the app's games enumerate only the iGPU and llvmpipe. On a laptop
# whose panel hangs off the NVIDIA GPU that is a black window, and the only
# fix is to quit the app and start it again.
#
# The evidence is flatpak's own record of each running instance,
# $XDG_RUNTIME_DIR/.flatpak/<instance>/info, which names every extension the
# instance mounted and the COMMIT it mounted. An instance is healthy when it
# has GL.nvidia-<running driver> and that commit is still deployed. It is
# stale when the extension is absent, or when the commit it holds has since
# been replaced and deleted. Multiarch apps (Steam) are held to the same test
# for GL32. Not a look inside /proc/<pid>/root: Steam's pressure-vessel
# sub-sandboxes carry empty GL skeletons there and get the driver another way,
# so the look reads a healthy Steam as broken.
#
# Sets FGL_STATUS (skip|missing|stale|ok), FGL_DRIVER and FGL_APPS/FGL_IDS
# (the stale apps' short names and instance ids).
flatpak_gl_scan() {
    FGL_STATUS=skip; FGL_DRIVER=""; FGL_APPS=""; FGL_IDS=""
    have flatpak || return 0
    # Instances are per user and sudo drops XDG_RUNTIME_DIR, so as root this
    # would look at root's (empty) set and call it healthy. Say nothing.
    # (The tests point PULSAR_FLATPAK_RUN at a fixture and may run as root on
    # the build host; that is not a sudo'd user, so the guard does not apply.)
    [ "$(id -u)" -ne 0 ] || [ -n "${PULSAR_FLATPAK_RUN:-}" ] || return 0
    local variant; variant=$(mf variant)
    case "$variant" in
        *nvidia*|"") ;;
        *) return 0 ;;
    esac
    local ver
    ver=$(tr -d '[:space:]' < "${PULSAR_NVIDIA_VERSION_FILE:-/sys/module/nvidia/version}" 2>/dev/null) || true
    # No loaded module is check_nvidia's finding, not this one's.
    [[ "$ver" =~ ^[0-9]+(\.[0-9]+)+$ ]] || return 0
    FGL_DRIVER=$ver
    local ext="nvidia-${ver//./-}"

    local runtimes gl32_installed=0 need_gl32=0
    runtimes=$(flatpak list --runtime --columns=application 2>/dev/null) || true
    if ! grep -Fxq "org.freedesktop.Platform.GL.${ext}" <<<"$runtimes"; then
        FGL_STATUS=missing; return 0
    fi
    # GL32 lands in its own transaction after GL, ~100MB later. An app that
    # needs it before then is waiting on an install, not on a restart, and
    # telling the user to restart it got them a second Steam with the same
    # problem.
    grep -Fxq "org.freedesktop.Platform.GL32.${ext}" <<<"$runtimes" && gl32_installed=1

    local run=${PULSAR_FLATPAK_RUN:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/.flatpak}
    local -a roots
    if [ -n "${PULSAR_FLATPAK_ROOTS:-}" ]; then
        read -r -a roots <<<"$PULSAR_FLATPAK_ROOTS"
    else
        roots=(/var/lib/flatpak "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak")
    fi
    local inst app info exts short
    local -a apps=()

    # <GL|GL32>: does this instance hold a still-deployed nvidia extension?
    gl_live() {
        local commit r d
        commit=$(printf '%s\n' "$exts" | sed -n "s/^org\.freedesktop\.Platform\.$1\.${ext}=//p" | head -1)
        [ -n "$commit" ] || return 1
        for r in "${roots[@]}"; do
            for d in "${r}/runtime/org.freedesktop.Platform.$1.${ext}"/*/*/"${commit}"; do
                [ -d "$d" ] && return 0
            done
        done
        return 1
    }

    while IFS=$'\t' read -r inst app; do
        info="${run}/${inst}/info"
        [ -r "$info" ] || continue
        exts=$(sed -n 's/^\(runtime\|app\)-extensions=//p' "$info" | tr ';' '\n')
        # Only apps on a runtime with the GL extension point: freedesktop,
        # and GNOME and KDE, which reuse it.
        grep -q '^org\.freedesktop\.Platform\.GL\.default=' <<<"$exts" || continue
        if gl_live GL; then
            grep -q '^org\.freedesktop\.Platform\.GL32\.default=' <<<"$exts" || continue
            gl_live GL32 && continue
            [ "$gl32_installed" = 1 ] || { need_gl32=1; continue; }
        fi
        FGL_IDS+="${inst} "
        short=${app##*.}
        case " ${apps[*]-} " in *" ${short} "*) ;; *) apps+=("$short") ;; esac
    done < <(flatpak ps --columns=instance,application 2>/dev/null || true)

    if [ ${#apps[@]} -gt 0 ]; then
        FGL_STATUS=stale
        FGL_APPS=$(printf '%s\n' "${apps[@]}" | paste -sd, - | sed 's/,/, /g')
    elif [ "$need_gl32" = 1 ]; then
        FGL_STATUS=missing
    else
        FGL_STATUS=ok
    fi
}

check_flatpak_gl() {
    flatpak_gl_scan
    case "$FGL_STATUS" in
        skip) return 0 ;;
        missing)
            record flatpak-gl warn "Flatpak GL driver for nvidia ${FGL_DRIVER} is missing or incomplete; Flatpak games run on the wrong GPU" \
                   "sudo systemctl start pulsar-gl-nvidia.service" ;;
        stale)
            record flatpak-gl warn "${FGL_APPS} started without the NVIDIA ${FGL_DRIVER} driver" \
                   "quit fully and reopen; until then its games get the iGPU and can show a black window" ;;
        ok)
            record flatpak-gl ok "running Flatpak apps have the NVIDIA ${FGL_DRIVER} driver" ;;
    esac
}

# GPU containers: `podman run --device nvidia.com/gpu=all` resolves through a
# CDI spec, and a spec names every driver library by its full version
# (libcuda.so.615.71.09). One written for another driver still parses, still
# resolves, and then fails inside the container on files that are not there
# -- so "a spec exists" is not the check; "a spec for THIS driver" is.
#
# nvidia-cdi-refresh.service writes /var/run/cdi/nvidia.yaml every boot, and
# /var/run is tmpfs, so that one cannot go stale. The stale one is the spec a
# how-to told someone to write by hand into /etc/cdi: it survives every
# driver bump after it. Every nvidia spec in podman's search path is read.
#
# The version comes from the enable-cuda-compat hook's --host-driver-version,
# falling back to the libcuda soname. Paths are overridable for the tests;
# /sys and /proc are read directly for the reason check_nvidia gives.
check_gpu_containers() {
    local variant; variant=$(mf variant)
    case "$variant" in *nvidia*) ;; *) return 0 ;; esac
    # An image from before the toolkit shipped: nothing promised, say nothing.
    local ctk=${PULSAR_NVIDIA_CTK:-/usr/bin/nvidia-ctk}
    [ -x "$ctk" ] || return 0
    local running
    running=$(cat "${PULSAR_NVIDIA_VERSION_FILE:-/sys/module/nvidia/version}" 2>/dev/null) || true
    # No module is check_nvidia's failure to report; a second line saying
    # the same thing louder is noise.
    [ -n "$running" ] || return 0

    local dirs=${PULSAR_CDI_DIRS:-/etc/cdi /var/run/cdi}
    local d f v found=0 stale=""
    for d in $dirs; do
        for f in "$d"/*.yaml "$d"/*.json; do
            [ -f "$f" ] || continue
            grep -q 'nvidia.com/gpu' "$f" 2>/dev/null || continue
            found=$((found + 1))
            v=$(grep -o -m1 -e '--host-driver-version=[0-9.]*' "$f" 2>/dev/null | cut -d= -f2) || true
            [ -n "$v" ] || v=$(grep -o -m1 -e 'libcuda\.so\.[0-9][0-9.]*[0-9]' "$f" 2>/dev/null \
                               | sed 's/^libcuda\.so\.//') || true
            if [ "$v" != "$running" ]; then
                stale="${stale:+${stale}, }${f} (${v:-no driver version})"
            fi
        done
    done

    local sebool=${PULSAR_SELINUX_BOOLEANS:-/sys/fs/selinux/booleans}/container_use_xserver_devices
    if [ "$found" -eq 0 ]; then
        record gpu-containers warn "no CDI spec, so containers cannot be given the GPU" \
               "sudo systemctl restart nvidia-cdi-refresh.service; journalctl -b -u nvidia-cdi-refresh.service"
    elif [ -n "$stale" ]; then
        record gpu-containers warn "stale CDI spec for driver ${running}: ${stale}" \
               "the boot unit owns /var/run/cdi; a hand-written spec in /etc/cdi goes stale on every driver bump -- delete it"
    elif [ -r "$sebool" ] && [ "$(cut -d' ' -f1 "$sebool" 2>/dev/null)" = 0 ]; then
        record gpu-containers warn "CDI spec matches ${running}, but SELinux blocks containers from the GPU" \
               "container_use_xserver_devices is off: systemctl status pulsar-gpu-containers.service"
    else
        record gpu-containers ok "CDI spec matches driver ${running}" \
               "podman run --rm --device nvidia.com/gpu=all IMAGE"
    fi
}

check_flathub() {
    have flatpak || { record flathub warn "flatpak is not installed"; return; }
    local opts
    # `|| true`: under pipefail a failing flatpak here aborted the whole
    # doctor, and --json printed nothing at all.
    opts=$(flatpak remotes --columns=name,options 2>/dev/null | awk '$1=="flathub"{ $1=""; print }') || true
    if [ -z "$opts" ]; then
        record flathub warn "flathub remote is not configured"
    elif grep -q filter <<<"$opts"; then
        # Fedora ships a filtered flathub; the whole point of the shipped
        # remotes.d file is that this system does not.
        record flathub warn "flathub is FILTERED" "most applications will be hidden"
    else
        record flathub ok "flathub present and unfiltered"
    fi
}

# The other half of the app set. /usr/share/pulsar/flatpaks.list installs the
# stock Silverblue desktop from Fedora's `fedora` OCI remote, so a system
# without that remote cannot finish first-boot app setup at all:
# pulsar-flatpaks.service fails every fedora-remote app, the success-only
# stamp never lands, and Restart=on-failure retries every 120s indefinitely --
# the same shape as the cherenkov batch failure, minus anything on screen that
# says so. Worth a check precisely because the symptom is silence.
#
# Matched on the name alone rather than by rebuilding the options column the
# way check_flathub does. `fedora-testing` is a real remote on some systems
# and an exact match is the only thing that does not read it as this one.
check_fedora() {
    # flatpak's absence is check_flathub's finding to report; saying it twice
    # in one run is noise, not two findings.
    have flatpak || return 0
    if flatpak remotes --columns=name 2>/dev/null | grep -Fxq fedora; then
        record fedora ok "fedora remote present"
    else
        record fedora warn "fedora remote is not configured" \
               "the stock Silverblue apps cannot install; it ships at /etc/flatpak/remotes.d/fedora.flatpakrepo"
    fi
}

# What "locally modified" means, spelled once. These are the origin keys that
# `rpm-ostree install` and `rpm-ostree override` write, counted on the BOOTED
# deployment; a missing key is null and `null | length` is 0, so absent and
# empty need no separate handling. Two readers depend on this answer -- doctor
# reports it, update routes on it -- and two copies of the list would drift
# into disagreeing about the same system.
JQ_LAYERED='[ .deployments[]? | select(.booted == true) |
   ( ."requested-packages", ."requested-local-packages",
     ."requested-local-fileoverride-packages", ."requested-base-removals",
     ."requested-base-local-replacements", ."requested-modules" ) ]
 | map(length) | add // 0'

# An origin that names a DIGEST has nowhere to go: upgrading it re-pulls the
# image it is already on. Every ISO built before 2026-09-25 installed exactly
# that, because bib switches the new system onto the ref it was handed and
# build-iso.sh hands it a digest (iso-config.toml's %post now undoes it). So a
# pinned origin is a machine that will never update, and `update --check`
# comparing the digest with itself would call it up to date forever.
#
# Given `rpm-ostree status --json`, prints the command that points the booted
# deployment back at :latest, or nothing when it already follows a tag. The
# transport prefix is kept as found, so a signed origin stays signed. Three
# readers share this -- doctor, update, update --check -- so it is spelled once.
pinned_origin_fix() {
    local origin
    origin=$(printf '%s' "$1" | jq -r '[ .deployments[]? | select(.booted == true) ][0]
        | ."container-image-reference" // ""' 2>/dev/null) || return 0
    case "$origin" in
        *@sha256:*) printf 'sudo rpm-ostree rebase %s:latest\n' "${origin%@sha256:*}" ;;
    esac
}

check_origin() {
    have rpm-ostree || return 0   # check_updates reports that
    local fix
    fix=$(pinned_origin_fix "$(rpm-ostree status --json 2>/dev/null || echo '{}')")
    if [ -n "$fix" ]; then
        record origin fail "this system follows one image digest, so it will never update" "fix: ${fix}"
    else
        record origin ok "not pinned to a digest"
    fi
}

check_updates() {
    have rpm-ostree || { record updates warn "rpm-ostree not available"; return; }
    local js line staged pinned total ver lay
    js=$(rpm-ostree status --json 2>/dev/null || echo '{}')
    # A failed read used to come out as "no update staged, 0 deployment(s)":
    # health nobody verified. A booted system always has at least one.
    if ! printf '%s' "$js" | jq -e '(.deployments // []) | length > 0' >/dev/null 2>&1; then
        record updates warn "could not read deployment status" "rpm-ostree status --json"
        return
    fi
    # one jq pass for all five numbers, not five passes over the same JSON
    line=$(printf '%s' "$js" | jq -r '
      [ ([.deployments[]? | select(.staged == true)] | length),
        ([.deployments[]? | select(.pinned == true)] | length),
        (.deployments // [] | length),
        ([.deployments[]? | select(.staged == true) | .version][0] // "?"),
        ('"$JQ_LAYERED"')
      ] | map(tostring) | join("\t")' 2>/dev/null) || line=''
    [ -n "$line" ] || line=$(printf '0\t0\t0\t?\t0')
    IFS=$'\t' read -r staged pinned total ver lay <<<"$line"
    local detail="${total} deployment(s), ${pinned} pinned"
    # Worth surfacing even when everything is healthy: it changes which tool
    # `pulsar update` runs, and it is the reason an update takes minutes
    # instead of seconds.
    [ "${lay:-0}" -gt 0 ] && detail="${detail}, ${lay} layered -- updates go through rpm-ostree"
    if [ "${staged:-0}" -gt 0 ]; then
        record updates ok "update staged: ${ver}" "reboot to apply"
    else
        record updates ok "no update staged" "$detail"
    fi
}

# The Pulsar code editor (the Atom fork) also ships a command called
# `pulsar`. As a Flatpak -- the normal way on this OS -- it exports only its
# app id and nothing collides. Its RPM writes /usr/bin/pulsar itself, and its
# AppImage is often linked into ~/.local/bin/pulsar, which sits earlier on PATH.
# Either way "pulsar doctor" quietly opens an editor, and an agent told by
# AGENTS.md to run `pulsar doctor --json` reads whatever that prints. Units call
# /usr/bin/pulsar by absolute path, so only an overwrite breaks them.
PULSAR_SELF_MARK="# pulsar -- the front door to a Pulsar system."
check_cli() {
    local sys=${PULSAR_SYSTEM_CLI:-/usr/bin/pulsar} first
    if [ -e "$sys" ] && ! grep -qxF "$PULSAR_SELF_MARK" "$sys" 2>/dev/null; then
        record cli fail "${sys} is not the Pulsar CLI (a layered Pulsar editor RPM?)" \
               "the update checks call it; remove the package that replaced it (rpm-ostree status)"
        return
    fi
    first=$(command -v pulsar 2>/dev/null) || first=""
    if [ -n "$first" ] && [ "$first" != "$sys" ] && ! grep -qxF "$PULSAR_SELF_MARK" "$first" 2>/dev/null; then
        record cli warn "another 'pulsar' comes first on PATH: ${first}" \
               "probably the Pulsar code editor; typing 'pulsar' runs it. use ${sys}, or rename that one"
        return
    fi
    record cli ok "'pulsar' is this system's CLI"
}

check_disk() {
    local root=/sysroot df=${PULSAR_DF:-df}
    [ -d "$root" ] || root=/
    local pct avail
    pct=$("$df" --output=pcent "$root" 2>/dev/null | tail -1 | tr -dc '0-9') || true
    avail=$("$df" -h --output=avail "$root" 2>/dev/null | tail -1 | tr -d ' ') || true
    [ -n "$pct" ] || { record disk warn "could not read disk usage for ${root}"; return; }
    # A bootc system needs room to stage a whole new image. Under ~10GB free
    # an upgrade starts failing in ways that look like network errors.
    if [ "$pct" -ge 90 ]; then
        record disk fail "${root} is ${pct}% full (${avail} free)" "staging an update needs several GB"
    elif [ "$pct" -ge 80 ]; then
        record disk warn "${root} is ${pct}% full (${avail} free)"
    else
        record disk ok "${root} ${pct}% used, ${avail} free"
    fi
}

# Ids, in the order they run. Each is check_<id with - as _>, and each is
# the id its findings carry in --json.
DOCTOR_CHECKS='scheduler ntsync gamemode mangohud greenboot nvidia flatpak-gl gpu-containers flathub fedora origin updates disk crashes cli'

doctor_help() {
    cat <<EOF
usage: pulsar doctor [check...]      health checks; exit 1 if one fails
       pulsar doctor flatpak-gl --notify
                                     also notify the desktop, once per app
                                     instance, when a running Flatpak app
                                     lacks the NVIDIA driver (pulsar-gl-check)
       pulsar doctor crashes --notify
                                     also notify, once per program per boot,
                                     with a button that asks your agent about
                                     it (pulsar-crash-watch; only with an agent)

checks: ${DOCTOR_CHECKS}
--json gives {checks: [{id, status, summary, detail}], ok}. A check that
does not apply here reports nothing, or status "skip" when named.
EOF
}

cmd_doctor() {
    local notify=0 a c before
    local -a only=() run=()
    for a in "$@"; do
        case "$a" in
            -h|--help) doctor_help; return 0 ;;
            --notify) notify=1 ;;
            -*) die "unknown option: ${a} (see: pulsar doctor --help)" ;;
            *)
                case " ${DOCTOR_CHECKS} " in
                    *" ${a} "*) only+=("$a") ;;
                    *) die "no such check: ${a} (checks: ${DOCTOR_CHECKS})" ;;
                esac ;;
        esac
    done
    if [ "$notify" = 1 ]; then
        case "${only[*]-}" in
            flatpak-gl|crashes) ;;
            *) die "--notify goes with one check: pulsar doctor flatpak-gl --notify, or crashes --notify" ;;
        esac
    fi
    if [ ${#only[@]} -eq 0 ]; then
        read -ra run <<<"$DOCTOR_CHECKS"
        # the release (26.9.1) here, beside the nightly build it is running
        local rel; rel=$(mf release)
        [ "${JSON:-0}" = 1 ] || printf '%sPulsar health%s  %s%s\n\n' "$C_BOLD" "$C_RESET" \
            "${rel:+${rel} · build }" "$(mf version)"
    else
        run=("${only[@]}")
    fi
    for c in "${run[@]}"; do
        before=$RECORDED
        "check_${c//-/_}"
        # Named and silent: say so, rather than print nothing and exit 0.
        if [ ${#only[@]} -gt 0 ] && [ "$RECORDED" = "$before" ]; then
            if [ "${JSON:-0}" = 1 ]; then
                CHECK_JSON+=$(jq -n -c --arg i "$c" '{id:$i, status:"skip", summary:"does not apply on this machine", detail:""}'),
            else
                printf 'skip  %-14s does not apply on this machine\n' "$c"
            fi
        fi
    done
    [ "$notify" = 0 ] || "${only[0]//-/_}_notify"
    if [ "${JSON:-0}" = 1 ]; then
        printf '{"checks":[%s],"ok":%s}\n' "${CHECK_JSON%,}" "$([ "$RC" -eq 0 ] && echo true || echo false)"
    elif [ ${#only[@]} -eq 0 ]; then
        printf '\n'
        [ "$RC" -eq 0 ] && printf '%sno failures%s\n' "$C_OK" "$C_RESET" \
                        || printf '%sone or more checks failed%s\n' "$C_FAIL" "$C_RESET"
    fi
    return "$RC"
}

# ---------------------------------------------------------------------------
# status / manifest
# ---------------------------------------------------------------------------
# The fields of `rpm-ostree status --json` that matter, and the only shape
# Pulsar hands out: `status --json` and `report` both use it.
STATUS_JQ='{ deployments: [ .deployments[]? | with_entries(select(.key | IN(
    "booted", "staged", "pinned", "version", "timestamp", "checksum",
    "container-image-reference", "container-image-reference-digest",
    "requested-packages", "requested-local-packages",
    "requested-base-removals", "requested-base-local-replacements"))) ] }'

cmd_status() {
    need rpm-ostree
    local js; js=$(rpm-ostree status --json 2>/dev/null) || die "could not read deployment status"
    if [ "${JSON:-0}" = 1 ]; then printf '%s' "$js" | jq "$STATUS_JQ"; return 0; fi
    # The image reference sheds its whole transport prefix -- a single strip
    # left "docker://" behind on "ostree-image-signed:docker://ghcr.io/...".
    local tsv
    tsv=$(printf '%s' "$js" | jq -r '
      .deployments[]? |
      (if .booted then "booted" elif .staged then "staged" else "-" end) + "\t"
      + (.version // "?") + "\t"
      + ((."container-image-reference" // .origin // "?") | sub("^([a-z-]+:)+(//)?"; "")) + "\t"
      + (if .pinned then "yes" else "no" end)')
    [ -n "$tsv" ] || { printf 'no deployments reported\n'; return 0; }

    # Columns measured from the data, like the manifest. The image reference
    # is the elastic column: truncated only when a real terminal is too
    # narrow to hold it -- a hardcoded 42 was cutting the tag off refs on
    # terminals with a hundred columns to spare -- and a pipe always gets
    # the full reference.
    local verw=7 imgw=5 state ver img pin
    while IFS=$'\t' read -r state ver img pin; do
        [ "${#ver}" -gt "$verw" ] && verw=${#ver}
        [ "${#img}" -gt "$imgw" ] && imgw=${#img}
    done <<<"$tsv"
    local cols=0 max=0
    [ -n "$C_RESET" ] && cols=$(tput cols 2>/dev/null || echo 0)
    if [ "$cols" -gt 0 ]; then
        max=$((cols - 8 - 1 - verw - 1 - 1 - 6))   # state, gaps, version, pinned
        if [ "$max" -ge 12 ] && [ "$imgw" -gt "$max" ]; then imgw=$max; else max=0; fi
    fi

    printf '%s%-8s %-*s %-*s %s%s\n' "$C_BOLD" "STATE" "$verw" "VERSION" "$imgw" "IMAGE" "PINNED" "$C_RESET"
    while IFS=$'\t' read -r state ver img pin; do
        if [ "$max" -gt 0 ] && [ "${#img}" -gt "$max" ]; then
            img="${img:0:max-3}..."
        fi
        printf '%-8s %-*s %-*s %s\n' "$state" "$verw" "$ver" "$imgw" "$img" "$pin"
    done <<<"$tsv"
}

# ---------------------------------------------------------------------------
# The machine, as opposed to the image. This is fastfetch's half of the
# readout, and it follows fastfetch's rule: everything is read at run time and
# every row is OPTIONAL. A VM with no DMI table, a tty with no session, a
# build container with no /sys -- each drops its row rather than printing a
# question mark, because a manifest full of "?" reads like a broken command
# instead of an honest one. Nothing below may fail `manifest`: every reader
# returns non-zero instead of dying, and its caller skips it.
#
# The readers return RAW values and the formatting lives in host_rows, for the
# same reason the manifest rows leave jq untouched: `--json` needs the number,
# the terminal needs "8.1 GiB / 62.2 GiB", and a reader that only knows how to
# produce the second cannot serve the first.
# ---------------------------------------------------------------------------

# Vendors disagree about which DMI field holds the name a human would use.
# Lenovo puts the marketing name in product_version and a model code ("83F5")
# in product_name; Dell does the reverse and parks "Not Specified" in version.
# Trying them in this order, with the known placeholder strings filtered, gets
# both right without special-casing either vendor.
dmi_model() {
    local f v
    for f in product_version product_family product_name; do
        v=$(cat "/sys/devices/virtual/dmi/id/$f" 2>/dev/null) || continue
        case "$v" in
            ""|None|"To Be Filled By O.E.M."|"System Product Name"|\
            "Default string"|"Not Specified"|"Not Applicable"|"INVALID") continue ;;
        esac
        printf '%s\n' "$v"; return 0
    done
    return 1
}

# "Intel(R) Core(TM) Ultra 9 275HX" is the string the kernel exports; the
# trademark noise is not information.
cpu_name() {
    local m
    m=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo 2>/dev/null | head -1)
    [ -n "$m" ] || return 1
    m=${m//(R)/}; m=${m//(TM)/}; m=${m//(tm)/}; m=${m//(C)/}
    m=$(printf '%s' "$m" | tr -s ' '); m=${m# }; m=${m% }
    printf '%s\n' "$m"
}

# Threads rather than cores: nproc is what schedulers and gamescope see.
cpu_threads() { nproc 2>/dev/null || return 1; }

# One row per display-class PCI device, in bus order, the way fastfetch prints
# a GPU line each. 3D-controller class is included on purpose: on most hybrid
# laptops the discrete card enumerates as 0302, not 0300, and filtering to VGA
# alone hides the card the user bought this image for. Without pciutils the
# vendor:device pair still goes out -- it is enough to look up, and better
# than silence.
gpu_names() {
    local line d found=1
    if have lspci; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            # "GB203M / GN22-X9 [GeForce RTX 5080 Max-Q]" -> the bracketed
            # marketing name, which is the half anyone recognises.
            case "$d" in *'['*']'*) d=${d##*[}; d=${d%%]*} ;; esac
            printf '%s\n' "$d"; found=0
        done < <(lspci -mm 2>/dev/null | awk -F'"' \
            '$2 ~ /VGA compatible controller|3D controller|Display controller/ { print $6 }')
    else
        for line in /sys/bus/pci/devices/*; do
            case "$(cat "$line/class" 2>/dev/null)" in
                0x03*) printf '%s:%s\n' \
                    "$(cat "$line/vendor" 2>/dev/null)" \
                    "$(cat "$line/device" 2>/dev/null)"; found=0 ;;
            esac
        done
    fi
    return "$found"
}

gib() { awk -v k="$1" 'BEGIN { printf "%.1f GiB\n", k / 1048576 }'; }

# "used total", in kB, as /proc/meminfo reports them. "Used" is total minus
# MemAvailable rather than minus MemFree: cache and reclaimable slab are not
# memory you have lost, and MemFree alone makes every healthy Linux box look
# full. MemAvailable predates every kernel this image can boot, but if it is
# somehow missing, used goes out as "-" rather than as a fabricated number.
mem_kb() {
    local total avail
    total=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null) || return 1
    [ -n "$total" ] || return 1
    avail=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo 2>/dev/null)
    if [ -n "$avail" ]; then printf '%s %s\n' "$((total - avail))" "$total"
    else                     printf -- '- %s\n' "$total"; fi
}

# Used / total, fastfetch's form.
mem_used_total() {
    local used total
    read -r used total < <(mem_kb) || return 1
    [ -n "$total" ] || return 1
    if [ "$used" = "-" ]; then gib "$total"
    else printf '%s / %s\n' "$(gib "$used")" "$(gib "$total")"; fi
}

# XDG_CURRENT_DESKTOP is a colon-separated list on derivative desktops
# ("pop:GNOME"); the last entry is the real one. Both variables are absent
# under sudo and on a tty, which is exactly when this row should not print.
session_desc() {
    local de=${XDG_CURRENT_DESKTOP:-} ty=${XDG_SESSION_TYPE:-}
    de=${de##*:}
    if   [ -n "$de" ] && [ -n "$ty" ]; then printf '%s (%s)\n' "$de" "$ty"
    elif [ -n "$de" ];                 then printf '%s\n' "$de"
    elif [ -n "$ty" ];                 then printf '%s\n' "$ty"
    else return 1; fi
}

uptime_s() {
    local s
    read -r s _ < /proc/uptime 2>/dev/null || return 1
    s=${s%.*}
    [ -n "$s" ] || return 1
    printf '%s\n' "$s"
}

# Coarse on purpose: this answers "did you reboot after the update?", and
# seconds of precision would only make the row noisier. --json gets the
# integer instead, because a machine should not have to parse "2h 14m".
uptime_desc() {
    local s d h m
    s=$(uptime_s) || return 1
    d=$((s / 86400)); h=$(((s % 86400) / 3600)); m=$(((s % 3600) / 60))
    if   [ "$d" -gt 0 ]; then printf '%dd %dh\n' "$d" "$h"
    elif [ "$h" -gt 0 ]; then printf '%dh %dm\n' "$h" "$m"
    else                      printf '%dm\n' "$m"; fi
}

# key<TAB>value rows for whatever this machine will admit to.
host_rows() {
    local v c n
    if v=$(dmi_model); then printf 'host\t%s\n' "$v"; fi
    if c=$(cpu_name); then
        if n=$(cpu_threads); then c="$c ($n threads)"; fi
        printf 'cpu\t%s\n' "$c"
    fi
    while IFS= read -r v; do
        if [ -n "$v" ]; then printf 'gpu\t%s\n' "$v"; fi
    done < <(gpu_names || true)
    if v=$(mem_used_total); then printf 'memory\t%s\n' "$v"; fi
    if v=$(session_desc);   then printf 'session\t%s\n' "$v"; fi
    if v=$(uptime_desc);    then printf 'uptime\t%s\n' "$v"; fi
    return 0
}

# The same facts as data. Raw numbers, not the terminal's formatting, and
# absent fields OMITTED rather than null -- the rows drop, so the keys drop
# too, and a consumer can test presence instead of testing for null.
#
# Everything lands under one "host" key so `jq 'del(.host)'` gives back the
# baked manifest: two machines on the same build still compare equal, which
# was the whole reason this was not merged in at the top level.
host_json() {
    local model cpu threads gpus used total de ty up
    model=$(dmi_model)   || model=""
    cpu=$(cpu_name)      || cpu=""
    threads=$(cpu_threads) || threads=""
    gpus=$(gpu_names | jq -R -s 'split("\n") | map(select(length > 0))') || gpus="[]"
    read -r used total < <(mem_kb) || { used="-"; total=""; }
    [ "$used" = "-" ] && used=""
    de=${XDG_CURRENT_DESKTOP:-}; de=${de##*:}
    ty=${XDG_SESSION_TYPE:-}
    up=$(uptime_s) || up=""

    jq -n --arg model "$model" --arg cpu "$cpu" --arg de "$de" --arg ty "$ty" \
          --argjson gpu "$gpus" \
          --argjson threads "${threads:-null}" \
          --argjson used "${used:-null}" \
          --argjson total "${total:-null}" \
          --argjson up "${up:-null}" '
      def prune: with_entries(select(
          .value != null and .value != "" and .value != [] and .value != {}));
      {
        model:       $model,
        cpu:         $cpu,
        cpu_threads: $threads,
        gpu:         $gpu,
        memory:      ({ used_bytes:  (if $used  == null then null else $used  * 1024 end),
                        total_bytes: (if $total == null then null else $total * 1024 end)
                      } | prune),
        session:     ({ desktop: $de, type: $ty } | prune),
        uptime_s:    $up
      } | prune
    '
}

cmd_manifest() {
    [ -r "$MANIFEST" ] || die "no manifest at ${MANIFEST} (image predates it, or was built without one)"
    if [ "${JSON:-0}" = 1 ]; then
        # The baked document plus one key, so the JSON says what the rows say.
        # A machine that can tell us nothing about itself gets no host key at
        # all rather than an empty object to special-case.
        local hj; hj=$(host_json)
        if [ -z "$hj" ] || [ "$hj" = "{}" ]; then
            cat "$MANIFEST"
        else
            jq --argjson host "$hj" '. + { host: $host }' "$MANIFEST" \
                || die "manifest at ${MANIFEST} is not valid JSON"
        fi
        return 0
    fi
    # Rows leave jq as key<TAB>value, unpadded and uncolored: widths, color,
    # and wrapping are terminal concerns, and bash is the only side that
    # knows the terminal. (Escapes hardcoded in the jq program once meant
    # `pulsar manifest | cat` emitted raw control codes.)
    # Split in two so the machine rows can be spliced between them: what this
    # image IS, what it is running ON, then what is INSIDE it.
    #
    # Every row here is a FACT. There were once two that were not: `sbom` and
    # `attestation`, whose values were other commands to go and run. The
    # attestation one made the cost obvious -- the baked `gh attestation
    # verify ...` line is 82 characters, three times the next longest row, and
    # it dragged the readout's right edge out past the art to say something
    # `pulsar --help` already says. A manifest is an inventory, not a menu.
    # Both commands still exist (`pulsar sbom`, `pulsar attest`); they are
    # listed where commands are listed.
    local head rest tsv
    head=$(jq -r '
      [ ["image",   (.image // "?") + (if .variant then " (" + .variant + ")" else "" end)],
        (if .release then ["release", .release] else empty end),
        ["build",   (.version // "?")],
        ["base",    (.base // "?")],
        ["built",   (.built // "?")],
        ["kernel",  (.kernel // "?")]
      ] | .[] | .[0] + "\t" + .[1]
    ' "$MANIFEST") || die "manifest at ${MANIFEST} is not valid JSON"
    rest=$(jq -r '
      ((.components // {}) | to_entries | map([.key, (.value | tostring)]))
      | .[] | .[0] + "\t" + .[1]
    ' "$MANIFEST") || die "manifest at ${MANIFEST} is not valid JSON"

    tsv=$head
    local hr; hr=$(host_rows)
    if [ -n "$hr" ];   then tsv=$(printf '%s\n%s' "$tsv" "$hr"); fi
    if [ -n "$rest" ]; then tsv=$(printf '%s\n%s' "$tsv" "$rest"); fi

    # The key column is measured, never guessed. A fixed width of 11 already
    # ran "attestation" into its value once; components come from the
    # manifest, so the longest key is whatever the image happened to ship.
    local keyw=0 k v
    while IFS=$'\t' read -r k v; do
        [ "${#k}" -gt "$keyw" ] && keyw=${#k}
    done <<<"$tsv"

    # Fit against the REAL terminal, not a magic minimum. The art is drawn
    # only when it leaves the values a usable column, and values wrap inside
    # their column -- the terminal's own wrap restarts at column zero, which
    # shears the art and the table both (seen in the field at 72 columns:
    # every long value snapped its row in half). An explicit --logo skips the
    # fit check; asking twice means wanting it regardless. cols=0 (no tty,
    # tput failure) disables wrapping entirely -- pipes do not wrap.
    local cols=0 artw=0 avail=0
    [ -n "$C_RESET" ] && cols=$(tput cols 2>/dev/null || echo 0)
    if want_logo; then
        artw=$(logo_width)
        if [ "$cols" -gt 0 ] && [ "${LOGO:-auto}" != always ] && \
           [ $((cols - artw - 2 - keyw - 2)) -lt 24 ]; then
            artw=0    # art at the price of the information is the wrong trade
        fi
    fi
    if [ "$cols" -gt 0 ]; then
        avail=$((cols - keyw - 2))
        [ "$artw" -gt 0 ] && avail=$((avail - artw - 2))
        [ "$avail" -lt 16 ] && avail=0   # too narrow to wrap sensibly
    fi

    local rows
    rows=$(format_rows "$keyw" "$avail" <<<"$tsv")
    if [ "$artw" -gt 0 ]; then paste_logo "$rows"; else printf '%s\n' "$rows"; fi
    swatches
}

# key<TAB>value rows in, colored lines out: the key padded into its column,
# the value word-wrapped to $2 columns with continuations indented under the
# value column. avail=0 wraps nothing. A single word longer than the column
# (an oci:// reference) is left whole -- a word broken to fit is worse than
# one the terminal wraps.
format_rows() {
    local keyw=$1 avail=$2 k v line word i
    while IFS=$'\t' read -r k v; do
        local -a words=() parts=()
        if [ "$avail" -gt 0 ]; then
            read -ra words <<<"$v"
            line=""
            for word in "${words[@]}"; do
                if [ -z "$line" ]; then line=$word
                elif [ $(( ${#line} + 1 + ${#word} )) -le "$avail" ]; then line="$line $word"
                else parts+=("$line"); line=$word; fi
            done
            parts+=("$line")
        else
            parts=("$v")
        fi
        printf '%s%-*s%s%s\n' "$C_KEY" $((keyw + 2)) "$k" "$C_RESET" "${parts[0]}"
        for ((i = 1; i < ${#parts[@]}; i++)); do
            printf '%*s%s\n' $((keyw + 2)) '' "${parts[i]}"
        done
    done
}

# The mark as ASCII, rendered from assets/brand/svg/pulsar-mark-small.svg by
# scripts/render-ascii-logo.py and shipped at /usr/share/pulsar/logo.ansi.
# Generated so it cannot drift from the artwork -- see that script for why
# hand-drawing it failed.
#
# Every line carries exactly the same number of visible characters, so pasting
# a second column beside it needs no width arithmetic -- and because the ramp
# is 7-bit, one character is one byte and `${#s}` is honest in any locale.
LOGO_FILE=${PULSAR_LOGO:-${PULSAR_LOGO_DIR:-/usr/share/pulsar}/logo.ansi}

# fastfetch's shape: art on the left, readout on the right, and whichever
# column is shorter simply runs out. Suppressed when there is no terminal to
# draw on or no art to draw; whether the terminal is WIDE enough is decided
# in cmd_manifest, where the measured key column is known.
want_logo() {
    [ "${LOGO:-auto}" != "never" ] || return 1
    [ -r "$LOGO_FILE" ] || return 1
    [ "${LOGO:-auto}" = "always" ] || [ -n "$C_RESET" ]
}

# Measured from the art itself, with the escapes stripped: the file is
# generated, so hardcoding its width here would be a second source of truth
# that nothing keeps honest.
logo_width() {
    local first
    IFS= read -r first < "$LOGO_FILE" || true
    # ${#} rather than wc -c: paste_logo pads with ${#} too, and the two must
    # agree on what "width" means if a custom PULSAR_LOGO is ever not 7-bit
    first=$(printf '%s' "$first" | sed $'s/\033\[[0-9;]*m//g')
    printf '%s\n' "${#first}"
}

paste_logo() {
    local -a art=() info=()
    mapfile -t art < "$LOGO_FILE"
    mapfile -t info <<< "$1"
    # Measured from the art itself, with the escapes stripped: the file is
    # generated, so hardcoding its width here would be a second source of
    # truth that nothing keeps honest.
    local plain pad
    plain=$(printf '%s' "${art[0]:-}" | sed $'s/\033\[[0-9;]*m//g')
    printf -v pad '%*s' "${#plain}" ''
    local i n=${#art[@]} m=${#info[@]}
    [ "$m" -gt "$n" ] && n=$m
    for ((i = 0; i < n; i++)); do
        printf '%s  %s\n' "${art[i]-$pad}" "${info[i]-}"
    done
}

# The brand palette as terminal blocks, the way fastfetch closes its readout.
# This is the line that makes the one-pager's mock terminal a transcript rather
# than an illustration -- the page shows these swatches, so the real command
# has to as well. 24-bit colour, and only when we are on a terminal;
# `pulsar manifest --json` and piped output get nothing.
swatches() {
    [ -n "$C_RESET" ] || return 0
    local rgb
    printf '\n'
    for rgb in "11;14;26" "36;31;61" "62;203;255" "143;168;255" "75;63;212" "233;237;247"; do
        printf '\033[48;2;%sm   \033[0m' "$rgb"
    done
    printf '\n'
}

# ---------------------------------------------------------------------------
# Lifecycle. These mutate, so they need root. rollback, pin and unpin hand
# straight to the tool that owns the deployment; update has to pick one.
# ---------------------------------------------------------------------------
# update -- the same intent, through whichever tool can actually honour it.
#
# bootc's model is the container image and nothing else. It does not know that
# `rpm-ostree install 1password` added a layer on top of that image, so an
# upgrade through bootc does not carry the layer forward: the packages you
# installed are not in the deployment it stages. rpm-ostree does know, because
# it wrote the origin, and its upgrade re-pulls the same container image and
# re-applies the layer on top.
#
# So this asks the deployment which it is, rather than making the user
# remember. An unlayered system -- the shipped default -- still goes through
# bootc, which is the tool that owns it.
#
# Unreadable status is fatal rather than a guess. Guessing bootc on a layered
# system throws the layer away, and you find out at the next boot.
# ---------------------------------------------------------------------------
# `update --check` answers the question itself instead of handing it to bootc
# or rpm-ostree, and that is the entire reason it lives here.
#
# On a deployment with layered packages, `rpm-ostree upgrade --check` reports
# "No updates available" no matter what the registry holds. Its container
# query reads ostree.manifest-digest off the deployment's own commit, and the
# merge commit layering produces does not carry that key -- only the base
# commit underneath it does. The query fails, the transaction still reports
# success, and the result is a false negative. GNOME Software reaches the same
# dead end through the same AutomaticUpdateTrigger call, which is why a
# layered system can sit on a stale image for weeks with nothing on screen
# ever saying so.
#
# Nothing about the comparison is hard, and rpm-ostree hands over both halves
# unprivileged: container-image-reference-digest is the manifest the booted
# deployment was built from, and it stays correct under layering. So ask the
# registry what the tag resolves to now and compare. One HTTP round trip, no
# root, no daemon.
#
# Exit status IS the answer, because a timer reads it: 0 up to date (or the
# update is already staged), 10 an update is available, 1 the question could
# not be answered. `bootc upgrade --check` needs root even to read and would
# be wrong here anyway, so --check never routes there.
# ---------------------------------------------------------------------------
UPDATE_STATE=${PULSAR_UPDATE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/pulsar}

cmd_update_check() {
    local notify=0 f
    for f in "$@"; do
        case "$f" in
            --check)  ;;
            --notify) notify=1 ;;
            *) die "'update --check' takes no other flags (got: ${f})" ;;
        esac
    done

    need rpm-ostree; need jq; need skopeo
    local js; js=$(rpm-ostree status --json 2>/dev/null) \
        || die "could not read deployment status"

    local booted='[ .deployments[]? | select(.booted == true) ][0]'
    local ref local_digest local_version
    # Same whole-transport strip as `status`: a single sub() left "docker://"
    # behind on "ostree-image-signed:docker://ghcr.io/...".
    ref=$(printf '%s' "$js" | jq -r "${booted} | (.\"container-image-reference\" // \"\") | sub(\"^([a-z-]+:)+(//)?\"; \"\")")
    local_digest=$(printf '%s' "$js" | jq -r "${booted} | .\"container-image-reference-digest\" // \"\"")
    local_version=$(printf '%s' "$js" | jq -r "${booted} | .version // \"?\"")

    [ -n "$ref" ] || die "the booted deployment is not container-native; there is no registry to ask"
    [ -n "$local_digest" ] || die "rpm-ostree reports no image digest for the booted deployment"
    # Asking the registry what a digest points at always answers "itself".
    local fix; fix=$(pinned_origin_fix "$js")
    [ -z "$fix" ] || die "this system follows one image digest, so no update can ever arrive; run: ${fix}"

    local inspect
    inspect=$(skopeo inspect --no-tags "docker://${ref}" 2>/dev/null) \
        || die "could not reach ${ref} to ask what it points at now"
    local remote_digest remote_version
    remote_digest=$(printf '%s' "$inspect" | jq -r '.Digest // ""')
    remote_version=$(printf '%s' "$inspect" | jq -r '.Labels["org.opencontainers.image.version"] // "?"')
    [ -n "$remote_digest" ] || die "${ref} returned a manifest with no digest"

    # --json: one object whatever the answer; the exit code still carries it.
    check_json() {
        jq -n -c --arg s "$1" --arg b "$local_version" --arg l "$remote_version" --arg r "$ref" \
            '{status: $s, booted: $b, latest: $l, image: $r, staged: ($s == "staged")}'
    }

    if [ "$remote_digest" = "$local_digest" ]; then
        if [ "${JSON:-0}" = 1 ]; then check_json current; return 0; fi
        printf 'up to date: %s (%s)\n' "$local_version" "$ref"
        return 0
    fi

    # An update already fetched is not an update to nag about. Without this the
    # timer would keep announcing the thing sitting in slot 0 waiting to boot.
    local staged_digest
    staged_digest=$(printf '%s' "$js" | jq -r '[ .deployments[]? | select(.staged == true) ][0] | ."container-image-reference-digest" // ""')
    if [ "$staged_digest" = "$remote_digest" ]; then
        # Staged by the background unit or the Update button: the one thing
        # left is a restart, so that is what the notification offers.
        [ "$notify" = 0 ] || update_notify_once staged "$remote_digest" "$remote_version" "$local_version"
        if [ "${JSON:-0}" = 1 ]; then check_json staged; return 0; fi
        printf 'staged: %s -- reboot to apply\n' "$remote_version"
        return 0
    fi

    if [ "${JSON:-0}" = 1 ]; then
        check_json available
    else
        printf 'update available: %s -> %s\n' "$local_version" "$remote_version"
    fi

    [ "$notify" = 0 ] || update_notify_once available "$remote_digest" "$remote_version" "$local_version"
    return 10
}

# ---------------------------------------------------------------------------
# The update notifications, once per published build each.
#
# "available" offers an Update button, which starts pulsar-update-stage.service
# (no password for a local admin: 50-pulsar-update.rules). "staged" offers a
# Restart button, which opens GNOME's own restart dialog -- the user confirms
# there, and nothing here ever reboots.
#
# With background staging on, "available" waits a day first. The background
# unit will usually have staged the build by then, and the user hears about it
# once, as "ready", instead of twice. A build that is still not staged after a
# day -- a laptop that lives on battery, a metered connection -- gets the
# Update button after all.
# ---------------------------------------------------------------------------
UPDATE_AUTO_GRACE=${PULSAR_UPDATE_AUTO_GRACE:-86400}

update_auto_enabled() {
    have systemctl || return 1
    [ "$(systemctl is-enabled pulsar-update-auto.timer 2>/dev/null)" = enabled ]
}

# $1 kind (available|staged) $2 digest $3 new version $4 booted version
update_notify_once() {
    local kind=$1 digest=$2 version=$3 booted=$4 state_file seen=""
    # "notified-digest" is the file every earlier release wrote for the
    # available notice; keeping the name keeps an upgraded machine from
    # announcing the same build again.
    case "$kind" in
        available) state_file="${UPDATE_STATE}/notified-digest" ;;
        staged)    state_file="${UPDATE_STATE}/notified-staged-digest" ;;
    esac
    if [ -r "$state_file" ]; then seen=$(cat "$state_file"); fi
    [ "$seen" != "$digest" ] || return 0
    mkdir -p "$UPDATE_STATE"

    if [ "$kind" = available ] && update_auto_enabled; then
        local since="${UPDATE_STATE}/available-since" first="" now d=""
        now=$(date +%s)
        if [ -r "$since" ]; then read -r d first < "$since" || true; [ "${d:-}" = "$digest" ] || first=""; fi
        if [ -z "$first" ]; then
            printf '%s %s\n' "$digest" "$now" > "$since"
            return 0
        fi
        [ $((now - first)) -ge "$UPDATE_AUTO_GRACE" ] || return 0
    fi

    update_notify_send "$kind" "$digest" "$version" "$booted"
    printf '%s\n' "$digest" > "$state_file"
}

update_notify_send() {
    local kind=$1 digest=$2 version=$3 booted=$4 title body
    have notify-send || return 0
    if [ "$kind" = available ]; then
        title="Pulsar ${version} is available"
        body="You are on ${booted}. Update downloads it now, and it takes over when you restart."
    else
        title="Pulsar ${version} is ready"
        body="Restart to start using it. Nothing changes until you do."
    fi
    # The click has to outlive this oneshot unit, so the waiting notification
    # runs as a transient unit of its own, as crash_notify_one's does. Without
    # systemd-run it still says what to do, just without the button.
    if ! have systemd-run || { [ "$kind" = staged ] && ! have gnome-session-quit; }; then
        if [ "$kind" = available ]; then body="You are on ${booted} -- run 'sudo pulsar update'"
        else body="Restart to start using it."; fi
        notify-send --app-name="Pulsar" --icon=software-update-available "$title" "$body" || true
        return 0
    fi
    local script unit="pulsar-update-${kind}-${digest#sha256:}"
    unit=${unit:0:48}
    if [ "$kind" = available ]; then
        # A cancelled password prompt is the user saying no, not a failure.
        # After a stage, the check runs again and posts "ready" itself, so
        # there is one place that words it.
        # shellcheck disable=SC2016  # expanded by the transient unit's sh
        script='a=$(notify-send --app-name=Pulsar --icon=software-update-available --action=update=Update "$1" "$2") || exit 0
[ "$a" = update ] || exit 0
if err=$(systemctl start pulsar-update-stage.service 2>&1); then exec "$3" update --check --notify; fi
case "$err" in *[Aa]uthenticat*|*"Access denied"*|*[Cc]ancel*) exit 0 ;; esac
exec notify-send --app-name=Pulsar --icon=dialog-warning "Pulsar $4 could not be downloaded" "See why: journalctl -u pulsar-update-stage"'
    else
        # gnome-session-quit shows GNOME's restart dialog; the user confirms
        # there. This never reboots on its own.
        # shellcheck disable=SC2016
        script='a=$(notify-send --app-name=Pulsar --icon=software-update-available --action=restart=Restart "$1" "$2") || exit 0
[ "$a" = restart ] || exit 0
exec gnome-session-quit --reboot'
    fi
    systemd-run --user --collect --quiet --unit="$unit" \
        -- sh -c "$script" sh "$title" "$body" "$(realpath "$SELF")" "$version" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# update --background -- pulsar-update-auto.service's job: stage a newer image
# if there is one and now is a good time, and otherwise say in one line why
# not. Every "not now" exits 0; the next run asks again.
# ---------------------------------------------------------------------------
POWER_SUPPLY_DIR=${PULSAR_POWER_SUPPLY_DIR:-/sys/class/power_supply}

# Prints why not to stage right now, or nothing (and fails) if it is fine.
update_background_blocker() {
    # On battery: systemd's ConditionACPower reading. A machine with no AC
    # connector at all (most desktops report none) counts as plugged in; one
    # with connectors counts as on battery only when none of them is online.
    local d type connectors=0 online=0
    for d in "$POWER_SUPPLY_DIR"/*; do
        [ -r "$d/type" ] || continue
        type=$(cat "$d/type" 2>/dev/null) || continue
        case "$type" in Mains|USB*) ;; *) continue ;; esac
        [ "$(cat "$d/scope" 2>/dev/null)" = Device ] && continue
        connectors=$((connectors + 1))
        [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && online=1
    done
    if [ "$connectors" -gt 0 ] && [ "$online" = 0 ]; then
        echo "on battery power"; return 0
    fi
    # Metered: NetworkManager's own verdict for the primary connection.
    # 1 = yes, 3 = guessed yes (a phone hotspot); 0 unknown and 2/4 no.
    local m
    if have busctl && m=$(busctl get-property org.freedesktop.NetworkManager \
            /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered 2>/dev/null); then
        case "${m##* }" in 1|3) echo "the network connection is metered"; return 0 ;; esac
    fi
    return 1
}

update_background() {
    need_root "update --background"
    local why out rc=0
    if why=$(update_background_blocker); then
        printf 'pulsar: not staging now: %s\n' "$why"
        return 0
    fi
    out=$(JSON=1 cmd_update_check --check 2>&1) || rc=$?
    case "$rc" in
        0)  printf 'pulsar: nothing to stage: %s\n' "$(printf '%s' "$out" | jq -r '.status + " (" + .latest + ")"' 2>/dev/null || echo current)"
            return 0 ;;
        10) ;;
        *)  printf 'pulsar: not staging now: could not tell whether a newer image exists: %s\n' \
                "$(printf '%s' "$out" | sed $'s/\033\\[[0-9;]*m//g; s/^pulsar: //' | tail -1)"
            return 0 ;;
    esac
    printf 'pulsar: staging %s for the next boot\n' "$(printf '%s' "$out" | jq -r .latest 2>/dev/null)"
    cmd_update
}

update_help() {
    cat <<'EOF'
usage: sudo pulsar update [--apply]   fetch and stage the newest image; it
                                      takes effect on the next boot. --apply
                                      also reboots into it
       pulsar update --check          is a newer image published? no root.
                                      exit 0 up to date or already staged,
                                      10 available, 1 could not tell
         --notify                     with --check: a desktop notification,
                                      once per published build
         --json                       with --check: the answer as JSON
       sudo pulsar update --background
                                      stage a newer image if there is one,
                                      unless on battery or a metered
                                      connection. pulsar-update-auto.timer
                                      runs this; turn it off with
                                      sudo systemctl disable --now pulsar-update-auto.timer

Through bootc, or through rpm-ostree when packages are layered (bootc would
drop them). Other flags pass through to whichever of the two runs. Staging
changes nothing until the next boot, and nothing here reboots unless you
pass --apply.
EOF
}

cmd_update() {
    local arg check=0 notify=0 background=0
    for arg in "$@"; do
        case "$arg" in
            -h|--help) update_help; return 0 ;;
            --check) check=1 ;;
            --notify) notify=1 ;;
            --background) background=1 ;;
        esac
    done
    if [ "$background" = 1 ]; then
        [ "$#" -eq 1 ] || die "--background takes no other flags: sudo pulsar update --background"
        no_json update
        update_background
        return $?
    fi
    if [ "$check" = 1 ]; then
        cmd_update_check "$@" || return $?
        return 0
    fi
    [ "$notify" = 0 ] || die "--notify goes with --check: pulsar update --check --notify"
    no_json update

    need_root update
    local lay fix
    if have rpm-ostree; then
        # Refused rather than run: the upgrade would re-pull the same digest
        # and report success, which is how this went unnoticed.
        fix=$(pinned_origin_fix "$(rpm-ostree status --json 2>/dev/null || echo '{}')")
        [ -z "$fix" ] || die "this system follows one image digest, so there is nothing to upgrade to; run: ${fix}"
        lay=$(rpm-ostree status --json 2>/dev/null | jq -r "$JQ_LAYERED" 2>/dev/null) \
            || die "could not read deployment status; refusing to guess which upgrade path is right"
        [ -n "$lay" ] || die "could not read deployment status; refusing to guess which upgrade path is right"
    else
        lay=0   # nothing to layer with, so nothing can be layered
    fi

    if [ "$lay" -eq 0 ]; then
        need bootc
        exec bootc upgrade "$@"
    fi

    printf '%spulsar:%s %s local package modification(s) on this deployment -- upgrading through rpm-ostree so they survive\n' \
        "$C_KEY" "$C_RESET" "$lay" >&2
    need rpm-ostree
    # The flags pulsar documents are bootc's, and --apply has an exact
    # counterpart here. Everything else passes through verbatim and fails at
    # rpm-ostree if it does not exist there, which is the honest outcome --
    # better than a silently dropped flag.
    local f; local -a a=()
    for f in "$@"; do
        case "$f" in --apply) a+=(--reboot) ;; *) a+=("$f") ;; esac
    done
    exec rpm-ostree upgrade ${a[@]+"${a[@]}"}
}

# ---------------------------------------------------------------------------
# doctor flatpak-gl --notify -- the check on its own, for pulsar-gl-check.path
# to run every time flatpak changes something. A stale app is the one
# finding here worth interrupting someone for: the next game it launches is
# black, and nothing else says why.
#
# Notifies only on `stale`. A `missing` extension is pulsar-gl-nvidia.service's
# to install, and telling the user to restart Steam before it lands would
# get them a second Steam with the same problem. When it lands, flatpak
# touches its change marker, this runs again, and the scan reads `stale`.
# ---------------------------------------------------------------------------
# Runs after check_flatpak_gl, which leaves the scan's findings in FGL_*.
flatpak_gl_notify() {
    [ "$FGL_STATUS" = stale ] || return 0

    # Once per app instance, not once per run: flatpak touches its marker
    # several times per transaction, and every one of those runs would see the
    # same stale Steam. An instance id is fresh each time an app starts, so a
    # restarted Steam that is somehow stale again still gets its warning.
    local state_file="${UPDATE_STATE}/gl-notified" seen="" id fresh=0
    if [ -r "$state_file" ]; then seen=$(cat "$state_file"); fi
    for id in $FGL_IDS; do
        case " ${seen} " in *" ${id} "*) ;; *) fresh=1 ;; esac
    done
    [ "$fresh" = 1 ] || return 0
    if have notify-send; then
        notify-send --app-name="Pulsar" --icon=dialog-warning \
            "Restart ${FGL_APPS} to use the NVIDIA GPU" \
            "It started without the NVIDIA ${FGL_DRIVER} driver, so its games get the iGPU and can show a black window. Quit it fully and reopen it." \
            || true
    fi
    mkdir -p "$UPDATE_STATE" && printf '%s\n' "$FGL_IDS" > "$state_file"
}

# ---------------------------------------------------------------------------
# agent guide -- the machine's own briefing for a coding agent.
#
# One vendor-neutral file in the image, at a path that moves with every update,
# so the guide can never describe a system older than the one it ships in.
# This command is the discovery path that works for every agent, including the
# ones that read nothing on their own: "run `pulsar agent guide`" is one line
# to put in any prompt. The per-vendor pointers live in `agent add`, written
# only for the agent the user actually chose.
# ---------------------------------------------------------------------------
AGENTS_MD=${PULSAR_AGENTS_MD:-/usr/share/pulsar/AGENTS.md}

# ---------------------------------------------------------------------------
# agent add -- a coding agent CLI, in a toolbox, on demand.
#
# Nothing here runs until somebody asks for a named agent. The image installs
# no agent and favours none: the table below is the whole of the opinion, and
# every row uses the install its vendor documents (checked 2026-09-26), not a
# packaging of ours that would need maintaining.
#
# WHERE THINGS GO, and why each is where it is:
#
#   the runtime   node/npm or uv, inside the `agents` toolbox via its own
#                 passwordless sudo. That is container root, not host root:
#                 the image and the host's rpm database never see it.
#   the agent     $XDG_DATA_HOME/pulsar/agents, one npm/uv prefix, written as
#                 the user. It is in $HOME, which the box shares, so an
#                 upgrade or a removed box leaves it where it was.
#   the command   ~/.local/bin/<cli>, a shim that runs the agent in the box,
#                 so `claude` or `codex` works from any host terminal.
#
# Every agent goes through npm or uv even where the vendor ALSO offers a curl
# script, because those scripts install their own launcher at exactly
# ~/.local/bin/<cli> -- the path the shim needs -- and $HOME is shared, so
# running one inside the box would overwrite the shim from the host's point of
# view. npm is a documented method for all four npm-shipped agents, and uv is
# aider's own recommended installer.
#
# The toolbox is a TIDINESS boundary, not a security one. It shares $HOME, the
# session bus and (through flatpak-spawn) a way out to the host. What keeps an
# agent from breaking the OS is the OS: /usr is read-only, and every change
# to it becomes a NEW deployment with the old one still bootable -- including
# the `rpm-ostree install` that stock polkit lets a wheel desktop session run
# without a password. See docs/AGENTS-SAFETY.md.
# ---------------------------------------------------------------------------
AGENT_BOX=${PULSAR_AGENT_BOX:-agents}
AGENT_PREFIX=${PULSAR_AGENT_PREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/pulsar/agents}
AGENT_SHIMS=${PULSAR_AGENT_SHIMS:-$HOME/.local/bin}
SHIM_MARK="# pulsar-agent-shim"

# name <TAB> command <TAB> installer <TAB> package <TAB> prompt <TAB> description.
# prompt is how `agent ask` hands it a first message and stays interactive:
# arg (a positional prompt), i (-i), prefill (--prompt fills the box without
# sending), read (none: the report goes in with --read). Deliberately
# nothing Microsoft-owned: GitHub Copilot's CLI is a fine opt-in for anyone who
# wants it, but a row here is a default suggestion, and that is not one.
AGENTS_TABLE='claude	claude	npm	@anthropic-ai/claude-code	arg	Claude Code (Anthropic)
codex	codex	npm	@openai/codex	arg	Codex CLI (OpenAI)
gemini	gemini	npm	@google/gemini-cli	i	Gemini CLI (Google)
opencode	opencode	npm	opencode-ai	prefill	opencode (open source, any provider)
aider	aider	uv	aider-chat	read	aider (open source, any provider)'

# Loads one row into A_NAME A_BIN A_METHOD A_PKG A_PROMPT A_DESC; fails on an unknown name.
agent_row() {
    local line
    line=$(printf '%s\n' "$AGENTS_TABLE" | awk -F'\t' -v n="$1" '$1 == n') || true
    [ -n "$line" ] || return 1
    IFS=$'\t' read -r A_NAME A_BIN A_METHOD A_PKG A_PROMPT A_DESC <<<"$line"
}

agent_names() { printf '%s\n' "$AGENTS_TABLE" | cut -f1 | paste -sd' ' -; }

# Single-quoted for sh, whatever the path holds. The shim is a file other
# shells will parse long after this one has exited.
sq() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

box_exists() {
    toolbox list --containers 2>/dev/null | awk 'NR > 1 { print $2 }' | grep -Fxq "$AGENT_BOX"
}

in_box() { toolbox run -c "$AGENT_BOX" "$@"; }

# Ours means it carries the marker. Anything else at that path -- a native
# installer's launcher, a user's own wrapper -- is not ours to replace.
is_our_shim() { [ -f "$1" ] && grep -qxF "$SHIM_MARK" "$1" 2>/dev/null; }

# An install this recipe did not make: the vendor's own installer (Claude
# Code's install.sh puts a launcher at ~/.local/bin/claude), npm -g in some
# other prefix, a distro package. People install agents that way whatever
# the docs say, and it is a perfectly good way to run one, so it is
# SUPPORTED, not refused: this recipe will not install a second copy over it
# or remove it, but it still gives it the machine guide. Prints the path.
native_launcher() {
    local b=$1 shim="${AGENT_SHIMS}/$1" found
    if { [ -e "$shim" ] || [ -L "$shim" ]; } && ! is_our_shim "$shim"; then
        printf '%s\n' "$shim"; return 0
    fi
    found=$(command -v "$b" 2>/dev/null) || return 1
    [ "$found" != "$shim" ] || return 1
    printf '%s\n' "$found"
}

# Where each agent looks for machine-wide guidance of its own accord, and only
# where the file there would be one this recipe can OWN outright:
#
#   claude    ~/.claude/rules/*.md load in every project, need no import
#             approval, and a rules file is a file of its own -- unlike
#             ~/.claude/CLAUDE.md, which is the user's and which /memory edits.
#   codex     $CODEX_HOME/AGENTS.md is Codex's global instruction file.
#   opencode  ~/.config/opencode/AGENTS.md is opencode's global rules file.
#
# A symlink rather than a copy, so the guide follows the image through every
# update instead of freezing at the version that happened to be booted here.
# gemini gets a hint instead: its only global file is ~/.gemini/GEMINI.md, which
# `/memory add` writes to, and a link into read-only /usr would break that.
# aider reads nothing on its own, so its shim passes --read.
agent_context_path() {
    case "$1" in
        claude)   printf '%s\n' "$HOME/.claude/rules/pulsar.md" ;;
        codex)    printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/AGENTS.md" ;;
        opencode) printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/AGENTS.md" ;;
        *)        return 1 ;;
    esac
}

link_agent_context() {
    local target
    if ! target=$(agent_context_path "$A_NAME"); then
        case "$A_NAME" in
            gemini) printf 'to give it the machine guide, add this line to ~/.gemini/GEMINI.md:\n  @%s\n' "$AGENTS_MD" ;;
            aider)
                if [ "${1:-}" = native ]; then
                    printf 'to give it the machine guide, add this to ~/.aider.conf.yml:\n  read: %s\n' "$AGENTS_MD"
                else
                    printf 'the shim passes --read %s whenever the image has it, so aider starts with the machine guide\n' "$AGENTS_MD"
                fi ;;
        esac
        return 0
    fi
    [ -r "$AGENTS_MD" ] || {
        printf 'this image has no %s yet; after the next update, rerun this to link the guide\n' "$AGENTS_MD"
        return 0
    }
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$AGENTS_MD" ]; then
        printf 'machine guide already linked at %s\n' "$target"
    elif [ -e "$target" ] || [ -L "$target" ]; then
        # Never overwritten: it is the user's file, and a guide is not worth
        # losing someone's instructions over.
        printf '%s already exists; left alone. The machine guide is %s (or: pulsar agent guide)\n' \
            "$target" "$AGENTS_MD"
    else
        mkdir -p "$(dirname "$target")"
        ln -s "$AGENTS_MD" "$target"
        printf 'linked the machine guide at %s\n' "$target"
    fi
}

# Skills: /usr/share/pulsar/skills/<name>/SKILL.md, in the Agent Skills
# layout (a folder, a SKILL.md with name and description) that each of these
# reads from a folder of its own, per its docs. Linked one skill at a time,
# so a user's own skills beside them are never touched, and linked rather
# than copied so they follow the image. aider reads no skills.
SKILLS_DIR=${PULSAR_SKILLS:-/usr/share/pulsar/skills}

agent_skills_path() {
    case "$1" in
        claude)   printf '%s\n' "$HOME/.claude/skills" ;;
        codex)    printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/skills" ;;
        gemini)   printf '%s\n' "$HOME/.gemini/skills" ;;
        opencode) printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills" ;;
        *)        return 1 ;;
    esac
}

link_agent_skills() {
    local dir s target linked=""
    dir=$(agent_skills_path "$A_NAME") || return 0
    [ -d "$SKILLS_DIR" ] || return 0
    for s in "$SKILLS_DIR"/*/; do
        s=${s%/}
        [ -r "${s}/SKILL.md" ] || continue
        target="${dir}/$(basename "$s")"
        if [ -L "$target" ] && [ "$(readlink "$target")" = "$s" ]; then
            continue
        elif [ -e "$target" ] || [ -L "$target" ]; then
            printf '%s already exists; left alone\n' "$target"
            continue
        fi
        mkdir -p "$dir"
        ln -s "$s" "$target"
        linked+="${linked:+, }$(basename "$s")"
    done
    [ -z "$linked" ] || printf 'linked skills into %s: %s\n' "$dir" "$linked"
}

unlink_agent_skills() {
    local dir l
    dir=$(agent_skills_path "$A_NAME") || return 0
    [ -d "$dir" ] || return 0
    for l in "$dir"/*; do
        # only links into the image's skills, never the user's own
        [ -L "$l" ] || continue
        case "$(readlink "$l")" in "${SKILLS_DIR}"/*) rm -f "$l"; printf 'removed the skill link %s\n' "$l" ;; esac
    done
}

# ---------------------------------------------------------------------------
# mcp -- this machine's facts as MCP tools (scripts/pulsar-mcp). `agent add`
# registers it in each agent's own MCP config, as an entry named "pulsar"
# that is written only if none exists and removed only if it is ours.
#
# An agent in the agents toolbox cannot see /usr/bin/pulsar, so its entry
# starts the server on the host through flatpak-spawn; a native install runs
# on the host already.
# ---------------------------------------------------------------------------
MCP_TOOL=${PULSAR_MCP:-/usr/libexec/pulsar/pulsar-mcp}

cmd_mcp() {
    case "${1:-}" in
        -h|--help)
            printf 'usage: pulsar mcp   an MCP server on stdio: doctor, status, manifest, report, crashes,\n                    update_check, agent_status, theme_list/current/set, and the guide.\n                    pulsar agent add registers it with each agent. Nothing in it needs root.\n'
            return 0 ;;
    esac
    [ $# -eq 0 ] || die "'mcp' takes no arguments (it speaks MCP on stdin/stdout)"
    [ -r "$MCP_TOOL" ] || die "the MCP server is not staged in this image (${MCP_TOOL})"
    PULSAR_CLI=$(realpath "$SELF") PULSAR_AGENTS_MD="$AGENTS_MD" exec python3 "$MCP_TOOL"
}

# The command an agent's MCP entry runs, as a JSON array: host or box.
mcp_argv_json() {
    local cli
    cli=$(realpath "$SELF")
    if [ "${1:-}" = box ]; then
        jq -n -c --arg c "$cli" '["flatpak-spawn", "--host", $c, "mcp"]'
    else
        jq -n -c --arg c "$cli" '[$c, "mcp"]'
    fi
}

# A JSON config's .<path> gets our entry, only if it has none. Atomic.
json_add_entry() {
    local file=$1 path=$2 entry=$3 tmp
    mkdir -p "$(dirname "$file")"
    [ -s "$file" ] || printf '{}\n' > "$file"
    jq -e . "$file" >/dev/null 2>&1 || { printf '%s is not JSON; add the pulsar MCP server to it yourself\n' "$file"; return 0; }
    if jq -e "getpath(${path}) != null" "$file" >/dev/null; then
        printf '%s already has an MCP server named pulsar; left alone\n' "$file"; return 0
    fi
    tmp=$(mktemp "${file}.XXXXXX")
    jq --argjson e "$entry" "setpath(${path}; \$e)" "$file" > "$tmp" && chmod --reference="$file" "$tmp" && mv "$tmp" "$file"
    printf 'registered the pulsar MCP server in %s\n' "$file"
}

# ...and loses it, only if it is still the one we wrote.
json_remove_entry() {
    local file=$1 path=$2 tmp
    [ -f "$file" ] && jq -e . "$file" >/dev/null 2>&1 || return 0
    # ours: it runs pulsar with the argument "mcp" (in whichever shape the
    # agent's config spells a command)
    jq -e "getpath(${path}) | tostring | (contains(\"pulsar\") and contains(\"\\\"mcp\\\"\"))" "$file" >/dev/null 2>&1 || return 0
    tmp=$(mktemp "${file}.XXXXXX")
    jq "delpaths([${path}])" "$file" > "$tmp" && chmod --reference="$file" "$tmp" && mv "$tmp" "$file"
    printf 'removed the pulsar MCP server from %s\n' "$file"
}

register_mcp() {
    local where=${1:-box} argv cmd f
    [ -r "$MCP_TOOL" ] || return 0
    have jq || return 0
    argv=$(mcp_argv_json "$where")
    case "$A_NAME" in
        claude)
            json_add_entry "$HOME/.claude.json" '["mcpServers","pulsar"]' \
                "$(jq -n -c --argjson a "$argv" '{type: "stdio", command: $a[0], args: $a[1:]}')" ;;
        gemini)
            json_add_entry "$HOME/.gemini/settings.json" '["mcpServers","pulsar"]' \
                "$(jq -n -c --argjson a "$argv" '{command: $a[0], args: $a[1:]}')" ;;
        opencode)
            json_add_entry "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" '["mcp","pulsar"]' \
                "$(jq -n -c --argjson a "$argv" '{type: "local", command: $a, enabled: true}')" ;;
        codex)
            f="${CODEX_HOME:-$HOME/.codex}/config.toml"
            if [ -f "$f" ] && grep -q '^\[mcp_servers\.pulsar\]' "$f"; then
                printf '%s already has an MCP server named pulsar; left alone\n' "$f"; return 0
            fi
            mkdir -p "$(dirname "$f")"
            cmd=$(printf '%s' "$argv" | jq -r '.[0] | tojson')
            local gap="" rest
            [ ! -s "$f" ] || gap=$'\n'
            rest=$(printf '%s' "$argv" | jq -c '.[1:]')
            printf '%s# pulsar-mcp: written by pulsar agent add codex\n[mcp_servers.pulsar]\ncommand = %s\nargs = %s\n' \
                "$gap" "$cmd" "$rest" >> "$f"
            printf 'registered the pulsar MCP server in %s\n' "$f" ;;
    esac
}

unregister_mcp() {
    local f tmp
    case "$A_NAME" in
        claude)   json_remove_entry "$HOME/.claude.json" '["mcpServers","pulsar"]' ;;
        gemini)   json_remove_entry "$HOME/.gemini/settings.json" '["mcpServers","pulsar"]' ;;
        opencode) json_remove_entry "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" '["mcp","pulsar"]' ;;
        codex)
            f="${CODEX_HOME:-$HOME/.codex}/config.toml"
            [ -f "$f" ] && grep -q '^# pulsar-mcp: written by' "$f" || return 0
            tmp=$(mktemp "${f}.XXXXXX")
            # our comment line, the table header, and its keys up to the next table
            awk '/^# pulsar-mcp: written by/ { skip = 1; next }
                 skip && /^\[/ && !/^\[mcp_servers\.pulsar\]/ { skip = 0 }
                 !skip' "$f" > "$tmp" && chmod --reference="$f" "$tmp" && mv "$tmp" "$f"
            printf 'removed the pulsar MCP server from %s\n' "$f" ;;
    esac
}

unlink_agent_context() {
    local target
    target=$(agent_context_path "$A_NAME") || return 0
    # Only the link this recipe made. A file the user wrote there stays.
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$AGENTS_MD" ]; then
        rm -f "$target"
        printf 'removed the guide link at %s\n' "$target"
    fi
}

write_agent_shim() {
    local shim="${AGENT_SHIMS}/${A_BIN}" real="${AGENT_PREFIX}/bin/${A_BIN}" guide=""
    # aider reads nothing unless told. Decided each time the shim runs, not
    # when it is written: a shim written on an image without the guide would
    # otherwise never pass it, even after an update ships one.
    if [ "$A_NAME" = aider ]; then
        guide="[ -r $(sq "$AGENTS_MD") ] && set -- --read $(sq "$AGENTS_MD") \"\$@\""
    fi
    mkdir -p "$AGENT_SHIMS"
    # NPM_CONFIG_PREFIX travels on the command line because toolbox forwards
    # only a fixed list of variables. It is what keeps a self-updating agent
    # (`claude update`, gemini's updater) writing to the prefix it was
    # installed in, rather than to the box's /usr, which needs sudo and fails.
    local cli
    cli=$(realpath "$SELF")
    cat > "$shim" <<EOF
#!/bin/sh
${SHIM_MARK}
# ${A_DESC}.
# Written by \`pulsar agent add ${A_NAME}\`; remove with
# \`pulsar agent remove ${A_NAME}\`. Edits here are overwritten by a rerun.
#
# \`pulsar agent run\` decides how it starts: in the '${AGENT_BOX}' toolbox,
# or sandboxed (pulsar agent sandbox). toolbox forwards only a fixed set of
# environment variables, so an API key exported in this shell does not reach
# the agent there. Log in through the agent instead.
real=$(sq "$real")
prefix=$(sq "$AGENT_PREFIX")
${guide}
# Inside the agents box itself: run the real thing directly, since toolbox
# cannot nest. Inside ANY OTHER container that shares this \$HOME (a dev box
# with no node or uv), hop back to the host and start it from there.
if [ -e /run/.containerenv ]; then
    if grep -qx 'name="${AGENT_BOX}"' /run/.containerenv 2>/dev/null; then
        NPM_CONFIG_PREFIX="\$prefix" exec "\$real" "\$@"
    fi
    exec flatpak-spawn --host $(sq "$cli") agent run $(sq "$A_NAME") -- "\$@"
fi
exec $(sq "$cli") agent run $(sq "$A_NAME") -- "\$@"
EOF
    chmod 0755 "$shim"
    printf 'wrote %s\n' "$shim"
}

agent_list() {
    local n b m p d state native notes=""
    if [ "${JSON:-0}" = 1 ]; then
        need jq
        while IFS=$'\t' read -r n b m p _ d; do
            state=available
            if is_our_shim "${AGENT_SHIMS}/${b}"; then state=installed
            elif native_launcher "$b" >/dev/null; then state=native
            fi
            jq -n -c --arg n "$n" --arg b "$b" --arg m "$m" --arg p "$p" --arg d "$d" --arg s "$state" \
                '{name: $n, command: $b, installer: $m, package: $p, description: $d, state: $s}'
        done <<<"$AGENTS_TABLE" | jq -s '.'
        return 0
    fi
    printf '%-9s %-9s %-34s %-10s %s\n' NAME COMMAND INSTALL STATE DESCRIPTION
    while IFS=$'\t' read -r n b m p _ d; do
        state=-
        if is_our_shim "${AGENT_SHIMS}/${b}"; then
            state=installed
        elif native=$(native_launcher "$b"); then
            state=native
            notes+="  ${n}: ${native} (its own installer; Pulsar leaves it alone)"$'\n'
        fi
        printf '%-9s %-9s %-34s %-10s %s\n' "$n" "$b" "${m} ${p}" "$state" "$d"
    done <<<"$AGENTS_TABLE"
    [ -z "$notes" ] || printf '\nnative installs:\n%s' "$notes"
    printf '\nnone is installed by default. box: %s  prefix: %s\n' "$AGENT_BOX" "$AGENT_PREFIX"
}

agent_install() {
    local native
    # Checked BEFORE anything is created or downloaded. A native install is
    # not an error: it is the agent the user already chose to run. Installing
    # a second copy in the box would put two versions on PATH, one shadowing
    # the other, so it gets the guide and nothing else.
    if native=$(native_launcher "$A_BIN"); then
        printf '%s is already installed by its own installer at %s\n' "$A_DESC" "$native"
        printf 'leaving it as it is: it runs on the host, not in the %s toolbox\n' "$AGENT_BOX"
        link_agent_context native
        link_agent_skills
        register_mcp host
        printf 'done: nothing installed\n'
        return 0
    fi
    need toolbox

    if box_exists; then
        printf 'using toolbox %s\n' "$AGENT_BOX"
    else
        # No --image: toolbox picks fedora-toolbox for the host's own release,
        # which is the choice a pin here would only ever lag behind.
        printf 'creating toolbox %s\n' "$AGENT_BOX"
        toolbox --assumeyes create "$AGENT_BOX" || die "could not create toolbox ${AGENT_BOX}"
    fi

    # The runtime is installed lazily and once: the second agent in the box
    # finds npm already there. `nodejs npm` rather than a versioned name, so
    # the box follows Fedora's default stream (Node 22 on F44, above every
    # agent's floor) instead of a number this file would have to chase.
    local tool
    case "$A_METHOD" in
        npm) tool=npm ;;
        uv)  tool=uv ;;
        *)   die "internal error: unknown installer '${A_METHOD}'" ;;
    esac
    if ! in_box sh -c "command -v ${tool}" >/dev/null 2>&1; then
        printf 'installing %s inside %s\n' "$tool" "$AGENT_BOX"
        case "$tool" in
            npm) in_box sudo dnf install -y nodejs npm ;;
            uv)  in_box sudo dnf install -y uv ;;
        esac || die "could not install ${tool} inside ${AGENT_BOX}"
    fi

    mkdir -p "$AGENT_PREFIX"
    printf 'installing %s (%s %s) into %s\n' "$A_DESC" "$A_METHOD" "$A_PKG" "$AGENT_PREFIX"
    case "$A_METHOD" in
        npm)
            in_box npm install -g --prefix "$AGENT_PREFIX" "${A_PKG}@latest" \
                || die "npm could not install ${A_PKG}" ;;
        uv)
            # aider's documented uv line, with every directory uv would write
            # pointed into the prefix, so removal has one place to clean.
            in_box env "UV_TOOL_DIR=${AGENT_PREFIX}/uv-tools" \
                       "UV_TOOL_BIN_DIR=${AGENT_PREFIX}/bin" \
                       "UV_PYTHON_INSTALL_DIR=${AGENT_PREFIX}/python" \
                uv tool install --force --python python3.12 --with pip "${A_PKG}@latest" \
                || die "uv could not install ${A_PKG}" ;;
    esac
    [ -x "${AGENT_PREFIX}/bin/${A_BIN}" ] \
        || die "the installer reported success, but ${AGENT_PREFIX}/bin/${A_BIN} is not there"

    write_agent_shim
    link_agent_context
    link_agent_skills
    register_mcp box
    case ":${PATH}:" in
        *":${AGENT_SHIMS}:"*) ;;
        *) printf 'note: %s is not on PATH in this shell; a new login shell adds it on Fedora\n' "$AGENT_SHIMS" ;;
    esac
    printf "done: run \`%s\` from any terminal\n" "$A_BIN"
}

agent_remove() {
    local shim="${AGENT_SHIMS}/${A_BIN}" native
    if is_our_shim "$shim"; then
        rm -f "$shim"
        printf 'removed %s\n' "$shim"
    elif native=$(native_launcher "$A_BIN"); then
        printf '%s was installed by its own installer; remove it with that installer\n' "$native"
        unlink_agent_context
        unlink_agent_skills
        unregister_mcp
        return 0
    fi
    unlink_agent_context
    unlink_agent_skills
    unregister_mcp
    if have toolbox && box_exists; then
        case "$A_METHOD" in
            npm) in_box npm uninstall -g --prefix "$AGENT_PREFIX" "$A_PKG" || true ;;
            uv)  in_box env "UV_TOOL_DIR=${AGENT_PREFIX}/uv-tools" \
                            "UV_TOOL_BIN_DIR=${AGENT_PREFIX}/bin" \
                     uv tool uninstall "$A_PKG" || true ;;
        esac
    else
        printf 'toolbox %s is gone; the package files, if any, are under %s\n' "$AGENT_BOX" "$AGENT_PREFIX"
    fi
    # Said out loud, because "removed" would otherwise read as "gone": the
    # agent's logins, history and settings are the user's data, not ours.
    printf "left in place: the agent's own config and credentials in \$HOME, and the %s toolbox (toolbox rm -f %s)\n" \
        "$AGENT_BOX" "$AGENT_BOX"
}

# ---------------------------------------------------------------------------
# agent guard -- make the silent system changes ask for a password.
#
# Stock Fedora polkit rules let a wheel user in an active local session layer
# packages, roll back, clean up deployments and install or remove system
# Flatpaks with no prompt, and so can anything that user starts. The rule that
# undoes that ships inert in the image; `on` copies it into /etc, where polkit
# picks it up at once (it watches the directory). Opt-in, not image policy: it
# departs from Silverblue's defaults and costs a human one more prompt.
#
# The state is read from polkit, not from the file: /etc/polkit-1/rules.d is
# not readable by users, and what matters is what polkit answers anyway.
# ---------------------------------------------------------------------------
GUARD_RULE=${PULSAR_GUARD_RULE:-/usr/share/pulsar/polkit/49-pulsar-guard.rules}
POLKIT_RULES_DIR=${PULSAR_POLKIT_RULES_DIR:-/etc/polkit-1/rules.d}
GUARD_MARKER='pulsar agent guard'
GUARD_ACTIONS='org.projectatomic.rpmostree1.install-uninstall-packages
org.projectatomic.rpmostree1.rollback
org.projectatomic.rpmostree1.cleanup
org.freedesktop.Flatpak.app-install
org.freedesktop.Flatpak.app-uninstall'

# action <TAB> yes|auth|no, for this process's session.
guard_answers() {
    local a rc
    while IFS= read -r a; do
        rc=0; pkcheck --action-id "$a" --process $$ >/dev/null 2>&1 || rc=$?
        case "$rc" in
            0) printf '%s\tyes\n' "$a" ;;
            2) printf '%s\tauth\n' "$a" ;;
            *) printf '%s\tno\n' "$a" ;;
        esac
    done <<<"$GUARD_ACTIONS"
}

# on: nothing gated goes through silently. off: all of it does. partial: a
# mix, which a hand-edited rule or a newer stock rule could produce.
guard_state() {
    have pkcheck || { printf 'unknown\n'; return 0; }
    local answers
    answers=$(guard_answers | cut -f2 | sort -u | paste -sd' ' -)
    case "$answers" in
        yes)   printf 'off\n' ;;
        *yes*) printf 'partial\n' ;;
        *)     printf 'on\n' ;;
    esac
}

agent_guard() {
    local sub=${1:-status}
    [ $# -le 1 ] || die "usage: pulsar agent guard [on | off]"
    local dest
    dest="${POLKIT_RULES_DIR}/$(basename "$GUARD_RULE")"
    case "$sub" in
        -h|--help)
            cat <<'EOF'
usage: pulsar agent guard           what polkit answers for your session
       sudo pulsar agent guard on   layering, rollback, cleanup and system
                                    Flatpak installs ask for a password
       sudo pulsar agent guard off  back to the Fedora default (no prompt)

It applies to you and to anything you run, a coding agent included.
Updates are not gated, and root (sudo) is not affected.
EOF
            ;;
        status)
            [ "$(id -u)" -ne 0 ] || die "'agent guard' checks your session; drop the sudo"
            need pkcheck
            local a v label
            if [ "${JSON:-0}" = 1 ]; then
                need jq
                guard_answers | jq -R -s --arg st "$(guard_state)" \
                    '{state: $st, actions: [split("\n")[] | select(length > 0) | split("\t") | {id: .[0], answer: .[1]}]}'
                return 0
            fi
            printf 'guard: %s\n\n' "$(guard_state)"
            while IFS=$'\t' read -r a v; do
                case "$v" in
                    yes)  label='no prompt' ;;
                    auth) label='asks for a password' ;;
                    *)    label='denied' ;;
                esac
                printf '  %-58s %s\n' "$a" "$label"
            done < <(guard_answers)
            ;;
        off)
            no_json "agent guard off"
            need_root "agent guard off"
            if [ ! -e "$dest" ]; then
                printf 'guard is already off (no %s)\n' "$dest"; return 0
            fi
            grep -qF "$GUARD_MARKER" "$dest" \
                || die "${dest} is not the rule 'agent guard' installs; leaving it alone"
            rm -f "$dest" || die "could not remove ${dest}"
            printf 'guard off: removed %s\n' "$dest"
            ;;
        on)
            no_json "agent guard on"
            need_root "agent guard on"
            [ -r "$GUARD_RULE" ] || die "the guard rule is not staged in this image (${GUARD_RULE})"
            if [ -e "$dest" ] && cmp -s "$GUARD_RULE" "$dest"; then
                printf 'guard is already on (%s)\n' "$dest"; return 0
            fi
            if [ -e "$dest" ] && ! grep -qF "$GUARD_MARKER" "$dest"; then
                die "${dest} exists and is not ours; leaving it alone"
            fi
            install -D -m 0644 "$GUARD_RULE" "$dest" || die "could not write ${dest}"
            # A new file in /etc gets its label from the directory, but make
            # sure: polkitd cannot read a mislabeled rule.
            if have restorecon; then restorecon "$dest" 2>/dev/null || true; fi
            printf 'guard on: installed %s\n' "$dest"
            printf 'these now ask for the admin password, for you and for anything you run:\n'
            printf '  rpm-ostree install/uninstall, rollback, cleanup\n'
            printf '  flatpak install/uninstall (system; --user is unaffected)\n'
            printf 'updates are not gated. check: pulsar agent guard\n'
            ;;
        *) die "unknown guard command: ${sub} (see: pulsar agent guard --help)" ;;
    esac
}

# ---------------------------------------------------------------------------
# agent, bare -- the one-screen answer to "what does this machine give an
# agent": the guide, the agents installed, and whether guard is on. --json
# is for the agent itself.
# ---------------------------------------------------------------------------
agent_status() {
    local guide=false guard=unknown n b m p d state native rows=""
    [ -r "$AGENTS_MD" ] && guide=true
    [ "$(id -u)" -eq 0 ] || guard=$(guard_state)
    while IFS=$'\t' read -r n b m p _ d; do
        state=""
        if is_our_shim "${AGENT_SHIMS}/${b}"; then
            state=installed
        elif native=$(native_launcher "$b"); then
            state=native
        fi
        [ -z "$state" ] || rows+="${n}"$'\t'"${b}"$'\t'"${state}"$'\n'
    done <<<"$AGENTS_TABLE"
    local sbx; sbx=$(setting_resolve sandbox "$(project_root)")
    if [ "${JSON:-0}" = 1 ]; then
        need jq
        printf '%s' "$rows" | jq -R -s --arg g "$AGENTS_MD" --argjson gp "$guide" --arg guard "$guard" \
            --arg sb "${sbx%%$'\t'*}" --arg sbsrc "${sbx#*$'\t'}" '
            {guide: {path: $g, present: $gp},
             agents: [split("\n")[] | select(length > 0) | split("\t")
                      | {name: .[0], command: .[1], install: .[2]}],
             guard: $guard, sandbox: {here: $sb, from: $sbsrc}}'
        return 0
    fi
    if [ "$guide" = true ]; then
        printf 'guide    %s  (pulsar agent guide)\n' "$AGENTS_MD"
    else
        printf 'guide    none in this image\n'
    fi
    if [ -n "$rows" ]; then
        while IFS=$'\t' read -r n b state; do
            [ -n "$n" ] || continue
            printf 'agent    %-9s %s\n' "$n" "$state"
        done <<<"$rows"
    else
        printf 'agents   none installed  (pulsar agent list, pulsar agent add <name>)\n'
    fi
    printf 'sandbox  %s here (%s)  (pulsar agent sandbox)\n' "${sbx%%$'\t'*}" "${sbx#*$'\t'}"
    case "$guard" in
        on)      printf 'guard    on: layering and system Flatpak installs ask for a password\n' ;;
        off)     printf 'guard    off: layering and system Flatpak installs do not prompt  (sudo pulsar agent guard on)\n' ;;
        partial) printf 'guard    partial  (see: pulsar agent guard)\n' ;;
        *)       printf 'guard    unknown  (run pulsar agent guard as yourself)\n' ;;
    esac
}

# ---------------------------------------------------------------------------
# agent sandbox -- the agent sees the project, not the rest of $HOME, and
# pushes through a gate that never hands it a credential.
#
# Off, an agent runs in the agents toolbox: it shares $HOME, the session bus
# and the user's keys. On, `pulsar agent run` starts it in a rootless podman
# container that holds:
#
#   the project       the git root it was started in, read-write, except
#                     what git runs things from, read-only: a hook or a
#                     core.fsmonitor planted there would run on the host the
#                     next time the USER runs git in it (sandbox_git_mounts)
#   its own state     ~/.claude, ~/.codex, ...: one login, both modes
#   git identity      ~/.gitconfig and ~/.config/git, read-only
#   the guide         AGENTS.md and the skills, read-only
#   the gate          one socket (pulsar-agent-gate): push and pull through
#                     the user's credentials, on the host, under a policy
#
# and nothing else of $HOME: a private tmpfs sits under those mounts. No
# session bus, no flatpak-spawn, no SSH agent. The network stays open (the
# agent needs its API): the sandbox limits what it can READ, not where it
# can send it. SELinux label separation is off, as toolbox has it, so the
# user's files are never relabeled; the mounts do the isolating.
#
# Settings, most specific first. Whatever the agent can write can only
# TIGHTEN, so a sandboxed agent cannot loosen its own next session:
#
#   repo      <root>/.pulsar/agent.toml   sandbox = "on"; push = "off"|"branches"
#   yours     ~/.config/pulsar/agent-projects (per git root; outside the project)
#   global    ~/.config/pulsar/agent.conf
#   default   sandbox off, push on
# ---------------------------------------------------------------------------
AGENT_CONF=${PULSAR_AGENT_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/pulsar/agent.conf}
AGENT_PROJECTS=${PULSAR_AGENT_PROJECTS:-${XDG_CONFIG_HOME:-$HOME/.config}/pulsar/agent-projects}
GATE_DIR=${PULSAR_GATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/pulsar/gate}
GATE_TOOL=${PULSAR_GATE:-/usr/libexec/pulsar/pulsar-agent-gate}
SANDBOX_BASE=${PULSAR_SANDBOX_BASE:-registry.fedoraproject.org/fedora-toolbox}

# The image: the host's own Fedora toolbox, plus what the agents run on.
sandbox_recipe() {
    local ver
    ver=$(sed -n 's/^VERSION_ID=//p' /etc/os-release 2>/dev/null | tr -d '"')
    [ -n "$ver" ] || ver=44
    cat <<EOF
FROM ${SANDBOX_BASE}:${ver}
RUN dnf -y install nodejs npm uv git python3 ripgrep fd-find jq && dnf clean all
LABEL digital.arclight.pulsar.sandbox=1
EOF
}

# Tagged by the recipe's hash, so a changed recipe is a new image.
sandbox_image() {
    printf 'localhost/pulsar-agent-sandbox:%s\n' "$(sandbox_recipe | sha256sum | cut -c1-12)"
}

sandbox_build() {
    local img; img=$(sandbox_image)
    podman image exists "$img" 2>/dev/null && return 0
    printf 'building the sandbox image %s (once; a few minutes)\n' "$img" >&2
    sandbox_recipe | podman build --quiet -t "$img" -f - >&2 || die "could not build the sandbox image"
}

# The project an agent started here is working in: the git root, else here.
project_root() {
    git -C "${1:-$PWD}" rev-parse --show-toplevel 2>/dev/null || (cd "${1:-$PWD}" && pwd -P)
}

# key (sandbox|push) -> "value <TAB> where it came from", for project $2.
setting_resolve() {
    local key=$1 root=$2 base="" src="" repo=""
    if [ -r "$AGENT_PROJECTS" ]; then
        base=$(awk -F'\t' -v k="$key" -v p="$root" '$1 == k && $2 == p { v = $3 } END { print v }' "$AGENT_PROJECTS")
        [ -z "$base" ] || src="this project, yours"
    fi
    if [ -z "$base" ] && [ -r "$AGENT_CONF" ]; then
        base=$(awk -F' *= *' -v k="$key" '$1 == k { v = $2 } END { print v }' "$AGENT_CONF")
        [ -z "$base" ] || src="global"
    fi
    if [ -z "$base" ]; then
        case "$key" in sandbox) base=off ;; push|wrap) base=on ;; esac
        src=default
    fi
    # The repo file can only tighten: sandbox on; push off or branches.
    if [ -r "${root}/.pulsar/agent.toml" ]; then
        repo=$(awk -F' *= *' -v k="$key" '$1 == k { gsub(/"/, "", $2); v = $2 } END { print v }' "${root}/.pulsar/agent.toml")
    fi
    case "$key:$repo" in
        sandbox:on)
            [ "$base" = on ] || { base=on; src="this project: .pulsar/agent.toml"; } ;;
        push:off)
            [ "$base" = off ] || { base=off; src="this project: .pulsar/agent.toml"; } ;;
        push:branches)
            [ "$base" != on ] || { base=branches; src="this project: .pulsar/agent.toml"; } ;;
    esac
    printf '%s\t%s\n' "$base" "$src"
}

setting_write() {
    local key=$1 value=$2 here=$3 root=$4 tmp
    if [ "$here" = 1 ]; then
        mkdir -p "$(dirname "$AGENT_PROJECTS")"
        tmp=$(mktemp)
        { [ -r "$AGENT_PROJECTS" ] && awk -F'\t' -v k="$key" -v p="$root" '!($1 == k && $2 == p)' "$AGENT_PROJECTS"
          printf '%s\t%s\t%s\n' "$key" "$root" "$value"; } > "$tmp"
        mv "$tmp" "$AGENT_PROJECTS"
    else
        mkdir -p "$(dirname "$AGENT_CONF")"
        tmp=$(mktemp)
        { [ -r "$AGENT_CONF" ] && awk -F' *= *' -v k="$key" '$1 != k' "$AGENT_CONF"
          printf '%s = %s\n' "$key" "$value"; } > "$tmp"
        mv "$tmp" "$AGENT_CONF"
    fi
}

gate_id() { printf '%s' "$1" | sha256sum | cut -c1-16; }

# Extra paths the user lets into the sandbox, global and this project's:
# "path" or "path:rw", one per line. Never from the repo file: allowing is
# loosening, and the agent can write that file.
sandbox_allows() {
    local root=$1
    { [ ! -r "$AGENT_CONF" ] || awk -F' *= *' '$1 == "allow" { print $2 }' "$AGENT_CONF"
      [ ! -r "$AGENT_PROJECTS" ] || awk -F'\t' -v p="$root" '$1 == "allow" && $2 == p { print $3 }' "$AGENT_PROJECTS"
    } | awk '!seen[$0]++'
}

sandbox_allow() {
    local want=$1 here=$2 root=$3 rw=$4 path entry tmp file
    [ -n "$want" ] || die "usage: pulsar agent sandbox allow <path> [--rw] [--here]"
    path=$(realpath -m "$want")
    [ -e "$path" ] || die "no such path: ${path}"
    case "$HOME/" in "${path%/}/"*) die "that would let the whole of ${path} in; allow the one file or folder you need" ;; esac
    case "$path" in
        "$HOME/.ssh"*|"$HOME/.gnupg"*|"$HOME/.local/share/keyrings"*|"$HOME/.config/gh"*|"$HOME/.password-store"*)
            printf 'warning: %s holds keys or tokens; the sandbox is weaker with it in\n' "$path" >&2 ;;
    esac
    entry=$path; [ "$rw" = 0 ] || entry="${path}:rw"
    tmp=$(mktemp)
    if [ "$here" = 1 ]; then
        file=$AGENT_PROJECTS
        { [ ! -r "$file" ] || awk -F'\t' -v p="$root" -v e="$path" '!($1 == "allow" && $2 == p && ($3 == e || $3 == e ":rw"))' "$file"
          printf 'allow\t%s\t%s\n' "$root" "$entry"; } > "$tmp"
    else
        file=$AGENT_CONF
        { [ ! -r "$file" ] || awk -F' *= *' -v e="$path" '!($1 == "allow" && ($2 == e || $2 == e ":rw"))' "$file"
          printf 'allow = %s\n' "$entry"; } > "$tmp"
    fi
    mkdir -p "$(dirname "$file")"; mv "$tmp" "$file"
    printf 'allowed into the sandbox%s: %s (%s)\n' "$([ "$here" = 1 ] && printf ' for %s' "$root")" "$path" \
        "$([ "$rw" = 1 ] && echo read-write || echo read-only)"
}

sandbox_disallow() {
    local path tmp
    path=$(realpath -m "$1")
    tmp=$(mktemp)
    if [ -r "$AGENT_CONF" ]; then
        awk -F' *= *' -v e="$path" '!($1 == "allow" && ($2 == e || $2 == e ":rw"))' "$AGENT_CONF" > "$tmp" && mv "$tmp" "$AGENT_CONF"
    fi
    tmp=$(mktemp)
    if [ -r "$AGENT_PROJECTS" ]; then
        awk -F'\t' -v e="$path" '!($1 == "allow" && ($3 == e || $3 == e ":rw"))' "$AGENT_PROJECTS" > "$tmp" && mv "$tmp" "$AGENT_PROJECTS"
    fi
    rm -f "$tmp"
    printf 'no longer allowed: %s\n' "$path"
}

# Programs the agent's own hooks run that live in $HOME and are not let in:
# the sandbox cannot see them, and the hook fails on every call. Claude Code
# only, for now: its hooks are in settings.json.
sandbox_hook_hints() {
    local name=$1 root=$2 cmd bin allows
    [ "$name" = claude ] && [ -r "$HOME/.claude/settings.json" ] && have jq || return 0
    allows=$(sandbox_allows "$root" | sed 's/:rw$//')
    jq -r '.. | objects | .command? // empty | strings' "$HOME/.claude/settings.json" 2>/dev/null \
        | awk '{ print $1 }' | sort -u | while IFS= read -r cmd; do
            bin=$(command -v "$cmd" 2>/dev/null) || continue
            case "$bin" in "$HOME"/*) ;; *) continue ;; esac
            grep -qxF "$bin" <<<"$allows" && continue
            printf 'note: your claude hooks run %s (%s), which the sandbox cannot see: pulsar agent sandbox allow %s\n' \
                "$cmd" "$bin" "$bin" >&2
        done
}

agent_sandbox() {
    local sub=${1:-} here=0 root a
    local -a rest=()
    shift || true
    local rw=0
    for a in "$@"; do
        case "$a" in --here) here=1 ;; --rw) rw=1 ;; *) rest+=("$a") ;; esac
    done
    root=$(project_root)
    case "$sub" in
        "")
            local sb push mirror
            sb=$(setting_resolve sandbox "$root"); push=$(setting_resolve push "$root")
            mirror="${GATE_DIR}/$(gate_id "$root").git"
            printf 'project  %s\n' "$root"
            printf 'sandbox  %s  (%s)\n' "${sb%%$'\t'*}" "${sb#*$'\t'}"
            printf 'push     %s  (%s)\n' "${push%%$'\t'*}" "${push#*$'\t'}"
            local al
            while IFS= read -r al; do
                [ -z "$al" ] || printf 'allow    %s\n' "$al"
            done < <(sandbox_allows "$root")
            if [ -d "$mirror" ]; then
                git -C "$mirror" config --get-regexp '^remote\..*\.url$' 2>/dev/null \
                    | sed 's/^remote\.\(.*\)\.url /remote   \1 -> /; s/$/  (pinned)/'
            fi
            local n native wrap
            wrap=$(setting_resolve wrap "$root"); wrap=${wrap%%$'\t'*}
            printf 'wrap     %s  (typing an agent'"'"'s name in bash goes through pulsar agent run)\n' \
                "$([ "$wrap" = off ] && echo off || echo on)"
            while IFS=$'\t' read -r n _; do
                native=$(native_launcher "$n" 2>/dev/null) || continue
                is_our_shim "${AGENT_SHIMS}/${n}" && continue
                if [ "$wrap" = off ]; then
                    printf 'note     %s runs from %s as installed: pulsar agent run %s sandboxes it (wrap is off)\n' "$n" "$native" "$n"
                fi
            done <<<"$AGENTS_TABLE"
            ;;
        on|off)
            [ ${#rest[@]} -eq 0 ] || die "usage: pulsar agent sandbox on|off [--here]"
            setting_write sandbox "$sub" "$here" "$root"
            if [ "$here" = 1 ]; then printf 'sandbox %s for %s\n' "$sub" "$root"; else printf 'sandbox %s (global)\n' "$sub"; fi
            local eff; eff=$(setting_resolve sandbox "$root")
            [ "${eff%%$'\t'*}" = "$sub" ] || printf 'here it stays %s: %s\n' "${eff%%$'\t'*}" "${eff#*$'\t'}"
            ;;
        push)
            case "${rest[0]:-}" in on|off|branches) ;; *) die "usage: pulsar agent sandbox push on|off|branches [--here]" ;; esac
            setting_write push "${rest[0]}" "$here" "$root"
            if [ "$here" = 1 ]; then printf 'push %s for %s\n' "${rest[0]}" "$root"; else printf 'push %s (global)\n' "${rest[0]}"; fi
            ;;
        wrap)
            # whether typing an agent's name goes through `agent run`
            # (/etc/profile.d/pulsar-agents.sh); global, read by every shell
            case "${rest[0]:-}" in on|off) ;; *) die "usage: pulsar agent sandbox wrap on|off" ;; esac
            [ "$here" = 0 ] || die "wrap is global: every shell reads it"
            setting_write wrap "${rest[0]}" 0 "$root"
            printf 'typing an agent'"'"'s name %s through pulsar agent run, in new shells\n' \
                "$([ "${rest[0]}" = on ] && echo goes || echo no longer goes)" ;;
        allow)
            [ ${#rest[@]} -eq 1 ] || die "usage: pulsar agent sandbox allow <path> [--rw] [--here]"
            sandbox_allow "${rest[0]}" "$here" "$root" "$rw" ;;
        disallow)
            [ ${#rest[@]} -eq 1 ] || die "usage: pulsar agent sandbox disallow <path>"
            sandbox_disallow "${rest[0]}" ;;
        list)
            [ -r "$AGENT_PROJECTS" ] && [ -s "$AGENT_PROJECTS" ] || { printf 'no per-project settings\n'; return 0; }
            awk -F'\t' '{ printf "%-8s %-9s %s%s\n", $1, $3, $2, (system("test -d \"" $2 "\"") ? "  (gone)" : "") }' "$AGENT_PROJECTS"
            ;;
        repin)
            # The remotes are pinned when a project first runs sandboxed. After
            # a real change of remote, the user says so, here, on the host.
            rm -rf "${GATE_DIR}/$(gate_id "$root").git"
            printf 'unpinned %s: its remotes are pinned again on the next sandboxed run\n' "$root" ;;
        -h|--help) agent_help ;;
        *) die "unknown sandbox command: ${sub} (see: pulsar agent --help)" ;;
    esac
}

# The sandbox's own home, per agent, persistent: its history and caches live
# here. The user's settings flow IN at every start; nothing flows out but the
# login. A sandboxed agent that edits its own settings -- adds a hook, an MCP
# server -- edits this copy, which the next start overwrites, and which the
# unsandboxed agent never reads. Mounting the real ~/.claude read-write would
# let exactly that run on the host.
SANDBOX_HOMES=${PULSAR_SANDBOX_HOMES:-${XDG_DATA_HOME:-$HOME/.local/share}/pulsar/sandbox}

# What of the user's agent setup goes in, relative to $HOME:
#   copy  small files the agent also writes (settings, its state file, the
#         login): copied in at each start, over whatever the sandbox did
#   ro    folders it only reads (skills, plugins, hooks): mounted read-only
#         from the real ones, so nothing is copied and nothing can be planted
agent_sync_paths() {
    local f
    case "$1" in
        claude)
            printf 'copy %s\n' .claude.json .claude/settings.json .claude/settings.local.json \
                .claude/keybindings.json .claude/.credentials.json
            # CLAUDE.md and whatever it @-imports beside it
            for f in "$HOME"/.claude/*.md; do [ ! -e "$f" ] || printf 'copy .claude/%s\n' "$(basename "$f")"; done
            printf 'ro %s\n' .claude/commands .claude/agents .claude/skills .claude/rules .claude/hooks .claude/plugins ;;
        codex)    printf 'copy %s\n' .codex/config.toml .codex/AGENTS.md .codex/auth.json
                  printf 'ro %s\n' .codex/prompts .codex/skills ;;
        gemini)   printf 'copy %s\n' .gemini/settings.json .gemini/GEMINI.md .gemini/oauth_creds.json .gemini/google_accounts.json
                  printf 'ro %s\n' .gemini/commands .gemini/skills ;;
        opencode) printf 'copy %s\n' .local/share/opencode/auth.json
                  printf 'ro %s\n' .config/opencode ;;
        aider)    printf 'copy %s\n' .aider.conf.yml ;;
    esac
}

# The login: the one thing copied back out, so both modes stay signed in.
agent_cred_path() {
    case "$1" in
        claude)   printf '%s\n' .claude/.credentials.json ;;
        codex)    printf '%s\n' .codex/auth.json ;;
        gemini)   printf '%s\n' .gemini/oauth_creds.json ;;
        opencode) printf '%s\n' .local/share/opencode/auth.json ;;
        *)        return 1 ;;
    esac
}

sandbox_sync_in() {
    local name=$1 home=$2 how rel
    mkdir -p "$home"; chmod 0700 "$home"
    while read -r how rel; do
        [ "$how" = copy ] && [ -n "$rel" ] || continue
        if [ -e "$HOME/$rel" ]; then
            mkdir -p "$(dirname "$home/$rel")"
            cp -a --remove-destination "$HOME/$rel" "$home/$rel"
            # the host's pulsar MCP server is not reachable from in here
            if [ "$rel" = .claude.json ] && have jq; then
                local t; t=$(mktemp)
                if jq 'del(.mcpServers.pulsar)' "$home/$rel" > "$t" 2>/dev/null; then mv "$t" "$home/$rel"; else rm -f "$t"; fi
            fi
        else
            # gone on the host: gone in here too, not left over from before
            rm -f "${home:?}/$rel"
        fi
    done < <(agent_sync_paths "$name")
}

# The read-only half, as podman -v arguments, one per line.
sandbox_ro_mounts() {
    local name=$1 how rel
    while read -r how rel; do
        [ "$how" = ro ] && [ -d "$HOME/$rel" ] || continue
        printf '%s\n' "$HOME/$rel:$HOME/$rel:ro"
    done < <(agent_sync_paths "$name")
}

# At the end of a session: the refreshed login goes back, if it is still
# JSON, if it changed in here, and if the host's copy did NOT change meanwhile
# (then the host's is newer, and the sandbox's may already be revoked).
sandbox_creds_out() {
    local name=$1 home=$2 before=$3 rel host in tmp
    rel=$(agent_cred_path "$name") || return 0
    host="$HOME/$rel"; in="$home/$rel"
    # A real file inside the sandbox's home, never a symlink: the agent could
    # point it at any JSON the user can read on the host (registry auth, a
    # cloud token) and have it copied into the host's login, then back into
    # the sandbox next session. Nor may the sandbox create a host login that
    # was not there before it started.
    [ -f "$in" ] && [ ! -L "$in" ] || return 0
    case "$(realpath -e -- "$in" 2>/dev/null)" in "$(realpath -e -- "$home")"/*) ;; *) return 0 ;; esac
    [ -n "$before" ] || return 0
    jq -e . "$in" >/dev/null 2>&1 || return 0
    [ "$(sha256sum < "$host" 2>/dev/null | cut -c1-64)" = "$before" ] || return 0
    cmp -s "$in" "$host" 2>/dev/null && return 0
    mkdir -p "$(dirname "$host")"
    tmp=$(mktemp "${host}.XXXXXX") && cp "$in" "$tmp" && chmod 0600 "$tmp" && mv "$tmp" "$host"
}

# Upstream tracking for what the agent pushed. Inside, .git/config is
# read-only, so `push -u` (and push.autoSetupRemote) cannot record it; the
# gate notes each branch that reached the real remote, and this records it
# on the host as the session ends. Only branch.<b>.remote and .merge, only
# for a local branch of that name with no upstream yet, and only for a
# remote the gate had pinned.
sandbox_tracking() {
    local root=$1 log=$2 mirror=$3 remote ref b
    [ -s "$log" ] || { rm -f "$log"; return 0; }
    while IFS=$'\t' read -r remote ref; do
        b=${ref#refs/heads/}
        [ "$ref" != "$b" ] || continue
        git check-ref-format --branch "$b" >/dev/null 2>&1 || continue
        git -C "$mirror" config "remote.${remote}.url" >/dev/null 2>&1 || continue
        git -C "$root" show-ref --verify --quiet "refs/heads/${b}" || continue
        git -C "$root" config "branch.${b}.remote" >/dev/null 2>&1 && continue
        git -C "$root" config "branch.${b}.remote" "$remote"
        git -C "$root" config "branch.${b}.merge" "$ref"
        printf 'note: %s now tracks %s/%s\n' "$b" "$remote" "$b" >&2
    done < <(sort -u "$log")
    rm -f "$log"
}

# Git runs things out of its own files: a hook, core.fsmonitor, any config it
# is pointed at. The project is read-write in here, so each of those the agent
# could write would run on the host the next time you ran git in the project,
# or your editor did in the background. .git/config and .git/hooks being
# read-only closed only the front door. The others:
#
#   .git itself        moved aside, it takes its read-only mounts with it,
#                      and a new .git with a config of the agent's takes its
#                      place; bound onto itself, it is a mount point, and a
#                      mount point cannot be renamed
#   .git/commondir     git then reads config and hooks from wherever it
#                      points; a plain repository never has one
#   submodules         their git directories under .git/modules have a
#                      config and hooks of their own, and a gitlink in the
#                      index plus a .git file or folder anywhere in the tree
#                      makes the user's `git status` run git in it
#   config it names    core.hooksPath (husky's .husky/_), include.path and
#                      includeIf: in the project, they are .git/hooks and
#                      .git/config by another name
#
# What a mount can close is closed before the agent starts. What it cannot --
# a file that does not exist yet, since mounting over it would make it on the
# host -- is checked when the session ends, before Pulsar runs git itself.

# Refuse a project whose git directory the sandbox cannot protect.
sandbox_git_check() {
    local root=$1
    { [ -e "${root}/.git" ] || [ -L "${root}/.git" ]; } || return 0
    [ -d "${root}/.git" ] && [ ! -L "${root}/.git" ] \
        || die "${root}/.git is not a folder: this is a linked worktree or a submodule, and its git directory is outside the project, where the sandbox cannot protect it; start the agent from the main checkout"
    [ ! -e "${root}/.git/commondir" ] \
        || die "${root}/.git/commondir exists, which a plain repository never has: git would read its config and hooks from wherever it points. Read it before starting an agent here"
}

# The git mounts, one podman -v per line: each git directory bound onto itself
# and its config and hooks read-only, then what the project's config points at.
sandbox_git_mounts() {
    local root=$1 g="${1}/.git" p d line key val src
    [ -d "$g" ] || return 0
    printf '%s:%s\n' "$g" "$g"
    [ ! -e "${g}/config" ] || printf '%s:%s:ro\n' "${g}/config" "${g}/config"
    mkdir -p "${g}/hooks"
    printf '%s:%s:ro\n' "${g}/hooks" "${g}/hooks"
    # linked worktrees live outside the project; their git side is not the
    # agent's to change
    [ ! -d "${g}/worktrees" ] || printf '%s:%s:ro\n' "${g}/worktrees" "${g}/worktrees"
    if [ -d "${g}/modules" ]; then
        while IFS= read -r -d '' p; do
            d=$(dirname "$p")
            mkdir -p "${d}/hooks"
            printf '%s:%s\n%s:%s:ro\n%s:%s:ro\n' "$d" "$d" "$p" "$p" "${d}/hooks" "${d}/hooks"
        done < <(find "${g}/modules" -name config -type f -print0 | sort -z)
    fi
    # As the user's git reads it: every scope, includes followed. An include
    # is relative to the file that names it; hooksPath to the checkout. One
    # outside the project is not in here at all, so it needs nothing.
    while IFS= read -r line; do
        src=${line%%$'\t'*}; src=${src#file:}
        line=${line#*$'\t'}
        key=${line%% *}; val=${line#* }
        case "$val" in \~/*) val="${HOME}/${val#\~/}" ;; esac
        case "$key" in
            core.hookspath) case "$val" in /*) ;; *) val="${root}/${val}" ;; esac
                            val=$(realpath -m "$val")
                            case "$val/" in "${root}/"*) mkdir -p "$val" ;; esac ;;
            *) case "$val" in /*) ;; *) val="$(dirname "$src")/${val}" ;; esac
               val=$(realpath -m "$val") ;;
        esac
        case "$val" in "${root}/"*) [ ! -e "$val" ] || printf '%s:%s:ro\n' "$val" "$val" ;; esac
    done < <(git -C "$root" config --show-origin --get-regexp '^(core\.hookspath|include\.path|includeif\..*\.path)$' 2>/dev/null)
}

# What in the tree could make the user's git run something, as NUL-separated
# records: every .git below the project's own (a submodule's pointer, or a
# repository), and every commondir in a git directory, each with its content
# or its identity. The records compare whole, so no name can forge a line.
sandbox_git_state() {
    local root=$1 p
    while IFS= read -r -d '' p; do
        if [ -f "$p" ] && [ ! -L "$p" ]; then
            printf 'f\t%s\t%s\0' "$(sha256sum < "$p" | cut -c1-64)" "$p"
        else
            printf 'x\t%s\t%s\0' "$(stat -c %d:%i "$p")" "$p"
        fi
    done < <(find "$root" -path "${root}/.git" -prune -o -name .git -print0 2>/dev/null)
    [ -d "${root}/.git" ] || return 0
    while IFS= read -r -d '' p; do
        printf 'c\t%s\t%s\0' "$(sha256sum < "$p" | cut -c1-64)" "$p"
    done < <(find "${root}/.git" -path "${root}/.git/worktrees" -prune -o -name commondir -print0 2>/dev/null)
}

# Anything new or changed since $2 (sandbox_git_state before the session) is
# renamed out of git's way, the way sandbox_defuse does agent config.
sandbox_git_defuse() {
    local root=$1 before=$2 rec p
    local -A seen=()
    if [ -f "$before" ]; then
        while IFS= read -r -d '' rec; do seen["$rec"]=1; done < "$before"
    fi
    while IFS= read -r -d '' rec; do
        [ -z "${seen["$rec"]:-}" ] || continue
        p=${rec#*$'\t'}; p=${p#*$'\t'}
        { [ -e "$p" ] || [ -L "$p" ]; } || continue
        rm -rf "${p}.from-sandbox"
        mv "$p" "${p}.from-sandbox"
        printf 'note: the sandboxed agent left %s, which your git would follow; renamed to %s.from-sandbox. Read it, and any git directory it points at, before renaming it back.\n' \
            "${p#"${root}/"}" "$(basename "$p")" >&2
    done < <(sandbox_git_state "$root")
    rm -f "$before"
}

# Agent config in the project that an agent loads by itself: read-only in
# here when it exists; created in here, it is defused when the session ends.
PROJECT_AGENT_CONFIG='.claude .mcp.json .codex .gemini .opencode opencode.json opencode.jsonc'

sandbox_defuse() {
    local root=$1 existed=$2 p
    for p in $PROJECT_AGENT_CONFIG; do
        case " ${existed} " in *" ${p} "*) continue ;; esac
        { [ -e "${root}/${p}" ] || [ -L "${root}/${p}" ]; } || continue
        rm -rf "${root}/${p}.from-sandbox"
        mv "${root}/${p}" "${root}/${p}.from-sandbox"
        printf 'note: the sandboxed agent created %s; renamed to %s.from-sandbox so no agent loads it. Read it, then rename it back if you want it.\n' \
            "$p" "$p" >&2
    done
}

sandbox_run() {
    local name=$1; shift
    local root cmd real
    root=$(project_root)
    [ "$root" != "$HOME" ] && [ "$root" != / ] \
        || die "the sandbox shows the agent one project; start it inside one, not in ${root}"
    need podman; need python3; need git
    # before anything here runs git in the project
    sandbox_git_check "$root"
    [ -r "$GATE_TOOL" ] || die "the push gate is not staged in this image (${GATE_TOOL})"
    cmd=$(agent_command "$name") || die "${name} is not installed (pulsar agent add ${name})"
    agent_row "$name"
    real=$(readlink -f "$cmd")
    sandbox_build
    local img; img=$(sandbox_image)

    local id mirror sock policy
    id=$(gate_id "$root")
    mirror="${GATE_DIR}/${id}.git"
    python3 "$GATE_TOOL" setup "$mirror" "$root" "$GATE_TOOL" || die "could not set up the push gate"
    policy=$(setting_resolve push "$root"); policy=${policy%%$'\t'*}
    git -C "$mirror" config pulsar.push "$policy"

    local home cred before=""
    home="${SANDBOX_HOMES}/${name}"
    sandbox_sync_in "$name" "$home"
    if cred=$(agent_cred_path "$name") && [ -f "$HOME/$cred" ]; then
        before=$(sha256sum < "$HOME/$cred" | cut -c1-64)
    fi

    local -a args=(run --rm -i --userns=keep-id --security-opt label=disable
        -v "${home}:${HOME}"
        -v "${root}:${root}"
        -w "$PWD"
        -e "HOME=${HOME}" -e "USER=$(id -un)" -e PULSAR_SANDBOX=1
        # Fedora adds ~/.local/bin only for login shells; an agent's hooks
        # do not run in one, and it is where an allowed tool usually lives.
        -e "PATH=${HOME}/.local/bin:${HOME}/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin"
        -e "TERM=${TERM:-xterm-256color}" -e "LANG=${LANG:-C.UTF-8}")
    [ ! -t 0 ] || args+=(-t)
    while IFS= read -r p; do
        [ -z "$p" ] || args+=(-v "$p")
    done < <(sandbox_git_mounts "$root")
    local gitstate="${XDG_RUNTIME_DIR:-/tmp}/pulsar/gitstate-${id}"
    mkdir -p "$(dirname "$gitstate")"
    sandbox_git_state "$root" > "$gitstate"
    while IFS= read -r p; do
        [ -z "$p" ] || args+=(-v "$p")
    done < <(sandbox_ro_mounts "$name")
    local p existed=""
    for p in $PROJECT_AGENT_CONFIG; do
        { [ -e "${root}/${p}" ] || [ -L "${root}/${p}" ]; } || continue
        existed+="${p} "
        args+=(-v "${root}/${p}:${root}/${p}:ro")
    done
    for p in "$HOME/.gitconfig" "${XDG_CONFIG_HOME:-$HOME/.config}/git"; do
        [ ! -e "$p" ] || args+=(-v "${p}:${p}:ro")
    done
    # The agent itself: Pulsar's prefix, or the native install's real files.
    if is_our_shim "${AGENT_SHIMS}/${A_BIN}"; then
        args+=(-v "${AGENT_PREFIX}:${AGENT_PREFIX}:ro" -e "NPM_CONFIG_PREFIX=${AGENT_PREFIX}")
        real="${AGENT_PREFIX}/bin/${A_BIN}"
    else
        args+=(-v "$(dirname "$real"):$(dirname "$real"):ro")
    fi
    local al
    while IFS= read -r al; do
        [ -n "$al" ] || continue
        case "$al" in
            *:rw) [ ! -e "${al%:rw}" ] || args+=(-v "${al%:rw}:${al%:rw}") ;;
            *)    [ ! -e "$al" ] || args+=(-v "${al}:${al}:ro") ;;
        esac
    done < <(sandbox_allows "$root")
    sandbox_hook_hints "$name" "$root"
    # The local model (pulsar agent model), if there is one: pasta forwards
    # exactly that port from the sandbox's loopback to the host's, and no
    # other host port is reachable. The key comes along, read-only.
    if [ -f "${MODEL_UNIT_DIR}/${MODEL_UNIT}.container" ]; then
        args+=(--network "pasta:-T,${MODEL_PORT}")
        [ ! -s "$MODEL_KEY" ] || args+=(-v "${MODEL_KEY}:${MODEL_KEY}:ro")
    fi
    [ ! -r "$AGENTS_MD" ] || args+=(-v "${AGENTS_MD}:/usr/share/pulsar/AGENTS.md:ro")
    [ ! -d "$SKILLS_DIR" ] || args+=(-v "${SKILLS_DIR}:/usr/share/pulsar/skills:ro")
    # The agent's own API key, if the user exported one; nothing else of the env.
    for p in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY OPENROUTER_API_KEY; do
        [ -z "${!p:-}" ] || args+=(-e "$p")
    done

    # Every pinned remote's URL, rewritten to the gate, in the env rather than
    # in the project's config, which the user's own git keeps using.
    sock="${XDG_RUNTIME_DIR:-/tmp}/pulsar/gate-${id}.sock"
    mkdir -p "$(dirname "$sock")"
    local n=0 rname url pin
    args+=(-v "${GATE_TOOL}:/usr/libexec/pulsar/pulsar-agent-gate:ro" -v "${sock}:/run/pulsar-gate.sock")
    # `gh pr create`, through the gate; the only gh there is in here
    local ghw="${XDG_RUNTIME_DIR:-/tmp}/pulsar/gh"
    printf '#!/bin/sh\n# the sandbox'"'"'s gh: pr create, through the gate (pulsar-agent-gate)\nexec python3 /usr/libexec/pulsar/pulsar-agent-gate gh /run/pulsar-gate.sock "$@"\n' > "$ghw"
    chmod 0755 "$ghw"
    args+=(-v "${ghw}:/usr/local/bin/gh:ro")
    # .git/config is read-only in here, so `push -u` cannot record tracking
    # (git says it did, after an error). autoSetupRemote makes a plain
    # `git push` of a new branch work without it.
    args+=(-e "GIT_CONFIG_KEY_0=protocol.ext.allow" -e "GIT_CONFIG_VALUE_0=always"
           -e "GIT_CONFIG_KEY_1=push.autoSetupRemote" -e "GIT_CONFIG_VALUE_1=true"); n=2
    while read -r rname url; do
        [ -n "$url" ] || continue
        args+=(-e "GIT_CONFIG_KEY_${n}=url.ext::python3 /usr/libexec/pulsar/pulsar-agent-gate connect /run/pulsar-gate.sock %s ${rname}.insteadOf"
               -e "GIT_CONFIG_VALUE_${n}=${url}")
        n=$((n + 1))
        pin=$(git -C "$root" config "remote.${rname}.url" 2>/dev/null) || pin=""
        [ "$pin" = "$url" ] || printf 'note: %s is pinned to %s, but the project now says %s (pulsar agent sandbox repin, if that is right)\n' \
            "$rname" "$url" "$pin" >&2
    done < <(git -C "$mirror" config --get-regexp '^remote\..*\.url$' | sed 's/^remote\.\(.*\)\.url /\1 /')
    args+=(-e "GIT_CONFIG_COUNT=${n}")

    local pushed="${XDG_RUNTIME_DIR:-/tmp}/pulsar/gate-${id}.pushed"
    rm -f "$pushed"
    PULSAR_GATE_PUSHED="$pushed" python3 "$GATE_TOOL" serve "$sock" "$mirror" \
        2>>"${XDG_RUNTIME_DIR:-/tmp}/pulsar/gate-${id}.log" &
    local gate_pid=$!
    # shellcheck disable=SC2064  # the values are fixed now, on purpose
    # git's own files are defused first: sandbox_tracking runs git on the host
    trap "kill ${gate_pid} 2>/dev/null; rm -f '${sock}'; sandbox_git_defuse '${root}' '${gitstate}'; sandbox_defuse '${root}' '${existed}'; sandbox_tracking '${root}' '${pushed}' '${mirror}'; sandbox_creds_out '${name}' '${home}' '${before}'" EXIT
    local waited=0
    while [ ! -S "$sock" ] && [ "$waited" -lt 50 ]; do sleep 0.1; waited=$((waited + 1)); done
    [ -S "$sock" ] || die "the push gate did not start (see ${XDG_RUNTIME_DIR:-/tmp}/pulsar/gate-${id}.log)"

    printf 'sandboxed: only %s is visible; push %s through the gate\n' "$root" "$policy" >&2
    [ "$name" != aider ] || [ ! -r "$AGENTS_MD" ] || set -- --read /usr/share/pulsar/AGENTS.md "$@"
    podman "${args[@]}" "$img" "$real" "$@"
}

# The one place that decides how an agent starts: the shim calls this.
agent_run() {
    local name="" mode=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --sandbox) mode=on ;;
            --no-sandbox) mode=off ;;
            --) shift; break ;;
            -*) die "unknown option: $1 (usage: pulsar agent run <name> [--sandbox|--no-sandbox] [-- args])" ;;
            *) [ -z "$name" ] || break; name=$1 ;;
        esac
        shift
    done
    [ -n "$name" ] || die "usage: pulsar agent run <name> [--sandbox|--no-sandbox] [-- args]"
    agent_row "$name" || die "unknown agent: ${name} (known: $(agent_names))"
    local root eff
    root=$(project_root)
    eff=$(setting_resolve sandbox "$root")
    if [ "$mode" = off ] && [ "${eff#*$'\t'}" = "this project: .pulsar/agent.toml" ]; then
        die "this project's .pulsar/agent.toml says to sandbox agents; remove that line to run one unsandboxed here"
    fi
    [ -n "$mode" ] || mode=${eff%%$'\t'*}
    if [ "$mode" = on ]; then
        sandbox_run "$name" "$@"
        return
    fi
    local cmd
    cmd=$(agent_command "$name") || die "${name} is not installed (pulsar agent add ${name})"
    # aider reads nothing unless told, so it is told about the guide here
    # rather than in the shim: decided at each start, it follows the image.
    [ "$name" != aider ] || [ ! -r "$AGENTS_MD" ] || set -- --read "$AGENTS_MD" "$@"
    if is_our_shim "$cmd"; then
        exec toolbox run -c "$AGENT_BOX" env NPM_CONFIG_PREFIX="$AGENT_PREFIX" "${AGENT_PREFIX}/bin/${A_BIN}" "$@"
    fi
    exec "$cmd" "$@"
}

# ---------------------------------------------------------------------------
# agent model -- a local model server, for an agent with no cloud account.
#
# llama.cpp's own server image, as a rootless podman quadlet: an
# OpenAI-compatible API on 127.0.0.1 only, the model fetched from Hugging Face
# by llama.cpp itself into ~/.local/share/pulsar/models. The image matches
# the hardware: CUDA on the nvidia image (the GPU through CDI), Vulkan where
# there is a /dev/dri, plain CPU otherwise.
#
# NOT started at login unless asked (--at-login): a loaded model holds
# gigabytes of VRAM, and this is also the machine the games run on.
#
# opencode and aider are the agents that take any provider. opencode gets a
# "Local (Pulsar)" provider added next to whatever it has, never replacing
# its default; aider gets the line to run. Nothing is installed on the host.
# ---------------------------------------------------------------------------
MODEL_UNIT_DIR=${PULSAR_QUADLET_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/containers/systemd}
MODEL_DIR=${PULSAR_MODEL_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/pulsar/models}
MODEL_PORT=${PULSAR_MODEL_PORT:-8080}
MODEL_DEFAULT=${PULSAR_MODEL_DEFAULT:-bartowski/Qwen2.5-Coder-7B-Instruct-GGUF}
MODEL_UNIT=pulsar-model
# The server's key. llama.cpp's defaults are no key and CORS open to every
# origin, so any web page in the browser could have used the model on
# 127.0.0.1. With a key it cannot, and CORS names only the server itself.
MODEL_KEY=${PULSAR_MODEL_KEY:-${XDG_CONFIG_HOME:-$HOME/.config}/pulsar/model-key}

model_key() {
    if [ ! -s "$MODEL_KEY" ]; then
        mkdir -p "$(dirname "$MODEL_KEY")"
        ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$MODEL_KEY" )
    fi
    cat "$MODEL_KEY"
}

# cuda | vulkan | cpu, for this machine
model_backend() {
    case "$(mf variant)" in
        *nvidia*) printf 'cuda\n'; return ;;
    esac
    if [ -e "${PULSAR_DRI:-/dev/dri}" ]; then printf 'vulkan\n'; else printf 'cpu\n'; fi
}

model_quadlet() {
    local model=$1 backend=$2 at_login=$3 image device=""
    case "$backend" in
        cuda)   image=ghcr.io/ggml-org/llama.cpp:server-cuda;   device="AddDevice=nvidia.com/gpu=all" ;;
        vulkan) image=ghcr.io/ggml-org/llama.cpp:server-vulkan; device="AddDevice=/dev/dri" ;;
        *)      image=ghcr.io/ggml-org/llama.cpp:server ;;
    esac
    cat <<EOF
# Written by \`pulsar agent model on\`; \`pulsar agent model off\` removes it.
# llama.cpp's server on 127.0.0.1:${MODEL_PORT} (OpenAI-compatible), ${backend}.
[Unit]
Description=Local model server for coding agents (${model})
After=network-online.target

[Container]
Image=${image}
${device}
PublishPort=127.0.0.1:${MODEL_PORT}:8080
Volume=${MODEL_DIR}:/models:Z
Volume=${MODEL_KEY}:/run/model-key:ro,Z
Environment=LLAMA_CACHE=/models
# --jinja: the model's own chat template, which is what makes tool calls work.
# The key, and CORS for the server's own origin only: see MODEL_KEY.
Exec=--host 0.0.0.0 --port 8080 -hf ${model} --jinja -ngl 999 -c 32768 --api-key-file /run/model-key --cors-origins http://127.0.0.1:${MODEL_PORT}
AutoUpdate=registry

[Service]
# the first start pulls the image and downloads the model
TimeoutStartSec=1800
Restart=on-failure
EOF
    if [ "$at_login" = 1 ]; then
        printf '\n[Install]\nWantedBy=default.target\n'
    fi
}

# The provider opencode shows as "Local (Pulsar)", next to its others.
model_opencode() {
    local action=$1 model=$2 f tmp id
    f="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
    [ -d "$(dirname "$f")" ] || return 0
    have jq || return 0
    [ -s "$f" ] || printf '{}\n' > "$f"
    jq -e . "$f" >/dev/null 2>&1 || { printf '%s is not JSON; add the local provider yourself\n' "$f"; return 0; }
    tmp=$(mktemp "${f}.XXXXXX")
    if [ "$action" = add ]; then
        id=$(basename "$model")
        jq --arg url "http://127.0.0.1:${MODEL_PORT}/v1" --arg id "$id" --arg key "$(model_key)" \
            '.provider["pulsar-local"] = {npm: "@ai-sdk/openai-compatible", name: "Local (Pulsar)",
               options: {baseURL: $url, apiKey: $key}, models: {($id): {name: $id, tool_call: true}}}' "$f" > "$tmp"
        printf 'opencode: added the "Local (Pulsar)" provider (pick it with /models)\n'
    else
        jq 'del(.provider["pulsar-local"]) | if .provider == {} then del(.provider) else . end' "$f" > "$tmp"
    fi
    chmod --reference="$f" "$tmp" && mv "$tmp" "$f"
}

agent_model() {
    local sub=${1:-} model="" at_login=0 purge=0 a
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --model) [ $# -ge 2 ] || die "--model wants a Hugging Face repo[:quant]"; model=$2; shift ;;
            --model=*) model=${1#--model=} ;;
            --at-login) at_login=1 ;;
            --purge) purge=1 ;;
            *) die "unknown option: $1 (see: pulsar agent --help)" ;;
        esac
        shift
    done
    local unit="${MODEL_UNIT_DIR}/${MODEL_UNIT}.container"
    case "$sub" in
        ""|status)
            if [ ! -f "$unit" ]; then
                printf 'model    off  (pulsar agent model on [--model <hf-repo[:quant]>])\n'
                return 0
            fi
            local state m
            state=$(systemctl --user is-active "${MODEL_UNIT}.service" 2>/dev/null) || true
            m=$(sed -n 's/^Exec=.* -hf \([^ ]*\) .*/\1/p' "$unit")
            printf 'model    %s  %s\n' "${state:-inactive}" "$m"
            printf 'endpoint http://127.0.0.1:%s/v1  (OpenAI-compatible)\n' "$MODEL_PORT"
            printf 'key      %s  (every request needs it)\n' "$MODEL_KEY"
            # shellcheck disable=SC2016  # the $(cat) is for the user to run
            printf 'aider    aider --openai-api-base http://127.0.0.1:%s/v1 --openai-api-key "$(cat %s)" --model openai/%s\n' \
                "$MODEL_PORT" "$MODEL_KEY" "$(basename "${m%%:*}")"
            ;;
        on)
            need podman
            [ -n "$model" ] || model=$MODEL_DEFAULT
            case "$model" in
                */*) ;;
                *) die "--model wants a Hugging Face repo, owner/name[:quant] (got: ${model})" ;;
            esac
            case "$model" in *[!A-Za-z0-9._:/-]*) die "not a model reference: ${model}" ;; esac
            local backend; backend=$(model_backend)
            mkdir -p "$MODEL_UNIT_DIR" "$MODEL_DIR"
            model_key >/dev/null
            model_quadlet "$model" "$backend" "$at_login" > "$unit"
            systemctl --user daemon-reload
            printf 'starting %s (%s); the first start downloads the image and the model\n' "$model" "$backend"
            systemctl --user restart "${MODEL_UNIT}.service" \
                || die "the model server did not start: journalctl --user -u ${MODEL_UNIT}"
            model_opencode add "$model"
            printf 'endpoint http://127.0.0.1:%s/v1\n' "$MODEL_PORT"
            printf 'key:     %s (every request needs it)\n' "$MODEL_KEY"
            # shellcheck disable=SC2016  # the $(cat) is for the user to run
            printf 'aider:   aider --openai-api-base http://127.0.0.1:%s/v1 --openai-api-key "$(cat %s)" --model openai/%s\n' \
                "$MODEL_PORT" "$MODEL_KEY" "$(basename "${model%%:*}")"
            [ "$at_login" = 1 ] || printf 'it stops at logout; --at-login to keep it running\n'
            ;;
        off)
            if [ -f "$unit" ]; then
                systemctl --user stop "${MODEL_UNIT}.service" 2>/dev/null || true
                rm -f "$unit"
                systemctl --user daemon-reload
                printf 'stopped and removed the local model server\n'
            else
                printf 'the local model server is not set up\n'
            fi
            model_opencode remove ""
            if [ "$purge" = 1 ]; then
                rm -rf "${MODEL_DIR:?}"
                printf 'deleted the downloaded models in %s\n' "$MODEL_DIR"
            elif [ -d "$MODEL_DIR" ]; then
                printf 'the downloaded models stay in %s (%s); --purge deletes them\n' \
                    "$MODEL_DIR" "$(du -sh "$MODEL_DIR" 2>/dev/null | cut -f1)"
            fi
            ;;
        *) die "unknown model command: ${sub} (see: pulsar agent --help)" ;;
    esac
}

