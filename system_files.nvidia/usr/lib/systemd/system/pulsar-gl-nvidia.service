# Installs org.freedesktop.Platform.GL(32).nvidia-<version> for the running
# driver and for the staged update's driver, so a Flatpak app never starts
# without the GPU driver it needs. The whole story is in the script's
# header.
#
# Started two ways: at boot (the [Install] below) and by
# pulsar-gl-nvidia.path whenever a deployment is staged. The staging trigger
# is the one that does the real work. It fetches the next driver's extension
# while the user is still on the old boot, so it is already present when the
# new boot's autostarted Steam mounts its extensions.
#
# Same retry shape as pulsar-flatpaks.service and for the same reason: at
# boot the network is often not up yet, and this image disables
# NetworkManager-wait-online. The script exits 0 when there is nothing it can
# do (all present, nothing on flathub yet, no flathub), so Restart= only
# loops on the failures that waiting fixes.
[Unit]
Description=Install the Flatpak GL extensions for the NVIDIA driver
Documentation=file:///usr/libexec/pulsar/gl-nvidia.sh
Wants=network-online.target
After=network-online.target

[Service]
# exec, not oneshot. A oneshot wanted by multi-user.target holds that target
# until it exits, and scx.service is ordered after multi-user.target -- so a
# boot that has to fetch ~1GB of GL extensions over a slow link would start
# the scheduler only when the download finished. As exec the unit is up the
# moment the script starts, and the download runs beside the boot.
Type=exec
ExecStart=/usr/libexec/pulsar/gl-nvidia.sh
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
