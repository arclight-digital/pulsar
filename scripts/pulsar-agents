# --------------------------------------------------------------- pure bits --
def terminal_palette(path, dark):
    """(foreground, background, cursor, [16 colors]) as hex from a Ptyxis
    palette file, the one the theme writes, or None."""
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    try:
        if not cp.read(path):
            return None
    except configparser.Error:
        return None
    sec = "Dark" if dark else "Light"
    if not cp.has_section(sec):
        sec = "Light" if dark else "Dark"
        if not cp.has_section(sec):
            return None
    g = cp[sec]
    try:
        colors = [g[f"Color{i}"] for i in range(16)]
        return g["Foreground"], g["Background"], g.get("Cursor"), colors
    except KeyError:
        return None


def dconf_string(key):
    """A string from dconf, read without the app's schema (GNOME Text Editor
    is a Flatpak, so its schema is not on the host; Gio.Settings aborts on a
    missing one)."""
    try:
        ok, out, _err, status = GLib.spawn_sync(None, ["dconf", "read", key], None, GLib.SpawnFlags.SEARCH_PATH,
                                                None, None)
    except GLib.Error:
        return None
    if not ok or status != 0:
        return None
    try:
        v = GLib.Variant.parse(None, out.decode().strip(), None, None)
    except GLib.Error:
        return None
    return v.get_string() if v.get_type_string() == "s" else None


def shell_tab_title(title, cwd):
    """A shell's tab: its folder's name. The shell's own title when it says
    where it is (bash's user@host:~/path) gives the folder; a title a
    program sets (an editor's, say) is kept as it is."""
    home = os.path.expanduser("~")

    def folder(path):
        path = os.path.expanduser(path.strip()).rstrip("/")
        return "~" if path in ("", home, "~") else os.path.basename(path)
    m = re.match(r"^[^@\s]+@[^:\s]+:(.+)$", title or "")
    if m:
        return folder(m.group(1))
    return title or folder(cwd or "")


def typing_key(keyval, state):
    """A key that types into the prompt: a character (without Ctrl or Alt),
    Enter, Backspace, Tab or Delete."""
    if state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.ALT_MASK):
        return False
    ch = Gdk.keyval_to_unicode(keyval)
    # a printable one: Escape has a character too (0x1b)
    return (ch >= 0x20 and ch != 0x7f) or keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_BackSpace,
                                                     Gdk.KEY_Tab, Gdk.KEY_Delete)


def wheel_command(pane, up, n, in_mode, sgr_mouse, alternate, cell):
    """The tmux command for n lines of wheel over a pane: tmux's history
    when scrolled back in it, or for a plain shell; the wheel itself, at the
    pointer's cell, to an agent that asked for SGR mouse reports (Claude
    Code's fullscreen scrolls its own transcript); nothing to any other
    agent on the alternate screen. Never arrow keys: in an agent's prompt Up
    brings back an old prompt, ready to send again."""
    if in_mode:
        return ["send", "-X", "-t", pane, "-N", str(n), "scroll-up" if up else "scroll-down"]
    if sgr_mouse:
        col, row = cell
        return ["send", "-t", pane, "-l", f"\x1b[<{64 if up else 65};{col};{row}M" * n]
    if up and not alternate:
        return ["copy-mode", "-e", "-t", pane, ";", "send", "-X", "-t", pane, "-N", str(n), "scroll-up"]
    return None


def ptyxis_palette_file():
    """The palette Ptyxis's default profile uses, if it is a file (a theme's)."""
    uuid = dconf_string("/org/gnome/Ptyxis/default-profile-uuid")
    pid = uuid and dconf_string(f"/org/gnome/Ptyxis/Profiles/{uuid}/palette")
    if not pid:
        return None
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    p = pathlib.Path(data) / "org.gnome.Ptyxis" / "palettes" / f"{pid}.palette"
    return p if p.is_file() else None


def snapshot_title(snap):
    """A snapshot from `agent undo --list --json`, as a row's title."""
    words = (snap.get("subject") or "").split()
    if "started" in words:
        return "Session started"
    if "restarted" in words:
        return "Session restarted"
    return "Snapshot"


def diff_summary(stat):
    """The last line of `git diff --stat`, or that nothing changed."""
    lines = [ln for ln in (stat or "").splitlines() if ln.strip()]
    return lines[-1].strip() if lines else "No changes since the session started"


def header_subtitle(s, now):
    """Under the session's name: the agent, what it is doing, where, and for
    Claude how full its context is."""
    parts = [AGENT_NAMES.get(s.get("agent"), s.get("agent") or "Started by hand"),
             session_status(s, now).split(" · ")[0]]
    if s.get("dir"):
        parts.append((s["dir"] if s.get("machine") else home(s["dir"]))
                     + (f" on {s['machine']}" if s.get("machine") else ""))
    return " · ".join(parts)


def load_state():
    """What the app remembers between runs: sessions with an unseen change,
    the last one open, recent folders, and each project's choices."""
    try:
        d = json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        d = {}
    if not isinstance(d, dict):
        d = {}
    d.setdefault("unseen", [])
    d.setdefault("recent", [])
    d.setdefault("projects", {})
    return d


def save_state(d):
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(d))
        tmp.replace(STATE_FILE)
    except OSError:
        pass


def is_repo(path):
    p = pathlib.Path(path or "/nonexistent")
    for d in (p, *p.parents):
        if (d / ".git").exists():
            return True
    return False


# ----------------------------------------------------------------- window ---
class Agents(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Agents", default_width=1200, default_height=780,
                         width_request=360, height_request=294)
        self.add_css_class("pulsar-agents")
        self.state = load_state()
        self.unseen = set(self.state["unseen"])
        self.sessions = {}      # name -> session JSON, archived ones too
        self.rows = {}          # name -> SessionRow
        self.terms = {}         # name -> Vte.Terminal
        self.collapsed = set()  # projects folded shut
        self.machines = []      # pulsar machine list
        self.remote = None      # pulsar machine sessions --json
        self.pending = None     # a session just started, not listed yet
        self.asked_home = False  # --new: the launcher, not the last session
        self._local = []
        self.current = None
        self.want = None        # a session asked for before it was listed
        self.listed_once = False
        self._shape = None
        self._poll = 0

        # sidebar: sessions by project
        new = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="New Session (Ctrl+Shift+N)")
        new.connect("clicked", lambda *_: self.new_session())
        self.new_button = new
        self.fold = Gtk.Button(icon_name="sidebar-show-symbolic", tooltip_text="Narrow the List (Ctrl+Shift+B)")
        self.fold.connect("clicked", lambda *_: self.set_compact(not self.compact))
        side_head = Adw.HeaderBar(show_end_title_buttons=False)
        side_head.pack_start(new)
        side_head.pack_end(self.fold)
        primary = Gio.Menu()
        primary.append("Preferences", "win.preferences")
        primary.append("Help", "win.help")
        self.primary_menu = Gtk.MenuButton(icon_name="open-menu-symbolic", tooltip_text="Main Menu",
                                           menu_model=primary, primary=True)
        side_head.pack_end(self.primary_menu)
        self.side_head = side_head
        self.list = Gtk.ListBox(css_classes=["navigation-sidebar", "sessions"])
        self.list.connect("row-activated", self._activated)
        self.empty = Gtk.Label(label="No sessions", valign=Gtk.Align.START, margin_top=18,
                               css_classes=["dim-label"])
        self.side_stack = Gtk.Stack()
        self.side_stack.add_named(self.empty, "empty")
        self.side_stack.add_named(Gtk.ScrolledWindow(child=self.list, hscrollbar_policy=Gtk.PolicyType.NEVER), "list")
        self.archived_button = Gtk.Button(css_classes=["flat", "footer-button"], margin_start=6, margin_end=6,
                                          margin_bottom=6, margin_top=4, visible=False)
        self.archived_button.connect("clicked", lambda *_: ArchivedDialog(self).present(self))
        self.compact_new = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="New Session (Ctrl+Shift+N)",
                                      css_classes=["tile-new"], halign=Gtk.Align.CENTER, margin_top=6,
                                      margin_bottom=4, visible=False)
        self.compact_new.connect("clicked", lambda *_: self.new_session())
        side_body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side_body.append(self.compact_new)
        side_body.append(self.side_stack)
        self.side_stack.set_vexpand(True)
        self.disk = DiskButton(self)
        foot = Gtk.Box(spacing=0)
        foot.append(self.disk.widget)
        foot.append(Gtk.Box(hexpand=True))
        foot.append(self.archived_button)
        self.foot = foot
        side = Adw.ToolbarView(content=side_body)
        side.add_top_bar(side_head)
        side.add_bottom_bar(foot)

        # content: the session's terminal, the status bar under it, the rail beside it
        self.title = Adw.WindowTitle(title="")
        self.title_dot = Gtk.Box(css_classes=["title-dot"], valign=Gtk.Align.CENTER, visible=False)
        title_box = Gtk.Box(spacing=8)
        title_box.append(self.title_dot)
        title_box.append(self.title)
        head = Adw.HeaderBar(title_widget=title_box)
        self.head_line = Gtk.Box(css_classes=["head-line"])
        self.rail_toggle = Gtk.ToggleButton(icon_name="sidebar-show-right-symbolic",
                                            tooltip_text="Changes, History and Messages (Ctrl+Shift+D)")
        self.shell_toggle = Gtk.ToggleButton(icon_name="utilities-terminal-symbolic",
                                             tooltip_text="Shell in the Session's Folder (Ctrl+`)")
        self.shell_toggle.connect("toggled", lambda b: self._show_shell(b.get_active()))
        self.menu_button = Gtk.MenuButton(icon_name="view-more-symbolic", tooltip_text="Session",
                                          menu_model=self._menu())
        head.pack_end(self.menu_button)
        head.pack_end(self.rail_toggle)
        # a dot on it: a hidden shell finished a command or rang its bell
        self.shell_dot = Gtk.Box(css_classes=["shell-dot"], halign=Gtk.Align.END, valign=Gtk.Align.START,
                                 can_target=False, visible=False)
        shell_over = Gtk.Overlay(child=self.shell_toggle)
        shell_over.add_overlay(self.shell_dot)
        head.pack_end(shell_over)
        self.banner = Adw.Banner(use_markup=False)
        self.banner.connect("button-clicked", lambda *_: self._banner_clicked())
        # sized by the page showing: the home's minimum must not widen a session
        self.term_stack = Gtk.Stack(vexpand=True, transition_type=Gtk.StackTransitionType.CROSSFADE,
                                    transition_duration=150, hhomogeneous=False, vhomogeneous=False)
        again = Gtk.Button(label="Continue", halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER,
                           css_classes=["pill", "suggested-action"])
        again.connect("clicked", lambda *_: self.resume())
        self.stopped = again
        self.term_stack.add_named(self.stopped, "stopped")
        retry = Gtk.Button(label="Try Again", halign=Gtk.Align.CENTER, css_classes=["pill"])
        retry.connect("clicked", lambda *_: self.retry_machines())
        self.offline_page = Adw.StatusPage(icon_name="network-server-symbolic", child=retry)
        self.term_stack.add_named(self.offline_page, "offline")
        self.term_stack.connect("notify::visible-child", self._sizes)
        self.launcher = Launcher(self)
        self.term_stack.add_named(self.launcher.widget, "none")
        self.term_stack.set_visible_child_name("none")
        # A shell of your own under the agent, in the session's folder (one
        # per session, kept while the app runs), as an editor's terminal panel
        # (a tab view of shells per session: tabs, as an editor's panel has)
        self.shells = {}
        self.shell_stack = Gtk.Stack(vexpand=True, hhomogeneous=False, vhomogeneous=False)
        new_tab = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="New Shell (Ctrl+Shift+`)",
                             css_classes=["flat"])
        new_tab.connect("clicked", lambda *_: self.new_shell())
        self.shell_tabs = Adw.TabBar(autohide=False, end_action_widget=new_tab, css_classes=["shell-tabs"])
        self.shell_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["shell-panel"], visible=False)
        self.shell_box.append(self.shell_tabs)
        self.shell_box.append(self.shell_stack)
        self.paned = Gtk.Paned(orientation=Gtk.Orientation.VERTICAL, start_child=self.term_stack,
                               end_child=self.shell_box, resize_start_child=True, shrink_start_child=False,
                               resize_end_child=False, shrink_end_child=False, vexpand=True,
                               css_classes=["shell-split"])
        self.paned.connect("notify::position", lambda *_: self._shell_moved())
        center = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        center.append(self.paned)
        self.status = StatusBar(self)
        center.append(self.status.outer)
        self.rail = Rail(self)
        self.overlay = Adw.OverlaySplitView(content=center, sidebar=self.rail.widget,
                                            sidebar_position=Gtk.PackType.END, show_sidebar=False,
                                            min_sidebar_width=340, max_sidebar_width=560, sidebar_width_fraction=.4)
        self.rail_toggle.bind_property("active", self.overlay, "show-sidebar",
                                       GObject.BindingFlags.BIDIRECTIONAL | GObject.BindingFlags.SYNC_CREATE)
        self.overlay.connect("notify::show-sidebar", lambda *_: self.rail.shown(self.overlay.get_show_sidebar()))
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.append(self.banner)
        body.append(self.overlay)
        self.overlay.set_vexpand(True)
        content = Adw.ToolbarView(content=body, css_classes=["stage"])
        content.add_top_bar(head)
        content.add_top_bar(self.head_line)

        self.split = Adw.NavigationSplitView(sidebar=Adw.NavigationPage(child=side, title="Agents"),
                                             content=Adw.NavigationPage(child=content, title="Session"),
                                             min_sidebar_width=250, max_sidebar_width=330)
        self.compact = False
        self.toasts = Adw.ToastOverlay(child=self.split)
        self.set_content(self.toasts)
        # it arrives rather than appears, as Pulsar Commands does
        self.split.set_opacity(0)
        self.fade_in = Adw.TimedAnimation.new(self.split, 0, 1, 180,
                                              Adw.PropertyAnimationTarget.new(self.split, "opacity"))
        self.connect("map", lambda *_: self.fade_in.play())
        narrow = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 640sp"))
        narrow.add_setter(self.split, "collapsed", True)
        self.add_breakpoint(narrow)
        mid = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 1000sp"))
        mid.add_setter(self.overlay, "collapsed", True)
        self.add_breakpoint(mid)

        for name, cb in (("stop", lambda: self.stop_session()), ("rename", lambda: self.rename()),
                         ("terminal", lambda: self.open_in_terminal()), ("new", lambda: self.new_session()),
                         ("archive-current", lambda: self.current and self.archive(self.current)),
                         ("rail", lambda: self.rail_toggle.set_active(not self.rail_toggle.get_active())),
                         ("shell", lambda: self.shell_toggle.get_sensitive()
                          and self.shell_toggle.set_active(not self.shell_toggle.get_active())),
                         ("shell-new", lambda: self.new_shell()),
                         ("next", lambda: self.cycle(1)), ("previous", lambda: self.cycle(-1)),
                         ("fold", lambda: self.set_compact(not self.compact)),
                         ("preferences", lambda: Preferences(self).present(self)),
                         ("help", lambda: Help().present(self))):
            a = Gio.SimpleAction.new(name, None)
            a.connect("activate", lambda _a, _p, cb=cb: cb())
            self.add_action(a)
        for name, cb in (("archive", self.archive), ("rename-session", lambda n: self.rename(n)),
                         ("goto", lambda n: self.show_session(n))):
            a = Gio.SimpleAction.new(name, GLib.VariantType.new("s"))
            a.connect("activate", lambda _a, p, cb=cb: cb(p.get_string()))
            self.add_action(a)
        for action, keys in (("win.help", ["F1"]), ("win.preferences", ["<Ctrl>comma"]), ("win.new", ["<Ctrl><Shift>n"]), ("win.archive-current", ["<Ctrl><Shift>Delete"]),
                             ("win.rail", ["<Ctrl><Shift>d"]), ("win.fold", ["<Ctrl><Shift>b"]),
                             ("win.shell", ["<Ctrl>grave"]), ("win.shell-new", ["<Ctrl><Shift>asciitilde"]),
                             ("win.next", ["<Ctrl>Page_Down"]), ("win.previous", ["<Ctrl>Page_Up"])):
            app.set_accels_for_action(action, keys)
        for i in range(1, 10):
            a = Gio.SimpleAction.new(f"nth-{i}", None)
            a.connect("activate", lambda *_a, i=i: self.nth(i))
            self.add_action(a)
            app.set_accels_for_action(f"win.nth-{i}", [f"<Alt>{i}"])
        self._actions_for(None)

        self.palette_file = ptyxis_palette_file()
        self.stage_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.stage_css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self._stage()
        Adw.StyleManager.get_default().connect("notify::dark", lambda *_: self._recolor())
        self.connect("notify::visible", lambda *_: self._start_poll())
        self.connect("notify::is-active", lambda *_: self.is_active() and self._seen(self.current))
        if self.state.get("compact"):
            self.set_compact(True)
        run([PULSAR, "machine", "list", "--json"], self._machines)
        # archived sessions older than a week go (never a worktree with uncommitted changes)
        if self.tidy_days():
            run([PULSAR, "agent", "sessions", "--tidy", "--days", str(self.tidy_days())], lambda *_: self.refresh())
        else:
            self.refresh()
        self._start_poll()

    def tidy_days(self):
        d = self.state.get("tidy_days", 7)
        return d if d in [c for c, _ in TIDY_CHOICES] else 7

    # ---- the list, narrowed to its tiles for focus ----
    def set_compact(self, on):
        self.compact = on
        self.split.set_min_sidebar_width(70 if on else 250)
        self.split.set_max_sidebar_width(70 if on else 330)
        self.split.set_sidebar_width_fraction(0 if on else .25)
        self.side_head.set_show_title(not on)
        self.new_button.set_visible(not on)
        self.primary_menu.set_visible(not on)
        # the + tile says it, in a column too narrow for words
        self.empty.set_visible(not on)
        self.compact_new.set_visible(on)
        self.fold.set_icon_name("sidebar-show-right-symbolic" if on else "sidebar-show-symbolic")
        self.fold.set_tooltip_text("Widen the List (Ctrl+Shift+B)" if on else "Narrow the List (Ctrl+Shift+B)")
        self._archived_label()
        self.foot.set_orientation(Gtk.Orientation.VERTICAL if on else Gtk.Orientation.HORIZONTAL)
        self.disk.set_compact(on)
        # one tight, centered column of icons
        self.archived_button.set_halign(Gtk.Align.CENTER if on else Gtk.Align.FILL)
        for side, wide in (("start", 6), ("end", 6), ("top", 4)):
            getattr(self.archived_button, f"set_margin_{side}")(0 if on else wide)
        (self.add_css_class if on else self.remove_css_class)("compact")
        self._shape = None
        self._rebuild()
        self.remember(compact=on)

    def _archived_label(self):
        n = sum(1 for x in self.sessions.values() if x.get("archived"))
        if self.compact:
            self.archived_button.set_child(Gtk.Image(icon_name="document-open-recent-symbolic"))
            self.archived_button.set_tooltip_text(f"Archived · {n}")
        else:
            self.archived_button.set_child(Adw.ButtonContent(icon_name="document-open-recent-symbolic",
                                                             label=f"Archived · {n}"))
            self.archived_button.set_tooltip_text(None)
        self.archived_button.set_visible(bool(n))

    # ---- remembered state ----
    def remember(self, **kw):
        self.state.update(kw)
        self.state["unseen"] = sorted(self.unseen)
        save_state(self.state)

    def _seen(self, name):
        if name and name in self.unseen:
            self.unseen.discard(name)
            if name in self.rows:
                self.rows[name].update(self.sessions[name], self._now(), False)
            self.remember()

    @staticmethod
    def _now():
        return GLib.get_real_time() // 1_000_000

    # ---- polling ----
    def _start_poll(self):
        if self._poll == 0 and self.get_visible():
            self._poll = GLib.timeout_add_seconds(POLL_S, self._tick)

    def _tick(self):
        if not self.get_visible():
            self._poll = 0
            return False
        self.refresh()
        return True

    def refresh(self):
        run([PULSAR, "agent", "sessions", "--json"], self._listed)
        # other machines every few polls, in the background; slower, and a
        # gone machine costs its timeout
        self._ticks = getattr(self, "_ticks", 0) + 1
        if self.machines and self._ticks % 3 == 1 and not getattr(self, "_remote_busy", False):
            self._remote_busy = True
            run([PULSAR, "machine", "sessions", "--json"], self._remote_listed)

    def _remote_listed(self, ok, out):
        self._remote_busy = False
        d = parse(out) if ok else None
        if isinstance(d, dict):
            self.remote = d
            # what each machine had when it last answered, for when it doesn't
            seen = remember_machines(self.state.get("machines_seen"), d, self._now())
            old = self.state.get("machines_seen") or {}
            # written when what a machine has changes, and its time every few
            # minutes (that's all "seen 2 h ago" needs), not on every poll
            if any((v.get("sessions") != (old.get(m) or {}).get("sessions"))
                   or v.get("at", 0) - (old.get(m) or {}).get("at", 0) >= 300 for m, v in seen.items()):
                self.remember(machines_seen=seen)
            self._apply(self._local)

    def _machines(self, ok, out):
        found = parse(out) if ok else None
        self.machines = [m["name"] for m in found] if isinstance(found, list) else []
        if self.machines:
            self._ticks = 0
            self.refresh()

    def _notify(self, s):
        n = Gio.Notification.new(f"{session_title(s)} on {s['machine']} needs you")
        n.set_body(AGENT_NAMES.get(s.get("agent"), s.get("agent") or "The agent") + " is waiting for you.")
        n.set_default_action_and_target_value("app.open-session", GLib.Variant.new_string(s["name"]))
        self.get_application().send_notification(f"session-{s['name']}", n)

    def agent_argv(self, *args):
        """pulsar agent <args>, on whichever machine the session named is on"""
        return _agent_argv(self.sessions, *args)

    def _listed(self, ok, out):
        found = parse(out) if ok else None
        if not isinstance(found, list):
            return
        self._local = found
        self._apply(found)

    def _apply(self, local):
        found = merge_machine_sessions(local, self.remote, self.state.get("machines_seen"), self.machines)
        before = self.sessions
        for s in found:
            # another machine's agent files aren't here: Claude's usage comes in its JSON
            s["meter"] = (session_meter(s) if not s.get("archived")
                          and (not s.get("machine") or s.get("agent") == "claude") else None)
            # the agent quit and its pane sits at a shell: here that is a
            # stopped session (Continue), not a shell to use; a terminal
            # attached elsewhere still has the shell
            if s.get("exited") is not None and s.get("state") != "ended":
                s["state"], s["lingering"] = "ended", True
        self.sessions = {s["name"]: s for s in found}
        if self.listed_once:
            looking = self.current if self.is_active() else None
            self.unseen |= newly_unseen(before, self.sessions, looking)
            # here, the CLI's bell hook notifies; another machine's can't reach
            # this desktop, so the app does, while it runs
            for k, s in self.sessions.items():
                if (s.get("machine") and s.get("state") == "waiting" and k != looking
                        and before.get(k, {}).get("state") not in (None, "waiting", "offline")):
                    self._notify(s)
        self.unseen &= set(self.sessions)
        if self.unseen != set(self.state["unseen"]):
            self.remember()
        self._rebuild()
        self._archived_label()
        now = self._now()
        if self.current in self.sessions and self.sessions[self.current].get("offline"):
            # its machine isn't answering (or not yet): the page says so, kept current
            self._show_offline(self.current, self.sessions[self.current])
        elif (self.current in self.sessions and not self.sessions[self.current].get("archived")
                and self.term_stack.get_visible_child_name() == "offline"):
            # its machine answers again: open it as any session
            self.show_session(self.current, resume=False)
        elif self.current in self.sessions and not self.sessions[self.current].get("archived"):
            self.pending = None
            s = self.sessions[self.current]
            self.title.set_title(session_title(s))
            self.title.set_subtitle(header_subtitle(s, now))
            self._actions_for(s)
            old = before.get(self.current, {})
            if s.get("lingering") and not old.get("lingering"):
                self._show_stopped(s)
            # the agent finished a turn or wants something: its changes are worth a look
            if s.get("state") == "waiting" and old.get("state") != "waiting":
                self.rail.reload()
            self.rail.session_changed(s, old)
            self.status.update(s, now)
        elif self.current and self.current != self.pending:
            # gone (archived elsewhere, forgotten); one just started isn't listed
            # until the CLI has made its worktree and tmux, so it is waited for
            self._clear_current()
        if self.term_stack.get_visible_child_name() == "none" and self.listed_once:
            self.launcher._cards()
        if self.want and self.want in self.sessions:
            w, self.want = self.want, None
            self.show_session(w)
        elif self.want and not self.listed_once and "@" not in self.want:
            # asked for one this machine doesn't have: the launcher, not nothing
            self.want = None
            self.launcher.show()
        elif not self.listed_once and not self.current and not self.want and not self.asked_home:
            last = self.state.get("last")
            if last in self.sessions and not self.sessions[last].get("archived"):
                self.show_session(last, resume=False)
            else:
                self.launcher.show()
        self.listed_once = True

    def _rebuild(self):
        """The sidebar: a heading per project, its sessions under it. Rows are
        kept and updated; the list is rebuilt only when what is in it moves."""
        groups = project_groups(self.sessions.values())
        projects = [p for p, _ss in groups]
        shape = tuple((p, p in self.collapsed, tuple(s["name"] for s in ss)) for p, ss in groups)
        now = self._now()
        if shape != self._shape:
            self._shape = shape
            while (r := self.list.get_first_child()) is not None:
                self.list.remove(r)
            rows = {}
            for p, ss in groups:
                # folded stays folded, narrowed or not
                self.list.append(ProjectRow(p, project_label(p, projects), p in self.collapsed, self.compact))
                if p in self.collapsed:
                    continue
                for s in ss:
                    rows[s["name"]] = self.rows.get(s["name"]) or SessionRow(self, s["name"])
                    rows[s["name"]].set_compact(self.compact)
                    self.list.append(rows[s["name"]])
            self.rows = rows
        for p, ss in groups:
            for s in ss:
                if s["name"] in self.rows:
                    self.rows[s["name"]].update(s, now, s["name"] in self.unseen)
        r = self.list.get_first_child()
        while r is not None:
            if isinstance(r, ProjectRow):
                ss = dict(groups).get(r.project, [])
                r.set_attention(any(s.get("state") == "waiting" or s["name"] in self.unseen for s in ss))
            r = r.get_next_sibling()
        self.side_stack.set_visible_child_name("list" if groups else "empty")
        if self.current in self.rows:
            self.list.select_row(self.rows[self.current])

    def _activated(self, _list, row):
        if isinstance(row, ProjectRow):
            (self.collapsed.discard if row.project in self.collapsed else self.collapsed.add)(row.project)
            self._shape = None
            self._rebuild()
        else:
            self.show_session(row.name)

    def visible_names(self):
        return [s["name"] for p, ss in project_groups(self.sessions.values()) if p not in self.collapsed for s in ss]

    def cycle(self, step):
        names = self.visible_names()
        if not names:
            return
        i = names.index(self.current) + step if self.current in names else 0
        self.show_session(names[i % len(names)], resume=False)

    def nth(self, i):
        names = self.visible_names()
        if i <= len(names):
            self.show_session(names[i - 1], resume=False)

    def _clear_current(self):
        self.current = None
        self.status.update(None, 0)
        self.title.set_title("")
        self.title.set_subtitle("")
        self.term_stack.set_visible_child_name("none")
        self.banner.set_revealed(False)
        self._actions_for(None)
        self.overlay.set_show_sidebar(False)

    # ---- one session ----
    def show_session(self, name, resume=True):
        s = self.sessions.get(name)
        if s is None:
            self.want = name
            self.refresh()
            return
        if s.get("archived"):
            self.unarchive(name)
        if s.get("offline"):
            self._show_offline(name, s)
            return
        self.current = name
        self._seen(name)
        self.remember(last=name)
        self.title.set_title(session_title(s))
        self.title.set_subtitle(header_subtitle(s, self._now()))
        if name in self.rows:
            self.list.select_row(self.rows[name])
        self._actions_for(s)
        self.status.update(s, self._now())
        self.banner.set_revealed(False)
        t = self.terms.get(name)
        if t is not None and not t.dead and not s.get("lingering"):
            self.term_stack.set_visible_child(t)
            t.grab_focus()
        elif s.get("state") != "ended":
            self.attach(name)
        elif resume:
            self.resume()
        else:
            self._show_stopped(s)
        self.split.set_show_content(True)
        self.rail.set_session(s)

    def _show_stopped(self, s):
        self.term_stack.set_visible_child_name("stopped")

    def _show_offline(self, name, s):
        """A session on a machine that isn't answering: what's known, and Retry."""
        self.current = name
        if name in self.rows:
            self.list.select_row(self.rows[name])
        self.title.set_title(session_title(s))
        self.title.set_subtitle(header_subtitle(s, self._now()))
        self._actions_for(None)
        self.banner.set_revealed(False)
        self.overlay.set_show_sidebar(False)
        self.rail.set_session(s)
        self.status.update(s, self._now())
        m = s.get("machine")
        if s.get("offline") == "checking":
            self.offline_page.set_title(f"Checking {m}")
            self.offline_page.set_description(None)
        else:
            w = when(s.get("seen_at"), self._now())
            self.offline_page.set_title(f"{m} isn't answering")
            self.offline_page.set_description((f"Last seen {w}. " if w else "")
                                              + "It may be asleep, off, or on another network.")
        self.term_stack.set_visible_child_name("offline")
        self.split.set_show_content(True)

    def retry_machines(self):
        self._ticks = 0
        self.offline_page.set_title("Checking…")
        self.offline_page.set_description(None)
        self.refresh()

    def resume(self):
        """A stopped session comes back in place: `agent attach` starts it
        again, on its conversation where the agent can."""
        s = self.sessions.get(self.current)
        if not s:
            return
        self.banner.set_title(resume_note(s) + "…")
        self.banner.set_button_label(None)
        self.banner.set_revealed(True)
        if s.get("lingering"):
            # its pane is a shell now: end it, then attach starts the agent again
            name = self.current
            s["lingering"] = False
            run(self.agent_argv("sessions", "--kill", name), lambda *_: name == self.current and self.resume())
            return
        t = self.attach(self.current)
        t.resuming = True
        GLib.timeout_add_seconds(2, lambda: self.refresh() and False)
        GLib.timeout_add_seconds(10, lambda: self._resumed(t) and False)

    def _resumed(self, t):
        if getattr(t, "resuming", False):
            t.resuming = False
            if t.name == self.current and not t.dead:
                self.banner.set_revealed(False)
        return False

    def _drew(self, t):
        # its tmux client is there once something is drawn: if it attached
        # after its terminal was hidden, it still mustn't size the window
        if not getattr(t, "sized", False):
            t.sized = True
            self._sizes()
        if getattr(t, "resuming", False) and not getattr(t, "hide_pending", False):
            t.hide_pending = True
            GLib.timeout_add(1200, lambda: (setattr(t, "hide_pending", False), self._resumed(t)) and False)

    def _terminal(self, name):
        old = self.terms.pop(name, None)
        if old is not None:
            self.term_stack.remove(old)
        t = Vte.Terminal(hexpand=True, vexpand=True, scroll_on_output=False, scroll_on_keystroke=True,
                         audible_bell=False, enable_fallback_scrolling=True)
        t.dead = False
        t.name = name
        t.started = self._now()
        t.connect("child-exited", self._exited)
        t.connect("bell", lambda term: None)
        t.connect("contents-changed", self._drew)
        # a terminal's own copy and paste keys; every other key is the agent's
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self._term_key, t)
        t.add_controller(keys)
        # the wheel scrolls tmux's history: tmux's mouse is off in the view,
        # so a drag stays the terminal's own selection
        wheel = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL,
                                          propagation_phase=Gtk.PropagationPhase.CAPTURE)
        wheel.connect("scroll", self._term_scroll, t)
        t.add_controller(wheel)
        # where the pointer is, for the wheel sent to an agent that tracks it
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", lambda _c, x, y: setattr(t, "pointer", (x, y)))
        t.add_controller(motion)
        self._color(t)
        self.terms[name] = t
        self.term_stack.add_child(t)
        self.term_stack.set_visible_child(t)
        return t

    def _cell(self, t):
        """The pointer's cell, 1-based (column, row), as a mouse report gives it."""
        x, y = getattr(t, "pointer", (0, 0))
        cw, ch = max(1, t.get_char_width()), max(1, t.get_char_height())
        return (min(t.get_column_count(), int(x // cw) + 1), min(t.get_row_count(), int(y // ch) + 1))

    def _term_key(self, _c, keyval, _code, state, t):
        mods = state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK | Gdk.ModifierType.ALT_MASK)
        # the shell panel, from the agent or the shell: Ctrl+` (a terminal
        # would send it on as NUL)
        if mods == Gdk.ModifierType.CONTROL_MASK and keyval == Gdk.KEY_grave:
            self.activate_action("win.shell", None)
            return True
        if mods == Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK \
                and keyval in (Gdk.KEY_grave, Gdk.KEY_asciitilde):
            self.activate_action("win.shell-new", None)
            return True
        if mods != Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK:
            # scrolled back into tmux's history: typing leaves it first, as a
            # terminal's scroll-on-keystroke does (in copy mode tmux would
            # take the key, and g, / or r even do something). Escape, Ctrl+C,
            # arrows and Page Up stay tmux's, to move through it or leave it:
            # passed on, Escape and Ctrl+C would interrupt the agent.
            if getattr(t, "scrolled", False) and typing_key(keyval, state):
                t.scrolled = False
                pane = self._pane(t)
                if pane:
                    try:
                        GLib.spawn_sync(None, ["tmux", "-L", TMUX_SOCKET, "if", "-F", "-t", pane, "#{pane_in_mode}",
                                               f"send -X -t {pane} cancel"], None, GLib.SpawnFlags.SEARCH_PATH,
                                        None, None)
                    except GLib.Error:
                        pass
            return False
        if keyval in (Gdk.KEY_C, Gdk.KEY_c):
            t.copy_clipboard_format(Vte.Format.TEXT)
            return True
        if keyval in (Gdk.KEY_V, Gdk.KEY_v):
            t.paste_clipboard()
            return True
        return False

    def _client_tty(self, t):
        """/dev/pts/N: the tty of this terminal's tmux client."""
        pty = t.get_pty()
        if pty is None:
            return None
        try:
            return f"/dev/pts/{struct.unpack('I', fcntl.ioctl(pty.get_fd(), 0x80045430, b'\0' * 4))[0]}"  # TIOCGPTN
        except OSError:
            return None

    def _sizes(self, *_):
        """Only the terminal on screen counts toward its window's size: the
        hidden ones keep the size they last had, and with the app's views a
        window follows its smallest client (agent sizes), so they're marked
        ignore-size. Another machine's clients are that machine's."""
        shown = self.term_stack.get_visible_child()
        for name, t in list(self.terms.items()):
            if t.dead or (self.sessions.get(name) or {}).get("machine"):
                continue
            tty = self._client_tty(t)
            if not tty:
                continue
            flag = "!ignore-size" if t is shown else "ignore-size"
            try:
                GLib.spawn_async(["tmux", "-L", TMUX_SOCKET, "refresh-client", "-t", tty, "-f", flag],
                                 flags=GLib.SpawnFlags.SEARCH_PATH)
            except GLib.Error:
                pass

    def _pane(self, t):
        """The tmux pane this terminal shows, found by its client's tty."""
        if getattr(t, "pane", None):
            return t.pane
        # a failed lookup (the client not attached yet) is tried again, but
        # not on every wheel event: each is a blocking tmux call
        now = time.monotonic()
        if now - getattr(t, "pane_tried", 0) < 2:
            return None
        t.pane_tried = now
        pty = t.get_pty()
        if pty is None:
            return None
        try:
            n = struct.unpack("I", fcntl.ioctl(pty.get_fd(), 0x80045430, b"\0" * 4))[0]  # TIOCGPTN
            ok, out, _e, st = GLib.spawn_sync(None, ["tmux", "-L", TMUX_SOCKET, "display", "-c", f"/dev/pts/{n}",
                                                     "-p", "#{pane_id}"], None, GLib.SpawnFlags.SEARCH_PATH,
                                              None, None)
        except (OSError, GLib.Error):
            return None
        pane = out.decode().strip() if ok and st == 0 else ""
        t.pane = pane if pane.startswith("%") else None
        return t.pane

    def _term_scroll(self, _c, _dx, dy, t):
        # another machine's session: its view has tmux's mouse on, there, so
        # the wheel goes through the terminal to it; no pane here to drive
        if (self.sessions.get(getattr(t, "name", None)) or {}).get("machine"):
            return False
        pane = self._pane(t)
        if not pane or not dy:
            return False
        n = max(1, round(abs(dy) * 3))
        try:
            _ok, out, _e, _st = GLib.spawn_sync(None, ["tmux", "-L", TMUX_SOCKET, "display", "-p", "-t", pane,
                                                      "#{pane_in_mode} #{mouse_any_flag} #{mouse_sgr_flag} "
                                                      "#{alternate_on}"], None, GLib.SpawnFlags.SEARCH_PATH,
                                               None, None)
            mode, mouse, sgr, alt = (out or b"").decode().split()
        except (GLib.Error, ValueError):
            return False
        cmd = wheel_command(pane, dy < 0, n, mode == "1", mouse == "1" and sgr == "1", alt == "1",
                            self._cell(t))
        if not cmd:
            return True
        if dy < 0 and mode != "1" and cmd[0] == "copy-mode":
            t.scrolled = True
        try:
            GLib.spawn_async(["tmux", "-L", TMUX_SOCKET, *cmd], flags=GLib.SpawnFlags.SEARCH_PATH)
        except GLib.Error:
            return False
        return True

    def spawn(self, name, argv):
        t = self._terminal(name)
        # PULSAR_AGENT_VIEW: attach through the app's own view of the session
        # (agent attach: no tmux keys, menus or status line here; a terminal
        # attached elsewhere keeps them)
        env = ["TMUX=", "TERM_PROGRAM=pulsar-agents", "PULSAR_AGENT_VIEW=1"]
        t.spawn_async(Vte.PtyFlags.DEFAULT, os.path.expanduser("~"), argv, env, GLib.SpawnFlags.DEFAULT,
                      None, None, -1, None, self._spawned, name)
        t.grab_focus()
        return t

    def _spawned(self, term, pid, error, name):
        if error is not None:
            term.dead = True
            self.alert("Could not open the session", error.message)

    def attach(self, name):
        return self.spawn(name, self.agent_argv("attach", name))

    def _exited(self, term, status):
        term.dead = True
        term.resuming = False

        def then(ok, out):
            self._listed(ok, out)
            if term.name != self.current or self.terms.get(term.name) is not term:
                return
            s = self.sessions.get(term.name)
            if s is None:
                # it never started: what the CLI said stays on screen
                self.pending = None
                self.banner.set_title("The session didn't start")
                self.banner.set_button_label(None)
                self.banner.set_revealed(True)
                return
            if s.get("offline"):
                self._show_offline(term.name, s)
                return
            if s.get("state") in ("running", "waiting"):
                self.banner.set_title("Detached")
                self.banner.set_button_label("Attach")
                self.banner.set_revealed(True)
            else:
                self.banner.set_revealed(False)
                self._show_stopped(s)
        run([PULSAR, "agent", "sessions", "--json"], then)

    def _banner_clicked(self):
        if self.current and not (self.sessions.get(self.current) or {}).get("offline"):
            self.banner.set_revealed(False)
            self.attach(self.current)

    # ---- colors: the terminal follows the theme Ptyxis has ----
    def _color(self, t):
        pal = terminal_palette(self.palette_file, Adw.StyleManager.get_default().get_dark()) if self.palette_file else None
        if not pal:
            return
        fg, bg, cursor, colors = pal

        def rgba(h):
            c = Gdk.RGBA()
            c.parse(h)
            return c
        t.set_colors(rgba(fg), rgba(bg), [rgba(c) for c in colors])
        if cursor:
            t.set_color_cursor(rgba(cursor))

    def _recolor(self):
        for t in [*self.terms.values(), *self._all_shells()]:
            self._color(t)
        self._stage()

    def _stage(self):
        """The terminal's own background under the whole session area, so the
        terminal, the header over it and the status bar are one surface."""
        pal = terminal_palette(self.palette_file, Adw.StyleManager.get_default().get_dark()) if self.palette_file else None
        fg, bg = (pal[0], pal[1]) if pal else ("@view_fg_color", "@view_bg_color")
        self.stage_css.load_from_string(stage_css(fg, bg))

    # ---- actions ----
    def _menu(self):
        m = Gio.Menu()
        m.append("Rename…", "win.rename")
        m.append("Open in Terminal", "win.terminal")
        end = Gio.Menu()
        end.append("Stop", "win.stop")
        end.append("Archive", "win.archive-current")
        m.append_section(None, end)
        return m

    def _title_state(self, s):
        st = (s or {}).get("state")
        for c in ("working", "needs"):
            self.title_dot.remove_css_class(c)
        self.head_line.remove_css_class("needs")
        if st == "running":
            self.title_dot.add_css_class("working")
        elif st == "waiting":
            self.title_dot.add_css_class("needs")
            self.head_line.add_css_class("needs")
        self.title_dot.set_visible(st in ("running", "waiting"))

    def _actions_for(self, s):
        self._title_state(s)
        live = bool(s) and s.get("state") != "ended"
        for name, on in (("stop", live), ("rename", bool(s)), ("archive-current", bool(s)),
                         ("terminal", bool(s) and bool(s.get("agent")))):
            self.lookup_action(name).set_enabled(on)
        self.menu_button.set_sensitive(bool(s))
        self.rail_toggle.set_sensitive(bool(s))
        self.shell_toggle.set_sensitive(bool(s) and bool(s.get("dir") or s.get("machine")))
        self._shell_follow(s)

    # ---- the shell panel ----
    def _all_shells(self):
        for view in self.shells.values():
            for k in range(view.get_n_pages()):
                yield view.get_nth_page(k).get_child()

    def _show_shell(self, on):
        s = self.sessions.get(self.current)
        if on and not s:
            self.shell_toggle.set_active(False)
            return
        self._shell_follow(s)
        if on:
            view = self.shells.get(self.current)
            page = view and view.get_selected_page()
            if page is not None:
                page.get_child().grab_focus()
        else:
            t = self.terms.get(self.current)
            if t is not None:
                t.grab_focus()

    def _shell_follow(self, s):
        """The panel shows the current session's shells (the first started
        the first time it's asked for), or nothing without a session."""
        on = self.shell_toggle.get_active() and bool(s)
        self.shell_box.set_visible(on)
        if not on:
            self._shell_dot()
            return
        view = self._shell_view(s)
        if view.get_n_pages() == 0:
            self._shell_start(s)
        self.shell_stack.set_visible_child(view)
        self.shell_tabs.set_view(view)
        page = view.get_selected_page()
        if page is not None:
            page.set_needs_attention(False)
        self._shell_dot()
        # its height, as you last dragged it; until it's placed, a position
        # GTK picks on showing it isn't one you chose
        self.shell_placed = False
        GLib.idle_add(self._shell_place)

    def _shell_view(self, s):
        view = self.shells.get(s["name"])
        if view is None:
            view = Adw.TabView(vexpand=True)
            view.name = s["name"]
            view.connect("close-page", self._shell_closing)
            view.connect("notify::selected-page", lambda v, _p: self._shell_selected(v))
            view.connect("page-detached", lambda v, _p, _i: self._shell_emptied(v))
            self.shells[s["name"]] = view
            self.shell_stack.add_child(view)
        return view

    def new_shell(self):
        """Another shell for the session, in its own tab; the panel opens."""
        s = self.sessions.get(self.current)
        if not s or not self.shell_toggle.get_sensitive():
            return
        if not self.shell_toggle.get_active():
            # opening the panel starts one when there's none: that's the new shell
            before = self._shell_view(s).get_n_pages()
            self.shell_toggle.set_active(True)
            if self._shell_view(s).get_n_pages() > before:
                return
        t = self._shell_start(s)
        if t is not None:
            t.grab_focus()

    def _shell_place(self):
        h = self.paned.get_height()
        if h > 0:
            want = int(self.state.get("shell_height") or 220)
            self.paned.set_position(max(120, h - min(want, h - 120)))
        self.shell_placed = True
        return False

    def _shell_moved(self):
        h = self.paned.get_height()
        if getattr(self, "shell_placed", False) and self.shell_box.get_visible() and h > 0 \
                and self.paned.get_position() > 0:
            self.state["shell_height"] = max(80, h - self.paned.get_position())

    def _shell_start(self, s):
        """A new shell in the session's tab view, selected: a login shell in
        the session's folder, or on its machine, there."""
        view = self._shell_view(s)
        if s.get("machine"):
            # on that machine, in the session's folder there
            argv = [PULSAR, "machine", "shell", s["machine"], *(["--dir", s["dir"]] if s.get("dir") else [])]
            cwd = os.path.expanduser("~")
        else:
            argv = [os.environ.get("SHELL") or "/bin/bash", "-l"]
            cwd = s.get("dir") if s.get("dir") and os.path.isdir(s["dir"]) else os.path.expanduser("~")
        t = Vte.Terminal(hexpand=True, vexpand=True, scroll_on_output=False, scroll_on_keystroke=True,
                         audible_bell=False)
        t.dead = False
        t.name = s["name"]
        t.cwd = s.get("dir") or ""
        t.integrated = False
        t.add_css_class("shell")
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self._term_key, t)
        t.add_controller(keys)
        t.connect("child-exited", lambda term, _st: self._shell_exited(term))
        t.connect("termprop-changed", self._shell_prop)
        t.connect("bell", lambda term: self._shell_attention(term))
        t.connect("contents-changed", lambda term: term.integrated or self._shell_attention(term))
        self._color(t)
        page = view.append(t)
        t.page = page
        page.set_title(os.path.basename(t.cwd.rstrip("/")) or "~")
        view.set_selected_page(page)
        # not inside the agents' tmux, and not taken for an agent's pane
        env = ["TMUX=", "PULSAR_TTY=", "PULSAR_SESSION_RECORD=", "PULSAR_PANE_ARGV="]
        t.spawn_async(Vte.PtyFlags.DEFAULT, cwd, argv, env, GLib.SpawnFlags.SEARCH_PATH,
                      None, None, -1, None, None, None)
        return t

    def _shell_prop(self, t, prop):
        """The tab says where the shell is (or the title it sets); a command
        that finishes while you can't see it marks the tab and the button."""
        if prop == Vte.TERMPROP_CURRENT_DIRECTORY_URI:
            uri = t.ref_termprop_uri(prop)
            path = GLib.filename_from_uri(uri.to_string())[0] if uri else ""
            if path:
                t.cwd = path
        elif prop in (Vte.TERMPROP_SHELL_PREEXEC, Vte.TERMPROP_SHELL_PRECMD):
            # the shell says when commands start and end: only an end counts
            t.integrated = True
            return
        elif prop == Vte.TERMPROP_SHELL_POSTEXEC:
            t.integrated = True
            self._shell_attention(t)
            return
        title = t.get_termprop_string(Vte.TERMPROP_XTERM_TITLE)
        title = (title[0] if isinstance(title, tuple) else title) or ""
        t.page.set_title(shell_tab_title(title, t.cwd))
        t.page.set_tooltip(title or t.cwd.replace(os.path.expanduser("~"), "~", 1))

    def _shell_attention(self, t):
        """A shell you can't see did something worth a look: its tab, and the
        header's button while the panel is hidden."""
        view = self.shells.get(t.name)
        shown = self.shell_box.get_visible() and t.name == self.current and view is not None \
            and view.get_selected_page() is t.page
        if shown or t.dead:
            return
        t.page.set_needs_attention(True)
        self._shell_dot()

    def _shell_dot(self):
        view = self.shells.get(self.current)
        hidden = view is not None and not self.shell_box.get_visible()
        self.shell_dot.set_visible(hidden and any(view.get_nth_page(k).get_needs_attention()
                                                  for k in range(view.get_n_pages())))

    def _shell_selected(self, view):
        page = view.get_selected_page()
        if page is not None:
            page.set_needs_attention(False)
        self._shell_dot()

    def _shell_closing(self, view, page):
        """A tab closed: its shell ends with it."""
        t = page.get_child()
        t.dead = True
        pty = t.get_pty()
        if pty is not None:
            pty.close()
        view.close_page_finish(page, True)
        return True

    def _shell_emptied(self, view):
        """The last tab gone: the panel hides; the next open starts a shell."""
        if view.get_n_pages() == 0 and view.name == self.current and self.shell_toggle.get_active():
            self.shell_toggle.set_active(False)

    def _shell_exited(self, term):
        """exit in a shell closes its tab."""
        term.dead = True
        view = self.shells.get(term.name)
        page = getattr(term, "page", None)
        if view is not None and page is not None and view.get_page(term) is page:
            view.close_page(page)

    def _shell_close(self, name):
        """Archiving a session ends its shells."""
        view = self.shells.pop(name, None)
        if view is None:
            return
        for k in reversed(range(view.get_n_pages())):
            view.close_page(view.get_nth_page(k))
        self.shell_stack.remove(view)

    def open_in_terminal(self):
        s = self.sessions.get(self.current)
        if not s:
            return
        try:
            Gio.Subprocess.new(["ptyxis", "--new-window", "--", *self.agent_argv("attach", s["name"])],
                               Gio.SubprocessFlags.NONE)
        except GLib.Error as e:
            self.alert("Could not open a terminal", e.message)

    def toast(self, title, undo=None):
        # titles and errors come from agents and other machines: text, not markup
        t = Adw.Toast(title=GLib.markup_escape_text(title), timeout=5)
        if undo:
            t.set_button_label("Undo")
            t.connect("button-clicked", lambda *_: undo())
        self.toasts.add_toast(t)

    def confirm(self, heading, body, action, label, then, destructive=True):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("cancel", "Cancel")
        d.add_response(action, label)
        d.set_response_appearance(action, Adw.ResponseAppearance.DESTRUCTIVE if destructive
                                  else Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response(action)
        d.set_close_response("cancel")
        d.connect("response", lambda _d, r: r == action and then())
        d.present(self)

    def alert(self, heading, body):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("close", "Close")
        d.present(self)

    def _cmd(self, failure, *args, then=None):
        def done(ok, out):
            if not ok:
                self.alert(failure, out.strip()[-600:])
            if then:
                then(ok, out)
            self.refresh()
        run(self.agent_argv(*args), done)

    def _unreachable(self, s):
        """Its machine isn't answering: say so, rather than wait out ssh."""
        if s and s.get("offline"):
            self.toast(f"{s.get('machine')} isn't answering")
            return True
        return False

    def stop_session(self):
        s = self.sessions.get(self.current)
        if not s or self._unreachable(s):
            return
        self._cmd("Could not stop the session", "sessions", "--kill", s["name"],
                  then=lambda ok, _o: ok and self.toast(f"Stopped {session_title(s)}"))

    def archive(self, name):
        s = self.sessions.get(name)
        if not s or self._unreachable(s):
            return
        title = session_title(s)

        def done(ok, _out):
            if not ok:
                return
            t = self.terms.pop(name, None)
            if t is not None:
                self.term_stack.remove(t)
            self._shell_close(name)
            if name == self.current:
                self._clear_current()
            self.unseen.discard(name)
            self.remember()
            left = self.disk.session_bytes(name)
            days = self.tidy_days()
            self.toast(f"Archived {title}" + (f" · its {human_bytes(left)} of scratch goes in {days} days"
                                              if left >= 100_000_000 and days else ""),
                       undo=lambda: self.unarchive(name))
        self._cmd("Could not archive the session", "sessions", "--archive", name, then=done)

    def unarchive(self, name):
        self._cmd("Could not bring the session back", "sessions", "--unarchive", name)

    def delete(self, name):
        GLib.timeout_add_seconds(2, lambda: self.disk.refresh() and False)
        self._cmd("Could not delete the session", "sessions", "--forget", name, "--json",
                  then=lambda ok, out: ok and (left := forget_left(parse((out.strip().splitlines() or [""])[-1])))
                  and self.alert(*left))

    def rename(self, name=None):
        name = name or self.current
        s = self.sessions.get(name)
        if not s or self._unreachable(s):
            return
        d = Adw.AlertDialog(heading="Rename Session")
        entry = Gtk.Entry(text=session_title(s), activates_default=True)
        d.set_extra_child(entry)
        d.add_response("cancel", "Cancel")
        d.add_response("rename", "Rename")
        d.set_response_appearance("rename", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("rename")
        d.set_close_response("cancel")
        d.connect("response", lambda _d, r: r == "rename" and self._cmd(
            "Could not rename the session", "sessions", "--title", name, entry.get_text().strip().lstrip("-").strip()))
        d.present(self)

    def undo(self, to, stopped=False, name=None):
        """What would change first, from the CLI itself; then do it, with a way
        back. A working session stops first, so its agent can't write mid-undo.
        The session is the one on screen when asked, even if you move on."""
        name = name or self.current
        s = self.sessions.get(name)
        if not s:
            return
        if s.get("state") != "ended" and not stopped:
            self.confirm(f"Stop {session_title(s)} and go back?", "", "stop", "Stop and Go Back",
                         lambda: self._cmd("Could not stop the session", "sessions", "--kill", name,
                                           then=lambda ok, _o: ok and self.undo(to, stopped=True, name=name)),
                         destructive=False)
            return
        extra = ["--to", str(to)] if to else []

        def shown(ok, out):
            text = out.strip()
            if not ok or text.startswith("nothing to do"):
                self.alert("Nothing to undo" if ok else "Could not go back", text[-600:])
                return
            self.confirm(f"Go back in {session_title(s)}?", text[-1200:], "undo", "Put Files Back",
                         lambda: run(self.agent_argv("undo", name, *extra, "--yes"), undone))

        def undone(ok, out):
            self.refresh()
            self.rail.reload()
            if not ok:
                self.alert("Could not go back", out.strip()[-600:])
                return
            self.toast("Files put back", undo=lambda: self._cmd("Could not redo", "undo", name, "--redo", "--yes",
                                                                then=lambda *_: self.rail.reload()))
        run(self.agent_argv("undo", name, *extra, "--dry-run"), shown)

    def revert_file(self, path, uncommitted):
        name = self.current
        if not name:
            return
        extra = ["--uncommitted"] if uncommitted else []

        def done(ok, out):
            self.rail.reload()
            if not ok:
                self.alert("Could not revert the file", out.strip()[-600:])
                return
            self.toast(f"Reverted {os.path.basename(path)}",
                       undo=lambda: self._cmd("Could not redo", "undo", name, "--redo", "--yes",
                                              then=lambda *_: self.rail.reload()))
        run(self.agent_argv("undo", name, "--file", path, *extra, "--yes"), done)

    def add_comment(self, path, line, text):
        """A comment on a diff line, typed into the agent's own prompt as
        path:line: text, not sent: the agent's prompt is the one place to
        type, and Enter there sends it with whatever else is said."""
        t = self.terms.get(self.current)
        if t is None or t.dead or not text.strip():
            return False
        t.paste_text(comment_line(path, line, text))
        t.grab_focus()
        return True

    def new_session(self):
        # a project here: another machine's folder isn't one to start in
        cur = self.sessions.get(self.current) or {}
        project = (session_project(cur) or None) if not cur.get("machine") else None
        self.asked_home = True
        self._clear_current()
        self.list.unselect_all()
        self.launcher.show(project)
        self.split.set_show_content(True)

    def started(self, name, agent, title, argv):
        self.current = name
        self.pending = name
        self.title.set_title(title or name)
        self.title.set_subtitle(AGENT_NAMES.get(agent, agent))
        stub = {"name": name, "agent": agent, "state": "running", "title": title}
        self._actions_for(stub)
        self.banner.set_revealed(False)
        self.rail.set_session(stub)
        self.spawn(name, argv)
        self.remember(last=name)
        self.split.set_show_content(True)
        GLib.timeout_add_seconds(2, lambda: self.refresh() and False)


class SessionIcon(Gtk.DrawingArea):
    """A session's own icon (session_icon): an outline in one hue with a
    shape inside it in another, from a short fixed list. The same name
    always draws the same icon, so two sessions of one agent are told
    apart at a glance."""

    def __init__(self, name, size):
        super().__init__(content_width=size, content_height=size, css_classes=["tile", "glyph"])
        self.icon = None
        self.set_draw_func(self._draw)
        # held weakly, and let go when the icon is: the style manager lives as
        # long as the app, and the launcher's cards come and go
        sm, me = Adw.StyleManager.get_default(), weakref.ref(self)
        hid = sm.connect("notify::dark", lambda *_: (i := me()) is not None and i.queue_draw())
        weakref.finalize(self, lambda: sm.handler_is_connected(hid) and sm.disconnect(hid))
        self.set_glyph(name)

    def set_glyph(self, name):
        icon = session_icon(name) if name else None
        if icon != self.icon:
            self.icon = icon
            self.queue_draw()

    def _draw(self, _a, cr, w, h):
        if not self.icon:
            return
        import math
        outline, inside, turn, hue, _hue2 = self.icon
        dark = Adw.StyleManager.get_default().get_dark()
        # an avatar, not a light: every icon is the same muted tile in its
        # hue, the glyph inside in one lighter tone of it
        tr, tg, tb = hsl_rgb(hue, .32, .26 if dark else .86)
        gr, gg, gb = hsl_rgb(hue, .55, .74 if dark else .36)
        rad = w * .28
        cr.new_sub_path()
        for x, y, a in ((w - rad, rad, -90), (w - rad, h - rad, 0), (rad, h - rad, 90), (rad, rad, 180)):
            cr.arc(x, y, rad, math.radians(a), math.radians(a + 90))
        cr.close_path()
        cr.set_source_rgb(tr, tg, tb)
        cr.fill()

        cx, cy = w / 2, h / 2
        R = min(w, h) * .27
        cr.set_source_rgb(gr, gg, gb)
        cr.set_line_width(max(1.2, w * .045))
        cr.set_line_join(1)
        if outline == "circle":
            cr.arc(cx, cy, R, 0, 2 * math.pi)
        elif outline == "squircle":
            q, rr = R * .92, R * .45
            cr.new_sub_path()
            for x, y, a in ((cx + q - rr, cy - q + rr, -90), (cx + q - rr, cy + q - rr, 0),
                            (cx - q + rr, cy + q - rr, 90), (cx - q + rr, cy - q + rr, 180)):
                cr.arc(x, y, rr, math.radians(a), math.radians(a + 90))
            cr.close_path()
        elif outline == "hexagon":
            for k in range(6):
                a = math.radians(60 * k - 90)
                cr.line_to(cx + R * math.cos(a), cy + R * math.sin(a))
            cr.close_path()
        else:  # diamond
            for dx, dy in ((0, -R), (R, 0), (0, R), (-R, 0)):
                cr.line_to(cx + dx * 1.1, cy + dy * 1.1)
            cr.close_path()
        cr.stroke()

        r = R * .5
        if inside == "dot":
            cr.arc(cx, cy, R * .3, 0, 2 * math.pi)
            cr.fill()
        elif inside == "ring":
            cr.set_line_width(max(1, R * .14))
            cr.arc(cx, cy, R * .38, 0, 2 * math.pi)
            cr.stroke()
        elif inside == "half":
            a = math.radians(90 * turn)
            cr.arc(cx, cy, r, a, a + math.pi)
            cr.close_path()
            cr.fill()
        elif inside == "quarter":
            a = math.radians(90 * turn)
            cr.move_to(cx, cy)
            cr.arc(cx, cy, r * 1.1, a, a + math.pi / 2)
            cr.close_path()
            cr.fill()
        elif inside == "orbit":
            a = math.radians(45 * turn - 90)
            cr.arc(cx + r * math.cos(a), cy + r * math.sin(a), R * .2, 0, 2 * math.pi)
            cr.fill()
        else:  # grid
            q, gap = R * .3, R * .16
            for x in (cx - gap / 2 - q, cx + gap / 2):
                for y in (cy - gap / 2 - q, cy + gap / 2):
                    cr.rectangle(x, y, q, q)
            cr.fill()


def meter_bar(width=-1):
    bar = Gtk.LevelBar(min_value=0, max_value=100, css_classes=["meter"], valign=Gtk.Align.CENTER,
                       width_request=width, visible=False)
    for o in ("low", "high", "full"):
        bar.remove_offset_value(o)
    return bar


def set_meter(bar, percent):
    bar.set_visible(percent is not None)
    if percent is None:
        return
    bar.set_value(max(0.0, min(100.0, percent)))
    for c in ("high", "full"):
        bar.remove_css_class(c)
    if percent >= 90:
        bar.add_css_class("full")
    elif percent >= 75:
        bar.add_css_class("high")


def short_tokens(n):
    """tokens(), but a whole million is 1M, not 1.0M"""
    return f"{n // 1_000_000}M" if n and n >= 1_000_000 and n % 1_000_000 == 0 else tokens(n)


def model_name(model):
    """claude-opus-5-5 is Opus 5.5; any other id as it is"""
    m = re.match(r"claude-([a-z]+)-(\d+)-(\d+)", model or "")
    return f"{m.group(1).capitalize()} {m.group(2)}.{m.group(3)}" if m else (model or "")


def context_text(m):
    """142k of 1M · 14%"""
    if m.get("window"):
        return f"{short_tokens(m['context'])} of {short_tokens(m['window'])} · {round(m['percent'])}%"
    return short_tokens(m["context"])


SHORT_LIMITS = {"5-hour": "5h", "Weekly": "Week"}


class StatusBar:
    """Under the open session's terminal, in segments: the model, what it
    is doing, how full its context is, the plan's limits where the agent
    writes them down, then the machine it's on, the sandbox, the branch, and
    what changed since the session started (which opens Changes)."""

    def __init__(self, win):
        self.win = win
        self.s = None
        self.changes_for = None
        self.changes_at = 0
        self.widget = Gtk.Box(spacing=0, css_classes=["statusbar"], visible=False)

        def seg(*kids, cls=()):
            b = Gtk.Box(spacing=7, css_classes=["seg", *cls], valign=Gtk.Align.CENTER)
            for k in kids:
                b.append(k)
            return b

        self.model = Gtk.Label(css_classes=["strong"])
        self.who = seg(self.model)
        self.dot = Gtk.Box(css_classes=["title-dot"], valign=Gtk.Align.CENTER)
        self.state = Gtk.Label()
        self.doing = seg(self.dot, self.state)
        self.ctx_bar = meter_bar(70)
        self.ctx_val = Gtk.Label(css_classes=["val"])
        self.ctx_pct = Gtk.Label(css_classes=["val", "pct"])
        self.ctx = seg(Gtk.Label(label="Context", css_classes=["key"]), self.ctx_bar, self.ctx_val, self.ctx_pct)
        self.limits = Gtk.Box(spacing=0)
        # the lock alone, as in the sidebar; the word is its tooltip
        self.lock = seg(Gtk.Image(icon_name="security-high-symbolic"), cls=("dim",))
        self.lock.set_tooltip_text("Sandboxed")
        self.branch_label = Gtk.Label(ellipsize=Pango.EllipsizeMode.MIDDLE, max_width_chars=28)
        self.has_branch = False
        self.branch = seg(self.branch_label, cls=("dim",))
        self.branch.set_tooltip_text("Branch")
        self.changes_label = Gtk.Label(css_classes=["val"])
        self.changes = Gtk.Button(child=self.changes_label, css_classes=["flat", "changes-btn"],
                                  tooltip_text="Changes (Ctrl+Shift+D)", valign=Gtk.Align.CENTER)
        self.changes.connect("clicked", lambda *_: win.rail_toggle.set_active(not win.rail_toggle.get_active()))
        for w in (self.who, self.doing, self.ctx, self.limits):
            self.widget.append(w)
        self.widget.append(Gtk.Box(hexpand=True))
        self.machine_label = Gtk.Label()
        self.machine = seg(Gtk.Image(icon_name="network-server-symbolic"), self.machine_label, cls=("dim",))
        for w in (self.machine, self.lock, self.branch, self.changes):
            self.widget.append(w)
        # clipped at the window's width rather than widening it
        self.outer = Gtk.ScrolledWindow(child=self.widget, hscrollbar_policy=Gtk.PolicyType.EXTERNAL,
                                        vscrollbar_policy=Gtk.PolicyType.NEVER, css_classes=["statusbar-outer"],
                                        visible=False)
        # the branch shows whole or not at all: checked when the bar's width
        # or what it holds changes (a frame's tick, compared, not measured each time)
        self._fit_key = None
        self.outer.add_tick_callback(self._fit)

    def update(self, s, now):
        self.s = s
        live = bool(s) and s.get("state") != "ended"
        self.widget.set_visible(live)
        self.outer.set_visible(live)
        if not live:
            return
        m = s.get("meter") or {}
        agent = AGENT_NAMES.get(s.get("agent"), s.get("agent") or "Started by hand")
        self.model.set_label(model_name(m.get("model")) or agent)
        self.model.set_tooltip_text(agent)
        st = s.get("state")
        for c in ("working", "needs", "idle"):
            self.dot.remove_css_class(c)
            self.state.remove_css_class(c)
        # lit while it works or waits for you; grey when stopped or out of reach
        self.dot.add_css_class({"waiting": "needs", "running": "working"}.get(st, "idle"))
        if st == "waiting":
            self.state.add_css_class("needs")
        self.state.set_label(session_status(s, now))
        self.ctx.set_visible(bool(m))
        if m:
            set_meter(self.ctx_bar, m.get("percent"))
            self.ctx_val.set_label(f"{short_tokens(m['context'])} / {short_tokens(m['window'])}"
                                   if m.get("window") else short_tokens(m["context"]))
            pct = m.get("percent")
            self.ctx_pct.set_label(f"{round(pct)}%" if pct is not None else "")
            self.ctx_pct.set_visible(pct is not None)
            for c in ("high", "full"):
                self.ctx_pct.remove_css_class(c)
            if pct is not None and pct >= 75:
                self.ctx_pct.add_css_class("full" if pct >= 90 else "high")
        while (c := self.limits.get_first_child()) is not None:
            self.limits.remove(c)
        for lim in m.get("limits") or []:
            bar = meter_bar(48)
            set_meter(bar, lim["percent"])
            kids = [Gtk.Label(label=SHORT_LIMITS.get(lim["label"], lim["label"]), css_classes=["key"]), bar,
                    Gtk.Label(label=f"{round(lim['percent'])}%", css_classes=["val"])]
            r = resets_in(lim.get("resets_at"), now)
            b = Gtk.Box(spacing=7, css_classes=["seg"], valign=Gtk.Align.CENTER,
                        tooltip_text=f"{lim['label']} limit, {r}" if r else f"{lim['label']} limit")
            for k in kids:
                b.append(k)
            self.limits.append(b)
        self.lock.set_visible(s.get("sandbox") == "on")
        self.machine.set_visible(bool(s.get("machine")))
        self.machine_label.set_label(s.get("machine") or "")
        self._git(s, now)

    def _git(self, s, now):
        """The branch, and what changed since the session started: read
        again when the session changes, when its agent stops to wait, and
        every 20 seconds while it works."""
        name = s["name"]
        due = (name != self.changes_for or now - self.changes_at >= 20
               or (s.get("state") == "waiting" and getattr(self, "_was", None) != "waiting"))
        self._was = s.get("state")
        if not due:
            return
        if name != self.changes_for:
            self.branch.set_visible(False)
            self.has_branch = False
            self.changes.set_visible(False)
        self.changes_for, self.changes_at = name, now
        if s.get("offline"):
            # its machine isn't answering: nothing to ask, nothing to show
            self.branch.set_visible(False)
            self.has_branch = False
            self.changes.set_visible(False)
            return
        d = s.get("dir")
        # a folder on another machine isn't here to ask git about
        if d and not s.get("machine"):
            run(["git", "-C", d, "branch", "--show-current"], self._branch, name)
        run(self.win.agent_argv("diff", name, "--files", "--json"), self._changes, name)

    def _branch(self, ok, out, name):
        if (self.s or {}).get("name") != name:
            return
        b = out.strip() if ok else ""
        self.branch_label.set_label(b)
        self.has_branch = bool(b)
        self.branch.set_visible(bool(b))
        self._fit_key = None

    def _fit(self, *_):
        """Hide the branch when the bar can't hold its whole name, rather than
        show "…"; it comes back once there's room."""
        w = self.outer.get_width()
        key = (w, self.has_branch, self.branch_label.get_label(), self.state.get_label(),
               self.ctx_val.get_label(), self.changes_label.get_label(), self.lock.get_visible(),
               self.machine.get_visible(), self.changes.get_visible(), self.ctx.get_visible())
        if not w or key == self._fit_key:
            return GLib.SOURCE_CONTINUE
        self._fit_key = key
        if not self.has_branch:
            return GLib.SOURCE_CONTINUE
        # the room inside the bar: its width less its own padding and the
        # segments' margins (learned while the segments fit; 16 px at first)
        box = self.widget.get_width()
        if box and box <= w:
            self._slack = w - box
        room = w - getattr(self, "_slack", 16)
        nat = self.widget.measure(Gtk.Orientation.HORIZONTAL, -1)[1]
        if not self.branch.get_visible():
            nat += self.branch.measure(Gtk.Orientation.HORIZONTAL, -1)[1]
        self.branch.set_visible(nat <= room)
        return GLib.SOURCE_CONTINUE

    def _changes(self, ok, out, name):
        if (self.s or {}).get("name") != name:
            return
        files = parse(out) if ok else None
        if not isinstance(files, list):
            self.changes.set_visible(False)
            return
        if not files:
            self.changes_label.set_markup('<span alpha="55%">No changes</span>')
        else:
            a = sum(f.get("added") or 0 for f in files)
            r = sum(f.get("removed") or 0 for f in files)
            n = len(files)
            self.changes_label.set_markup(f"{n} file{'s' if n != 1 else ''}  "
                                          f"<span foreground='#2ec27e'>+{a}</span> "
                                          f"<span foreground='#e66100'>−{r}</span>")
        self.changes.set_visible(True)


class ProjectRow(Gtk.ListBoxRow):
    """A project's heading in the sidebar; activating it folds it."""

    def __init__(self, project, label, collapsed, compact=False):
        super().__init__(selectable=False, css_classes=["project"] + (["collapsed"] if collapsed else []),
                         tooltip_text=home(project) or None, activatable=True)
        self.project = project
        # a project on another machine: the machine icon the status bar uses, before its name
        machine = split_project(project)[0]
        box = Gtk.Box(spacing=6, margin_start=10, margin_end=8)
        if machine:
            box.append(Gtk.Image(icon_name="network-server-symbolic", pixel_size=12, css_classes=["project-machine"]))
        box.append(Gtk.Label(label=label, xalign=0, hexpand=True, css_classes=["project-label"],
                             ellipsize=Pango.EllipsizeMode.END))
        self.dot = Gtk.Box(css_classes=["dot"], valign=Gtk.Align.CENTER, visible=False)
        box.append(self.dot)
        box.append(Gtk.Image(icon_name="pan-end-symbolic" if collapsed else "pan-down-symbolic",
                             css_classes=["fold"], pixel_size=12))
        if compact:
            # narrowed: one fixed-size target per group, so nothing in it can
            # widen the column. Another machine's icon, or ⋯ for a folded
            # group; the dot rides its corner.
            self.set_tooltip_text(label)
            icon = "network-server-symbolic" if machine else ("view-more-horizontal-symbolic" if collapsed else None)
            if icon is None:
                self.set_child(Gtk.Box(css_classes=["fold-rule"]))
            else:
                mark = Gtk.Overlay(halign=Gtk.Align.CENTER, width_request=32, height_request=24,
                                   css_classes=["fold-mark"] + (["folded"] if collapsed else []))
                mark.set_child(Gtk.Image(icon_name=icon, pixel_size=14, halign=Gtk.Align.CENTER,
                                         valign=Gtk.Align.CENTER, css_classes=["project-machine"]))
                box.remove(self.dot)
                self.dot.set_halign(Gtk.Align.END)
                self.dot.set_valign(Gtk.Align.START)
                mark.add_overlay(self.dot)
                self.set_child(mark)
        else:
            self.set_child(box)
        self.collapsed = collapsed

    def set_attention(self, on):
        self.dot.set_visible(on and self.collapsed)
        (self.dot.add_css_class if on else self.dot.remove_css_class)("waiting")


class SessionRow(Gtk.ListBoxRow):
    """A session: its icon, its title, what it is doing, a dot
    when it needs you or changed while you weren't looking, Archive on hover."""

    def __init__(self, win, name):
        super().__init__(css_classes=["session"])
        self.win = win
        self.name = name
        box = Gtk.Box(spacing=10, margin_top=5, margin_bottom=5, margin_start=2, margin_end=2)
        self.tile = SessionIcon(name, 34)
        self.tile.set_valign(Gtk.Align.CENTER)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        self.label = Gtk.Label(label=name, xalign=0, css_classes=["session-title"], ellipsize=Pango.EllipsizeMode.END)
        self.sub = Gtk.Label(xalign=0, css_classes=["caption", "dim-label"], ellipsize=Pango.EllipsizeMode.END)
        self.text = text
        text.append(self.label)
        text.append(self.sub)
        self.meter = meter_bar()
        self.meter.set_margin_top(4)
        text.append(self.meter)
        self.dot = Gtk.Box(css_classes=["dot"], valign=Gtk.Align.CENTER)
        self.lock = Gtk.Image(icon_name="security-high-symbolic", tooltip_text="Sandboxed", visible=False,
                              css_classes=["dim-label"])
        arch = Gtk.Button(icon_name="window-close-symbolic", tooltip_text="Archive", valign=Gtk.Align.CENTER,
                          css_classes=["flat", "circular", "archive"])
        self.arch = arch
        arch.connect("clicked", lambda *_: win.archive(name))
        self.cdot = Gtk.Box(css_classes=["dot", "corner"], halign=Gtk.Align.END, valign=Gtk.Align.START,
                            visible=False)
        tile_over = Gtk.Overlay(child=self.tile)
        tile_over.add_overlay(self.cdot)
        self.cmeter = meter_bar(30)
        self.cmeter.set_halign(Gtk.Align.CENTER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER)
        col.append(tile_over)
        col.append(self.cmeter)
        box.append(col)
        box.append(text)
        box.append(self.lock)
        box.append(self.dot)
        box.append(arch)
        self.set_child(box)
        menu = Gio.Menu()
        for label, action in (("Rename…", "win.rename-session"), ("Archive", "win.archive")):
            item = Gio.MenuItem.new(label, None)
            item.set_action_and_target_value(action, GLib.Variant.new_string(name))
            menu.append_item(item)
        self.popover = Gtk.PopoverMenu.new_from_model(menu)
        self.popover.set_parent(self)
        self.popover.set_has_arrow(False)
        click = Gtk.GestureClick(button=3)
        click.connect("pressed", self._menu)
        self.add_controller(click)

    def set_compact(self, on):
        """Narrowed list: the tile alone, a dot on its corner when it changed
        unseen, its context under it, its title on hover."""
        self.compact = on
        for w in (self.text, self.arch, self.dot):
            w.set_visible(not on and (w is not self.dot or self.dot.has_css_class("unseen")))
        self.lock.set_visible(not on and getattr(self, "sandboxed", False))
        self.set_tooltip_text(self.label.get_label() if on else None)
        self.get_child().set_halign(Gtk.Align.CENTER if on else Gtk.Align.FILL)
        (self.add_css_class if on else self.remove_css_class)("compact")

    def _menu(self, _g, _n, x, y):
        r = Gdk.Rectangle()
        r.x, r.y, r.width, r.height = int(x), int(y), 1, 1
        self.popover.set_pointing_to(r)
        self.popover.popup()

    def update(self, s, now, unseen):
        agent = AGENT_NAMES.get(s.get("agent"), s.get("agent") or "Started by hand")
        self.tile.set_tooltip_text(agent)
        self.label.set_label(session_title(s))
        self.tile.set_glyph(s.get("icon") or self.name)
        self.sub.set_label(session_status(s, now))
        for c in ("unseen",):
            self.dot.remove_css_class(c)
        for c in ("needs", "working"):
            self.tile.remove_css_class(c)
            self.sub.remove_css_class(c)
        if s.get("state") == "waiting":
            self.tile.add_css_class("needs")
            self.sub.add_css_class("needs")
        elif s.get("state") == "running":
            self.tile.add_css_class("working")
        (self.add_css_class if s.get("offline") else self.remove_css_class)("offline")
        if unseen:
            self.dot.add_css_class("unseen")
        compact = getattr(self, "compact", False)
        self.dot.set_visible(unseen and not compact)
        (self.cdot.add_css_class if unseen else self.cdot.remove_css_class)("unseen")
        self.cdot.set_visible(unseen and compact)
        self.sandboxed = s.get("sandbox") == "on"
        self.lock.set_visible(self.sandboxed and not getattr(self, "compact", False))
        if getattr(self, "compact", False):
            self.set_tooltip_text(f"{session_title(s)}\n{session_status(s, now)}")
        m = s.get("meter")
        set_meter(self.meter, m and m.get("percent"))
        set_meter(self.cmeter, m and m.get("percent") if getattr(self, "compact", False) else None)
        self.meter.set_tooltip_text(context_text(m) if m else None)
        self.set_opacity(1 if s.get("state") != "ended" or unseen else .62)


class Rail:
    """Beside the terminal: Changes, file by file (`agent diff`), since the
    session started or since the last commit; and History, its snapshots
    (`agent undo --list --json`). Read when shown, on Refresh, and when the
    agent stops to wait for you; never on a timer (a diff reads the tree)."""

    SCOPES = (("Since the session started", []), ("Not yet committed", ["--uncommitted"]))

    def __init__(self, win):
        self.win = win
        self.s = None
        self.visible = False
        self.files = []
        self.path = None
        self.diff_text = ""
        self.stack = Adw.ViewStack()

        # changes
        self.scope = Gtk.DropDown.new_from_strings([s[0] for s in self.SCOPES])
        self.scope.connect("notify::selected", lambda *_: self.reload())
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh", css_classes=["flat"])
        refresh.connect("clicked", lambda *_: self.reload())
        head = Gtk.Box(spacing=6, css_classes=["rail-head"])
        head.append(self.scope)
        head.append(Gtk.Box(hexpand=True))
        head.append(refresh)
        self.summary = Gtk.Label(xalign=0, wrap=True, css_classes=["caption", "dim-label"], margin_start=12,
                                 margin_end=12, margin_bottom=4)
        self.file_list = Gtk.ListBox(css_classes=["navigation-sidebar", "files"])
        self.file_list.connect("row-selected", self._file_picked)
        files_scroll = Gtk.ScrolledWindow(child=self.file_list, propagate_natural_height=True, max_content_height=200,
                                          hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.buffer = GtkSource.Buffer()
        lang = GtkSource.LanguageManager.get_default().get_language("diff")
        if lang:
            self.buffer.set_language(lang)
        self._scheme()
        Adw.StyleManager.get_default().connect("notify::dark", lambda *_: self._scheme())
        self.view = GtkSource.View(buffer=self.buffer, editable=False, monospace=True, cursor_visible=True,
                                   wrap_mode=Gtk.WrapMode.NONE, left_margin=8, top_margin=6, bottom_margin=6)
        self.comment_entry = Gtk.Entry(placeholder_text="Comment on this line", hexpand=True)
        self.comment_entry.connect("activate", lambda *_: self._comment())
        self.comment_pop = Gtk.Popover(child=self.comment_entry)
        self.comment_button = Gtk.MenuButton(icon_name="chat-message-new-symbolic", popover=self.comment_pop,
                                             tooltip_text="Comment")
        self.comment_pop.connect("show", lambda *_: self._comment_target())
        self.revert = Gtk.Button(label="Revert File", css_classes=["flat"], sensitive=False)
        self.revert.connect("clicked", lambda *_: self.path and self.win.revert_file(
            self.path, bool(self.SCOPES[self.scope.get_selected()][1])))
        self.target = Gtk.Label(xalign=0, hexpand=True, css_classes=["caption", "dim-label"],
                                ellipsize=Pango.EllipsizeMode.START)
        foot = Gtk.Box(spacing=6, margin_start=10, margin_end=8, margin_top=4, margin_bottom=6)
        foot.append(self.target)
        foot.append(self.revert)
        foot.append(self.comment_button)
        changes = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        changes.append(head)
        changes.append(self.summary)
        changes.append(files_scroll)
        changes.append(Gtk.Box(css_classes=["hairline"]))
        changes.append(Gtk.ScrolledWindow(child=self.view, vexpand=True))
        changes.append(foot)
        self.stack.add_titled_with_icon(changes, "changes", "Changes", "document-edit-symbolic")

        # history
        self.snaps = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        self.snap_note = Gtk.Label(xalign=0, wrap=True, css_classes=["caption", "dim-label"])
        snap_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=12, margin_bottom=12,
                           margin_start=12, margin_end=12)
        snap_box.append(self.snap_note)
        snap_box.append(self.snaps)
        self.stack.add_titled_with_icon(Gtk.ScrolledWindow(child=snap_box, vexpand=True), "history", "History",
                                        "document-open-recent-symbolic")

        # messages: this session and the others (agent inbox), read only; you
        # talk to the agent in its terminal
        self.msgs = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        self.msg_note = Gtk.Label(xalign=0, wrap=True, css_classes=["caption", "dim-label"])
        msg_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=12, margin_bottom=12,
                          margin_start=12, margin_end=12)
        msg_box.append(self.msg_note)
        msg_box.append(self.msgs)
        self.msg_scroll = Gtk.ScrolledWindow(child=msg_box, vexpand=True)
        self.msg_page = self.stack.add_titled_with_icon(self.msg_scroll, "messages", "Messages", "mail-unread-symbolic")
        self.stack.connect("notify::visible-child-name", lambda *_: self.visible and self._messages())
        self._msg_seen = None

        bar = Adw.InlineViewSwitcher(stack=self.stack, css_classes=["flat"], margin_top=8, margin_bottom=2,
                                     margin_start=10, margin_end=10, homogeneous=True)
        self.widget = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["rail"])
        self.widget.append(bar)
        self.widget.append(self.stack)
        self.stack.set_vexpand(True)

    def _scheme(self):
        mgr = GtkSource.StyleSchemeManager.get_default()
        # the theme's scheme, the one it sets for Text Editor
        want = dconf_string("/org/gnome/TextEditor/style-scheme") or "Adwaita"
        dark = Adw.StyleManager.get_default().get_dark()
        for sid in ((want + "-dark") if dark else want, want, "Adwaita-dark" if dark else "Adwaita"):
            sch = mgr.get_scheme(sid)
            if sch:
                self.buffer.set_style_scheme(sch)
                return

    def set_session(self, s):
        changed = (self.s or {}).get("name") != s.get("name")
        self.s = s
        if changed:
            self.path = None
            self.buffer.set_text("")
            self.summary.set_label("")
            self._fill_files([])
            self._msg_seen = None
            if self.visible:
                self.reload()

    def session_changed(self, s, old):
        self.s = s
        if (old.get("state") == "ended") != (s.get("state") == "ended"):
            self._snapshots()
        # messages come and go around a turn's end
        if old.get("state") != s.get("state"):
            self._messages()

    def shown(self, visible):
        self.visible = visible
        if visible:
            self.reload()

    def _scope_args(self):
        return self.SCOPES[self.scope.get_selected()][1]

    def reload(self):
        if not self.visible or not self.s:
            return
        name = self.s["name"]
        run(self.win.agent_argv("diff", name, *self._scope_args(), "--files", "--json"), self._listed_files, name)
        self._snapshots()
        self._messages()

    def _messages(self):
        if not self.visible or not self.s or self.stack.get_visible_child_name() != "messages":
            return
        name = self.s["name"]
        # --keep: you reading them isn't the agent reading them
        run(self.win.agent_argv("inbox", name, "--keep", "--json"), self._got_messages, name)

    def _got_messages(self, ok, out, name):
        if not self.s or name != self.s["name"]:
            return
        rows = parse(out) if ok else None
        if not isinstance(rows, list):
            self.msg_note.set_label("Could not read the messages")
            return
        key = (name, len(rows), rows[-1].get("id") if rows else None, tuple(r.get("read") for r in rows))
        if key == self._msg_seen:
            return
        self._msg_seen = key
        me = self.s.get("real_name") or name
        while (child := self.msgs.get_first_child()) is not None:
            self.msgs.remove(child)
        self.msgs.set_visible(bool(rows))
        if not rows:
            self.msg_note.set_label("No messages. Another session's agent can send this one a message, "
                                    "and the agent here can answer it.")
            return
        unread = sum(1 for r in rows if r.get("to") == me and not r.get("read"))
        self.msg_note.set_label(f"{len(rows)} message{'s' if len(rows) != 1 else ''}"
                                + (f" · {unread} the agent hasn't opened" if unread else ""))
        def excerpt(t):
            line = (t or "").split("\n", 1)[0]
            return line if len(line) <= 48 else line[:47].rstrip() + "…"
        short = {r.get("id"): excerpt(r.get("text")) for r in rows}
        now = self.win._now()
        for r in rows:
            inbound = r.get("to") == me
            other = (r.get("from") or "outside a session") if inbound else r.get("to")
            head = f"From {other}" if inbound else f"To {other}"
            sub = [when(r.get("at"), now)]
            if r.get("re") in short:
                sub.append(f"answering “{short[r['re']]}”")
            elif r.get("re"):
                sub.append("answering an earlier message")
            row = Adw.ActionRow(title=GLib.markup_escape_text(head),
                                subtitle=GLib.markup_escape_text(" · ".join(x for x in sub if x)), css_classes=["message"])
            if not inbound:
                row.add_css_class("outbound")
            if inbound and not r.get("read"):
                row.add_suffix(Gtk.Box(css_classes=["title-dot", "needs"], valign=Gtk.Align.CENTER,
                                       tooltip_text="The agent hasn't opened it with its inbox"))
            body = Gtk.Label(label=r.get("text") or "", xalign=0, wrap=True, selectable=True,
                             wrap_mode=Pango.WrapMode.WORD_CHAR, css_classes=["message-text"],
                             margin_start=12, margin_end=12, margin_bottom=10)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.append(row)
            box.append(body)
            self.msgs.append(box)
        GLib.idle_add(lambda: self.msg_scroll.get_vadjustment().set_value(
            self.msg_scroll.get_vadjustment().get_upper()) and False)

    def _listed_files(self, ok, out, name):
        if not self.s or name != self.s["name"]:
            return
        files = parse(out) if ok else None
        if not isinstance(files, list):
            self.summary.set_label(out.strip().splitlines()[-1] if out.strip() else "Could not compare")
            self._fill_files([])
            self.buffer.set_text("")
            return
        self.summary.set_label(files_summary(files, bool(self._scope_args())))
        self._fill_files(files)

    def _fill_files(self, files):
        self.files = files
        keep = self.path
        while (r := self.file_list.get_first_child()) is not None:
            self.file_list.remove(r)
        pick = None
        for f in files:
            row = Gtk.ListBoxRow()
            row.path = f.get("path")
            box = Gtk.Box(spacing=8)
            st = f.get("status") or "modified"
            box.append(Gtk.Label(label=st[:1].upper(), tooltip_text=st.capitalize(), css_classes=["badge", st]))
            box.append(Gtk.Label(label=f.get("path", ""), xalign=0, hexpand=True,
                                 ellipsize=Pango.EllipsizeMode.START))
            if f.get("added") is not None:
                box.append(Gtk.Label(label=f"+{f['added']}", css_classes=["count", "added"]))
                box.append(Gtk.Label(label=f"−{f.get('removed') or 0}", css_classes=["count", "removed"]))
            row.set_child(box)
            self.file_list.append(row)
            if pick is None or row.path == keep:
                pick = row
        self.file_list.set_visible(bool(files))
        if pick is not None:
            self.file_list.select_row(pick)
        else:
            self.path = None
            self.buffer.set_text("")
            self.revert.set_sensitive(False)
            self.target.set_label("")

    def _file_picked(self, _l, row):
        if row is None or not self.s:
            return
        self.path = row.path
        self.revert.set_sensitive(True)
        self.target.set_label(row.path)
        name = self.s["name"]
        run(self.win.agent_argv("diff", name, *self._scope_args(), "--", row.path), self._diff, name, row.path)

    def _diff(self, ok, out, name, path):
        if not self.s or name != self.s["name"] or path != self.path:
            return
        self.diff_text = out if ok else ""
        self.buffer.set_text(self.diff_text)
        self._tint()
        self.buffer.place_cursor(self.buffer.get_start_iter())

    def _tint(self):
        """Added and removed lines on a faint green or red, hunks on the
        accent, so the diff reads at a glance as a review does."""
        tags = self.buffer.get_tag_table()
        if tags.lookup("add") is None:
            for name, rgba in (("add", "rgba(46,194,126,.13)"), ("del", "rgba(237,51,59,.13)"),
                               ("hunk", "rgba(120,130,255,.12)")):
                c = Gdk.RGBA()
                c.parse(rgba)
                self.buffer.create_tag(name, paragraph_background_rgba=c)
        for i, ln in enumerate(self.diff_text.split("\n")):
            tag = ("hunk" if ln.startswith("@@") else "add" if ln.startswith("+") and not ln.startswith("+++")
                   else "del" if ln.startswith("-") and not ln.startswith("---") else None)
            if tag:
                ok_, start = self.buffer.get_iter_at_line(i)
                end = start.copy()
                end.forward_to_line_end()
                self.buffer.apply_tag_by_name(tag, start, end)

    def _comment_target(self):
        it = self.buffer.get_iter_at_mark(self.buffer.get_insert())
        ref = diff_line_ref(self.diff_text, it.get_line())
        self.ref = ref
        self.comment_entry.set_placeholder_text(f"Comment on {ref[0]}:{ref[1]}" if ref
                                                else "Click a changed line first")
        self.comment_entry.set_sensitive(bool(ref))
        self.comment_entry.grab_focus()

    def _comment(self):
        if getattr(self, "ref", None) and self.comment_entry.get_text().strip():
            if not self.win.add_comment(self.ref[0], self.ref[1], self.comment_entry.get_text()):
                # no agent's prompt to put it in (stopped, or not attached): keep it
                self.win.toast("Open the session to comment: the comment goes into its agent's prompt")
                return
            self.comment_entry.set_text("")
            self.comment_pop.popdown()

    def _snapshots(self):
        if not self.s:
            return
        run(self.win.agent_argv("undo", self.s["name"], "--list", "--json"), self._listed, self.s["name"])

    def _listed(self, ok, out, name):
        if not self.s or name != self.s["name"]:
            return
        while (r := self.snaps.get_first_child()) is not None:
            self.snaps.remove(r)
        snaps = parse(out) if ok else None
        live = self.s.get("state") != "ended"
        if not isinstance(snaps, list) or not snaps:
            self.snap_note.set_label("No snapshots")
            self.snap_note.set_visible(True)
            self.snaps.set_visible(False)
            return
        self.snaps.set_visible(True)
        self.snap_note.set_visible(False)
        for snap in snaps:
            when_ = GLib.DateTime.new_from_unix_local(int(snap.get("time", 0))).format("%b %-d, %H:%M")
            row = Adw.ActionRow(title=GLib.markup_escape_text(snapshot_title(snap)), subtitle=when_)
            b = Gtk.Button(label="Go Back…", valign=Gtk.Align.CENTER)
            b.connect("clicked", lambda _b, n=snap.get("n"): self.win.undo(n))
            row.add_suffix(b)
            self.snaps.append(row)


def files_summary(files, uncommitted):
    """Over the file list: how many files and lines, against what."""
    if not files:
        return "Nothing uncommitted" if uncommitted else "No changes since the session started"
    added = sum(f.get("added") or 0 for f in files)
    removed = sum(f.get("removed") or 0 for f in files)
    n = len(files)
    return f"{n} file{'s' if n != 1 else ''} · +{added} −{removed}"


class DiskButton:
    """In the sidebar's footer: how much room is left where agents write,
    amber when it's getting tight, red when suspend won't fit. Its popover
    lists the big things in /var/tmp, ~/.cache and the sessions' scratch
    folders (pulsar agent disk), each with Delete."""

    REFRESH_S = 600

    def __init__(self, win):
        self.win = win
        self.data = None
        self.compact = False
        self.label = Gtk.Label()
        self.icon = Gtk.Image(icon_name="drive-harddisk-symbolic")
        box = Gtk.Box(spacing=6)
        box.append(self.icon)
        box.append(self.label)
        self.box = box
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        self.head = Gtk.Label(xalign=0, css_classes=["head"])
        self.why = Gtk.Label(xalign=0, wrap=True, max_width_chars=48, css_classes=["why", "dim-label"])
        self.busy = Gtk.Spinner(spinning=True, visible=False, halign=Gtk.Align.CENTER)
        pop_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=10,
                          margin_start=10, margin_end=10, css_classes=["disk-pop"])
        for w in (self.head, self.why, self.busy):
            pop_box.append(w)
        pop_box.append(Gtk.ScrolledWindow(child=self.list, propagate_natural_height=True, max_content_height=420,
                                          hscrollbar_policy=Gtk.PolicyType.NEVER))
        self.pop = Gtk.Popover(child=pop_box)
        self.pop.connect("show", lambda *_: self.refresh())
        self.widget = Gtk.MenuButton(child=box, popover=self.pop, css_classes=["flat", "disk-button"],
                                     margin_start=6, margin_bottom=6, margin_top=4)
        GLib.timeout_add_seconds(2, lambda: self.refresh() and False)
        GLib.timeout_add_seconds(self.REFRESH_S, lambda: self.refresh() or True)

    def set_compact(self, on):
        self.compact = on
        self.label.set_visible(not on)
        # narrowed: the icon alone, centered in the column
        self.box.set_halign(Gtk.Align.CENTER if on else Gtk.Align.FILL)
        self.widget.set_halign(Gtk.Align.CENTER if on else Gtk.Align.FILL)
        self.widget.set_margin_start(0 if on else 6)
        self.widget.set_margin_bottom(0 if on else 6)

    def refresh(self):
        if getattr(self, "_running", False):
            return
        self._running = True
        self.busy.set_visible(self.data is None)
        run([PULSAR, "agent", "disk", "--json"], self._got)

    def session_bytes(self, name):
        for it in (self.data or {}).get("items", []):
            if it.get("kind") == "session" and it.get("session") == name:
                return it.get("bytes") or 0
        return 0

    def _got(self, ok, out):
        self._running = False
        self.busy.set_visible(False)
        d = parse(out) if ok else None
        if not isinstance(d, dict):
            return
        self.data = d
        free, need = d.get("free"), d.get("suspend_need")
        level = disk_level(free, need)
        for c in ("low", "critical"):
            self.widget.remove_css_class(c)
        if level != "ok":
            self.widget.add_css_class(level)
        self.label.set_label(f"{human_bytes(free)} free" if free is not None else "")
        self.widget.set_tooltip_text(f"{human_bytes(free)} free" if free is not None else None)
        self.head.set_label(f"{human_bytes(free)} free" if free is not None else "")
        self.why.set_visible(False)
        while (r := self.list.get_first_child()) is not None:
            self.list.remove(r)
        items = d.get("items") or []
        now = GLib.get_real_time() // 1_000_000
        for it in items:
            if it.get("kind") == "session" and not it.get("bytes"):
                continue
            path = it.get("path", "")
            sess = it.get("session")
            title = session_title(self.win.sessions.get(sess, {"name": sess})) if sess else os.path.basename(path)
            where = {"session": "session scratch", "tmp": "/var/tmp", "cache": "~/.cache"}.get(it.get("kind"), "")
            row = Adw.ActionRow(title=title, subtitle=" · ".join(x for x in (
                human_bytes(it.get("bytes")), where, when(it.get("modified"), now)) if x))
            row.set_tooltip_text(home(path))
            gone = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Delete…", valign=Gtk.Align.CENTER,
                              css_classes=["flat"])
            gone.connect("clicked", lambda _b, it=it: self._delete(it))
            row.add_suffix(gone)
            self.list.append(row)
        self.list.set_visible(bool(self.list.get_first_child()))

    def _delete(self, it):
        path = it.get("path", "")
        d = Adw.AlertDialog(heading=f"Delete {os.path.basename(path)}?",
                            body=f"{home(path)}, {human_bytes(it.get('bytes'))}. This can't be undone.")
        d.add_response("cancel", "Cancel")
        d.add_response("delete", "Delete")
        d.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_close_response("cancel")

        def done(ok, out):
            if not ok:
                self.win.alert("Could not delete it", out.strip()[-600:])
            else:
                self.win.toast(out.strip().splitlines()[-1].replace(os.path.expanduser("~"), "~")
                               .replace("deleted", "Deleted", 1))
            self.refresh()
        d.connect("response", lambda _d, r: r == "delete" and run([PULSAR, "agent", "disk", "--delete", path], done))
        self.pop.popdown()
        d.present(self.win)


class Help(Adw.Dialog):
    """How to work with agents here, each point tied to the part of Pulsar
    that does it, and the keyboard shortcuts."""

    PRACTICES = (
        ("One task per session",
         "A session is named from its first message, or from Name if you fill it in. When the task is done, archive it (the × on the session, "
         "or Ctrl+Shift+Delete); it is deleted after the time set in Preferences."),
        ("A worktree for work alongside other sessions",
         "Worktree gives a session its own branch and folder, <repository>/.worktrees/<session>, so two agents "
         "never edit the same checkout."),
        ("The sandbox for code you didn't write",
         "A sandboxed agent sees its project and not the rest of your home folder, and pushes through Pulsar's "
         "gate without holding your credentials. Set it per project where you start a session, or for all in "
         "Preferences."),
        ("Review before you commit",
         "Changes lists every file the agent touched since the session started. A comment on a diff line goes "
         "into the agent's prompt; Revert File puts one file back. Pulsar never commits to your branches."),
        ("Go back when a session goes wrong",
         "History has a snapshot from each time the session started. Go Back puts the files back as they were "
         "then, and Undo takes that back."),
        ("Long commands as jobs",
         "pulsar job run --notify <session> -- <command> runs a build or a training run in a tmux of its own, "
         "keeps its output, and tells the session how it ended. pulsar machine job <machine> does the same on "
         "another machine."),
        ("Big files in the scratch folder",
         "An agent should put VM disks, builds and downloads in $PULSAR_SCRATCH, which is deleted with its "
         "session. The footer shows the free space on /var; on the NVIDIA image a full /var stops the machine "
         "from suspending."),
        ("Messages between sessions are another agent's words",
         "A message arrives labelled with the session that says it sent it, and Pulsar tells agents to treat it "
         "as data, not as your instructions. Turn messages off, or change how many, in Preferences."),
    )
    SHORTCUTS = (
        ("New session", "<Ctrl><Shift>n"),
        ("Next or previous session", "<Ctrl>Page_Down <Ctrl>Page_Up"),
        ("Session 1 to 9 in the list", "<Alt>1...<Alt>9"),
        ("Archive the session", "<Ctrl><Shift>Delete"),
        ("Changes, History and Messages", "<Ctrl><Shift>d"),
        ("A shell in the session's folder", "<Ctrl>grave"),
        ("Another shell, in a new tab", "<Ctrl><Shift>asciitilde"),
        ("Narrow or widen the list", "<Ctrl><Shift>b"),
        ("Copy and paste in the terminal", "<Ctrl><Shift>c <Ctrl><Shift>v"),
        ("Preferences", "<Ctrl>comma"),
        ("Help", "F1"),
    )

    def __init__(self):
        super().__init__(title="Help", content_width=600, content_height=720)
        page = Adw.PreferencesPage()
        work = Adw.PreferencesGroup(title="Working with Agents")
        for title, body in self.PRACTICES:
            row = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(body),
                                activatable=False, subtitle_selectable=True)
            row.add_css_class("help-row")
            work.add(row)
        page.add(work)
        keys = Adw.PreferencesGroup(title="Keyboard Shortcuts")
        for title, accel in self.SHORTCUTS:
            row = Adw.ActionRow(title=title, activatable=False)
            row.add_suffix(Adw.ShortcutLabel(accelerator=accel, valign=Gtk.Align.CENTER))
            keys.add(row)
        page.add(keys)
        tv = Adw.ToolbarView(content=page)
        tv.add_top_bar(Adw.HeaderBar())
        self.set_child(tv)


class Preferences(Adw.PreferencesDialog):
    """How new sessions start, whether sessions may message each other, and
    how long archived ones are kept. All but the last are the CLI's own
    settings (pulsar agent default, sandbox, messages), so a terminal and
    the app agree; read from `pulsar --json agent settings`."""

    def __init__(self, win):
        super().__init__(title="Preferences", search_enabled=False, content_width=600)
        self.win = win
        self._busy = True
        page = Adw.PreferencesPage()

        new = Adw.PreferencesGroup(title="New Sessions")
        self.agents = []
        self.agent = Adw.ComboRow(title="Agent", sensitive=False)
        self.agent.connect("notify::selected", lambda *_: self._set_agent())
        new.add(self.agent)
        self.sandbox = Adw.SwitchRow(title="Sandbox", subtitle="The agent sees only its project folder",
                                     sensitive=False)
        self.sandbox.connect("notify::active", lambda *_: self._set(["agent", "sandbox",
                                                                     "on" if self.sandbox.get_active() else "off"]))
        new.add(self.sandbox)
        self.push = Adw.ComboRow(title="Sandbox Pushes",
                                 model=Gtk.StringList.new([t for _, t in PUSH_CHOICES]), sensitive=False)
        self.push.connect("notify::selected", lambda *_: self._set(["agent", "sandbox", "push",
                                                                    PUSH_CHOICES[self.push.get_selected()][0]]))
        new.add(self.push)
        page.add(new)

        talk = Adw.PreferencesGroup(title="Messages Between Sessions")
        self.messages = Adw.SwitchRow(title="Allow Messages", sensitive=False)
        self.messages.connect("notify::active", lambda *_: self._set(["agent", "messages",
                                                                      "on" if self.messages.get_active() else "off"]))
        talk.add(self.messages)
        self.cap = Adw.SpinRow.new_with_range(1, 60, 1)
        self.cap.set_title("Limit")
        self.cap.set_subtitle("Messages one session can send another in 10 minutes")
        self.cap.set_sensitive(False)
        self.cap.connect("notify::value", lambda *_: self._cap_changed())
        self.messages.bind_property("active", self.cap, "visible", GObject.BindingFlags.SYNC_CREATE)
        talk.add(self.cap)
        page.add(talk)

        # your other Pulsar machines: this one found by them (off unless turned
        # on), and the ones announcing here, each a click from being added
        mach = Adw.PreferencesGroup(title="Your Machines")
        self.announce = Adw.SwitchRow(title="Announce This Machine",
                                      subtitle="Your other Pulsar machines on this network can add it",
                                      sensitive=False)
        self.announce.connect("notify::active", lambda *_: self._set(["machine", "announce",
                                                                      "on" if self.announce.get_active() else "off"]))
        mach.add(self.announce)
        self.found = Adw.ActionRow(title="Looking for Pulsar machines…", activatable=False)
        mach.add(self.found)
        self.machines_group = mach
        self.found_rows = []
        page.add(mach)

        keep = Adw.PreferencesGroup(title="Archived Sessions")
        self.tidy = Adw.ComboRow(title="Delete After",
                                 subtitle="With their snapshots and scratch folders; branches stay",
                                 model=Gtk.StringList.new([t for _, t in TIDY_CHOICES]))
        self.tidy.set_selected([d for d, _ in TIDY_CHOICES].index(win.tidy_days()))
        self.tidy.connect("notify::selected", lambda *_: self._set_tidy())
        keep.add(self.tidy)
        page.add(keep)
        self.add(page)
        self._cap_timer = 0
        run([PULSAR, "--json", "agent", "settings"], self._loaded)
        run([PULSAR, "--json", "machine", "announce"], self._announced)
        run([PULSAR, "--json", "machine", "discover"], self._discovered)

    def _announced(self, ok, out):
        d = parse(out) if ok else None
        busy, self._busy = self._busy, True
        self.announce.set_active(isinstance(d, dict) and d.get("announce") == "on")
        self._busy = busy
        self.announce.set_sensitive(True)

    def _discovered(self, ok, out):
        found = parse(out) if ok else None
        for r in self.found_rows:
            self.machines_group.remove(r)
        self.found_rows = []
        others = [m for m in (found or []) if isinstance(m, dict) and not m.get("self")]
        self.found.set_visible(not others)
        self.found.set_title("No other Pulsar machines are announcing on this network" if found is not None
                             else "Could not look for Pulsar machines")
        self.found.set_subtitle("Turn this on in their Preferences too" if found is not None else "")
        for m in others:
            row = Adw.ActionRow(title=GLib.markup_escape_text(m.get("name") or "?"),
                                subtitle=GLib.markup_escape_text(" · ".join(x for x in (
                                    m.get("target"), f"Pulsar {m['release']}" if m.get("release") else None,
                                    None if m.get("ssh") else "SSH is off there") if x)))
            row.add_prefix(Gtk.Image(icon_name="network-server-symbolic"))
            if m.get("added"):
                row.add_suffix(Gtk.Label(label="Added", css_classes=["dim-label"]))
            else:
                add = Gtk.Button(label="Add", valign=Gtk.Align.CENTER)
                add.connect("clicked", lambda b, m=m: self._add_machine(b, m))
                row.add_suffix(add)
            self.machines_group.add(row)
            self.found_rows.append(row)

    def _add_machine(self, button, m):
        button.set_sensitive(False)

        def done(ok, out):
            if ok:
                self.add_toast(Adw.Toast(title=GLib.markup_escape_text(f"Added {m['name']}: its sessions show in the list")))
                self.win.refresh()
                run([PULSAR, "machine", "list", "--json"], self.win._machines)
                run([PULSAR, "--json", "machine", "discover"], self._discovered)
                return
            button.set_sensitive(True)
            # almost always: this machine's key isn't on that one yet
            d = Adw.AlertDialog(heading=f"Could not reach {m['name']}",
                                body=f"Put your SSH key there first, from a terminal (it asks for your password "
                                     f"on {m['name']} once):\n\nssh-copy-id {m['target']}\n\nThen Add again.\n\n"
                                     + (out.strip().splitlines() or [""])[-1][:300])
            d.set_body_use_markup(False)
            d.add_response("ok", "OK")
            d.present(self)
        run([PULSAR, "machine", "add", m["name"], m["target"]], done)

    def _loaded(self, ok, out):
        d = parse(out) if ok else None
        if not isinstance(d, dict):
            self.add_toast(Adw.Toast(title="Could not read the agent settings"))
            return
        self.agents = [a for a in d.get("installed") or [] if isinstance(a, str)]
        self.agent.set_model(Gtk.StringList.new([AGENT_NAMES.get(a, a) for a in self.agents]))
        if d.get("default") in self.agents:
            self.agent.set_selected(self.agents.index(d["default"]))
        self.agent.set_sensitive(len(self.agents) > 1)
        self.sandbox.set_active(d.get("sandbox") == "on")
        self.push.set_selected(next((i for i, (k, _) in enumerate(PUSH_CHOICES) if k == d.get("push")), 0))
        self.messages.set_active(d.get("messages") != "off")
        cap = d.get("message_cap")
        self.cap.set_value(cap if isinstance(cap, int) and 1 <= cap <= 60 else 10)
        for w in (self.sandbox, self.push, self.messages, self.cap):
            w.set_sensitive(True)
        self._busy = False

    def _set(self, args):
        if self._busy:
            return
        run([PULSAR, *args], lambda ok, out: ok or self.add_toast(
            Adw.Toast(title=GLib.markup_escape_text((out.strip().splitlines() or ["Could not save that"])[-1][:120]))))

    def _set_agent(self):
        i = self.agent.get_selected()
        if not self._busy and 0 <= i < len(self.agents):
            self._set(["agent", "default", self.agents[i]])
            self.win.launcher._load_agents()

    def _cap_changed(self):
        # one write when the spinning stops, not one per step
        if self._busy:
            return
        if self._cap_timer:
            GLib.source_remove(self._cap_timer)
        def save():
            self._cap_timer = 0
            self._set(["agent", "messages", "--cap", str(int(self.cap.get_value()))])
            return False
        self._cap_timer = GLib.timeout_add(600, save)

    def _set_tidy(self):
        i = self.tidy.get_selected()
        if 0 <= i < len(TIDY_CHOICES):
            self.win.state["tidy_days"] = TIDY_CHOICES[i][0]
            self.win.remember()


class ArchivedDialog(Adw.Dialog):
    """Archived sessions: back to the list, or deleted now. Pulsar deletes
    them after a week anyway, or as long as Preferences says."""

    def __init__(self, win):
        super().__init__(title="Archived", content_width=480)
        self.win = win
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup()
        now = win._now()
        arch = sorted((s for s in win.sessions.values() if s.get("archived")), key=lambda s: -(s["archived"] or 0))
        for s in arch:
            row = Adw.ActionRow(title=GLib.markup_escape_text(session_title(s)),
                                subtitle=GLib.markup_escape_text(" · ".join(x for x in (
                                    home(session_project(s)), deleted_in(s["archived"], now, win.tidy_days())) if x)))
            back = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER)
            back.connect("clicked", lambda _b, n=s["name"], r=row: self._restore(n, r))
            gone = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Delete Now", valign=Gtk.Align.CENTER,
                              css_classes=["flat"])
            gone.connect("clicked", lambda _b, s=s, r=row: self._delete(s, r))
            row.add_suffix(back)
            row.add_suffix(gone)
            group.add(row)
        self.group = group
        page.add(group)
        tv = Adw.ToolbarView(content=page)
        tv.add_top_bar(Adw.HeaderBar())
        self.set_child(tv)

    def _restore(self, name, row):
        self.win.unarchive(name)
        self.group.remove(row)

    def _delete(self, s, row):
        d = Adw.AlertDialog(heading=f"Delete {session_title(s)}?", body=forget_body(s))
        d.add_response("cancel", "Cancel")
        d.add_response("delete", "Delete")
        d.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_close_response("cancel")
        d.connect("response", lambda _d, r: r == "delete" and (self.win.delete(s["name"]), self.group.remove(row)))
        d.present(self)


class Launcher:
    """The window's home when no session is open, and where + goes: what
    the agent should do, in which project, with which agent. The project's
    agent, worktree and sandbox are remembered."""

    SANDBOX = (("Sandbox: default", None), ("Sandbox: on", True), ("Sandbox: off", False))

    def __init__(self, win):
        self.win = win
        self.agents = []
        self.default_agent = None
        self.folder = None
        self.recent_paths = []
        # the box: what to do, and under it the project, agent, worktree,
        # sandbox and Start, the way the session's message box is built
        self.view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=10, bottom_margin=10,
                                 accepts_tab=False, hexpand=True, css_classes=["home-text"])
        self.buffer = self.view.get_buffer()
        self.buffer.connect("changed", lambda *_: self._typed())
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._key)
        self.view.add_controller(keys)
        self.placeholder = Gtk.Label(label="What should the agent do?", xalign=0, can_target=False,
                                     valign=Gtk.Align.START, margin_top=10, css_classes=["placeholder", "home-text"])
        over = Gtk.Overlay(child=Gtk.ScrolledWindow(child=self.view, propagate_natural_height=True,
                                                    min_content_height=64, max_content_height=220,
                                                    hscrollbar_policy=Gtk.PolicyType.NEVER))
        over.add_overlay(self.placeholder)

        self.project_label = Gtk.Label()
        pbox = Gtk.Box(spacing=6)
        pbox.append(Gtk.Image(icon_name="folder-symbolic"))
        pbox.append(self.project_label)
        self.project_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["navigation-sidebar"])
        self.project_list.connect("row-activated", self._project_row)
        self.project_pop = Gtk.Popover(child=self.project_list)
        self.project = Gtk.MenuButton(child=pbox, popover=self.project_pop, css_classes=["chip", "flat"],
                                      always_show_arrow=True)

        self.agent = Gtk.DropDown(css_classes=["chip", "flat"])
        self.agent.connect("notify::selected", lambda *_: self._remember())
        self.worktree = Gtk.ToggleButton(label="Worktree", css_classes=["chip", "flat"])
        self.worktree.connect("toggled", lambda *_: self._remember())
        self.sandbox = Gtk.DropDown.new_from_strings([c[0] for c in self.SANDBOX])
        for c in ("chip", "flat"):
            self.sandbox.add_css_class(c)
        self.sandbox.connect("notify::selected", lambda *_: self._remember())
        # optional: what the sidebar calls it (and the session's name, made
        # from it); left empty, both come from the prompt
        self.name = Gtk.Entry(placeholder_text="Name", width_chars=10, max_width_chars=24, max_length=48,
                              primary_icon_name="document-edit-symbolic",
                              tooltip_text="What the sidebar calls this session. Empty: taken from the prompt",
                              css_classes=["chip", "name-chip"], valign=Gtk.Align.CENTER)
        self.name.connect("activate", lambda *_: self._go())
        self.start = Gtk.Button(icon_name="go-up-symbolic", tooltip_text="Start (Enter)", sensitive=False,
                                css_classes=["circular", "suggested-action"], valign=Gtk.Align.CENTER)
        self.start.connect("clicked", lambda *_: self._go())
        # the chips flow onto a second line in a narrow window, rather than
        # widening the box past it; Start stays at the end of the last line
        chips = Adw.WrapBox(child_spacing=4, line_spacing=4, hexpand=True)
        for w in (self.project, self.name, self.agent, self.worktree, self.sandbox):
            chips.append(w)
        bar = Gtk.Box(spacing=4)
        bar.append(chips)
        self.start.set_valign(Gtk.Align.END)
        bar.append(self.start)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, css_classes=["composer-box", "home-box"])
        box.append(over)
        box.append(bar)

        self.hint = Gtk.Label(xalign=0, wrap=True, css_classes=["caption", "error"], visible=False)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, valign=Gtk.Align.CENTER,
                      margin_start=24, margin_end=24, margin_bottom=56)
        self.mark = Gtk.Image(pixel_size=56, css_classes=["mark"], halign=Gtk.Align.CENTER, margin_bottom=6)
        self._mark()
        Adw.StyleManager.get_default().connect("notify::dark", lambda *_: self._mark())
        col.append(self.mark)
        col.append(box)
        col.append(self.hint)
        self.resume_heading = Gtk.Label(label="Recent", xalign=0,
                                        css_classes=["launch-heading"], visible=False)
        self.cards = Gtk.Box(spacing=8, homogeneous=True)
        col.append(self.resume_heading)
        col.append(self.cards)
        self.widget = Adw.Clamp(child=col, maximum_size=720, css_classes=["launcher"])
        self._loading = False
        self._load_agents()

    def _load_agents(self):
        if self._loading:
            return
        self._loading = True
        run([PULSAR, "agent", "list", "--json"], self._listed)

    def _listed(self, ok, out):
        found = parse(out) if ok else None
        self.agents = [a["name"] for a in (found or []) if a.get("state") in ("installed", "native")]
        # a new model moves the selection, which isn't the user choosing an agent
        self._applying = True
        self.agent.set_model(Gtk.StringList.new([AGENT_NAMES.get(a, a) for a in self.agents]))
        self._applying = False
        run([PULSAR, "agent", "default"], self._default)

    def _default(self, ok, out):
        self._loading = False
        if ok and out.strip() in self.agents:
            self.default_agent = out.strip()
        elif self.agents:
            self.default_agent = self.agents[0]
        if not self.agents:
            self.hint.set_label("No agent is installed")
            self.hint.set_visible(True)
        self._apply()

    def recent(self):
        seen, out = set(), []
        ss = sorted(self.win.sessions.values(), key=lambda s: -(s.get("last_active") or s.get("started") or 0))
        for p in list(self.win.state.get("recent", [])) + [session_project(s) for s in ss]:
            if p and p not in seen and os.path.isdir(p):
                seen.add(p)
                out.append(p)
        return out

    def _mark(self):
        d = next((d for d in BRAND if (d / "pulsar-mark.svg").exists()), None)
        if d is None:
            self.mark.set_visible(False)
            return
        name = "pulsar-mark.svg" if Adw.StyleManager.get_default().get_dark() else "pulsar-mark-light.svg"
        px = 52 * 2
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_size(str(d / name), px, px)
            self.mark.set_from_paintable(Gdk.Texture.new_for_pixbuf(pb))
        except GLib.Error:
            self.mark.set_visible(False)

    def _cards(self):
        """The three sessions most recently at work, one click from here.
        Rebuilt only when what they say changes, not on every poll."""
        now = self.win._now()
        ss = [s for s in self.win.sessions.values() if not s.get("archived")]
        ss.sort(key=lambda s: ({"waiting": 0, "running": 1}.get(s.get("state"), 2),
                               -(s.get("last_active") or s.get("started") or 0)))
        key = tuple((s["name"], s.get("state"), session_title(s), session_status(s, now)) for s in ss[:3])
        if key == getattr(self, "_cards_key", None):
            return
        self._cards_key = key
        while (c := self.cards.get_first_child()) is not None:
            self.cards.remove(c)
        for s in ss[:3]:
            agent = AGENT_NAMES.get(s.get("agent"), s.get("agent") or "")
            box = Gtk.Box(spacing=10)
            tile = SessionIcon(s.get("icon") or s["name"], 34)
            tile.set_valign(Gtk.Align.CENTER)
            tile.set_tooltip_text(agent)
            if s.get("state") == "waiting":
                tile.add_css_class("needs")
            elif s.get("state") == "running":
                tile.add_css_class("working")
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
            text.append(Gtk.Label(label=session_title(s), xalign=0, css_classes=["session-title"],
                                  ellipsize=Pango.EllipsizeMode.END))
            sub = Gtk.Label(label=session_status(s, now), xalign=0, css_classes=["caption", "dim-label"],
                            ellipsize=Pango.EllipsizeMode.END)
            if s.get("state") == "waiting":
                sub.add_css_class("needs")
            text.append(sub)
            text.append(Gtk.Label(label=os.path.basename(session_project(s).rstrip("/")), xalign=0,
                                  css_classes=["caption", "dim-label"], ellipsize=Pango.EllipsizeMode.END))
            box.append(tile)
            box.append(text)
            card = Gtk.Button(child=box, css_classes=["flat", "resume-card"])
            card.connect("clicked", lambda _b, n=s["name"]: self.win.show_session(n))
            self.cards.append(card)
        self.resume_heading.set_visible(bool(ss))

    def show(self, project=None):
        """The projects in the picker; the one asked for, else the latest, chosen."""
        self._cards()
        recent = self.recent()[:8]
        for p in (self.folder, project):
            if p and p not in recent and os.path.isdir(p):
                recent.insert(0, p)
        self.recent_paths = recent
        while (r := self.project_list.get_first_child()) is not None:
            self.project_list.remove(r)
        for p in recent:
            row = Gtk.ListBoxRow()
            row.path = p
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=4, margin_bottom=4, margin_start=4,
                        margin_end=8)
            v.append(Gtk.Label(label=project_label(p, recent), xalign=0))
            v.append(Gtk.Label(label=home(p), xalign=0, css_classes=["caption", "dim-label"]))
            row.set_child(v)
            self.project_list.append(row)
        other = Gtk.ListBoxRow()
        other.path = None
        other.set_child(Gtk.Label(label="Other Folder…", xalign=0, margin_top=6, margin_bottom=6, margin_start=4))
        self.project_list.append(other)
        project = project if project and os.path.isdir(project) else None
        self._set(project or (self.folder if self.folder in recent else None) or (recent[0] if recent else None))
        if not self.agents:
            self._load_agents()
        self.view.grab_focus()

    def _typed(self):
        """Start only once there's something for the agent to do."""
        has = bool(self._text().strip())
        self.placeholder.set_visible(not self._text())
        self.start.set_sensitive(bool(self.agents) and bool(self.folder) and has)

    def _project_row(self, _l, row):
        self.project_pop.popdown()
        if row.path is None:
            self._pick()
        else:
            self._set(row.path)

    def _text(self):
        return self.buffer.get_text(self.buffer.get_start_iter(), self.buffer.get_end_iter(), False)

    def _key(self, _c, keyval, _code, state):
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and not state & Gdk.ModifierType.SHIFT_MASK:
            self._go()
            return True
        return False

    def _set(self, path):
        self.folder = path
        self.project_label.set_label(project_label(path, self.recent_paths) if path else "Choose a project")
        self.project.set_tooltip_text(home(path) if path else None)
        self._apply()

    def _apply(self):
        """The project's remembered choices into the chips."""
        self._applying = True
        prefs = self.win.state["projects"].get(self.folder or "", {})
        repo = is_repo(self.folder)
        self.worktree.set_sensitive(repo)
        self.worktree.set_active(bool(prefs.get("worktree")) and repo)
        sb = prefs.get("sandbox")
        self.sandbox.set_selected(next((i for i, c in enumerate(self.SANDBOX) if c[1] == sb), 0))
        if self.agents:
            a = prefs.get("agent") if prefs.get("agent") in self.agents else self.default_agent
            if a in self.agents:
                self.agent.set_selected(self.agents.index(a))
        self._applying = False
        self._typed()

    def _remember(self):
        if getattr(self, "_applying", False) or not self.folder or not self.agents:
            return
        self.win.state["projects"][self.folder] = self._choices()

    def _choices(self):
        agent = self.agents[self.agent.get_selected()] if self.agent.get_selected() < len(self.agents) else None
        return {"agent": agent, "worktree": self.worktree.get_active() and self.worktree.get_sensitive(),
                "sandbox": self.SANDBOX[self.sandbox.get_selected()][1]}

    def _pick(self):
        d = Gtk.FileDialog(title="Project Folder",
                           initial_folder=Gio.File.new_for_path(self.folder or os.path.expanduser("~")))
        d.select_folder(self.win, None, self._picked)

    def _picked(self, d, res):
        try:
            f = d.select_folder_finish(res)
        except GLib.Error:
            return
        if f and f.get_path():
            self.show(f.get_path())

    def _go(self):
        if not (self.agents and self.folder and self._text().strip()):
            return
        c = self._choices()
        prompt = self._text().strip()
        given = " ".join(self.name.get_text().split())
        # not a session's name, nor a branch or worktree the repository has
        taken = set(self.win.sessions) | repo_names(self.folder)
        name = (slug_name(given, taken, words=6) or slug_name(prompt, taken)
                or session_name_for(self.folder, taken))
        title = given or title_from_prompt(prompt) or None
        st = self.win.state
        st["projects"][self.folder] = c
        st["recent"] = [self.folder] + [p for p in st.get("recent", []) if p != self.folder][:9]
        argv = run_argv(c["agent"], name, self.folder, c["worktree"], c["sandbox"], title=title,
                        prompt=prompt or None)
        self.buffer.set_text("")
        self.name.set_text("")
        self.win.started(name, c["agent"], title, argv)


def main(argv):
    app = Adw.Application(application_id="digital.arclight.Pulsar.Agents",
                          flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def startup(_a):
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def command_line(a, cl):
        args = cl.get_arguments()[1:]
        w = a.get_active_window() or Agents(a)
        w.present()
        if args and args[0] == "--new":
            w.new_session()
        elif args:
            w.show_session(args[0])
        return 0
    def open_session(_act, param):
        w = app.get_active_window() or Agents(app)
        w.present()
        w.show_session(param.get_string())
    act = Gio.SimpleAction.new("open-session", GLib.VariantType.new("s"))
    act.connect("activate", open_session)
    app.add_action(act)
    app.connect("startup", startup)
    app.connect("command-line", command_line)
    return app.run(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
