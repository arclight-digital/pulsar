---
// One transition in the ledger: what moved, and how far.
//
// The transition itself is Version.astro's job, which dims what the two sides
// share. That rendering is a typographic device and reads aloud as noise, so
// it is hidden from assistive tech here and a plain spoken sentence carries
// the same row instead.
//
// A group of more than one package is a disclosure rather than a bare "+9",
// because "+9" invites exactly one question and the answer is already here.
// No script: <details> is the platform's, it is keyboard-operable, and the
// four kilobytes of JavaScript this page ships are not going to grow for it.
// The wrapper and its header are dynamic tags so the two shapes -- openable
// and not -- are one piece of markup rather than two that can drift apart.
import Version from './Version.astro';
import type { TransitionGroup } from '../data/digest';

interface Props {
  group: TransitionGroup;
}

const { group } = Astro.props;
const { delta } = group;

const extra = group.members.length - 1;
const others = group.members.filter((name) => name !== group.label);

const Wrap = extra > 0 ? 'details' : 'div';
const Head = extra > 0 ? 'summary' : 'div';

const spoken =
  `${group.label}, ${group.from} to ${group.to}` +
  (extra > 0 ? `, with ${extra} other package${extra === 1 ? '' : 's'}` : '');
---

<li class:list={['drow', { 'is-major': group.reach === 'major', 'is-down': group.downgraded }]}>
  <Wrap>
    <Head class="dr-line">
      <span class="dr-head">
        <span class="dr-name">{group.label}</span>
        {
          extra > 0 && (
            <span class="dr-with">
              +{extra} package{extra === 1 ? '' : 's'}
            </span>
          )
        }
      </span>

      <span class="dr-ver" aria-hidden="true">
        <Version delta={delta} from={group.from} to={group.to} />
      </span>

      <span class="sr-only">{spoken}</span>
    </Head>

    {
      extra > 0 && (
        <ul class="dr-members">
          {others.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
      )
    }
  </Wrap>
</li>

<style>
  .drow {
    border-bottom: 1px solid var(--chip-line);
  }

  /* Grid rather than flex so the version column starts at the same x on every
     row and the transitions stack into a column the eye can run down. */
  .dr-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.3rem 1.4rem;
    padding: 0.5rem 0 0.5rem 1.15rem;
    position: relative;
  }

  summary.dr-line {
    cursor: pointer;
    list-style: none; /* Firefox */
  }

  summary.dr-line::-webkit-details-marker {
    display: none;
  }

  /* The gutter marker, drawn rather than borrowed from ::marker: a rule for an
     ordinary row, a chevron that turns for a row that opens. */
  div.dr-line::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05em;
    width: 6px;
    height: 1px;
    background: var(--line);
  }

  summary.dr-line::before {
    content: "";
    position: absolute;
    left: 1px;
    top: 0.82em;
    width: 5px;
    height: 5px;
    border-right: 1.5px solid var(--accent-soft);
    border-bottom: 1.5px solid var(--accent-soft);
    transform: rotate(-45deg);
    transition: transform 0.18s var(--ease-out);
  }

  details[open] > summary.dr-line::before {
    transform: rotate(45deg);
  }

  summary.dr-line:hover .dr-name,
  summary.dr-line:focus-visible .dr-name {
    color: var(--accent);
  }

  summary.dr-line:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 3px;
  }

  .dr-head {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .dr-name {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
    overflow-wrap: anywhere;
    transition: color 0.15s ease-out;
  }

  /* One type size across the row -- name, count, version, members. The
     distinctions here are of kind, not of rank, and they are carried by
     colour and by face: mono for anything that is a package name or a
     version, the UI face for the count, which is prose about them. */
  .dr-with {
    font-size: 0.82rem;
    color: var(--dim);
    white-space: nowrap;
  }

  /* A jump worth noticing reads as one: more weight on the name, no badge. */
  .is-major .dr-name {
    font-weight: 700;
  }

  .dr-ver {
    font-size: 0.82rem;
    text-align: right;
    min-width: 0;
  }

  /* A downgrade is not an improvement and must not be lit like one. Version
     colours its own spans, so overriding one of them reaches across a scope
     boundary: kept to this single, deliberate case. */
  .is-down :global(.v-to) {
    color: var(--text);
    font-weight: 700;
  }

  .dr-members {
    list-style: none;
    margin: -0.1rem 0 0.75rem;
    padding: 0 0 0 1.15rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    /* Below this the version cannot share a line with anything, so the row
       becomes two lines rather than two columns fighting for the width. */
    .dr-line {
      grid-template-columns: minmax(0, 1fr);
    }
    .dr-ver {
      text-align: left;
    }
  }
</style>
