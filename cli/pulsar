#!/usr/bin/env bash
# pulsar -- the front door to a Pulsar system.
#
# Every subcommand is a thin wrapper over bootc, ostree, rpm-ostree, systemd or
# jq. That is deliberate: none of this needs logic of its own, and a compiled
# binary would add a build pipeline to hide five lines of shell. What it does
# add is a single place where the RIGHT question gets asked -- see `doctor`.
#
# Reads go through rpm-ostree, writes through bootc. Not a style preference:
# `bootc status` requires root even to READ, and a health check you cannot run
# without sudo is one you will not run. `rpm-ostree status --json` reports the
# same deployments unprivileged, so `pulsar status` and `pulsar doctor` work as
# any user, and only the commands that actually mutate the system ask for root.
#
# The one write that does not always go through bootc is `update` -- bootc owns
# the container image and nothing else, so on a system with layered packages it
# is the wrong tool. See cmd_update.
set -euo pipefail

VERSION="1.0.0"
MANIFEST=${PULSAR_MANIFEST:-/usr/share/pulsar/manifest.json}
SBOM_TOOL=${PULSAR_SBOM_TOOL:-/usr/libexec/pulsar/rpm-sbom.sh}

# ---------------------------------------------------------------------------
# Output. Colour only when stdout is a terminal, so piping into a file or a
# log does not embed escape codes.
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
    C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_FAIL=$'\033[31m'; C_KEY=$'\033[36m'
else
    C_RESET=""; C_DIM=""; C_BOLD=""; C_OK=""; C_WARN=""; C_FAIL=""; C_KEY=""
fi

die() { printf '%spulsar:%s %s\n' "$C_FAIL" "$C_RESET" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

need_root() {
    [ "$(id -u)" -eq 0 ] && return 0
    die "'$1' changes the system and must run as root -- try: sudo pulsar $1"
}

# The mirror image, for setup recipes: they write to $HOME and talk to the
# user session bus, and under sudo both silently target root's. The failure
# that surfaces otherwise is systemd's "Failed to connect to bus", which
# points nowhere near the actual mistake.
need_user() {
    [ "$(id -u)" -ne 0 ] && return 0
    die "'setup $1' configures your session and must not run as root -- drop the sudo"
}

need() { have "$1" || die "required tool not found: $1"; }

# Commands that take no arguments say so, instead of silently ignoring what
# they were given: `pulsar doctor tomorrow` should not run doctor today.
no_args() {
    local c=$1; shift
    [ $# -eq 0 ] || die "'${c}' takes no arguments (got: $*)"
}

# Reads a top-level string out of the baked manifest. Absent manifest is not
# fatal: a system rebased from an older image, or a hand-built one, still gets
# a working doctor and status.
mf() {
    # if-then, not `A && B || C`: in that form C also runs when A succeeds and
    # B fails, which is the same shape as the fallback bug that made the
    # greenboot check report health it could not see.
    [ -r "$MANIFEST" ] || return 0
    jq -r --arg k "$1" '.[$k] // empty' "$MANIFEST" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# doctor -- the reason this CLI exists.
#
# Checks carry a severity, and only `fail` changes the exit code. The
# distinction matters and is the same one greenboot's required.d/wanted.d
# split encodes: a scheduler that did not attach is a performance regression
# on a completely usable machine, so it warns. A boot that greenboot marked
# red is a system that tried to roll itself back, so it fails.
# ---------------------------------------------------------------------------
CHECK_JSON=""
RC=0

# record <id> <ok|warn|fail> <headline> [detail]
record() {
    local id=$1 status=$2 head=$3 detail=${4:-}
    local colour symbol
    case "$status" in
        ok)   colour=$C_OK;   symbol="ok  " ;;
        warn) colour=$C_WARN; symbol="warn" ;;
        fail) colour=$C_FAIL; symbol="FAIL"; RC=1 ;;
        # a typo'd severity would otherwise die on an unbound variable three
        # lines down, attributed to nothing
        *)    die "internal error: record() called with status '${status}'" ;;
    esac
    if [ "${JSON:-0}" = 1 ]; then
        CHECK_JSON+=$(jq -n -c --arg i "$id" --arg s "$status" --arg h "$head" --arg d "$detail" \
            '{id:$i, status:$s, summary:$h, detail:$d}'),
    else
        printf '%s%s%s  %-11s %s\n' "$colour" "$symbol" "$C_RESET" "$id" "$head"
        [ -n "$detail" ] && printf '           %s%s%s\n' "$C_DIM" "$detail" "$C_RESET"
    fi
    return 0
}

check_scheduler() {
    local state file=/sys/kernel/sched_ext/state
    if [ ! -e "$file" ]; then
        record scheduler ok "kernel has no sched_ext; stock EEVDF" ; return
    fi
    state=$(cat "$file" 2>/dev/null || echo unknown)
    if [ "$state" = "enabled" ]; then
        local ops; ops=$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || echo unknown)
        record scheduler ok "sched_ext enabled" "root scheduler: ${ops}"
    elif [ ! -e /usr/lib/pulsar/scx-supported ]; then
        # Not a fault: this kernel's BTF cannot load ANY BPF scheduler, the
        # build detected that, and scx.service is skipped rather than failed.
        # Reporting it as a warning forever would be indistinguishable from
        # something the user could fix, and there is nothing to fix here.
        record scheduler ok "stock EEVDF: this kernel cannot load a BPF scheduler" \
               "scx kfuncs carry the implicit prog-aux argument (Fedora kernel BTF)"
    else
        # Warn, not fail. The machine runs fine on EEVDF -- but this is the
        # check that catches the failure `systemctl is-active scx.service`
        # cannot see, where the unit is green and no scheduler ever attached.
        local unit
        # NOT $(cmd || echo fallback): is-active PRINTS "failed" and THEN exits
        # nonzero, so the fallback appends to it and you get "failed\nunknown".
        unit=$(systemctl is-active scx.service 2>/dev/null) || true
        [ -n "$unit" ] || unit=unknown
        record scheduler warn "sched_ext is '${state}' -- running stock EEVDF" \
               "scx.service: ${unit}"
    fi
}

check_ntsync() {
    if [ -e /dev/ntsync ]; then
        record ntsync ok "/dev/ntsync present" "$(stat -c '%A %U:%G' /dev/ntsync 2>/dev/null || true)"
    elif grep -q '^ntsync ' /proc/modules 2>/dev/null; then
        record ntsync warn "ntsync module loaded but /dev/ntsync is missing" "check 70-ntsync.rules"
    else
        record ntsync warn "ntsync not available" "Proton falls back to esync/fsync"
    fi
}

check_greenboot() {
    local enabled
    # is-enabled prints "not-found" AND exits nonzero. Appending a fallback
    # produced "not-found\nnot-found", which matched nothing, so this check
    # fell through and reported "passed" on a system with no greenboot at all.
    enabled=$(systemctl is-enabled greenboot-healthcheck.service 2>/dev/null) || true
    [ -n "$enabled" ] || enabled=not-found
    if [ "$enabled" = "not-found" ] || [ "$enabled" = "masked" ]; then
        record greenboot warn "greenboot is not installed on this deployment" \
               "automatic rollback is not armed"
        return
    fi
    local result; result=$(systemctl show -p Result --value greenboot-healthcheck.service 2>/dev/null || echo unknown)
    if [ "$result" = "success" ] || [ "$result" = "" ]; then
        record greenboot ok "health checks passed" "boot marked green"
    else
        # A red boot means greenboot is counting down to a rollback.
        record greenboot fail "last health check result: ${result}" \
               "journalctl -u greenboot-healthcheck.service"
    fi
}

check_nvidia() {
    local variant; variant=$(mf variant)
    case "$variant" in
        *nvidia*) ;;
        "") # No manifest. Only report if the driver is actually present.
            grep -q '^nvidia ' /proc/modules 2>/dev/null || return 0 ;;
        *)  # Vanilla image: nvidia absence is correct, say nothing.
            return 0 ;;
    esac
    # /proc/modules and /sys, never lsmod/modinfo: those live in /usr/sbin,
    # which is not on every user's PATH, and under pipefail a missing binary
    # reads as "no nvidia module" -- a false clean bill of health.
    if ! grep -q '^nvidia ' /proc/modules 2>/dev/null; then
        record nvidia fail "nvidia variant but no nvidia module is loaded" \
               "Secure Boot may have rejected an unsigned module: dmesg | grep -i taint"
        return
    fi
    local running expected
    running=$(cat /sys/module/nvidia/version 2>/dev/null) || true
    [ -n "$running" ] || running=unknown
    expected=$(mf nvidia_driver)
    # Only compare against something version-shaped. A manifest once carried
    # nvidia_driver="package kmod-nvidia-open is not installed" -- rpm prints
    # that on stdout and exits 1, so a `$(rpm -q ... || fallback)` captured it
    # as the value, and comparing against it warned on every run, forever.
    # Garbage in the manifest is the manifest's bug to report, not a reason
    # to cry wolf about a driver that is fine.
    case "$expected" in
        *[!0-9.]*|'') expected="" ;;
    esac
    if [ -n "$expected" ] && [ "$running" != "$expected" ]; then
        record nvidia warn "driver ${running}, image expects ${expected}" \
               "a reboot into the staged deployment usually reconciles this"
    else
        record nvidia ok "nvidia-open ${running} loaded"
    fi
}

check_flathub() {
    have flatpak || { record flathub warn "flatpak is not installed"; return; }
    local opts
    opts=$(flatpak remotes --columns=name,options 2>/dev/null | awk '$1=="flathub"{ $1=""; print }')
    if [ -z "$opts" ]; then
        record flathub warn "flathub remote is not configured"
    elif printf '%s' "$opts" | grep -q filter; then
        # Fedora ships a filtered flathub; the whole point of the shipped
        # remotes.d file is that this system does not.
        record flathub warn "flathub is FILTERED" "most applications will be hidden"
    else
        record flathub ok "flathub present and unfiltered"
    fi
}

# What "locally modified" means, spelled once. These are the origin keys that
# `rpm-ostree install` and `rpm-ostree override` write, counted on the BOOTED
# deployment; a missing key is null and `null | length` is 0, so absent and
# empty need no separate handling. Two readers depend on this answer -- doctor
# reports it, update routes on it -- and two copies of the list would drift
# into disagreeing about the same system.
JQ_LAYERED='[ .deployments[]? | select(.booted == true) |
   ( ."requested-packages", ."requested-local-packages",
     ."requested-local-fileoverride-packages", ."requested-base-removals",
     ."requested-base-local-replacements", ."requested-modules" ) ]
 | map(length) | add // 0'

check_updates() {
    have rpm-ostree || { record updates warn "rpm-ostree not available"; return; }
    local js line staged pinned total ver lay
    js=$(rpm-ostree status --json 2>/dev/null || echo '{}')
    # one jq pass for all five numbers, not five passes over the same JSON
    line=$(printf '%s' "$js" | jq -r '
      [ ([.deployments[]? | select(.staged == true)] | length),
        ([.deployments[]? | select(.pinned == true)] | length),
        (.deployments // [] | length),
        ([.deployments[]? | select(.staged == true) | .version][0] // "?"),
        ('"$JQ_LAYERED"')
      ] | map(tostring) | join("\t")' 2>/dev/null) || line=''
    [ -n "$line" ] || line=$(printf '0\t0\t0\t?\t0')
    IFS=$'\t' read -r staged pinned total ver lay <<<"$line"
    local detail="${total} deployment(s), ${pinned} pinned"
    # Worth surfacing even when everything is healthy: it changes which tool
    # `pulsar update` runs, and it is the reason an update takes minutes
    # instead of seconds.
    [ "${lay:-0}" -gt 0 ] && detail="${detail}, ${lay} layered -- updates go through rpm-ostree"
    if [ "${staged:-0}" -gt 0 ]; then
        record updates ok "update staged: ${ver}" "reboot to apply"
    else
        record updates ok "no update staged" "$detail"
    fi
}

check_disk() {
    local root=/sysroot
    [ -d "$root" ] || root=/
    local pct avail
    pct=$(df --output=pcent "$root" 2>/dev/null | tail -1 | tr -dc '0-9')
    avail=$(df -h --output=avail "$root" 2>/dev/null | tail -1 | tr -d ' ')
    [ -n "$pct" ] || { record disk warn "could not read disk usage for ${root}"; return; }
    # A bootc system needs room to stage a whole new image. Under ~10GB free
    # an upgrade starts failing in ways that look like network errors.
    if [ "$pct" -ge 90 ]; then
        record disk fail "${root} is ${pct}% full (${avail} free)" "staging an update needs several GB"
    elif [ "$pct" -ge 80 ]; then
        record disk warn "${root} is ${pct}% full (${avail} free)"
    else
        record disk ok "${root} ${pct}% used, ${avail} free"
    fi
}

cmd_doctor() {
    [ "${JSON:-0}" = 1 ] || printf '%sPulsar health%s  %s\n\n' "$C_BOLD" "$C_RESET" "$(mf version)"
    check_scheduler
    check_ntsync
    check_greenboot
    check_nvidia
    check_flathub
    check_updates
    check_disk
    if [ "${JSON:-0}" = 1 ]; then
        printf '{"checks":[%s],"ok":%s}\n' "${CHECK_JSON%,}" "$([ "$RC" -eq 0 ] && echo true || echo false)"
    else
        printf '\n'
        [ "$RC" -eq 0 ] && printf '%sno failures%s\n' "$C_OK" "$C_RESET" \
                        || printf '%sone or more checks failed%s\n' "$C_FAIL" "$C_RESET"
    fi
    return "$RC"
}

# ---------------------------------------------------------------------------
# status / manifest
# ---------------------------------------------------------------------------
cmd_status() {
    need rpm-ostree
    local js; js=$(rpm-ostree status --json 2>/dev/null) || die "could not read deployment status"
    if [ "${JSON:-0}" = 1 ]; then printf '%s\n' "$js"; return 0; fi
    # The image reference sheds its whole transport prefix -- a single strip
    # left "docker://" behind on "ostree-image-signed:docker://ghcr.io/...".
    local tsv
    tsv=$(printf '%s' "$js" | jq -r '
      .deployments[]? |
      (if .booted then "booted" elif .staged then "staged" else "-" end) + "\t"
      + (.version // "?") + "\t"
      + ((."container-image-reference" // .origin // "?") | sub("^([a-z-]+:)+(//)?"; "")) + "\t"
      + (if .pinned then "yes" else "no" end)')
    [ -n "$tsv" ] || { printf 'no deployments reported\n'; return 0; }

    # Columns measured from the data, like the manifest. The image reference
    # is the elastic column: truncated only when a real terminal is too
    # narrow to hold it -- a hardcoded 42 was cutting the tag off refs on
    # terminals with a hundred columns to spare -- and a pipe always gets
    # the full reference.
    local verw=7 imgw=5 state ver img pin
    while IFS=$'\t' read -r state ver img pin; do
        [ "${#ver}" -gt "$verw" ] && verw=${#ver}
        [ "${#img}" -gt "$imgw" ] && imgw=${#img}
    done <<<"$tsv"
    local cols=0 max=0
    [ -n "$C_RESET" ] && cols=$(tput cols 2>/dev/null || echo 0)
    if [ "$cols" -gt 0 ]; then
        max=$((cols - 8 - 1 - verw - 1 - 1 - 6))   # state, gaps, version, pinned
        if [ "$max" -ge 12 ] && [ "$imgw" -gt "$max" ]; then imgw=$max; else max=0; fi
    fi

    printf '%s%-8s %-*s %-*s %s%s\n' "$C_BOLD" "STATE" "$verw" "VERSION" "$imgw" "IMAGE" "PINNED" "$C_RESET"
    while IFS=$'\t' read -r state ver img pin; do
        if [ "$max" -gt 0 ] && [ "${#img}" -gt "$max" ]; then
            img="${img:0:max-3}..."
        fi
        printf '%-8s %-*s %-*s %s\n' "$state" "$verw" "$ver" "$imgw" "$img" "$pin"
    done <<<"$tsv"
}

# ---------------------------------------------------------------------------
# The machine, as opposed to the image. This is fastfetch's half of the
# readout, and it follows fastfetch's rule: everything is read at run time and
# every row is OPTIONAL. A VM with no DMI table, a tty with no session, a
# build container with no /sys -- each drops its row rather than printing a
# question mark, because a manifest full of "?" reads like a broken command
# instead of an honest one. Nothing below may fail `manifest`: every reader
# returns non-zero instead of dying, and its caller skips it.
#
# The readers return RAW values and the formatting lives in host_rows, for the
# same reason the manifest rows leave jq untouched: `--json` needs the number,
# the terminal needs "8.1 GiB / 62.2 GiB", and a reader that only knows how to
# produce the second cannot serve the first.
# ---------------------------------------------------------------------------

# Vendors disagree about which DMI field holds the name a human would use.
# Lenovo puts the marketing name in product_version and a model code ("83F5")
# in product_name; Dell does the reverse and parks "Not Specified" in version.
# Trying them in this order, with the known placeholder strings filtered, gets
# both right without special-casing either vendor.
dmi_model() {
    local f v
    for f in product_version product_family product_name; do
        v=$(cat "/sys/devices/virtual/dmi/id/$f" 2>/dev/null) || continue
        case "$v" in
            ""|None|"To Be Filled By O.E.M."|"System Product Name"|\
            "Default string"|"Not Specified"|"Not Applicable"|"INVALID") continue ;;
        esac
        printf '%s\n' "$v"; return 0
    done
    return 1
}

# "Intel(R) Core(TM) Ultra 9 275HX" is the string the kernel exports; the
# trademark noise is not information.
cpu_name() {
    local m
    m=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo 2>/dev/null | head -1)
    [ -n "$m" ] || return 1
    m=${m//(R)/}; m=${m//(TM)/}; m=${m//(tm)/}; m=${m//(C)/}
    m=$(printf '%s' "$m" | tr -s ' '); m=${m# }; m=${m% }
    printf '%s\n' "$m"
}

# Threads rather than cores: nproc is what schedulers and gamescope see.
cpu_threads() { nproc 2>/dev/null || return 1; }

# One row per display-class PCI device, in bus order, the way fastfetch prints
# a GPU line each. 3D-controller class is included on purpose: on most hybrid
# laptops the discrete card enumerates as 0302, not 0300, and filtering to VGA
# alone hides the card the user bought this image for. Without pciutils the
# vendor:device pair still goes out -- it is enough to look up, and better
# than silence.
gpu_names() {
    local line d found=1
    if have lspci; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            # "GB203M / GN22-X9 [GeForce RTX 5080 Max-Q]" -> the bracketed
            # marketing name, which is the half anyone recognises.
            case "$d" in *'['*']'*) d=${d##*[}; d=${d%%]*} ;; esac
            printf '%s\n' "$d"; found=0
        done < <(lspci -mm 2>/dev/null | awk -F'"' \
            '$2 ~ /VGA compatible controller|3D controller|Display controller/ { print $6 }')
    else
        for line in /sys/bus/pci/devices/*; do
            case "$(cat "$line/class" 2>/dev/null)" in
                0x03*) printf '%s:%s\n' \
                    "$(cat "$line/vendor" 2>/dev/null)" \
                    "$(cat "$line/device" 2>/dev/null)"; found=0 ;;
            esac
        done
    fi
    return "$found"
}

gib() { awk -v k="$1" 'BEGIN { printf "%.1f GiB\n", k / 1048576 }'; }

# "used total", in kB, as /proc/meminfo reports them. "Used" is total minus
# MemAvailable rather than minus MemFree: cache and reclaimable slab are not
# memory you have lost, and MemFree alone makes every healthy Linux box look
# full. MemAvailable predates every kernel this image can boot, but if it is
# somehow missing, used goes out as "-" rather than as a fabricated number.
mem_kb() {
    local total avail
    total=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null) || return 1
    [ -n "$total" ] || return 1
    avail=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo 2>/dev/null)
    if [ -n "$avail" ]; then printf '%s %s\n' "$((total - avail))" "$total"
    else                     printf -- '- %s\n' "$total"; fi
}

# Used / total, fastfetch's form.
mem_used_total() {
    local used total
    read -r used total < <(mem_kb) || return 1
    [ -n "$total" ] || return 1
    if [ "$used" = "-" ]; then gib "$total"
    else printf '%s / %s\n' "$(gib "$used")" "$(gib "$total")"; fi
}

# XDG_CURRENT_DESKTOP is a colon-separated list on derivative desktops
# ("pop:GNOME"); the last entry is the real one. Both variables are absent
# under sudo and on a tty, which is exactly when this row should not print.
session_desc() {
    local de=${XDG_CURRENT_DESKTOP:-} ty=${XDG_SESSION_TYPE:-}
    de=${de##*:}
    if   [ -n "$de" ] && [ -n "$ty" ]; then printf '%s (%s)\n' "$de" "$ty"
    elif [ -n "$de" ];                 then printf '%s\n' "$de"
    elif [ -n "$ty" ];                 then printf '%s\n' "$ty"
    else return 1; fi
}

uptime_s() {
    local s
    read -r s _ < /proc/uptime 2>/dev/null || return 1
    s=${s%.*}
    [ -n "$s" ] || return 1
    printf '%s\n' "$s"
}

# Coarse on purpose: this answers "did you reboot after the update?", and
# seconds of precision would only make the row noisier. --json gets the
# integer instead, because a machine should not have to parse "2h 14m".
uptime_desc() {
    local s d h m
    s=$(uptime_s) || return 1
    d=$((s / 86400)); h=$(((s % 86400) / 3600)); m=$(((s % 3600) / 60))
    if   [ "$d" -gt 0 ]; then printf '%dd %dh\n' "$d" "$h"
    elif [ "$h" -gt 0 ]; then printf '%dh %dm\n' "$h" "$m"
    else                      printf '%dm\n' "$m"; fi
}

# key<TAB>value rows for whatever this machine will admit to.
host_rows() {
    local v c n
    if v=$(dmi_model); then printf 'host\t%s\n' "$v"; fi
    if c=$(cpu_name); then
        if n=$(cpu_threads); then c="$c ($n threads)"; fi
        printf 'cpu\t%s\n' "$c"
    fi
    while IFS= read -r v; do
        if [ -n "$v" ]; then printf 'gpu\t%s\n' "$v"; fi
    done < <(gpu_names || true)
    if v=$(mem_used_total); then printf 'memory\t%s\n' "$v"; fi
    if v=$(session_desc);   then printf 'session\t%s\n' "$v"; fi
    if v=$(uptime_desc);    then printf 'uptime\t%s\n' "$v"; fi
    return 0
}

# The same facts as data. Raw numbers, not the terminal's formatting, and
# absent fields OMITTED rather than null -- the rows drop, so the keys drop
# too, and a consumer can test presence instead of testing for null.
#
# Everything lands under one "host" key so `jq 'del(.host)'` gives back the
# baked manifest: two machines on the same build still compare equal, which
# was the whole reason this was not merged in at the top level.
host_json() {
    local model cpu threads gpus used total de ty up
    model=$(dmi_model)   || model=""
    cpu=$(cpu_name)      || cpu=""
    threads=$(cpu_threads) || threads=""
    gpus=$(gpu_names | jq -R -s 'split("\n") | map(select(length > 0))') || gpus="[]"
    read -r used total < <(mem_kb) || { used="-"; total=""; }
    [ "$used" = "-" ] && used=""
    de=${XDG_CURRENT_DESKTOP:-}; de=${de##*:}
    ty=${XDG_SESSION_TYPE:-}
    up=$(uptime_s) || up=""

    jq -n --arg model "$model" --arg cpu "$cpu" --arg de "$de" --arg ty "$ty" \
          --argjson gpu "$gpus" \
          --argjson threads "${threads:-null}" \
          --argjson used "${used:-null}" \
          --argjson total "${total:-null}" \
          --argjson up "${up:-null}" '
      def prune: with_entries(select(
          .value != null and .value != "" and .value != [] and .value != {}));
      {
        model:       $model,
        cpu:         $cpu,
        cpu_threads: $threads,
        gpu:         $gpu,
        memory:      ({ used_bytes:  (if $used  == null then null else $used  * 1024 end),
                        total_bytes: (if $total == null then null else $total * 1024 end)
                      } | prune),
        session:     ({ desktop: $de, type: $ty } | prune),
        uptime_s:    $up
      } | prune
    '
}

cmd_manifest() {
    [ -r "$MANIFEST" ] || die "no manifest at ${MANIFEST} (image predates it, or was built without one)"
    if [ "${JSON:-0}" = 1 ]; then
        # The baked document plus one key, so the JSON says what the rows say.
        # A machine that can tell us nothing about itself gets no host key at
        # all rather than an empty object to special-case.
        local hj; hj=$(host_json)
        if [ -z "$hj" ] || [ "$hj" = "{}" ]; then
            cat "$MANIFEST"
        else
            jq --argjson host "$hj" '. + { host: $host }' "$MANIFEST" \
                || die "manifest at ${MANIFEST} is not valid JSON"
        fi
        return 0
    fi
    # Rows leave jq as key<TAB>value, unpadded and uncolored: widths, color,
    # and wrapping are terminal concerns, and bash is the only side that
    # knows the terminal. (Escapes hardcoded in the jq program once meant
    # `pulsar manifest | cat` emitted raw control codes.)
    # Split in two so the machine rows can be spliced between them: what this
    # image IS, what it is running ON, then what is INSIDE it.
    #
    # Every row here is a FACT. There were once two that were not: `sbom` and
    # `attestation`, whose values were other commands to go and run. The
    # attestation one made the cost obvious -- the baked `gh attestation
    # verify ...` line is 82 characters, three times the next longest row, and
    # it dragged the readout's right edge out past the art to say something
    # `pulsar --help` already says. A manifest is an inventory, not a menu.
    # Both commands still exist (`pulsar sbom`, `pulsar attest`); they are
    # listed where commands are listed.
    local head rest tsv
    head=$(jq -r '
      [ ["image",   (.image // "?") + (if .variant then " (" + .variant + ")" else "" end)],
        ["version", (.version // "?")],
        ["base",    (.base // "?")],
        ["built",   (.built // "?")],
        ["kernel",  (.kernel // "?")]
      ] | .[] | .[0] + "\t" + .[1]
    ' "$MANIFEST") || die "manifest at ${MANIFEST} is not valid JSON"
    rest=$(jq -r '
      ((.components // {}) | to_entries | map([.key, (.value | tostring)]))
      | .[] | .[0] + "\t" + .[1]
    ' "$MANIFEST") || die "manifest at ${MANIFEST} is not valid JSON"

    tsv=$head
    local hr; hr=$(host_rows)
    if [ -n "$hr" ];   then tsv=$(printf '%s\n%s' "$tsv" "$hr"); fi
    if [ -n "$rest" ]; then tsv=$(printf '%s\n%s' "$tsv" "$rest"); fi

    # The key column is measured, never guessed. A fixed width of 11 already
    # ran "attestation" into its value once; components come from the
    # manifest, so the longest key is whatever the image happened to ship.
    local keyw=0 k v
    while IFS=$'\t' read -r k v; do
        [ "${#k}" -gt "$keyw" ] && keyw=${#k}
    done <<<"$tsv"

    # Fit against the REAL terminal, not a magic minimum. The art is drawn
    # only when it leaves the values a usable column, and values wrap inside
    # their column -- the terminal's own wrap restarts at column zero, which
    # shears the art and the table both (seen in the field at 72 columns:
    # every long value snapped its row in half). An explicit --logo skips the
    # fit check; asking twice means wanting it regardless. cols=0 (no tty,
    # tput failure) disables wrapping entirely -- pipes do not wrap.
    local cols=0 artw=0 avail=0
    [ -n "$C_RESET" ] && cols=$(tput cols 2>/dev/null || echo 0)
    if want_logo; then
        artw=$(logo_width)
        if [ "$cols" -gt 0 ] && [ "${LOGO:-auto}" != always ] && \
           [ $((cols - artw - 2 - keyw - 2)) -lt 24 ]; then
            artw=0    # art at the price of the information is the wrong trade
        fi
    fi
    if [ "$cols" -gt 0 ]; then
        avail=$((cols - keyw - 2))
        [ "$artw" -gt 0 ] && avail=$((avail - artw - 2))
        [ "$avail" -lt 16 ] && avail=0   # too narrow to wrap sensibly
    fi

    local rows
    rows=$(format_rows "$keyw" "$avail" <<<"$tsv")
    if [ "$artw" -gt 0 ]; then paste_logo "$rows"; else printf '%s\n' "$rows"; fi
    swatches
}

# key<TAB>value rows in, colored lines out: the key padded into its column,
# the value word-wrapped to $2 columns with continuations indented under the
# value column. avail=0 wraps nothing. A single word longer than the column
# (an oci:// reference) is left whole -- a word broken to fit is worse than
# one the terminal wraps.
format_rows() {
    local keyw=$1 avail=$2 k v line word i
    while IFS=$'\t' read -r k v; do
        local -a words=() parts=()
        if [ "$avail" -gt 0 ]; then
            read -ra words <<<"$v"
            line=""
            for word in "${words[@]}"; do
                if [ -z "$line" ]; then line=$word
                elif [ $(( ${#line} + 1 + ${#word} )) -le "$avail" ]; then line="$line $word"
                else parts+=("$line"); line=$word; fi
            done
            parts+=("$line")
        else
            parts=("$v")
        fi
        printf '%s%-*s%s%s\n' "$C_KEY" $((keyw + 2)) "$k" "$C_RESET" "${parts[0]}"
        for ((i = 1; i < ${#parts[@]}; i++)); do
            printf '%*s%s\n' $((keyw + 2)) '' "${parts[i]}"
        done
    done
}

# The mark as ASCII, rendered from assets/brand/pulsar-mark.svg by
# scripts/render-ascii-logo.py and shipped at /usr/share/pulsar/logo.ansi.
# Generated so it cannot drift from the artwork -- see that script for why
# hand-drawing it failed.
#
# Every line carries exactly the same number of visible characters, so pasting
# a second column beside it needs no width arithmetic -- and because the ramp
# is 7-bit, one character is one byte and `${#s}` is honest in any locale.
LOGO_FILE=${PULSAR_LOGO:-/usr/share/pulsar/logo.ansi}

# fastfetch's shape: art on the left, readout on the right, and whichever
# column is shorter simply runs out. Suppressed when there is no terminal to
# draw on or no art to draw; whether the terminal is WIDE enough is decided
# in cmd_manifest, where the measured key column is known.
want_logo() {
    [ "${LOGO:-auto}" != "never" ] || return 1
    [ -r "$LOGO_FILE" ] || return 1
    [ "${LOGO:-auto}" = "always" ] || [ -n "$C_RESET" ]
}

# Measured from the art itself, with the escapes stripped: the file is
# generated, so hardcoding its width here would be a second source of truth
# that nothing keeps honest.
logo_width() {
    local first
    IFS= read -r first < "$LOGO_FILE" || true
    # ${#} rather than wc -c: paste_logo pads with ${#} too, and the two must
    # agree on what "width" means if a custom PULSAR_LOGO is ever not 7-bit
    first=$(printf '%s' "$first" | sed $'s/\033\[[0-9;]*m//g')
    printf '%s\n' "${#first}"
}

paste_logo() {
    local -a art=() info=()
    mapfile -t art < "$LOGO_FILE"
    mapfile -t info <<< "$1"
    # Measured from the art itself, with the escapes stripped: the file is
    # generated, so hardcoding its width here would be a second source of
    # truth that nothing keeps honest.
    local plain pad
    plain=$(printf '%s' "${art[0]:-}" | sed $'s/\033\[[0-9;]*m//g')
    printf -v pad '%*s' "${#plain}" ''
    local i n=${#art[@]} m=${#info[@]}
    [ "$m" -gt "$n" ] && n=$m
    for ((i = 0; i < n; i++)); do
        printf '%s  %s\n' "${art[i]-$pad}" "${info[i]-}"
    done
}

# The brand palette as terminal blocks, the way fastfetch closes its readout.
# This is the line that makes the one-pager's mock terminal a transcript rather
# than an illustration -- the page shows these swatches, so the real command
# has to as well. 24-bit colour, and only when we are on a terminal;
# `pulsar manifest --json` and piped output get nothing.
swatches() {
    [ -n "$C_RESET" ] || return 0
    local rgb
    printf '\n'
    for rgb in "11;14;26" "36;31;61" "62;203;255" "143;168;255" "75;63;212" "233;237;247"; do
        printf '\033[48;2;%sm   \033[0m' "$rgb"
    done
    printf '\n'
}

# ---------------------------------------------------------------------------
# Lifecycle. These mutate, so they need root. rollback, pin and unpin hand
# straight to the tool that owns the deployment; update has to pick one.
# ---------------------------------------------------------------------------
# update -- the same intent, through whichever tool can actually honour it.
#
# bootc's model is the container image and nothing else. It does not know that
# `rpm-ostree install 1password` added a layer on top of that image, so an
# upgrade through bootc does not carry the layer forward: the packages you
# installed are not in the deployment it stages. rpm-ostree does know, because
# it wrote the origin, and its upgrade re-pulls the same container image and
# re-applies the layer on top.
#
# So this asks the deployment which it is, rather than making the user
# remember. An unlayered system -- the shipped default -- still goes through
# bootc, which is the tool that owns it.
#
# Unreadable status is fatal rather than a guess. Guessing bootc on a layered
# system throws the layer away, and you find out at the next boot.
cmd_update() {
    need_root update
    local lay
    if have rpm-ostree; then
        lay=$(rpm-ostree status --json 2>/dev/null | jq -r "$JQ_LAYERED" 2>/dev/null) \
            || die "could not read deployment status; refusing to guess which upgrade path is right"
        [ -n "$lay" ] || die "could not read deployment status; refusing to guess which upgrade path is right"
    else
        lay=0   # nothing to layer with, so nothing can be layered
    fi

    if [ "$lay" -eq 0 ]; then
        need bootc
        exec bootc upgrade "$@"
    fi

    printf '%spulsar:%s %s local package modification(s) on this deployment -- upgrading through rpm-ostree so they survive\n' \
        "$C_KEY" "$C_RESET" "$lay" >&2
    need rpm-ostree
    # The flags pulsar documents are bootc's, and --apply has an exact
    # counterpart here. Everything else passes through verbatim and fails at
    # rpm-ostree if it does not exist there, which is the honest outcome --
    # better than a silently dropped flag.
    local f; local -a a=()
    for f in "$@"; do
        case "$f" in --apply) a+=(--reboot) ;; *) a+=("$f") ;; esac
    done
    exec rpm-ostree upgrade ${a[@]+"${a[@]}"}
}

cmd_rollback() { need_root rollback; need bootc; exec bootc rollback "$@"; }

cmd_pin() {
    need_root pin; need ostree
    # Index 0 is the booted deployment for `ostree admin pin`.
    ostree admin pin 0 && printf 'pinned the booted deployment; it will survive GC\n'
}
cmd_unpin() {
    need_root unpin; need ostree
    ostree admin pin --unpin 0 && printf 'unpinned the booted deployment\n'
}

# ---------------------------------------------------------------------------
# sbom -- generated, never baked.
#
# A file inside the image cannot describe the image that contains it: adding
# it changes the thing it describes. So this reads the live rpm database,
# which is the same source CI scans, through the same script. The published
# per-build copies live in R2 and are linked from the manifest.
# ---------------------------------------------------------------------------
cmd_sbom() {
    [ -x "$SBOM_TOOL" ] || die "sbom generator missing at ${SBOM_TOOL}"
    "$SBOM_TOOL" --local
}

# ---------------------------------------------------------------------------
# attest -- prove where this image came from.
#
# The verify command lives in the manifest rather than here because the owner
# and registry are build-time facts: an image built from a fork must verify
# against the fork, and a copy of the command in the CLI would verify against
# us and pass when it should not.
#
# Run as an argv array, never through eval or `bash -c`. The manifest is a
# data file and running a string out of one is a habit worth not having; the
# array also means a value containing a pipe or a semicolon fails loudly
# instead of doing something inventive.
#
# The verifier is NOT shipped in the image, so the command is printed before
# anything is checked. Printing first is what makes the missing-tool path
# useful rather than a dead end: the line on your screen is the whole answer
# to "how do I check this myself", and it is as true from a distrobox or a
# laptop that has never booted Pulsar as it is from here.
# ---------------------------------------------------------------------------
cmd_attest() {
    local cmd; cmd=$(mf attestation)
    [ -n "$cmd" ] || die "this image's manifest carries no attestation command"
    local -a argv=(); read -ra argv <<<"$cmd"
    [ "${#argv[@]}" -gt 0 ] || die "the manifest's attestation command is empty"
    # Echoed first: the point of the command is that you can check it yourself,
    # and a verifier you cannot read is not much of one.
    printf '%s%s%s\n' "$C_DIM" "$cmd" "$C_RESET"
    have "${argv[0]}" || die "this image does not ship '${argv[0]}'; run the command above wherever you have it"
    "${argv[@]}"
}

# ---------------------------------------------------------------------------
# changelog -- what moved between the published build and this one.
# ---------------------------------------------------------------------------
cmd_changelog() {
    local url; url=$(mf changelog_url)
    [ -n "$url" ] || die "this image records no changelog_url; see ${MANIFEST}"
    need curl
    local js
    js=$(curl -fsSL "$url" 2>/dev/null) || die "could not fetch ${url}"
    if [ "${JSON:-0}" = 1 ]; then printf '%s\n' "$js"; return 0; fi
    # A baseline diff says what it is instead of "0 upgraded · 0 added";
    # downgrades are marked ! rather than blending into the upgrades; and a
    # response that is not the changelog (a captive portal, an error page
    # served as 200) dies with a message instead of raw jq stderr.
    printf '%s' "$js" | jq -r '
      if .baseline == true then
        "first build, nothing to compare against yet",
        "generated \(.generated // "?")"
      else
        "\(.summary.upgraded // 0) upgraded · \(.summary.added // 0) added · \(.summary.removed // 0) removed"
        + (if (.summary.downgraded // 0) > 0 then " · \(.summary.downgraded) downgraded" else "" end),
        "generated \(.generated // "?")", "",
        (.changed[]? | "  \(if .direction == "downgraded" then "!" else "~" end) \(.name)  \(.from) → \(.to)"),
        (.added[]?   | "  + \(.name)  \(.version)"),
        (.removed[]? | "  - \(.name)  \(.version)")
      end' || die "the response from ${url} is not a changelog"
}

# ---------------------------------------------------------------------------
# setup -- the mutable-state recipes an image cannot bake.
# ---------------------------------------------------------------------------
cmd_setup() {
    local recipe=${1:-}
    case "$recipe" in
    devbox)
        need_user devbox
        need distrobox
        local ini=/usr/share/pulsar/distrobox.ini
        [ -r "$ini" ] || die "no distrobox manifest at ${ini}"
        distrobox assemble create --file "$ini"
        ;;
    quadlet)
        need_user quadlet
        local tpl=/usr/share/pulsar/templates/example.container
        local dir="${HOME}/.config/containers/systemd"
        [ -r "$tpl" ] || die "no quadlet template at ${tpl}"
        mkdir -p "$dir"
        if [ -e "${dir}/example.container" ]; then
            printf 'example.container already exists; leaving it alone\n'
        else
            cp "$tpl" "${dir}/example.container"
            printf 'copied template to %s/example.container\n' "$dir"
        fi
        systemctl --user daemon-reload
        systemctl --user enable --now podman-auto-update.timer
        printf 'edit it, then: systemctl --user start example\n'
        ;;
    gamescale)
        need_user gamescale
        # Delegates to upstream's installer against the copy staged in the
        # image, so this runs offline from pinned, hash-verified files and the
        # ~/.local copy matches the image exactly. Reimplementing the flatpak
        # grants here would drift from upstream the moment they change one.
        local src=/usr/share/pulsar/gamescale/install.sh
        [ -x "$src" ] || die "gamescale is not staged in this image (${src})"
        shift || true
        printf 'running the staged gamescale installer (offline, pinned)\n'
        "$src" "$@"
        ;;
    ""|-h|--help)
        printf 'usage: pulsar setup <recipe>\n\n  devbox      create the default distrobox\n  quadlet     install the quadlet template and enable auto-update\n  gamescale   grant flatpak launchers, from the staged copy\n'
        ;;
    *) die "unknown recipe: ${recipe} (try: pulsar setup --help)" ;;
    esac
}

usage() {
    cat <<'EOF'
pulsar -- manage a Pulsar system

  pulsar manifest          what is in this image, and what it is running on
  pulsar doctor            health snapshot (exit 1 if a check fails);
                           the default when no command is given
  pulsar status            deployments: booted, staged, rollback, pins
  pulsar changelog         packages that moved in the latest published build
  pulsar sbom              this system's packages as SPDX 2.3
  pulsar attest            print (and run) the provenance check for this image

  pulsar update            fetch and stage an update        (root)
                           through bootc, or through rpm-ostree if you have
                           layered packages, which bootc would drop
  pulsar rollback          boot the previous deployment     (root)
  pulsar pin | unpin       protect the booted deployment    (root)

  pulsar setup <recipe>    devbox | quadlet | gamescale

Options
  --logo, --no-logo        force or suppress the mark in `manifest`
  --json                   machine-readable output (doctor, status, manifest,
                           changelog); everything else ignores it.
                           `manifest --json` adds the host facts under a
                           "host" key, so `jq 'del(.host)'` is the baked
                           manifest and two machines on the same build still
                           compare equal
  --version, --help
EOF
}

main() {
    JSON=0
    local args=() seen_cmd=0
    for a in "$@"; do
        case "$a" in
            --json) JSON=1 ;;
            --logo) LOGO=always ;;
            --no-logo) LOGO=never ;;
            # Once a subcommand has been seen, --help belongs to IT: otherwise
            # `pulsar setup --help` printed the top-level usage and never told
            # you what the recipes were.
            -h|--help)
                if [ "$seen_cmd" = 1 ]; then args+=("$a"); else usage; exit 0; fi ;;
            -V|--version) printf 'pulsar %s\n' "$VERSION"; exit 0 ;;
            -*) args+=("$a") ;;
            *) seen_cmd=1; args+=("$a") ;;
        esac
    done
    set -- ${args[@]+"${args[@]}"}
    local cmd=${1:-doctor}
    shift || true
    # jq is needed by nearly everything -- but not by help, which is how you
    # find out what this is on a box that lacks jq.
    case "$cmd" in help) ;; *) need jq ;; esac
    # update/rollback pass their arguments through to the upgrade tool (which
    # has flags worth passing, --check among them); setup hands them to its
    # recipe.
    # Everything else takes none and says so.
    case "$cmd" in
        manifest)  no_args manifest "$@";  cmd_manifest ;;
        doctor)    no_args doctor "$@";    cmd_doctor ;;
        status)    no_args status "$@";    cmd_status ;;
        update)    cmd_update "$@" ;;
        rollback)  cmd_rollback "$@" ;;
        pin)       no_args pin "$@";       cmd_pin ;;
        unpin)     no_args unpin "$@";     cmd_unpin ;;
        changelog) no_args changelog "$@"; cmd_changelog ;;
        sbom)      no_args sbom "$@";      cmd_sbom ;;
        attest)    no_args attest "$@";    cmd_attest ;;
        setup)     cmd_setup "$@" ;;
        help)      usage ;;
        *)         usage >&2; die "unknown command: ${cmd}" ;;
    esac
}

main "$@"
