---
// The front door: the mark, the wordmark, one line, one button. Its
// background is assets/shaders/pulsar.frag -- the same shader that renders
// the OS wallpapers -- running live in WebGL; src/scripts/sky.ts compiles it.
//
// Nothing here may move when ARC UI hydrates. Every box has its size before
// any script runs: the mark is an <img> with width and height, the words are
// text, and the one button is pre-rendered to declarative shadow DOM at build
// time and held to its final height below. The old hero lost 0.22 of layout
// shift on phones to two code blocks collapsing on hydration; there are no
// code blocks here, and the install commands live under #install.
//
// The wordmark wears ARC's hero device: a blurred bloom twin behind it,
// breathing on the hero's own glow knob so the light theme stays calm. The
// wordmark itself stays solid -- the brand draws it that way.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Mark from './Mark.astro';
import Sky from './Sky.astro';

// Where the flywheel pivots: the mark's CORE, read from the shipped SVG at
// build time rather than typed in as a percentage. Each logo drop moves the
// core inside its cropped viewBox, and a hard-coded origin left over from the
// last drop makes the core orbit instead of spin. The light mark is staged
// onto this file's box (stage-assets.mjs), so the one origin serves both
// themes. The build runs from site/, so the repo root is one level up.
const MARK_SVG = join(process.cwd(), '..', 'assets', 'brand', 'svg', 'pulsar-animated-large.svg');
function coreOrigin(svg: string): string {
  const box = svg.match(/<svg\b[^>]*\bviewBox="([^"]+)"/)?.[1]?.split(/[\s,]+/).map(Number);
  const core = svg.match(/<circle\b[^>]*\bclass="pl-core"[^>]*>/)?.[0];
  const cx = Number(core?.match(/\bcx="([^"]+)"/)?.[1]);
  const cy = Number(core?.match(/\bcy="([^"]+)"/)?.[1]);
  if (!box || box.length !== 4 || !Number.isFinite(cx) || !Number.isFinite(cy)) {
    throw new Error(`cannot find the viewBox and .pl-core circle in ${MARK_SVG}`);
  }
  const [x, y, w, h] = box;
  return `${(((cx - x) / w) * 100).toFixed(2)}% ${(((cy - y) / h) * 100).toFixed(2)}%`;
}
const markOrigin = coreOrigin(readFileSync(MARK_SVG, 'utf8'));
---

<header class="hero">
  <Sky />

  <div class="inner">
    {/* spin is the easter egg's hook -- see src/scripts/spin.ts. Inlined,
        so the mark wears the page's theme: pick one and it recolours. */}
    <Mark kind="hero" size={200} spin class="mark" style={`--mark-origin: ${markOrigin}`} />
    <h1 class="wordmark">
      <span class="glow-wrap">
        <span class="word">PULSAR</span>
        <span class="word word-shadow" aria-hidden="true">PULSAR</span>
      </span>
    </h1>
    <p class="tagline">Your lighthouse in the sky.</p>
    <p class="sub">A stylish, atomic, agentic Linux that looks after itself.</p>
    <div class="go">
      <arc-button href="#install" variant="primary" size="lg">Get started</arc-button>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: url('/assets/silk-still-dark.jpg') center / cover no-repeat var(--ink);
    color: var(--star);
    --glow-a: 1;
  }
  :global(:root[data-theme='light']) .hero {
    background-image: url('/assets/silk-still-light.jpg');
    color: var(--deep);
    --glow-a: 0.4;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .hero {
      background-image: url('/assets/silk-still-light.jpg');
      color: var(--deep);
      --glow-a: 0.4;
    }
  }

  .inner {
    position: relative;
    /* its own stacking context, so the readability wash below sits behind
       the words but above the live sky */
    isolation: isolate;
    width: min(100% - 2 * var(--space-lg), 44rem);
    min-width: 0;
    /* a little above optical center, and clear of the look picker pinned to
       the hero's bottom edge */
    padding: var(--space-2xl) 0 calc(var(--space-2xl) + 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* A soft wash of the page's deepest ground behind the words. The live sky's
     filaments are bright enough to fight a line of text where they cross it;
     the wash calms the center and fades out long before the edges, so the
     sky still reads as alive around the lockup. --bg-deep follows the page
     theme and the site-wide theme picker, so it never shows as a dark box on
     a light page. The dither tile sits on top: a CSS gradient over the sky
     bands without it. */
  .inner::before {
    content: '';
    position: absolute;
    inset: 0 -40%;
    z-index: -1;
    pointer-events: none;
    background: url('/assets/dither.png') repeat, radial-gradient(
      ellipse closest-side at 50% 50%,
      color-mix(in oklab, var(--bg-deep) 70%, transparent) 0%,
      color-mix(in oklab, var(--bg-deep) 40%, transparent) 50%,
      transparent 100%
    );
  }

  .hero :global(.mark) {
    display: block;
    margin-bottom: var(--space-lg);
    /* the core, not the box center: see --mark-origin in the frontmatter */
    transform-origin: var(--mark-origin, 50% 50%);
  }

  /* Easter egg: the mark is a flywheel -- src/scripts/spin.ts turns it
     about its core and writes --spin-glow from its speed (0 at rest, 1 at a
     hard flick). The glow is the house glow, on the page's accent, and costs
     nothing at rest: a zero-radius drop shadow. */
  .hero :global(.mark) {
    filter: drop-shadow(0 0 calc(var(--spin-glow, 0) * 22px) rgba(var(--accent-primary-rgb), calc(var(--spin-glow, 0) * 0.85)));
    will-change: transform;
  }

  .wordmark {
    margin: 0 0 var(--space-md);
    line-height: 1;
  }
  .glow-wrap {
    position: relative;
    display: block;
  }
  .word {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.8rem, 8vw, 5.25rem);
    letter-spacing: 0.3em;
    /* swallow the trailing tracking, so the word centers on its letters */
    margin-right: -0.3em;
    line-height: 1;
    z-index: 1;
  }
  /* ARC's hero device: the word the page is named for emits. A blurred bloom
     twin behind the wordmark -- hot white core, accent halo, wide secondary
     falloff. Copied from arcui.dev's own headline. */
  .word-shadow {
    position: absolute;
    inset: 0;
    color: transparent;
    text-shadow:
      0 0 14px rgba(255, 255, 255, calc(0.2 * var(--glow-a))),
      0 0 32px rgba(var(--accent-primary-rgb), calc(0.38 * var(--glow-a))),
      0 0 70px rgba(var(--accent-primary-rgb), calc(0.26 * var(--glow-a))),
      0 0 130px rgba(var(--accent-secondary-rgb), calc(0.22 * var(--glow-a)));
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
    user-select: none;
    animation: breathe 5s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    from {
      opacity: 0.62;
    }
    to {
      opacity: 0.88;
    }
  }

  .tagline {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-xl);
    letter-spacing: -0.005em;
    margin: 0 0 var(--space-sm);
  }
  .sub {
    font-size: var(--text-lg);
    line-height: var(--body-lh);
    text-wrap: balance;
    opacity: 0.78;
    margin: 0 0 var(--space-xl);
  }


  /* The button's final box, reserved before hydration: ARC's lg button, so
     the declarative shadow DOM and the hydrated element are the same size
     and nothing under it can move. */
  .go {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
  .go arc-button {
    display: inline-block;
  }

  @media (prefers-reduced-motion: reduce) {
    .word-shadow {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .hero :global(.mark) {
      --mk-fit: 144px;
    }
    /* the look picker sits higher here (Sky.astro), clear of the theme button */
    .inner {
      padding-bottom: calc(var(--space-xl) + 8.5rem);
    }
  }
</style>
