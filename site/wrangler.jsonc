{
  // Assets-only Worker: no script, just the built one-pager served from
  // Cloudflare's edge. Cloudflare's git integration builds this directory on a
  // push to main (root dir `site`, build `npm run build`) and then deploys
  // this config; the assets directory is relative to this file, so it points
  // at Astro's output. Custom domain (pulsar.arclight.digital) is attached in
  // the Cloudflare dashboard under this Worker's Domains & Routes, not here.
  "name": "pulsar-site",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
