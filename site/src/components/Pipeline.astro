---
// The supply chain, as a trail, and then the command that checks it. A real
// shell session rather than another input-looking row: the command wrapped
// the way you would actually type it, plus gh's genuine output shape. The
// button copies the one-line form.
import { IMAGES, REPO } from '../data/site';

interface Props {
  /** the home page shows the trail and the check; /provenance also explains */
  compact?: boolean;
}

const { compact = false } = Astro.props;

const STAGES = [
  { name: 'commit', detail: 'a change lands in the public repo; that night’s build picks it up' },
  { name: 'build', detail: 'both images, on a build machine created for the night and destroyed after' },
  { name: 'sign', detail: 'the NVIDIA driver with the key Secure Boot is told to trust; the image with cosign' },
  { name: 'attest', detail: 'a build record (SLSA provenance) and a full package list (SPDX SBOM), attached to the image' },
  { name: 'boot', detail: 'your machine switches to the signed image, and rolls back on its own if the new one fails its boot checks' },
];

const shown = [
  'gh attestation verify \\',
  `  oci://${IMAGES.nvidia}:latest \\`,
  '  --owner arclight-digital',
].join('\n');
---

<div class="pipe">
  <arc-timeline heading-level="3" class="trail">
    {
      STAGES.map((stage) => (
        <arc-timeline-item heading={stage.name}>{stage.detail}</arc-timeline-item>
      ))
    }
  </arc-timeline>

  <div class="check">
    <p class="check-cap">don't take the page's word for&nbsp;it</p>
    <arc-code-block
      class="theme-fixed-dark"
      language="bash"
      filename="check where an image came from"
      code={shown}
    ></arc-code-block>
    {
      !compact && (
        <p class="hint">
          <span class="sent">One person's laptop OS, over-engineered on purpose, MIT-licensed.</span>{' '}
          Running someone else's signed images is a trust decision —{' '}
          <a href={`${REPO}#two-variants-one-key`}>fork it and use your own key</a> if that's not a
          relationship you want.
        </p>
      )
    }
  </div>
</div>

<style>
  .pipe {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .trail {
    display: block;
    font-family: var(--font-mono);
  }
  .check-cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .check arc-code-block {
    display: block;
  }
  .check .hint {
    margin-top: var(--space-md);
  }
  @media (max-width: 56rem) {
    .pipe {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
