#!/usr/bin/python3
"""pulsar-agents -- coding agents' sessions in one window.

A front end over `pulsar agent`, not an agent of its own. Each session is
the agent's own terminal UI, attached here as it would be in a terminal
(`pulsar agent attach`), so every agent, sign-in, sandbox and the undo
snapshots work as they do there. Closing the window leaves the sessions
running in their tmux server; opening it again picks them up.

What the CLI calls ending and forgetting, this calls stopping and
archiving: a stopped session continues when opened (on its conversation
where the agent can), and an archived one waits in Archived for 7 days
(`pulsar agent sessions --tidy`) before its snapshots go. Under the
terminal, a message box that sends to the agent, with comments from the
diff. Beside it, what changed (`pulsar agent diff`) and the snapshots
(`pulsar agent undo`).

`pulsar-agents [<session> | --new]` opens on that session, or on a new one;
a second launch raises the open window and turns to it. A notification's
Open lands here.
"""
import configparser
import json
import os
import pathlib
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Vte", "3.91")
gi.require_version("GtkSource", "5")
from gi.repository import Adw, Gdk, Gio, GLib, GObject, Gtk, GtkSource, Pango, Vte  # noqa: E402

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from pulsar_gui import (AGENT_NAMES, NAME_OK, PULSAR, home, message_with_comments, parse,  # noqa: E402,F401
                        project_groups, project_label, resume_note, run, run_argv, session_doing,
                        session_name_for, session_project, session_status, session_title, slug_name,
                        title_from_prompt, tokens, when, diff_line_ref, newly_unseen, forget_body, forget_left)

POLL_S = 3
# the sidebar's tile per agent: two letters, since three of them start with C or A
AGENT_TILES = {"claude": "Cl", "codex": "Cx", "agy": "Ag", "opencode": "Oc", "gemini": "Ge", "aider": "Ai"}
TIDY_DAYS = 7
SANDBOX_CHOICES = (("As set for this project", None), ("On", True), ("Off", False))
STATE_FILE = pathlib.Path(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")) \
    / "pulsar" / "agents-app.json"

