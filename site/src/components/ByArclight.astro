<style>
  /* the kit's own hover: a 1px lift with the Arclight accent glow, not
     Pulsar's; the label uses the site's mono standing in for the kit's Azeret
     subset, and the lockup is coloured by the theme via currentColor */
  .by-arclight {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.4s var(--ease-out),
      filter 0.4s var(--ease-out);
  }

  .by-arclight:hover,
  .by-arclight:focus-visible {
    transform: translateY(-1px);
    filter: drop-shadow(0 0 6px rgba(77, 126, 247, 0.25))
      drop-shadow(0 0 16px rgba(168, 85, 247, 0.1));
  }

  .by-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 0.15em;
  }

  .by-lockup {
    height: 22px;
    width: auto;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .by-arclight {
      transition: none;
    }
  }
</style>
