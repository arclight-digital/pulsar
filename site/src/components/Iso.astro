---
// Starting from bare metal. Reuses the install card's chrome -- same terminal
// family, same labelled rows -- but the filename is a link rather than a
// command to copy.
import CopyButton from './CopyButton.astro';
import DownloadRow from './DownloadRow.astro';
import Term from './Term.astro';
import { COSIGN_PUB, ISOS } from '../data/site';

const SUMS = ['sha256', 'sha256.sig', 'json'];

// The signature covers the checksum manifest, not the 5GB ISO -- verifying
// the manifest and then checking the ISO against it proves the same thing
// without cosign reading five gigabytes. --insecure-ignore-tlog is the
// documented flag for plain key-based verification: the trust anchor here is
// the published key, not a transparency-log entry, and the name is cosign's,
// not a warning about this page.
const VERIFY = [
  `cosign verify-blob ${ISOS.vanilla}.sha256`,
  `--key ${COSIGN_PUB}`,
  `--signature ${ISOS.vanilla}.sha256.sig`,
  '--insecure-ignore-tlog=true',
  `&& sha256sum -c ${ISOS.vanilla}.sha256`,
].join(' ');
---

<section class="iso" id="iso">
  <h2>Starting from bare metal</h2>

  <p class="lede">
    A weekly installer ISO for each variant, built from the published image itself &mdash; the same
    Anaconda installer stock Silverblue uses, landing directly in Pulsar.{' '}
    <span class="sent">Checksummed, and signed with Pulsar's release&nbsp;key.</span>
  </p>

  <Term ariaLabel="ISO downloads" class="install iso-card">
    <Fragment slot="caption">weekly &middot; x86_64 &middot; 5&ndash;6&nbsp;GB</Fragment>
    <DownloadRow which="standard" file={ISOS.vanilla} sums={SUMS} />
    <DownloadRow which="nvidia" file={ISOS.nvidia} sums={SUMS} />
    <p class="hint">
      Write it to a USB&nbsp;stick with GNOME&nbsp;Disks or <code>dd</code>, boot,&nbsp;install.{' '}
      The <code>.json</code> sidecar records exactly which image digest the installer carries.
      Verify the manifest's signature, then the ISO against the&nbsp;manifest:
    </p>
  </Term>

  <Term ariaLabel="Verify the ISO signature">
    <Fragment slot="caption">
      signed with the release key &mdash; it never leaves the signing&nbsp;host
      <CopyButton text={VERIFY} label="Copy the ISO verify command" />
    </Fragment>
    <pre><code><span class="cmd">cosign verify-blob {ISOS.vanilla}.sha256 \
  --key {COSIGN_PUB} \
  --signature {ISOS.vanilla}.sha256.sig \
  --insecure-ignore-tlog=true</span>
<span class="ok">Verified OK</span>
<span class="cmd">sha256sum -c {ISOS.vanilla}.sha256</span>
<span class="ok">{ISOS.vanilla}: OK</span></code></pre>
  </Term>
</section>

<style>
  .iso {
    margin-top: 5.5rem;
  }

  .lede {
    color: var(--muted);
    max-width: 40rem;
  }

  /* the download card is wider than the terminal default -- filenames plus
     three sidecar links need the room. :global because the element carries
     Term's scope, not this component's. */
  :global(.iso-card) {
    margin: 1.8rem 0 0;
    max-width: 46rem;
  }
</style>
