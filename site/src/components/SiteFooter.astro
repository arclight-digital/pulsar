---
// The close. Pinned dark in both themes, the way the terminals are: the page
// ends on ink, under a spectrum line that is the palette read left to right.
import ByArclight from './ByArclight.astro';
import Mark from './Mark.astro';
import { REPO, SUPPORT_URL } from '../data/site';

const SITE = [
  { label: 'Install', href: '/docs/install' },
  { label: 'Docs', href: '/docs' },
  { label: 'Themes', href: '/#themes' },
  { label: 'gamescale', href: '/docs/gamescale' },
  { label: 'Provenance', href: '/docs/provenance' },
  { label: 'Changelog', href: '/docs/changelog' },
  { label: 'The pulsar command', href: '/docs/cli' },
];

const MACHINE = [
  { label: 'Source', href: REPO },
  { label: 'The shader', href: `${REPO}/blob/main/assets/shaders/pulsar.frag` },
  { label: 'changelog.json', href: '/changelog.json' },
  { label: 'manifest.json', href: '/manifest.json' },
  { label: 'MIT License', href: `${REPO}/blob/main/LICENSE` },
];
---

<div class="foot theme-fixed-dark">
  <div class="spectrum" aria-hidden="true"></div>
  <arc-footer contained="lg" no-border>
    <div slot="logo" class="brand">
      {/* Static, and the small drawing: the brand package's placement for a
          44px footer mark. The pulse belongs to the top bar and the hero. */}
      <Mark kind="small" size={44} class="foot-mark" />
      <div>
        <p class="word">PULSAR</p>
        <p class="brandline">Stylish · atomic · agentic</p>
      </div>
    </div>

    <div>
      <p class="col-title">Site</p>
      <ul class="col">
        {SITE.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="col-title">Machine</p>
      <ul class="col">
        {MACHINE.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="col-title">Arclight</p>
      <ul class="col">
        <li><a href="https://arclight.build">arclight.build</a></li>
        <li><a href="https://arcui.dev">ARC UI</a></li>
        <li><a href="https://github.com/arclight-digital">GitHub</a></li>
      </ul>
    </div>

    <div slot="legal" class="legal">
      <div class="colophons">
      <p class="colophon made">
        Free to download and MIT licensed. Made by Arclight Digital&nbsp;LLC.
        {
          SUPPORT_URL ? (
            <a href={SUPPORT_URL}>Like it? Support Pulsar&nbsp;→</a>
          ) : (
            <span class="soon">Support Pulsar: coming&nbsp;soon.</span>
          )
        }
      </p>
      <p class="colophon">
        Set in Host&nbsp;Grotesk and JetBrains&nbsp;Mono, on ARC&nbsp;UI. One fragment shader
        renders the home page's sky live and the OS wallpapers in&nbsp;CI. No analytics,
        no&nbsp;cookies.
      </p>
      </div>
      <ByArclight />
    </div>
  </arc-footer>
</div>

<style>
  .foot {
    background: var(--bg-deep);
    color: var(--text-primary);
    /* room under the colophon for the fixed scroll-to-top button, which sits
       bottom-left and would otherwise cover its last line at the page's end */
    padding-bottom: var(--space-3xl);
  }
  .spectrum {
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--peri), var(--violet));
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .brand :global(.foot-mark) {
    display: block;
  }
  .word {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-lg);
    letter-spacing: 0.3em;
    line-height: var(--glyph-lh);
    margin: 0;
  }
  .brandline {
    margin: var(--space-xs) 0 0;
    color: var(--text-secondary);
    font-size: var(--label-size);
    letter-spacing: var(--label-spacing);
    text-transform: uppercase;
    font-family: var(--font-label);
    font-weight: var(--label-weight);
  }
  .col-title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    font-size: var(--label-size);
    letter-spacing: var(--label-spacing);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .col {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .col a {
    display: inline-block;
    padding-block: var(--space-xs);
    color: var(--text-primary);
    text-decoration: none;
  }
  .col a:hover {
    color: var(--accent-primary);
    text-shadow: var(--glow-xs);
  }
  .legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }
  .colophons {
    display: grid;
    gap: var(--space-xs);
  }
  .made {
    color: var(--text-secondary);
  }
  .made a,
  .soon {
    white-space: nowrap;
  }
  .soon {
    color: var(--text-muted);
  }
  .colophon {
    margin: 0;
    max-width: 44rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--body-lh);
  }
</style>
