#!/usr/bin/python3
"""pulsar-agent-gate -- git push for a sandboxed agent, without its credentials.

A sandboxed agent (`pulsar agent sandbox`) holds no SSH key, no token and no
credential helper. Its git rewrites each of the project's remotes to this
gate, through git's ext:: transport:

  sandbox:  git push origin  ->  pulsar-agent-gate connect <socket> ...
  host:     pulsar-agent-gate serve <socket> <mirror>
              -> git receive-pack <mirror>
                   -> pre-receive: pulsar-agent-gate hook
                        policy, then `git push <pinned remote>` as the user

The mirror is a bare repository on the host, one per project, that the
sandbox cannot see. It holds:

  remote.<name>.url     each remote's URL, PINNED when the mirror was made.
                        Never re-read from the project, whose .git/config the
                        agent could otherwise point at another repository and
                        have the gate push there with the user's credentials.
  pulsar.push           on | branches | off
  pulsar.defaultBranch  per remote: what `branches` protects

Policy, whatever the setting: branches only (no tags), no deletes, no
force-push; the upstream push never passes --force, so a remote that moved
rejects a non-fast-forward itself. `branches` also refuses the default
branch. Fetches go through the same gate, refreshed from the real remote
first, so the agent can pull without credentials too.

Stdlib only: this file also runs inside the sandbox image as the client.
"""
import json
import os
import re
import socket
import subprocess
import sys
import threading
import urllib.error
import urllib.request

ZERO = "0" * 40
SERVICES = {"upload-pack", "receive-pack"}


def git(*args, cwd=None, check=True, **kw):
    return subprocess.run(["git", *args], cwd=cwd, check=check, text=True, capture_output=True, **kw)


def pkt(line):
    data = (line + "\n").encode()
    return b"%04x" % (len(data) + 4) + data


def pinned(mirror):
    """{name: url} of the remotes the mirror was made with."""
    r = git("config", "--get-regexp", r"^remote\..*\.url$", cwd=mirror, check=False)
    out = {}
    for line in r.stdout.splitlines():
        key, _, url = line.partition(" ")
        out[key[len("remote."):-len(".url")]] = url
    return out


# ------------------------------------------------------------------ host ----

def setup(mirror, project, hook_cmd):
    """Make the mirror if it is not there, pinning the project's remotes as
    they are now. An existing mirror is left exactly as it is."""
    if os.path.isdir(os.path.join(mirror, "objects")):
        return 0
    remotes = git("config", "--get-regexp", r"^remote\..*\.url$", cwd=project, check=False).stdout.splitlines()
    if not remotes:
        print(f"pulsar-agent-gate: {project} has no remotes; nothing to push to", file=sys.stderr)
    os.makedirs(os.path.dirname(mirror), mode=0o700, exist_ok=True)
    git("init", "--quiet", "--bare", mirror)
    git("config", "pulsar.project", project, cwd=mirror)
    git("config", "pulsar.push", "on", cwd=mirror)
    for line in remotes:
        key, _, url = line.partition(" ")
        name = key[len("remote."):-len(".url")]
        # a URL and nothing else: no fetch refspec, so a push from inside the
        # hook never tries to move a remote-tracking ref in quarantine
        git("config", f"remote.{name}.url", url, cwd=mirror)
        head = git("ls-remote", "--symref", url, "HEAD", check=False, timeout=60).stdout
        for h in head.splitlines():
            if h.startswith("ref: refs/heads/"):
                git("config", f"pulsar.defaultBranch.{name}", h.split()[1][len("refs/heads/"):], cwd=mirror)
    hook = os.path.join(mirror, "hooks", "pre-receive")
    with open(hook, "w") as f:
        f.write(f"#!/bin/sh\nexec {hook_cmd} hook\n")
    os.chmod(hook, 0o755)
    return 0


def refresh(mirror, remote):
    """Bring the mirror's branches up to the real remote's, as the user."""
    return git("fetch", "--quiet", "--prune", remote, "+refs/heads/*:refs/heads/*",
               cwd=mirror, check=False, timeout=300)


# ------------------------------------------------------ pull requests ----
#
# `gh pr create` inside the sandbox is this client, and this is the one thing
# it can do on the forge: open a pull request, as the user, with a token the
# host's own `git credential` gives for the pinned remote's host. The token
# never enters the sandbox. No merge, close, comment or edit. GitHub only,
# for now; the head branch must already be on the remote (pushed through the
# gate), and `push off` means no pull requests either.

GITHUB_API = os.environ.get("PULSAR_GATE_GITHUB_API", "https://api.github.com")
GH_URL = re.compile(r"^(?:https://(?:[^@/]+@)?github\.com/|git@github\.com:|ssh://git@github\.com/)"
                    r"([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?$")


def credential(host):
    """The user's password/token for https://<host>, from their own git
    credential setup, never prompting."""
    r = subprocess.run(["git", "credential", "fill"], input=f"protocol=https\nhost={host}\n\n",
                       text=True, capture_output=True, timeout=60,
                       env=dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never"))
    for line in r.stdout.splitlines():
        if line.startswith("password="):
            return line[len("password="):]
    return None


def pr_create(mirror, remote, req):
    url = pinned(mirror).get(remote, "")
    m = GH_URL.match(url)
    if not m:
        return {"error": f"{remote} is {url}: pull requests through the gate work for GitHub remotes only, for now"}
    owner, repo = m.group(1), m.group(2)
    policy = git("config", "--default", "on", "pulsar.push", cwd=mirror, check=False).stdout.strip()
    if policy == "off":
        return {"error": "pushing is off for this project, and so are pull requests (on the host: pulsar agent sandbox push on)"}
    title, body = str(req.get("title") or "").strip(), str(req.get("body") or "")
    head = str(req.get("head") or "")
    base = str(req.get("base") or "") or git("config", f"pulsar.defaultBranch.{remote}", cwd=mirror, check=False).stdout.strip()
    if not title or len(title) > 256:
        return {"error": "a pull request needs a title, 256 characters at most"}
    if len(body) > 65536:
        return {"error": "the body is over 64 KiB"}
    for name, b in (("head", head), ("base", base)):
        if not b or git("check-ref-format", "--branch", b, check=False).returncode != 0:
            return {"error": f"{name} '{b}' is not a branch name"}
    if refresh(mirror, remote).returncode != 0:
        return {"error": f"could not reach {url}"}
    for name, b in (("head", head), ("base", base)):
        if git("rev-parse", "--verify", "--quiet", f"refs/heads/{b}", cwd=mirror, check=False).returncode != 0:
            return {"error": f"{name} branch '{b}' is not on {remote}" + (": push it first" if name == "head" else "")}
    token = credential("github.com")
    if not token:
        return {"error": "the host has no GitHub credential git can use (git credential fill for github.com gave none)"}
    data = json.dumps({"title": title, "body": body, "head": head, "base": base,
                       "draft": bool(req.get("draft"))}).encode()
    rq = urllib.request.Request(f"{GITHUB_API}/repos/{owner}/{repo}/pulls", data=data, method="POST", headers={
        "Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "pulsar-agent-gate", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(rq, timeout=60) as r:
            out = json.load(r)
        return {"url": out.get("html_url", ""), "number": out.get("number")}
    except urllib.error.HTTPError as e:
        try:
            err = json.load(e)
            msg = err.get("message", "")
            detail = "; ".join(x.get("message", "") for x in err.get("errors", []) if isinstance(x, dict))
        except (ValueError, AttributeError):
            msg, detail = str(e), ""
        return {"error": f"GitHub said {e.code}: {msg}" + (f" ({detail})" if detail else "")}
    except OSError as e:
        return {"error": f"could not reach GitHub: {e}"}


def handle_pr(conn, mirror, remote):
    buf = b""
    while not buf.endswith(b"\n") and len(buf) < 70000:
        b = conn.recv(65536)
        if not b:
            break
        buf += b
    try:
        req = json.loads(buf.decode())
    except ValueError:
        req = None
    res = pr_create(mirror, remote, req) if isinstance(req, dict) else {"error": "a malformed request"}
    conn.sendall((json.dumps(res) + "\n").encode())


def handle(conn, mirror):
    header = b""
    while not header.endswith(b"\n"):
        b = conn.recv(1)
        if not b or len(header) > 512:
            return
        header += b
    parts = header.decode(errors="replace").split()
    service, remote = (parts + ["", ""])[:2]
    # ext::'s %s is "upload-pack"; accept the git- form too
    service = service.removeprefix("git-")
    if service == "pr-create":
        if remote not in pinned(mirror):
            conn.sendall((json.dumps({"error": f"no pinned remote '{remote}' for this project"}) + "\n").encode())
            return
        handle_pr(conn, mirror, remote)
        return
    proto = parts[2] if len(parts) > 2 else ""
    remotes = pinned(mirror)
    if service not in SERVICES:
        conn.sendall(pkt(f"ERR pulsar gate: '{service}' is not a git service the gate serves"))
        return
    if remote not in remotes:
        conn.sendall(pkt(f"ERR pulsar gate: no pinned remote '{remote}' for this project"))
        return
    r = refresh(mirror, remote)
    if r.returncode != 0:
        msg = (r.stderr.strip().splitlines() or ["fetch failed"])[-1]
        conn.sendall(pkt(f"ERR pulsar gate: could not reach {remotes[remote]}: {msg}"))
        return
    env = dict(os.environ, PULSAR_GATE_REMOTE=remote)
    if proto:
        env["GIT_PROTOCOL"] = proto
    fd = conn.fileno()
    os.dup2(fd, 0)
    os.dup2(fd, 1)
    os.execvpe("git", ["git", service, mirror], env)


def serve(sock_path, mirror):
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old = os.umask(0o077)
    srv.bind(sock_path)
    os.umask(old)
    srv.listen(8)
    while True:
        conn, _ = srv.accept()
        if os.fork() == 0:
            srv.close()
            try:
                handle(conn, mirror)
            finally:
                os._exit(0)
        conn.close()
        try:
            while os.waitpid(-1, os.WNOHANG)[0]:
                pass
        except ChildProcessError:
            pass


def hook():
    """pre-receive in the mirror: runs on the host, as the user."""
    remote = os.environ.get("PULSAR_GATE_REMOTE", "")
    policy = git("config", "--default", "on", "pulsar.push", check=False).stdout.strip()
    default = git("config", f"pulsar.defaultBranch.{remote}", check=False).stdout.strip()
    refspecs, errors = [], []
    for line in sys.stdin:
        old, new, ref = line.split()
        if policy == "off":
            errors.append(f"{ref}: pushing is off for this project (on the host: pulsar agent sandbox push on)")
        elif not ref.startswith("refs/heads/"):
            errors.append(f"{ref}: only branches can be pushed from the sandbox, not tags")
        elif new == ZERO:
            errors.append(f"{ref}: deleting a branch is not allowed from the sandbox")
        elif old != ZERO and git("merge-base", "--is-ancestor", old, new, check=False).returncode != 0:
            errors.append(f"{ref}: force-push is not allowed from the sandbox")
        elif policy == "branches" and default and ref == f"refs/heads/{default}":
            errors.append(f"{ref}: this project only allows pushing to other branches (push = branches)")
        else:
            refspecs.append(f"{new}:{ref}")
    if errors:
        for e in errors:
            print(f"pulsar gate: {e}", file=sys.stderr)
        return 1
    if not refspecs:
        return 0
    # As the user, with their credentials; never --force. The new objects are
    # still in quarantine, which the object-directory variables let this push
    # read. GIT_QUARANTINE_PATH itself only forbids ref updates, and a remote
    # on a local path would inherit it and refuse the push, so it goes.
    env = {k: v for k, v in os.environ.items() if k != "GIT_QUARANTINE_PATH"}
    r = subprocess.run(["git", "push", "--atomic", "--no-verify", remote, *refspecs],
                       text=True, capture_output=True, env=env)
    for line in (r.stdout + r.stderr).splitlines():
        print(f"pulsar gate: {line}", file=sys.stderr)
    # What went through, for the host to record as upstream tracking when the
    # session ends: inside, .git/config is read-only and `push -u` cannot.
    log = os.environ.get("PULSAR_GATE_PUSHED")
    if r.returncode == 0 and log:
        with open(log, "a") as f:
            for spec in refspecs:
                f.write(f"{remote}\t{spec.split(':', 1)[1]}\n")
    return r.returncode


# --------------------------------------------------------------- sandbox ----

def connect(sock_path, service, remote):
    """git's ext:: transport: our stdio is the git protocol stream."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(sock_path)
    s.sendall(f"{service} {remote} {os.environ.get('GIT_PROTOCOL', '')}\n".encode())

    def up():
        while (b := os.read(0, 65536)):
            s.sendall(b)
        s.shutdown(socket.SHUT_WR)
    t = threading.Thread(target=up, daemon=True)
    t.start()
    while (b := s.recv(65536)):
        os.write(1, b)
    return 0


def gh(sock_path, args):
    """The sandbox's `gh`: `gh pr create` and nothing else."""
    if args[:2] != ["pr", "create"]:
        print("gh: only `gh pr create` works in Pulsar's sandbox, through its gate. "
              "Ask the user for anything else on GitHub.", file=sys.stderr)
        return 1
    req, i, rest = {"draft": False}, 0, args[2:]
    fill = False
    while i < len(rest):
        a = rest[i]
        val = rest[i + 1] if i + 1 < len(rest) else None
        if a in ("-t", "--title"):
            req["title"], i = val, i + 2
        elif a in ("-b", "--body"):
            req["body"], i = val, i + 2
        elif a in ("-F", "--body-file"):
            req["body"] = sys.stdin.read() if val == "-" else open(val, encoding="utf-8").read()
            i += 2
        elif a in ("-B", "--base"):
            req["base"], i = val, i + 2
        elif a in ("-H", "--head"):
            req["head"], i = val, i + 2
        elif a in ("-d", "--draft"):
            req["draft"], i = True, i + 1
        elif a in ("-f", "--fill"):
            fill, i = True, i + 1
        elif "=" in a and a.split("=", 1)[0] in ("--title", "--body", "--base", "--head", "--body-file"):
            k, v = a.split("=", 1)
            rest[i:i + 1] = [k, v]
        else:
            print(f"gh: '{a}' is not supported in the sandbox (use --title, --body, --body-file, --base, "
                  "--head, --draft, --fill)", file=sys.stderr)
            return 1
    head = req.get("head") or git("rev-parse", "--abbrev-ref", "HEAD", check=False).stdout.strip()
    req["head"] = head
    if fill and not req.get("title"):
        req["title"] = git("log", "-1", "--format=%s", check=False).stdout.strip()
        req.setdefault("body", git("log", "-1", "--format=%b", check=False).stdout.strip())
    if not req.get("title"):
        print("gh: a title is needed (--title, or --fill for the last commit's)", file=sys.stderr)
        return 1
    remote = git("config", f"branch.{head}.remote", check=False).stdout.strip() or "origin"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(sock_path)
    s.sendall(f"pr-create {remote}\n".encode() + (json.dumps(req) + "\n").encode())
    buf = b""
    while (b := s.recv(65536)):
        buf += b
    try:
        res = json.loads(buf.decode())
    except ValueError:
        print("gh: no answer from the gate", file=sys.stderr)
        return 1
    if res.get("error"):
        print(f"gh: {res['error']}", file=sys.stderr)
        return 1
    print(res.get("url", ""))
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "serve" and len(argv) == 4:
        return serve(argv[2], argv[3])
    if cmd == "connect" and len(argv) == 5:
        return connect(argv[2], argv[3], argv[4])
    if cmd == "hook":
        return hook()
    if cmd == "gh" and len(argv) >= 3:
        return gh(argv[2], argv[3:])
    if cmd == "setup" and len(argv) == 5:
        return setup(argv[2], argv[3], argv[4])
    print("usage: pulsar-agent-gate serve <socket> <mirror> | connect <socket> <service> <remote>"
          " | setup <mirror> <project> <hook-cmd> | hook", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
