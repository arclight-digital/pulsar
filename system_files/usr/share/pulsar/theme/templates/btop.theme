theme[meter_bg]="{{selection}}"
theme[proc_misc]="{{accent}}"
theme[cpu_box]="{{blue}}"
theme[mem_box]="{{green}}"
theme[net_box]="{{magenta}}"
theme[proc_box]="{{cyan}}"
theme[div_line]="{{selection}}"
theme[temp_start]="{{green}}"
theme[temp_mid]="{{yellow}}"
theme[temp_end]="{{red}}"
