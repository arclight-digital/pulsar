---
// The page's primary action, in one place. It appeared four times in the old
// single-file page, each with the same two inline SVGs pasted again.
//
// `text` is what lands on the clipboard, which is not always what is on
// screen: the verify sessions display a wrapped, backslash-continued command
// and copy the one-line form.
interface Props {
  text: string;
  /** what the button announces -- "Copy the ..." reads as a command */
  label: string;
}

const { text, label } = Astro.props;
---

<button class="copy" data-copy data-copy-text={text} aria-label={label}>
  <svg
    class="clip"
    viewBox="0 0 16 16"
    width="15"
    height="15"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
    <path d="M10.5 5.5v-2a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3.5V9A1.5 1.5 0 0 0 4 10.5h1.5"
    ></path>
  </svg>
  <svg
    class="check"
    viewBox="0 0 16 16"
    width="15"
    height="15"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <path d="M2.5 8.5l3.5 3.5 7-8"></path>
  </svg>
</button>
