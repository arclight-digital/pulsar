def run(args, ok_codes=(0,), env=None):
    """(text, is_error). The CLI's exit codes that carry an answer (doctor's
    1, update --check's 10) are answers, not errors."""
    try:
        r = subprocess.run([CLI, *args], capture_output=True, text=True, timeout=300,
                           env=dict(os.environ, NO_COLOR="1", **(env or {})))
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"could not run pulsar: {e}", True
    out = r.stdout.strip() or r.stderr.strip()
    return out, r.returncode not in ok_codes


def session_name(v):
    """A session or job name as the CLI takes it, or None: never an option."""
    v = str(v or "")
    return v if v and not v.startswith("-") and all(c.isalnum() or c in "-_" for c in v) else None


def _proc(pid, name):
    with open(f"/proc/{pid}/{name}", "rb") as f:
        return f.read()


def _record_from(pid, steps=8):
    """PULSAR_SESSION_RECORD from pid's environment or its nearest parent's
    that has one, as the CLI reads it (<session>.session), or None. Not past
    the container: conmon carries the environment of whoever ran toolbox
    run, which names that shell's session, not the agent's."""
    for _ in range(steps):
        if pid <= 1:
            return None
        try:
            if _proc(pid, "comm").startswith(b"conmon"):
                return None
            env = _proc(pid, "environ").split(b"\0")
            status = _proc(pid, "status").decode(errors="replace")
        except OSError:
            return None
        for e in env:
            if e.startswith(b"PULSAR_SESSION_RECORD="):
                v = e.split(b"=", 1)[1].decode(errors="replace")
                base = os.path.basename(v)
                if base.endswith(".session") and session_name(base[:-len(".session")]):
                    return v
        m = re.search(r"^PPid:\s*(\d+)", status, re.M)
        pid = int(m.group(1)) if m else 0
    return None


def caller_record():
    """The session record of an agent in the agents toolbox, which starts this
    server on the host through flatpak-spawn: that passes on neither the
    agent's environment nor a parent to walk up from (the server's parent is
    flatpak-session-helper). flatpak-spawn itself still holds the fd it gave
    the server as stdin, and above it in the box is the agent, whose
    environment names the session even when flatpak-spawn's doesn't (Codex
    starts its servers with a scrubbed one). Only then: anywhere else the
    process holding stdin is just the parent, which the CLI walks already."""
    try:
        if not _proc(os.getppid(), "comm").startswith(b"flatpak-session"):
            return None
        mine = os.readlink("/proc/self/fd/0")
    except OSError:
        return None
    # the same open file, whatever kind (a pipe, or the socketpair Node uses)
    if not mine.startswith(("pipe:", "socket:")):
        return None
    me = os.getpid()
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) == me:
            continue
        try:
            fds = os.listdir(f"/proc/{p}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                if os.readlink(f"/proc/{p}/fd/{fd}") != mine:
                    continue
            except OSError:
                continue
            rec = _record_from(int(p))
            if rec:
                return rec
            break
    return None


_me = None


def whoami():
    """The agent session this server's agent runs in, or None."""
    global _me
    if _me:
        return _me
    text, err = run(["agent", "whoami"])
    if err or not session_name(text.strip()):
        rec = caller_record()
        if not rec:
            return None
        text, err = run(["agent", "whoami"], env={"PULSAR_SESSION_RECORD": rec})
    if not err and session_name(text.strip()):
        _me = text.strip()
    return _me


# for the tools that act as the calling session, when whoami() can't tell
def no_session(what):
    return (f"{what}: this server couldn't tell which agent session it serves. Agents started "
            "with pulsar agent run --tmux, or from the Agents app, are in one; if this agent "
            "was, its session's name didn't reach the server, which is a Pulsar bug"), True


def call(name, a):
    if name == "doctor":
        return run(["--json", "doctor", *([a["check"]] if a.get("check") else [])], (0, 1))
    if name == "status":
        return run(["--json", "status"])
    if name == "manifest":
        return run(["--json", "manifest"])
    if name == "report":
        args = ["report"]
        if a.get("crash"):
            args += ["--crash", str(a["crash"])]
        if a.get("lines"):
            args += ["--lines", str(int(a["lines"]))]
        return run(args)
    if name == "crashes":
        return run(["--json", "doctor", "crashes"], (0, 1))
    if name == "update_check":
        return run(["--json", "update", "--check"], (0, 10))
    if name == "agent_status":
        parts = {}
        for key, args in (("agent", ["--json", "agent"]), ("guard", ["--json", "agent", "guard"]),
                          ("pin", ["--json", "pin"])):
            text, err = run(args)
            try:
                parts[key] = json.loads(text) if not err else {"error": text}
            except ValueError:
                parts[key] = {"error": text}
        return json.dumps(parts), False
    if name == "sessions":
        text, err = run(["--json", "agent", "sessions"])
        if err:
            return text, True
        try:
            rows = json.loads(text)
        except ValueError:
            return text, True
        me = whoami()
        keep = ("name", "agent", "title", "state", "waiting_for", "dir", "project", "worktree_of", "sandbox", "archived")
        return json.dumps({"you": me, "sessions": [{k: r.get(k) for k in keep} for r in rows if not r.get("archived")]}), False
    if name == "session_read":
        n = session_name(a.get("name"))
        if not n:
            return "session_read needs a session's name (see sessions)", True
        return run(["--json", "agent", "read", n, "--lines", str(int(a.get("lines") or 80))])
    if name == "session_message":
        raw = str(a.get("name") or "")
        # <session>@<machine>: a session on another of the user's machines
        n = raw if re.fullmatch(r"[A-Za-z0-9_-]+@[a-z0-9][a-z0-9-]*", raw) else session_name(raw)
        text = str(a.get("text") or "")
        if not n or not text.strip():
            return "session_message needs a session's name and some text", True
        me = whoami()
        if not me:
            # every message says which session sent it; one that can't is refused
            return no_session("not sent, since every message names the session it's from")
        re_ = str(a.get("reply_to") or "")
        if re_ and not re.fullmatch(r"m[0-9]+-[0-9a-f]+", re_):
            return "reply_to is a message id from inbox", True
        return run(["agent", "send", n, "--from", me, *(["--reply-to", re_] if re_ else []), "--", text])
    if name == "inbox":
        me = whoami()
        if not me:
            return no_session("no inbox to read")
        return run(["--json", "agent", "inbox", me, *(["--unread"] if a.get("unread") else [])])
    if name == "job_start":
        cmd = a.get("command")
        if not isinstance(cmd, list) or not cmd or not all(isinstance(c, str) for c in cmd):
            return "job_start needs command: a list of strings", True
        args = ["job", "run"]
        if a.get("name"):
            args += ["--name", str(a["name"])]
        if a.get("dir"):
            args += ["--dir", str(a["dir"])]
        me = whoami()
        if a.get("notify_me", True) and me:
            args += ["--notify", me]
        return run([*args, "--", *cmd])
    if name == "machines":
        return run(["--json", "machine", "check"])
    if name in ("machine_job", "machine_run", "machine_fetch"):
        m = str(a.get("machine") or "")
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", m):
            return f"{name} needs a machine's name (see machines)", True
        d = str(a.get("dir") or "")
        if d.startswith("-"):
            return "dir is a folder", True
        opt_dir = ["--dir", d] if d else []
        nm = a.get("name")
        if nm is not None and not session_name(nm):
            return "name is letters, digits, - and _", True
        opt_name = ["--name", nm] if nm else []
        if name == "machine_job":
            cmd = a.get("command")
            if not isinstance(cmd, list) or not cmd or not all(isinstance(c, str) for c in cmd):
                return "machine_job needs command: a list of strings", True
            me = whoami()
            notify = ["--notify", me] if a.get("notify_me", True) and me else []
            return run(["machine", "job", m, *opt_name, *opt_dir, *notify, "--", *cmd])
        if name == "machine_run":
            agent, prompt = str(a.get("agent") or ""), str(a.get("prompt") or "")
            if not re.fullmatch(r"[a-z][a-z0-9-]*", agent) or not prompt.strip():
                return "machine_run needs an agent's name and a prompt", True
            sb = [] if a.get("sandbox") is None else (["--sandbox"] if a.get("sandbox") else ["--no-sandbox"])
            return run(["machine", "run", m, agent, *opt_name, *opt_dir, *sb, "--prompt", prompt])
        sess = session_name(a.get("session"))
        if not sess:
            return "machine_fetch needs a session's name (see sessions)", True
        return run(["machine", "fetch", m, sess, *opt_dir])
    if name == "jobs":
        return run(["--json", "job", "list"])
    if name == "job_log":
        n = session_name(a.get("name"))
        if not n:
            return "job_log needs a job's name (see jobs)", True
        return run(["job", "log", n, "--lines", str(int(a.get("lines") or 50))])
    if name == "job_stop":
        n = session_name(a.get("name"))
        if not n:
            return "job_stop needs a job's name (see jobs)", True
        return run(["job", "stop", n])
    if name == "theme_list":
        return run(["theme", "list"])
    if name == "theme_current":
        return run(["theme", "current"])
    if name == "theme_set":
        theme = str(a.get("theme", ""))
        if not theme or theme.startswith("-"):
            return "theme_set needs a theme slug (see theme_list)", True
        args = ["theme", "set", theme, "--no-restart"]
        if a.get("variant") in ("dark", "light"):
            args += ["--variant", a["variant"]]
        return run(args)
    return f"unknown tool: {name}", True


def tool_list():
    out = []
    for t in TOOLS:
        d = {k: t[k] for k in ("name", "description", "inputSchema")}
        d["annotations"] = {"readOnlyHint": t["readOnly"], "destructiveHint": False,
                            "idempotentHint": t["readOnly"], "openWorldHint": False}
        out.append(d)
    return out


def handle(msg):
    method, mid, params = msg.get("method"), msg.get("id"), msg.get("params") or {}
    if not isinstance(params, dict):
        raise LookupError("params must be an object")
    if mid is None:
        return None     # a notification (initialized, cancelled): nothing to say
    if method == "initialize":
        want = params.get("protocolVersion")
        return {"protocolVersion": want if want in PROTOCOLS else PROTOCOLS[0],
                "capabilities": {"tools": {}, "resources": {}},
                "serverInfo": {"name": "pulsar", "version": VERSION},
                "instructions": "Facts about this Pulsar machine (image-based Fedora Silverblue). Read the guide "
                                "resource first. Nothing here needs or grants root."}
    if method == "ping":
        return {}
    if method == "tools/list":
        return {"tools": tool_list()}
    if method == "tools/call":
        name, args = params.get("name", ""), params.get("arguments") or {}
        if not isinstance(name, str) or not isinstance(args, dict):
            raise LookupError("tools/call takes a name and an arguments object")
        text, err = call(name, args)
        return {"content": [{"type": "text", "text": text}], "isError": err}
    if method == "resources/list":
        return {"resources": [{"uri": "pulsar://guide", "name": "AGENTS.md",
                               "description": "How this machine works, and what to ask the user before touching",
                               "mimeType": "text/markdown"}]}
    if method == "resources/read":
        if params.get("uri") != "pulsar://guide":
            raise LookupError(f"no resource {params.get('uri')}")
        try:
            text = open(GUIDE, encoding="utf-8").read()
        except OSError as e:
            raise LookupError(f"no guide in this image: {e}")
        return {"contents": [{"uri": "pulsar://guide", "mimeType": "text/markdown", "text": text}]}
    raise NotImplementedError(method)


def main():
    if sys.stdin.isatty():
        # a person ran it: say what it is waiting for (stderr, never the protocol stream)
        sys.stderr.write("pulsar mcp: an MCP server, waiting for JSON-RPC on stdin. An agent starts it, "
                         "not you: `pulsar agent add` registers it. Ctrl-D or Ctrl-C to quit.\n")
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            reply = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}
        else:
            if not isinstance(msg, dict):
                # a batch or a bare value: answered, never a crash that takes
                # every tool away for the rest of the session
                sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": None,
                                             "error": {"code": -32600, "message": "invalid request: one JSON object per line"}}) + "\n")
                sys.stdout.flush()
                continue
            try:
                result = handle(msg)
                if result is None:
                    continue
                reply = {"jsonrpc": "2.0", "id": msg.get("id"), "result": result}
            except NotImplementedError as e:
                reply = {"jsonrpc": "2.0", "id": msg.get("id"), "error": {"code": -32601, "message": f"method not found: {e}"}}
            except LookupError as e:
                reply = {"jsonrpc": "2.0", "id": msg.get("id"), "error": {"code": -32602, "message": str(e)}}
            except Exception as e:  # a bad argument must not end the server
                reply = {"jsonrpc": "2.0", "id": msg.get("id"), "error": {"code": -32603, "message": f"internal error: {e}"}}
        sys.stdout.write(json.dumps(reply) + "\n")
        sys.stdout.flush()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
