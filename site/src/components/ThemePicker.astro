---
// The site-wide picker: a small floating trigger on every page, opening a
// sheet with two independent choices.
//
//   Theme      recolors the whole site through ARC's tokens (never its
//              parts), remembered across pages; dark-first, as the image
//              lists them. Single-mode themes say so and set the page's mode.
//   Wallpaper  the home page's sky: Pulsar's live shader in any of its four
//              looks, or any theme's own rendered wallpaper. Picking a theme
//              suggests its wallpaper until the visitor picks one; after
//              that, themes leave it alone (scripts/wallpaper.ts).
//
// arc-sheet is modal: the page behind is inert (so focus stays in the
// sheet), Escape closes it, and focus returns to the trigger. Its scrim is
// kept light through its own custom properties so the recolor behind it is
// visible while choosing. Every swatch carries the theme's name as text.
import { THEMES, label, tileAttrs, variant } from '../data/themes';

const LOOKS = ['Silk', 'Leak', 'Satin', 'Holo'];
const WALLS = THEMES.filter((t) => !['pulsar', 'pulsar-holo'].includes(t.slug) && variant(t, 'dark').wall);
const modeNote = (t: (typeof THEMES)[number]) =>
  t.variants.dark && t.variants.light ? '' : t.variants.dark ? 'dark only' : 'light only';
---

<button type="button" class="fab" data-picker-open aria-haspopup="dialog" aria-label="Choose a theme">
  <span class="fab-sw" aria-hidden="true"></span>
  <span class="fab-tx">Theme</span>
</button>

<arc-sheet side="right" heading="Make it yours" class="picker-sheet" data-picker>
  <section class="grp" aria-labelledby="pk-theme">
    <h2 class="grp-h" id="pk-theme">Theme</h2>
    <p class="grp-note">Recolors this whole site, the way <code>pulsar theme set</code> recolors your desktop.</p>
    <ul class="themes" role="list">
      {
        THEMES.map((t) => {
          const v = variant(t, t.prefer === 'light' ? 'light' : 'dark');
          return (
            <li>
              <button type="button" class="th" aria-pressed="false" {...tileAttrs(t)}>
                <span class="th-sw" aria-hidden="true">
                  {[v.bg, v.accent, ...v.swatch.slice(3, 6)].map((c) => (
                    <span style={`background:${c}`} />
                  ))}
                </span>
                <span class="th-name">{label(t)}</span>
                {modeNote(t) && <span class="th-mode">{modeNote(t)}</span>}
              </button>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="grp" aria-labelledby="pk-wall">
    <h2 class="grp-h" id="pk-wall">Wallpaper</h2>
    <p class="grp-note">The home page’s sky, chosen apart from the theme. Pick one and themes stop suggesting theirs.</p>
    <p class="sub">Pulsar, live</p>
    <div class="looks" role="group" aria-label="Pulsar, live">
      {
        LOOKS.map((name, index) => (
          <button type="button" class="lk" data-look={index} data-wall="pulsar" aria-pressed={index === 0 ? 'true' : 'false'}>
            {name}
          </button>
        ))
      }
    </div>
    <p class="sub">A theme’s wallpaper</p>
    <ul class="walls" role="list">
      {
        WALLS.map((t) => (
          <li>
            <button
              type="button"
              class="wl"
              data-wall={t.slug}
              data-dark={t.variants.dark?.wall}
              data-light={t.variants.light?.wall}
              aria-pressed="false"
            >
              <img src={variant(t, 'dark').wall} alt="" width="160" height="100" loading="lazy" decoding="async" />
              <span>{label(t)}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <div slot="footer" class="foot">
    <button type="button" class="reset" data-picker-reset>Reset Theming to Default</button>
  </div>
</arc-sheet>

<arc-toast position="bottom-left" data-theme-toast></arc-toast>

<style>
  .fab {
    position: fixed;
    right: var(--space-lg);
    bottom: var(--space-lg);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-md) var(--space-xs) var(--space-xs);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    /* solid: a translucent chip over arbitrary page content cannot promise
       its label's contrast */
    background: var(--bg-elevated);
    backdrop-filter: blur(12px);
    color: var(--text-primary);
    font: inherit;
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    font-size: var(--label-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: var(--glow-xs);
    transition: box-shadow 0.2s var(--ease-out);
  }
  .fab:hover {
    box-shadow: var(--glow-hover);
  }
  .fab:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .fab-sw {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
    background: conic-gradient(var(--accent-primary) 0 50%, var(--bg-deep) 50% 100%);
    border: 1px solid var(--border-bright);
  }

  .picker-sheet {
    --sheet-width: min(420px, 92vw);
    /* light scrim: the recolor behind the sheet should stay visible */
    --sheet-backdrop: rgba(0, 0, 0, 0.18);
    --sheet-backdrop-filter: none;
  }
  .grp + .grp {
    margin-top: var(--space-xl);
  }
  .grp-h {
    font-size: var(--text-md);
    margin: 0 0 var(--space-xs);
  }
  .grp-note {
    margin: 0 0 var(--space-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .sub {
    margin: var(--space-md) 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--label-size);
    color: var(--text-muted);
  }

  .themes,
  .walls {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .themes {
    display: grid;
    gap: var(--space-xs);
  }
  .th {
    appearance: none;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: none;
    color: var(--text-primary);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .th:hover {
    background: var(--bg-card);
  }
  .th[aria-pressed='true'] {
    border-color: var(--accent-primary);
    background: var(--bg-card);
  }
  .th:focus-visible,
  .lk:focus-visible,
  .wl:focus-visible,
  .reset:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .th-sw {
    display: inline-flex;
    width: 4.5rem;
    height: 1.25rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-default);
  }
  .th-sw span {
    flex: 1;
  }
  .th-mode {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    color: var(--text-muted);
  }

  .looks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .lk {
    appearance: none;
    min-height: 2.5rem;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    background: none;
    color: var(--text-primary);
    font: inherit;
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    font-size: var(--label-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .lk[aria-pressed='true'][data-live-on] {
    border-color: var(--accent-primary);
    background: var(--bg-card);
  }
  .walls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
  }
  .wl {
    appearance: none;
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-secondary);
    font: inherit;
    font-size: var(--text-xs);
    text-align: left;
    cursor: pointer;
  }
  .wl img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
  }
  .wl[aria-pressed='true'] img {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .wl[aria-pressed='true'] span {
    color: var(--text-primary);
  }
  .foot {
    display: flex;
    justify-content: flex-end;
  }
  .reset {
    appearance: none;
    min-height: 2.5rem;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    background: none;
    color: var(--text-primary);
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 40rem) {
    .fab {
      right: var(--space-md);
      bottom: var(--space-md);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fab {
      transition: none;
    }
  }
</style>
