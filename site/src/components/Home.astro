---
// The home page. The order is the order a visitor's questions arrive in:
// what is it (the intro, with the desktop itself), how do I get it (install,
// where "Get started" lands), will it break (it can't rot), what does it do
// for me (the agent, the themes, the games), and can I check any of this (last
// night's changelog, the paper trail). Copy is earnest and short: say what
// it does for a person, then how, and never argue with anyone else's OS.
import Agents from './Agents.astro';
import Gamescale from './Gamescale.astro';
import GetPulsar from './GetPulsar.astro';
import Hero from './Hero.astro';
import Inside from './Inside.astro';
import Ledger from './Ledger.astro';
import Pipeline from './Pipeline.astro';
import ThemeShowcase from './ThemeShowcase.astro';
import Version from './Version.astro';
import Base from '../layouts/Base.astro';
import { changelog, version } from '../data/build';
import { arithmetic, digest } from '../data/digest';
import { THEMES, label, variant } from '../data/themes';

const lead = digest.lead;
const extra = lead ? lead.members.length - 1 : 0;
const headline = digest.baseline ? 'First build.' : digest.quiet ? 'Nothing moved.' : lead?.label;

const DESCRIPTION =
  'A stylish, atomic, agentic Linux, built nightly on Fedora: sixteen GNOME themes in one command, a machine you can hand to a coding agent, and games that just run.';

// The desktop, as the theme harness photographed it: Pulsar Holo, the house's
// other theme, since the themes section below opens on Pulsar's own.
const HOLO = THEMES.find((t) => t.slug === 'pulsar-holo') ?? THEMES[0]!;
const DESKTOP = variant(HOLO, 'dark').desktop;

// The nightly loop, left to right: what happens between one build and the
// next, including the part nobody has to do anything for.
const LOOP = [
  { i: 'moon', t: 'Tonight, a new system is built', d: 'From the latest Fedora packages, on a fresh machine, and compared with yesterday’s line by line.' },
  { i: 'bell', t: 'When it’s ready, you’re told', d: 'One quiet notification when there’s something new. Nothing installs itself.' },
  { i: 'arrow-clockwise', t: 'When you restart, it takes over', d: 'The new system waits beside the one you’re using and swaps in cleanly, between one session and the next.' },
  { i: 'shield-check', t: 'If it fails, it undoes itself', d: 'If it can’t boot, your computer goes back to the last good one, on its own.' },
];

const ROT = [
  {
    t: 'The same system, every boot',
    d: 'The system is one image, read-only while it runs. Nothing drifts, nothing half-updates, and your files live apart from it.',
  },
  {
    t: 'It stays GNOME',
    d: 'Stock GNOME underneath, the way Fedora ships it. Nothing new to learn, and a theme is always a change you can take back.',
  },
  {
    t: 'Ready for real work',
    d: 'Toolboxes for any Linux userland, virtual machines out of the box, and every app on an unfiltered Flathub.',
  },
];

const GAMING = [
  {
    t: 'Tuned the way games want',
    d: 'Gamescope, GameMode and MangoHud are built in. ntsync is there for Proton, and the kernel limits games trip over are already raised.',
  },
  {
    t: 'The launchers are already there',
    d: 'Steam, Heroic, Faugus, ProtonPlus, Protontricks and Bottles install on your first boot, with a video player, a music player and the GNOME apps.',
  },
  {
    t: 'NVIDIA, signed for Secure Boot',
    d: 'The open NVIDIA driver is built for each image and signed for Secure Boot; you enroll its key once after installing. Flatpak games get their piece of the driver before you restart into an update, so they never lose the GPU.',
  },
];
---

<Base
  title="Pulsar — stylish, atomic, agentic Linux, built on Fedora"
  ogTitle="Pulsar — your lighthouse in the sky"
  description={DESCRIPTION}
  path="/"
  immersive
>
  <Hero />
  <main id="main">
    <arc-container size="lg">
      {/* ---- what it is ------------------------------------------------ */}
      <section class="chapter intro" id="about" aria-labelledby="about-h">
        <div class="intro-copy">
          <h2 id="about-h" class="statement">
            Set up well. <span class="lift">Kept that way.</span>
          </h2>
          <p class="big">
            Pulsar makes the hard choices for you, then keeps them working, so the computer gets out of
            your way.
          </p>
          <p>
            The GNOME desktop environment plus 16 unique themes — and easily add your own. Your games
            are ready the moment you log in. Your coding agent gets the whole machine to help with, and
            no way to break it.
          </p>
          <p class="own">We sweated the details. It’s still your computer: go change something.</p>
        </div>
        <figure class="desk">
          <div class="desk-frame">
            <img
              src={DESKTOP}
              alt={`The Pulsar desktop in the ${label(HOLO)} theme: GNOME with the top bar, a terminal and the wallpaper.`}
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>{label(HOLO)}, one of the sixteen. A real screenshot, not a mockup.</figcaption>
        </figure>
      </section>

      {/* ---- how to get it -------------------------------------------- */}
      <GetPulsar />

      {/* ---- will it break -------------------------------------------- */}
      <section class="chapter" id="rot" aria-labelledby="rot-h">
        <h2 id="rot-h">It can’t rot</h2>
        <arc-divider class="h-rule" align="left" variant="line-gradient"></arc-divider>
        <p class="lede">
          Most computers get worse the longer you own them. Pulsar is rebuilt from scratch every night,
          so yours never has the chance.
        </p>

        <ol class="loop" aria-label="What happens between one build and the next">
          {
            LOOP.map((s, i) => (
              <li class={`station${i === LOOP.length - 1 ? ' safety' : ''}`}>
                <span class="badge" aria-hidden="true"><arc-icon name={s.i} size="md"></arc-icon></span>
                <p class="st-t">{s.t}</p>
                <p class="st-d">{s.d}</p>
              </li>
            ))
          }
        </ol>

        <Inside facts={ROT} manifest />
      </section>

      {/* ---- what it does for you ------------------------------------- */}
      <Agents />

      <ThemeShowcase layout="wide" />

      <section class="chapter" id="games" aria-labelledby="games-h">
        <h2 id="games-h">Games that just work</h2>
        <arc-divider class="h-rule" align="left" variant="line-gradient"></arc-divider>
        <p class="lede">
          Pulsar started life as a gaming machine, and it still is one.
          {' '}<span class="sent">Install a game, press&nbsp;play.</span>
        </p>
        <h3 class="gs-h">
          <img class="gs-icon" src="/assets/gamescale.svg" alt="" width="40" height="40" loading="lazy" decoding="async" />
          <span>gamescale</span>
        </h3>
        <Gamescale compact />
        <div class="games-facts">
          <Inside facts={GAMING} />
        </div>
      </section>

      {/* ---- can I check it ------------------------------------------- */}
      <section class="chapter" id="changelog" aria-labelledby="changelog-h">
        <h2 id="changelog-h">What changed last night</h2>
        <arc-divider class="h-rule" align="left" variant="line-gradient"></arc-divider>
        {/* last night's build, from the manifest the build host committed,
            checked against the registry by src/scripts/beacon.ts */}
        <p class="buildline">
          <a class="build-chip" href="/docs/changelog" id="build-chip">
            <span class="build-dot" aria-hidden="true"></span>
            build <strong id="build-version" data-build-version>{version}</strong>
          </a>
          <span class="buildnote hint" id="build-note" hidden></span>
        </p>
        <div class="lead">
          <p class="lead-tx">
            <span class="lead-pkg">{headline}</span>
            {
              lead && !digest.baseline && !digest.quiet && (
                <>
                  {extra > 0 && <arc-badge size="sm" class="mono">+{extra} related {extra === 1 ? 'package' : 'packages'}</arc-badge>}
                  <span class="lead-ver" aria-hidden="true">
                    <Version delta={lead.delta} from={lead.from} to={lead.to} />
                  </span>
                  <span class="sr-only">{lead.label}, {lead.from} to {lead.to}</span>
                </>
              )
            }
          </p>
          <p class="lead-sub">{arithmetic()}</p>
          <p class="prov mono">
            {
              digest.fromDigest && digest.toDigest && (
                <>
                  <span class="dim">image</span>
                  <span>{digest.fromDigest}</span>
                  <span class="dim" aria-hidden="true">→</span>
                  <span>{digest.toDigest}</span>
                </>
              )
            }
            <span><span class="dim">diffed</span> <arc-time-ago datetime={changelog.generated}></arc-time-ago></span>
          </p>
          {/* Filled by src/scripts/beacon.ts when the newest nightly built
              nothing. Hidden in the served HTML: skips commit nothing. */}
          <p class="hint skip-note" data-skip-note hidden></p>
        </div>
        <Ledger />
        <p class="hint">
          Every row, unsummarized: <a href="/changelog.json">changelog.json</a>. On a Pulsar machine,
          <code>pulsar changelog</code> prints the same&nbsp;list.
        </p>
      </section>

      <section class="chapter" id="provenance" aria-labelledby="provenance-h">
        <h2 id="provenance-h">Every image has a paper trail</h2>
        <arc-divider class="h-rule" align="left" variant="line-gradient"></arc-divider>
        <p class="lede">
          Built on a machine that exists for one night, and published with its full package list
          attached.
          {' '}<span class="sent">Check any of it from your own&nbsp;terminal.</span>
        </p>
        <Pipeline compact />
        <p class="more"><a href="/docs/provenance">How the pipeline works →</a></p>
      </section>
    </arc-container>
  </main>
</Base>

<style>
  /* ---- intro: a statement beside the thing itself ---------------------- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: center;
    padding-top: var(--space-3xl);
  }
  .statement {
    font-size: clamp(2.4rem, 5.2vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 var(--space-lg);
  }
  .lift {
    color: var(--accent-primary);
    text-shadow: var(--glow-xs);
  }
  .intro-copy p {
    max-width: 46ch;
    color: var(--text-secondary);
    text-wrap: pretty;
    margin: 0 0 var(--space-md);
  }
  .intro-copy .big {
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .intro-copy .own {
    margin-top: var(--space-lg);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
  }
  .desk {
    margin: 0;
    min-width: 0;
  }
  .desk-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-default);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.6), var(--glow-hover);
    aspect-ratio: 16 / 10;
    background: var(--ink);
  }
  .desk-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .desk figcaption {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ---- the nightly loop: four stations on one lit line ---------------- */
  .loop {
    list-style: none;
    margin: var(--space-xl) 0 var(--space-2xl);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    position: relative;
  }
  .loop::before {
    content: '';
    position: absolute;
    top: 23px;
    left: 24px;
    right: 24px;
    height: 2px;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary) 70%, var(--color-success));
    opacity: 0.45;
  }
  .station {
    position: relative;
    min-width: 0;
  }
  .badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-md);
    border-radius: var(--radius-full);
    background: var(--bg-deep);
    border: 1px solid var(--accent-primary);
    box-shadow: var(--glow-sm);
    color: var(--accent-primary);
  }
  .safety .badge {
    border-color: var(--color-success);
    color: var(--color-success);
    box-shadow: 0 0 10px color-mix(in oklab, var(--color-success) 45%, transparent);
  }
  .st-t {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-lg);
    line-height: var(--heading-lh);
    margin: 0 0 var(--space-xs);
  }
  .st-d {
    margin: 0;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* ---- games ----------------------------------------------------------- */
  .gs-h {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-2xl);
    margin: var(--space-xl) 0 var(--space-md);
  }
  .gs-icon {
    display: block;
    width: 40px;
    height: 40px;
  }
  .games-facts {
    margin-top: var(--space-2xl);
  }

  /* ---- changelog ------------------------------------------------------- */
  .buildline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    margin: 0 0 var(--space-lg);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }
  .build-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md) var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
    background: var(--chip);
    border: 1px solid var(--chip-line);
    color: var(--on-chip);
    font-family: var(--font-mono);
    text-decoration: none;
    transition: box-shadow 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }
  .build-chip:hover {
    border-color: var(--cyan);
    box-shadow: var(--glow-xs);
  }
  .build-chip strong {
    font-weight: var(--font-mono-weight);
    font-variant-numeric: tabular-nums;
    color: var(--cyan);
  }
  .build-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--cyan);
    box-shadow: var(--glow-sm);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  .build-chip[data-stale] .build-dot {
    animation: none;
    background: var(--text-ghost);
    box-shadow: none;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  .buildnote {
    margin: 0;
  }
  .lead {
    margin: 0 0 var(--space-xl);
  }
  .lead-tx {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin: 0 0 var(--space-md);
  }
  .lead-pkg {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-3xl);
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    color: var(--accent-primary);
    text-shadow: var(--glow-xs);
  }
  .lead-ver {
    font-size: var(--text-lg);
  }
  .lead-sub {
    max-width: 62ch;
    font-size: var(--text-lg);
    margin: 0 0 var(--space-sm);
  }
  .prov {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin: 0;
  }
  .dim {
    color: var(--text-ghost);
  }
  .skip-note {
    margin: var(--space-sm) 0 0;
  }
  .more {
    margin: var(--space-lg) 0 0;
  }
  .more a {
    text-decoration: none;
  }
  .more a:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .build-dot {
      animation: none;
    }
  }

  @media (max-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .loop {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
      padding-left: calc(48px + var(--space-md));
    }
    /* the line runs down the badges on a phone */
    .loop::before {
      top: 24px;
      bottom: 24px;
      left: 23px;
      right: auto;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, var(--accent-primary), var(--accent-secondary) 70%, var(--color-success));
    }
    .badge {
      position: absolute;
      left: calc(-48px - var(--space-md));
      top: 0;
      margin: 0;
    }
  }
</style>
