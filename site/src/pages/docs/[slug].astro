---
// One repo doc (docs/*.md), rendered where the sidebar points at it.
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const title = headings.find((h) => h.depth === 1)?.text ?? doc.id;
// the first paragraph, for search and share snippets
const description = (doc.body ?? '').split(/\n\s*\n/).map((p) => p.trim()).find((p) => p && !p.startsWith('#'))?.replace(/[`*_]/g, '').replace(/\s+/g, ' ').slice(0, 155) ?? title;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ id: h.slug, label: h.text, level: h.depth }));
---

<Docs title={title} description={description} path={`/docs/${doc.id}`} headings={toc}>
  <Content />
</Docs>
