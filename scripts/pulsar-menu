def run_detached(argv):
    subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# The Shell's extension that gives the menu its ground (glass.js,
# Glass._trackCommandMenu), and its ExtensionState while it runs
THEME_EXTENSION = "pulsar-theme@arclight.digital"
EXTENSION_ACTIVE = 1


def shell_grounds(info):
    """Whether the Shell paints the menu's ground: its glass, or the theme's
    solid popover when glass is off. Only while pulsar-theme runs there;
    info is the Shell's GetExtensionInfo reply (unpacked: {} for an unknown
    extension), or None when the Shell did not answer."""
    return bool(info) and info.get("state") == EXTENSION_ACTIVE


def window_class():
    """The window, built on first use: the logic above runs without GTK."""
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    gi.require_version("Gdk", "4.0")
    gi.require_version("Pango", "1.0")
    gi.require_version("Gsk", "4.0")
    gi.require_version("Graphene", "1.0")
    from gi.repository import Adw, Gdk, Gio, GLib, Graphene, Gsk, Gtk, Pango
    try:   # GLib 2.86 moved it to GioUnix, and warns on the old name
        gi.require_version("GioUnix", "2.0")
        from gi.repository import GioUnix
        AppInfo = GioUnix.DesktopAppInfo
    except (ValueError, ImportError):
        AppInfo = Gio.DesktopAppInfo

    def hint(box, keys, what):
        for k in keys:
            lab = Gtk.Label(label=k)
            lab.add_css_class("key")
            box.append(lab)
        box.append(Gtk.Label(label=what, margin_end=14))

    class Scrub(Gtk.Widget):
        """A title that, while its row is chosen, slides along to show the
        rest of a name too long to fit, holds there, and slides back.
        Asks for no width of its own, so a long name never widens the menu."""
        def __init__(self, label):
            super().__init__(hexpand=True, overflow=Gtk.Overflow.HIDDEN)
            self.label = label
            label.set_parent(self)
            self.offset = 0.0
            self.anim = None
            self.timer = 0

        def do_measure(self, orientation, for_size):
            mn, nat, mb, nb = self.label.measure(orientation, -1)
            if orientation == Gtk.Orientation.HORIZONTAL:
                return 0, 0, -1, -1
            return mn, nat, mb, nb

        def do_size_allocate(self, width, height, baseline):
            w = width
            if self.label.get_ellipsize() == Pango.EllipsizeMode.NONE:
                w = max(width, self.label.measure(Gtk.Orientation.HORIZONTAL, -1)[1])
            t = Gsk.Transform.new().translate(Graphene.Point().init(-self.offset, 0))
            self.label.allocate(w, height, baseline, t)

        def do_dispose(self):
            self.stop()
            if self.label is not None:
                self.label.unparent()
                self.label = None

        def _move(self, value):
            self.offset = value
            self.queue_allocate()

        def _later(self, ms, then):
            def fire():
                self.timer = 0
                then()
                return False
            self.timer = GLib.timeout_add(ms, fire)

        def _slide(self, to, ms, then, easing):
            target = Adw.CallbackAnimationTarget.new(self._move)
            self.anim = Adw.TimedAnimation.new(self, self.offset, to, ms, target)
            self.anim.set_easing(easing)
            self.anim.connect("done", lambda _a: then())
            self.anim.play()

        def start(self, delay=SCRUB_DELAY_MS):
            """After a moment on the row: slide to the end, hold, slide back."""
            self.stop()
            self._later(delay, self._go)

        def _go(self):
            if self.label is None:
                return
            self.label.set_ellipsize(Pango.EllipsizeMode.NONE)
            full = self.label.measure(Gtk.Orientation.HORIZONTAL, -1)[1]
            over = full - self.get_width()
            if over <= 1:
                self.label.set_ellipsize(Pango.EllipsizeMode.END)
                return
            # along at an even pace (an eased end crawls for the last
            # stretch), back with a quick ease
            self._slide(over, scrub_ms(over), lambda: self._later(
                SCRUB_HOLD_MS, lambda: self._slide(0, SCRUB_BACK_MS, self.stop, Adw.Easing.EASE_OUT_CUBIC)),
                Adw.Easing.LINEAR)

        def stop(self):
            if self.timer:
                GLib.source_remove(self.timer)
                self.timer = 0
            if self.anim is not None:
                a, self.anim = self.anim, None
                a.reset()
            self.offset = 0.0
            if self.label is not None:
                self.label.set_ellipsize(Pango.EllipsizeMode.END)
            self.queue_allocate()

    # Adw's window: rounded corners and the shadow, with no title bar
    class Menu(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Pulsar Commands",
                             resizable=False, default_width=620, default_height=520)
            self.add_css_class("pulsar-menu")
            # no ground of its own: the Shell gives this window the glass and
            # light of its menus, or with glass off the theme's popover
            # (glass.js, Glass._trackCommandMenu), and the window's
            # .background would lie over them. Unless pulsar-theme is not
            # running (switched off, failed): then nothing else would, and it
            # keeps its own. Asked once, without waiting; until the answer
            # the menu is fading in from nothing either way.
            self.remove_css_class("background")

            def grounded(bus, res):
                try:
                    info = bus.call_finish(res).unpack()[0]
                except GLib.Error:
                    info = None
                if not shell_grounds(info):
                    self.add_css_class("background")
            bus = app.get_dbus_connection()
            if bus is None:
                self.add_css_class("background")
            else:
                # the Shell's own, not org.gnome.Shell.Extensions (a service
                # of its own, started to answer)
                bus.call("org.gnome.Shell", "/org/gnome/Shell",
                         "org.gnome.Shell.Extensions", "GetExtensionInfo", GLib.Variant("(s)", (THEME_EXTENSION,)),
                         GLib.VariantType.new("(a{sv})"), Gio.DBusCallFlags.NO_AUTO_START, 2000, None, grounded)
            css = Gtk.CssProvider()
            css.load_from_string(CSS)
            Gtk.StyleContext.add_provider_for_display(self.get_display(), css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.entry = Gtk.SearchEntry(placeholder_text="Search apps, files and Pulsar", hexpand=True,
                                         margin_top=10, margin_bottom=8, margin_start=14, margin_end=14)
            self.entry.add_css_class("search")
            box.append(self.entry)
            box.append(Gtk.Box(css_classes=["spectrum"]))
            self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE, margin_top=2, margin_bottom=8)
            self.list.set_filter_func(self._filter)
            self.list.set_header_func(self._header)
            # what an empty list says, rather than nothing at all
            empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["empty"],
                            valign=Gtk.Align.CENTER)
            empty.append(Gtk.Image(icon_name="system-search-symbolic", pixel_size=32))
            self.empty_title = Gtk.Label(css_classes=["empty-title"], wrap=True, justify=Gtk.Justification.CENTER)
            self.empty_hint = Gtk.Label(css_classes=["dim-label", "caption"], wrap=True,
                                        justify=Gtk.Justification.CENTER)
            empty.append(self.empty_title)
            empty.append(self.empty_hint)
            self.list.set_placeholder(empty)
            self.list.connect("row-selected", lambda *_a: self._footer())
            self.list.connect("row-activated", lambda _l, row: self.run(row.item))
            scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            scroll.set_child(self.list)
            self.scroll = scroll
            box.append(scroll)
            foot = Gtk.Box(css_classes=["footer"], spacing=5)
            hint(foot, ["\u2191", "\u2193"], "choose")
            hint(foot, ["\u21b5"], "run")
            # only while a file is chosen
            self.folder_hint = Gtk.Box(spacing=5, visible=False)
            hint(self.folder_hint, ["Ctrl", "\u21b5"], "show in folder")
            foot.append(self.folder_hint)
            hint(foot, ["Esc"], "close")
            box.append(foot)
            # a quick fade in, so it arrives rather than appears. Opacity, not a
            # Gtk.Revealer: a revealer hides its child until the fade starts, so
            # the search field could not take the focus and the first keys were lost
            box.set_opacity(0)
            self.set_content(box)
            self.fade_in = Adw.TimedAnimation.new(box, 0, 1, 160, Adw.PropertyAnimationTarget.new(box, "opacity"))
            self.connect("map", lambda *_a: self.fade_in.play())
            # type as soon as it opens
            self.set_focus(self.entry)
            self.query = ""
            self.calc = CalcItem()
            self.calc.want_rates = self._fetch_rates
            self.fetching = False
            self.home = os.path.realpath(os.path.expanduser("~"))
            self.own = [d for d in (GLib.get_user_special_dir(getattr(GLib.UserDirectory, n)) for n in
                        ("DIRECTORY_DESKTOP", "DIRECTORY_DOCUMENTS", "DIRECTORY_DOWNLOAD", "DIRECTORY_MUSIC",
                         "DIRECTORY_PICTURES", "DIRECTORY_VIDEOS", "DIRECTORY_PUBLIC_SHARE",
                         "DIRECTORY_TEMPLATES")) if d and os.path.realpath(d) != self.home]
            self.files = None        # the index's prepared search, made on first use
            self.files_off = None    # why there is no file search, once known
            self.file_cancel = None
            self.add(self.calc)
            for it in base_items():
                self.add(it)
            self.entry.connect("search-changed", self._changed)
            self.entry.connect("activate", lambda _e: self._activate_selected())
            self.entry.connect("stop-search", lambda _e: self.close())
            keys = Gtk.EventControllerKey()
            keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            keys.connect("key-pressed", self._key)
            self.add_controller(keys)
            self.was_active = False
            self.leaving = False
            self.scrubbing = None
            self.connect("notify::is-active", self._active)
            self._select_first()
            self._load_accels()
            # the slow ones after the window is up
            self._async([PULSAR, "agent", "sessions", "--json"], self._got_sessions)
            self._async([PULSAR, "agent", "default"], self._got_agent)

        def add(self, it, position=-1):
            row = Gtk.ListBoxRow()
            row.item = it
            h = Gtk.Box(spacing=12, margin_top=7, margin_bottom=7, margin_start=8, margin_end=10)
            if it.full_color:
                icon = Gtk.Image(gicon=it.gicon, pixel_size=32, css_classes=["app-icon"])
            elif it.gicon is not None:
                icon = Gtk.Image(gicon=it.gicon, pixel_size=16, css_classes=["tile"])
            else:
                icon = Gtk.Image(icon_name=it.icon, pixel_size=16, css_classes=["tile"])
            icon.set_valign(Gtk.Align.CENTER)
            row.icon = icon
            h.append(icon)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
            # the window keeps its width: a long name is cut short, never
            # the reason the menu grows (a non-resizable window takes its
            # rows' natural width, so they are given none of their own)
            row.title = Gtk.Label(label=it.title, xalign=0, selectable=False, max_width_chars=1,
                                  ellipsize=Pango.EllipsizeMode.END,
                                  css_classes=["item-title"] + (["answer"] if it.key == "calc" else []))
            row.scrub = Scrub(row.title)
            v.append(row.scrub)
            # a file's folder loses its middle: its first and last folders say where
            sub = Gtk.Label(label=it.subtitle, xalign=0, max_width_chars=1,
                            ellipsize=Pango.EllipsizeMode.MIDDLE if it.reveal else Pango.EllipsizeMode.END)
            sub.add_css_class("dim-label")
            sub.add_css_class("caption")
            v.append(sub)
            row.sub = sub
            h.append(v)
            row.accel = Gtk.Label(label=it.accel, css_classes=["accel", "dim-label"])
            h.append(row.accel)
            row.set_child(h)
            self.list.insert(row, position)

        def _filter(self, row):
            return row.item.matches(self.query)

        def _header(self, row, before):
            # a group's name over its first row that is showing
            if not row.item.group:
                row.set_header(None)
            elif before is not None and before.item.group == row.item.group:
                row.set_header(None)
            elif row.get_header() is None or row.get_header().get_label() != row.item.group:
                row.set_header(Gtk.Label(label=row.item.group, xalign=0, css_classes=["group"]))

        def _fetch_rates(self):
            if self.fetching or self.calc.rates_failed:
                return
            self.fetching = True
            import threading

            def report(got):
                GLib.idle_add(self._got_rates, got)
            threading.Thread(target=fetch_then, args=(report,), daemon=True).start()

        def _got_rates(self, rates):
            # the answer row only: the apps and files found are still the ones
            self.fetching = False
            self.calc.rates = rates
            self.calc.rates_failed = rates is None
            self._answer_row()
            self.list.invalidate_filter()
            self.list.invalidate_headers()
            row = self.list.get_selected_row()
            if row is None or not row.item.matches(self.query):
                self._select_first()
            return False

        def _answer_row(self):
            row = self.list.get_row_at_index(0)
            if row.item.matches(self.query):
                row.title.set_label(row.item.title)
                row.sub.set_label(row.item.subtitle)
                row.icon.set_from_icon_name(row.item.icon)

        def _changed(self, entry):
            self.query = entry.get_text()
            self._answer_row()
            # rows from the last search go; apps come straight after the answer
            rows = self._all_rows()
            gone, new = found_changes([r.item for r in rows], self.query, self._apps(self.query))
            for r in rows:
                if r.item in gone:
                    self.list.remove(r)
            for n, it in enumerate(new):
                self.add(it, 1 + n)
            self._search_files(self.query)
            self.empty_title.set_label(nothing_found(self.query)[0])
            self.empty_hint.set_label(nothing_found(self.query)[1])
            self.list.invalidate_filter()
            self.list.invalidate_headers()
            self._select_first()

        def _visible_rows(self):
            return [r for r in self._all_rows() if r.item.matches(self.query)]

        def _select_first(self):
            rows = self._visible_rows()
            self.list.select_row(rows[0] if rows else None)

        def _move(self, step):
            rows = self._visible_rows()
            if not rows:
                return
            cur = self.list.get_selected_row()
            i = rows.index(cur) if cur in rows else -1
            row = rows[max(0, min(len(rows) - 1, i + step))]
            self.list.select_row(row)
            # keep it in view; focus stays in the search field
            ok, b = row.compute_bounds(self.list)
            adj = self.scroll.get_vadjustment()
            if ok:
                top, bottom = b.get_y(), b.get_y() + b.get_height()
                if top < adj.get_value():
                    adj.set_value(top)
                elif bottom > adj.get_value() + adj.get_page_size():
                    adj.set_value(bottom - adj.get_page_size())

        def _key(self, _c, keyval, _code, _state):
            if keyval == Gdk.KEY_Escape:
                self.close()
                return True
            if keyval in (Gdk.KEY_Down, Gdk.KEY_Tab):
                self._move(1)
                return True
            if keyval in (Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab):
                self._move(-1)
                return True
            if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                row = self.list.get_selected_row()
                if (_state & Gdk.ModifierType.CONTROL_MASK and row is not None
                        and row.item.reveal and row.item.matches(self.query)):
                    self._show_in_folder(row.item.reveal)
                    return True
                self._activate_selected()
                return True
            return False

        def _activate_selected(self):
            row = self.list.get_selected_row()
            if row is not None and row.item.matches(self.query):
                self.run(row.item)

        def _active(self, *_a):
            # clicked away: close, as a menu does (not while it is hiding to
            # start a screen reader: closing would end the app first)
            if self.leaving:
                return
            if self.is_active():
                self.was_active = True
            elif self.was_active:
                self.close()

        def run(self, it):
            if it.launch is not None:
                ctx = self.get_display().get_app_launch_context()
                try:
                    it.launch(ctx)
                except GLib.Error as e:
                    print(f"pulsar-menu: {it.key}: {e.message}", file=sys.stderr)
                self.close()
                return
            if not it.argv:
                return   # the answer row while there is no answer yet
            if it.settle:
                # hidden, not closed: the app lives until the reader has started
                self.leaving = True
                self.set_visible(False)
                GLib.timeout_add(SETTLE_MS, lambda: self._start(it) and False)
                return
            self._start(it)

        def _start(self, it):
            try:
                run_detached(it.argv)
            except OSError as e:
                print(f"pulsar-menu: {it.key}: {e}", file=sys.stderr)
            self.close()

        def _async(self, argv, done):
            try:
                p = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
            except GLib.Error:
                return

            def finished(proc, res):
                try:
                    _ok, out, _err = proc.communicate_utf8_finish(res)
                except GLib.Error:
                    return
                if proc.get_successful():
                    done(out or "")
            p.communicate_utf8_async(None, None, finished)

        def _got_sessions(self, out):
            try:
                items = session_items(json.loads(out))
            except (ValueError, TypeError, KeyError):
                return
            # after "Agent sessions", wherever the rows are now
            at = next(i for i, r in enumerate(self._all_rows()) if r.item.key == "sessions") + 1
            for n, it in enumerate(items):
                self.add(it, at + n)
            self._select_first()

        def _got_agent(self, out):
            name = out.strip().split()[0] if out.strip() else ""
            if name:
                rows = self._all_rows()
                at = max(i for i, r in enumerate(rows) if r.item.group == "Agents") + 1
                self.add(agent_item(name), at)

        def _footer(self):
            row = self.list.get_selected_row()
            self.folder_hint.set_visible(row is not None and bool(row.item.reveal))
            # the chosen row's name, in full, a moment after it is chosen
            if self.scrubbing is not None and self.scrubbing is not row:
                self.scrubbing.scrub.stop()
            self.scrubbing = row
            if row is not None:
                row.scrub.start()

        def _apps(self, query):
            if not query.strip():
                return []
            infos = {}

            def shown(i):
                try:
                    a = AppInfo.new(i)
                except TypeError:
                    a = None
                if a is None or not a.should_show():
                    return False
                infos[i] = a
                return True
            out = []
            for i in pick_apps(AppInfo.search(query), shown):
                a = infos[i]
                it = Found(query, f"app:{i}", a.get_display_name() or a.get_name(),
                           a.get_description() or a.get_generic_name() or "", "Apps")
                it.gicon = a.get_icon() or Gio.ThemedIcon.new("application-x-executable")
                it.full_color = True
                it.launch = lambda ctx, a=a: a.launch([], ctx)
                out.append(it)
            return out

        def _file_search(self):
            """The index's prepared search, or None (and why) when there is none."""
            if self.files is not None or self.files_off is not None:
                return self.files
            try:
                s = Gio.Settings.new("org.gnome.desktop.search-providers")
                if not files_allowed(s.get_boolean("disable-external"), s.get_strv("disabled")):
                    self.files_off = "off in Settings"
                    return None
            except Exception:  # no such schema: nothing to honor
                pass
            try:
                gi.require_version("Tsparql", "3.0")
                from gi.repository import Tsparql
                conn = Tsparql.SparqlConnection.bus_new("org.freedesktop.LocalSearch3", None, None)
                self.files = conn.query_statement(FILES_QUERY, None)
            except (ValueError, ImportError, GLib.Error) as e:
                self.files_off = str(e)
                print(f"pulsar-menu: no file search: {e}", file=sys.stderr)
            return self.files

        def _search_files(self, query):
            if self.file_cancel is not None:
                self.file_cancel.cancel()
                self.file_cancel = None
            terms = file_terms(query)
            stmt = self._file_search() if terms else None
            if stmt is None:
                return
            cancel = Gio.Cancellable()
            self.file_cancel = cancel
            stmt.bind_string("terms", terms)

            def done(st, res):
                try:
                    cur = st.execute_finish(res)
                    rows = []
                    while cur.next(cancel):
                        url, rank, mod = cur.get_string(0)[0], cur.get_double(1), cur.get_string(2)[0]
                        path = Gio.File.new_for_uri(url).get_path()
                        if path:
                            rows.append((path, rank, mod))
                    cur.close()
                except GLib.Error:
                    return   # cancelled: a newer search is on its way
                if cancel.is_cancelled() or query != self.query:
                    return
                self.file_cancel = None
                self._got_files(query, rank_files(rows, query, self.home, self.own))
            stmt.execute_async(cancel, done)

        def _got_files(self, query, paths):
            found = []
            for path in paths:
                f = Gio.File.new_for_path(path)
                try:
                    info = f.query_info("standard::display-name,standard::symbolic-icon",
                                        Gio.FileQueryInfoFlags.NONE, None)
                except GLib.Error:
                    continue   # gone since it was indexed
                it = Found(query, f"file:{path}", info.get_display_name(), where(path, self.home), "Files")
                it.gicon = info.get_symbolic_icon()
                uri = f.get_uri()
                it.launch = lambda ctx, uri=uri: Gio.AppInfo.launch_default_for_uri(uri, ctx)
                it.reveal = uri
                found.append(it)
            # the same search again (the same words typed back) adds none twice
            for it in found_changes([r.item for r in self._all_rows()], query, found)[1]:
                self.add(it)
            self.list.invalidate_headers()
            # the first row only if nothing was chosen: files arrive while you type
            row = self.list.get_selected_row()
            if row is None or not row.item.matches(self.query):
                self._select_first()

        def _show_in_folder(self, uri):
            try:
                Gio.bus_get_sync(Gio.BusType.SESSION).call_sync(
                    "org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                    "org.freedesktop.FileManager1", "ShowItems",
                    GLib.Variant("(ass)", ([uri], "")), None, Gio.DBusCallFlags.NONE, 3000, None)
            except GLib.Error as e:
                print(f"pulsar-menu: show in folder: {e.message}", file=sys.stderr)
            self.close()

        def _all_rows(self):
            i, rows = 0, []
            while (row := self.list.get_row_at_index(i)) is not None:
                rows.append(row)
                i += 1
            return rows

        def _load_accels(self):
            for row in self._all_rows():
                sid = SHORTCUT_IDS.get(row.item.key)
                if not sid:
                    continue
                path = f"/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/{sid}/"
                try:
                    s = Gio.Settings.new_with_path("org.gnome.settings-daemon.plugins.media-keys.custom-keybinding", path)
                    if s.get_string("command").startswith(row.item.argv[0]) and s.get_string("binding"):
                        row.accel.set_label(accel_label(s.get_string("binding")))
                except Exception:  # no such schema here
                    pass

    return Menu


def main(argv):
    Menu = window_class()
    from gi.repository import Adw
    app = Adw.Application(application_id="digital.arclight.Pulsar.Menu")

    def activate(a):
        w = a.get_active_window()
        if w is not None:
            # the shortcut again: close, like a toggle
            w.close()
            return
        Menu(a).present()
    app.connect("activate", activate)
    return app.run(argv[:1])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
