---
// The shipped image's own baked manifest -- the same file `pulsar manifest`
// reads on the machine -- rendered at build time from src/data/manifest.json
// as a terminal transcript. Not an illustration of a readout: the readout.
//
// The rows are the ones the CLI prints, in the CLI's order. No sbom or
// attestation row: both were values that named another command to run, which
// is not what an inventory is for; the CLI dropped them for the same reason.
// The host rows the CLI prints have no meaning here either -- this is a
// BUILD's manifest, and there is no machine on the other side of it.
import { manifest } from '../data/build';

const rows: Array<[string, string]> = [
  ['image', manifest.variant ? `${manifest.image} (${manifest.variant})` : manifest.image],
  ['version', manifest.version],
  ['base', manifest.base],
  ['built', manifest.built],
  ['kernel', manifest.kernel],
  ...Object.entries(manifest.components ?? {}).map(
    ([key, value]) => [key, String(value)] as [string, string],
  ),
];

// the column the values line up on, from the longest key present
const gutter = Math.max(...rows.map(([key]) => key.length)) + 2;

const code = rows.map(([key, value]) => `${key}${' '.repeat(gutter - key.length)}${value}`).join('\n');
---

<figure class="manifest">
  <arc-code-block class="theme-fixed-dark" filename="pulsar manifest" code={code}></arc-code-block>
  <figcaption class="hint">the image's own manifest — rendered, not written</figcaption>
</figure>

<style>
  .manifest {
    margin: 0;
  }
  .manifest arc-code-block {
    display: block;
    font-variant-numeric: tabular-nums;
  }
  figcaption {
    margin-top: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }
</style>
