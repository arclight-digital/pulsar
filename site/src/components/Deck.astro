---
// The hero deck. These controls drive the SAME uniforms the OS wallpapers are
// rendered with: four looks x two themes = the shipped set.
//
// One bar, two zones. The travelling pill is decoration on top of state that
// is already carried by aria-pressed and the label colour, so a browser
// without :has() loses the motion and nothing else.
const LOOKS = ['Silk', 'Leak', 'Satin', 'Holo'];
---

<div class="deck">
  <span class="deck-note">the shipped wallpapers&nbsp;&mdash;&nbsp;live</span>
  <div class="ctl">
    {/* Hidden until a GL context actually exists: a visitor without WebGL
        must never see buttons that silently do nothing. sky.ts unhides it
        once the shader has compiled and drawn. */}
    <div class="ctl-zone" role="group" aria-label="Backdrop" id="lookSeg" hidden>
      <span class="ctl-lab" aria-hidden="true">Backdrop</span>
      <div class="picker picker-4">
        <span class="pill" aria-hidden="true"></span>
        {
          LOOKS.map((name, index) => (
            <button data-look={index} aria-pressed={index === 0 ? 'true' : 'false'}>
              {name}
            </button>
          ))
        }
      </div>
    </div>

    <div class="ctl-zone" role="group" aria-label="Theme">
      <span class="ctl-lab" aria-hidden="true">Theme</span>
      <div class="picker picker-2">
        <span class="pill" aria-hidden="true"></span>
        <button data-theme-pick="dark" aria-pressed="true">
          <svg
            viewBox="0 0 16 16"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M13.4 9.8A5.8 5.8 0 0 1 6.2 2.6a5.9 5.9 0 1 0 7.2 7.2Z"></path>
          </svg>
          <span>Dark</span>
        </button>
        <button data-theme-pick="light" aria-pressed="false">
          <svg
            viewBox="0 0 16 16"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="3"></circle>
            <path
              d="M8 1.4v1.5M8 13.1v1.5M2.4 2.4l1.1 1.1M12.5 12.5l1.1 1.1M1.4 8h1.5M13.1 8h1.5M2.4 13.6l1.1-1.1M12.5 3.5l1.1-1.1"
            ></path>
          </svg>
          <span>Light</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .deck {
    position: absolute;
    bottom: 1.4rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    padding: 0 1rem;
    max-width: 100%;
  }

  .deck-note {
    flex-basis: 100%;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* One bar for both controls. The blur is load-bearing rather than
     decorative: these sit on a live shader whose luminance is unknown across
     four looks x two themes, and the frosted ground is what keeps the labels
     readable over all eight. */
  .ctl {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--chip);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 8px 24px -12px rgba(11, 14, 26, 0.7);
    overflow: hidden;
  }

  .ctl-zone {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
  }

  .ctl-zone + .ctl-zone {
    border-left: 1px solid var(--line);
  }

  .ctl-zone[hidden] {
    display: none;
  }

  .ctl-lab {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    user-select: none;
    padding-left: 0.25rem;
  }

  /* equal columns, so the travelling pill can be a fixed fraction */
  .picker {
    position: relative;
    display: grid;
  }

  .picker-4 {
    grid-template-columns: repeat(4, minmax(3.4rem, 1fr));
  }

  .picker-2 {
    grid-template-columns: repeat(2, minmax(4.2rem, 1fr));
  }

  .picker button {
    position: relative;
    z-index: 1;
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 400 0.8rem/1 var(--font-ui); /* shipped weights only */
    min-height: 2.35rem;
    padding: 0 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    cursor: pointer;
    border-radius: 9px;
    transition: color 0.16s ease-out;
  }

  .picker button:hover {
    color: var(--text);
  }

  .picker button:focus-visible {
    outline-offset: -2px;
  }

  .picker button[aria-pressed="true"] {
    color: var(--accent);
    font-weight: 700;
  }

  .picker button svg {
    flex: none;
  }

  /* The pill is the one authored motion in this control: it travels between
     positions rather than blinking on. */
  .pill {
    position: absolute;
    z-index: 0;
    inset: 0 auto 0 0;
    border-radius: 9px;
    background: rgba(143, 168, 255, 0.16);
    box-shadow: inset 0 0 0 1px var(--line);
    pointer-events: none;
  }

  /* No travel until the first reflect() has placed it: the active theme is
     only known after JS reads storage and the system query, so an enabled
     transition makes every load start on Dark and visibly slide across. */
  :global(:root[data-ready]) .pill {
    transition: transform 0.34s var(--ease-out);
  }

  .picker-4 .pill {
    width: 25%;
  }
  .picker-2 .pill {
    width: 50%;
  }

  .picker-4:has(button:nth-of-type(1)[aria-pressed="true"]) .pill {
    transform: translateX(0);
  }
  .picker-4:has(button:nth-of-type(2)[aria-pressed="true"]) .pill {
    transform: translateX(100%);
  }
  .picker-4:has(button:nth-of-type(3)[aria-pressed="true"]) .pill {
    transform: translateX(200%);
  }
  .picker-4:has(button:nth-of-type(4)[aria-pressed="true"]) .pill {
    transform: translateX(300%);
  }
  .picker-2:has(button:nth-of-type(1)[aria-pressed="true"]) .pill {
    transform: translateX(0);
  }
  .picker-2:has(button:nth-of-type(2)[aria-pressed="true"]) .pill {
    transform: translateX(100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .pill {
      transition: none;
    }
  }

  @media (max-width: 34rem) {
    .ctl {
      flex-direction: column;
    }
    .ctl-zone + .ctl-zone {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .ctl-zone {
      justify-content: space-between;
    }
    .picker-4 {
      grid-template-columns: repeat(4, minmax(2.9rem, 1fr));
    }
  }

  /* The deck floats over the shader on desktop, and the hero reserves room for
     it with a fixed padding-bottom. That reservation is a constant; the deck's
     height is not. On a phone it wraps to three rows -- note, backdrop pill,
     theme pill -- outgrows the reserved space, and prints straight over the
     install copy, because an absolutely positioned element cannot push
     anything. Below this width it rejoins the flow as the hero grid's second
     row, and overlap becomes structurally impossible rather than a number that
     has to be re-tuned every time a button is added. */
  @media (max-width: 46rem) {
    .deck {
      position: static;
      transform: none;
      margin-top: 1.6rem;
    }
  }

  @media (max-width: 26rem) {
    .picker button {
      padding: 0 0.45rem;
      font-size: 0.76rem;
    }
    .ctl-lab {
      font-size: 0.58rem;
      letter-spacing: 0.12em;
    }
  }
</style>
