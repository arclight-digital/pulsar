---
// Two install paths, both visible: one command for a machine already on
// Silverblue, one download for a machine that is not. Nothing hides behind a
// tab, so nothing is unreachable without JavaScript.
import DownloadRow from './DownloadRow.astro';
import { IMAGES, ISOS } from '../data/site';

interface Props {
  /** the home page links to /install for the key enrolment; /install is it */
  compact?: boolean;
}

const { compact = false } = Astro.props;

const switchTo = (image: string) => `sudo bootc switch ${image}:latest`;
---

<div class="install">
  <div class="path">
    <h3>Already on Fedora Silverblue or Kinoite 44+</h3>
    <div class="cmds">
      <arc-code-block
        class="theme-fixed-dark"
       
        language="bash"
        filename="standard"
        code={switchTo(IMAGES.vanilla)}
      ></arc-code-block>
      <arc-code-block
        class="theme-fixed-dark"
       
        language="bash"
        filename="nvidia"
        code={switchTo(IMAGES.nvidia)}
      ></arc-code-block>
    </div>
    <p class="hint">
      Then reboot. The nvidia module comes signed —{' '}
      {
        compact ? (
          <a href="/install#secure-boot">enrol the cert once</a>
        ) : (
          <a href="#secure-boot">enrol the cert once</a>
        )
      }{' '}
      and keep Secure&nbsp;Boot&nbsp;on.
    </p>
  </div>

  <div class="path">
    <h3>Fresh machine</h3>
    {
      compact ? (
        <>
          <ul class="isos">
            <DownloadRow which="standard" file={ISOS.vanilla} />
            <DownloadRow which="nvidia" file={ISOS.nvidia} />
          </ul>
          <p class="hint">
            Weekly · x86_64 · 5–6&nbsp;GB. Write it to a USB&nbsp;stick, boot, install. Checksummed
            and signed in the open — <a href="/install#iso">verify it</a>.
          </p>
        </>
      ) : (
        <p class="lede">
          A weekly installer ISO for each variant, checksummed and signed with the release key.{' '}
          <a href="#iso">Downloads and the verify command are below.</a>
        </p>
      )
    }
  </div>
</div>

<style>
  .install {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .path h3 {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    letter-spacing: var(--label-spacing);
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }
  .cmds {
    display: grid;
    gap: var(--space-md);
  }
  .cmds arc-code-block {
    display: block;
  }
  .isos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .hint {
    margin-top: var(--space-md);
    margin-bottom: 0;
  }
  @media (max-width: 56rem) {
    .install {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
