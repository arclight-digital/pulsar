#!/usr/bin/python3
"""Lay out a disk for Pulsar: the one step of an install that can destroy data.

    pulsar-install-disk plan  --mode erase|alongside [--no-encrypt] [IDENTITY] DISK
    pulsar-install-disk apply --mode erase|alongside --key-file FILE [IDENTITY] DISK
    pulsar-install-disk apply --mode erase|alongside --no-encrypt [IDENTITY] DISK

IDENTITY is --expect-size BYTES --expect-serial SERIAL: the disk the person
chose, as lsblk described it to the installer. DISK is only a name (/dev/sda),
and a name can come to mean another drive when one is unplugged and another
plugged in; with IDENTITY, the disk at DISK must still be that one, checked
before planning and again just before writing.

Both run systemd-repart from the layouts in /usr/share/pulsar/installer/repart:
an EFI system partition, a 2G /boot, and a btrfs root. With --key-file the
root is LUKS2, unlocked by the passphrase in FILE; with --no-encrypt it is
plain btrfs (the same layout with the root's Encrypt= line taken out). `apply`
needs exactly one of the two: there is no default, so an unencrypted install
is only ever one somebody asked for.

  erase      everything on DISK goes. The plan must create exactly those three
             partitions and nothing else.
  alongside  DISK keeps every partition it has. Pulsar goes into the free space
             and shares the existing EFI system partition. The plan must leave
             every existing partition unchanged, reuse an ESP rather than make
             one, and create only /boot and the root.

`apply` re-plans first and refuses unless the plan passes the same checks, so a
caller can't apply something it never saw. repart decides the layout; this
script decides whether that layout is one Pulsar is willing to write. Exit 0
prints the plan as JSON; exit 2 means refused, with the reason on stderr, and
nothing written; exit 3 means the write began and failed partway: the disk
has changed, and what is on it now is unknown.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile

LAYOUTS = os.environ.get("PULSAR_INSTALLER_LAYOUTS", "/usr/share/pulsar/installer/repart")
OURS = {"esp", "xbootldr", "root-x86-64"}
CREATED = {"erase": ["esp", "xbootldr", "root-x86-64"], "alongside": ["xbootldr", "root-x86-64"]}


class Refused(Exception):
    """Refused before writing anything: exit 2."""


class WriteFailed(Exception):
    """The write began and did not finish: exit 3."""


REFUSED, WRITE_FAILED = 2, 3


ROOT_CONF = "30-root.conf"
ENCRYPT_LINE = "Encrypt=key-file"


def definitions(mode, encrypt, scratch):
    """The layout directory repart reads. Encrypted: the shipped one, which
    must encrypt its root. Not: a copy in scratch whose root has its one
    Encrypt= line removed, checked to have none left."""
    shipped = os.path.join(LAYOUTS, mode)
    lines = open(os.path.join(shipped, ROOT_CONF)).read().splitlines(keepends=True)
    enc = [l for l in lines if l.strip().startswith("Encrypt=")]
    if [l.strip() for l in enc] != [ENCRYPT_LINE]:
        raise Refused(f"{mode}/{ROOT_CONF} should have exactly one {ENCRYPT_LINE} line, has {enc}")
    if encrypt:
        return shipped
    plain = os.path.join(scratch, mode)
    shutil.copytree(shipped, plain)
    with open(os.path.join(plain, ROOT_CONF), "w") as f:
        f.writelines(l for l in lines if not l.strip().startswith("Encrypt="))
    for name in os.listdir(plain):
        if any(l.strip().startswith("Encrypt=") for l in open(os.path.join(plain, name))):
            raise Refused(f"the unencrypted layout still encrypts {name}")
    return plain


def repart(mode, defs, disk, key_file, dry_run):
    cmd = [
        "systemd-repart",
        f"--definitions={defs}",
        f"--empty={'force' if mode == 'erase' else 'refuse'}",
        f"--dry-run={'yes' if dry_run else 'no'}",
        "--json=short",
        "--no-pager",
        # repart derives partition and LUKS UUIDs from the machine ID, which
        # every boot of one live ISO shares: without this, every install
        # from it had the same UUIDs
        "--seed=random",
    ]
    if key_file:
        cmd.append(f"--key-file={key_file}")
    cmd.append(disk)
    # repart TRIMs the new partitions itself, straight on the disk. Left to
    # its default, mkfs.btrfs then TRIMs the root a second time, through the
    # LUKS mapping and the loop device repart formats it on; on a block device
    # a loop device's TRIM becomes a write-zeroes, which some NVMe drives carry
    # out by writing. The suspect in installs that sat at "Partitioning and
    # encrypting the disk" for minutes on a 1 TB NVMe (2026-10-29); the disk
    # step's log, now shown and kept, says whether it was.
    env = dict(os.environ, SYSTEMD_REPART_MKFS_OPTIONS_BTRFS="--nodiscard")
    if not dry_run:
        # the real run says what it is doing as it goes (encrypting,
        # formatting): its log passes straight through to the caller, which
        # shows it, instead of arriving all at once when it ends
        r = subprocess.run(cmd, stdout=subprocess.PIPE, text=True, env=env)
        if r.returncode != 0:
            raise WriteFailed(f"systemd-repart exited {r.returncode}")
        try:
            return json.loads(r.stdout)
        except ValueError as e:
            raise WriteFailed(f"systemd-repart wrote the disk but its plan can't be read: {e}") from e
    r = subprocess.run(cmd, capture_output=True, text=True, env=env)
    if r.returncode != 0:
        why = r.stderr.strip().splitlines()
        raise Refused(why[0] if why else f"systemd-repart exited {r.returncode}")
    return json.loads(r.stdout)


def short_serial(serial):
    return f"serial ending {serial[-4:]}" if serial else "no serial number"


def same_disk(disk, size, serial):
    """Refuse unless the disk at DISK is the one the person chose: the same
    size in bytes and the same serial number (lsblk's, as the installer read
    them). A different drive at the same name is never written."""
    if size is None and serial is None:
        return
    r = subprocess.run(["lsblk", "-J", "-b", "-d", "-o", "SIZE,SERIAL", disk], capture_output=True, text=True)
    if r.returncode != 0:
        raise Refused(f"can't read {disk} to check it is the disk you chose: {r.stderr.strip()}")
    try:
        dev = json.loads(r.stdout)["blockdevices"][0]
        now_size, now_serial = int(dev.get("size") or 0), (dev.get("serial") or "").strip()
    except (ValueError, LookupError, TypeError) as e:
        raise Refused(f"can't read {disk} to check it is the disk you chose: {e}") from e
    if (size is not None and now_size != size) or (serial is not None and now_serial != serial.strip()):
        was = [f"{size} bytes" if size is not None else None, short_serial(serial.strip()) if serial is not None else None]
        raise Refused(f"{disk} is no longer the disk you chose: it was "
                      f"{', '.join(x for x in was if x)}, and is now {now_size} bytes, {short_serial(now_serial)}. "
                      "Was a disk unplugged or swapped?")


def check(mode, plan):
    """The whole safety argument. Each refusal names what it caught."""
    created = sorted(p["type"] for p in plan if p["activity"] == "create")
    if created != sorted(CREATED[mode]):
        raise Refused(f"plan would create {created}, expected {sorted(CREATED[mode])}")
    for p in plan:
        if p["activity"] not in ("create", "unchanged"):
            raise Refused(f"plan would {p['activity']} partition {p['type']} ({p['label']})")
    if mode == "erase":
        if any(p["type"] not in OURS for p in plan):
            raise Refused("an erase plan kept a partition that isn't Pulsar's")
        return
    esps = [p for p in plan if p["type"] == "esp"]
    if len(esps) != 1 or esps[0]["activity"] != "unchanged":
        raise Refused("installing alongside needs exactly one existing EFI system partition")
    if not any(p["type"] not in OURS for p in plan):
        raise Refused("nothing to install alongside: the disk has only EFI, boot and root partitions")


def main():
    ap = argparse.ArgumentParser(prog="pulsar-install-disk")
    ap.add_argument("action", choices=["plan", "apply"])
    ap.add_argument("--mode", required=True, choices=sorted(CREATED))
    secret = ap.add_mutually_exclusive_group()
    secret.add_argument("--key-file", help="encrypt the root with the passphrase in FILE")
    secret.add_argument("--no-encrypt", action="store_true", help="a plain, unencrypted root")
    ap.add_argument("--expect-size", type=int, help="refuse unless DISK is this many bytes")
    ap.add_argument("--expect-serial", help="refuse unless DISK has this serial number")
    ap.add_argument("disk")
    a = ap.parse_args()
    if a.action == "apply" and not (a.key_file or a.no_encrypt):
        ap.error("apply needs --key-file (encrypted) or --no-encrypt: there is no default")
    try:
        with tempfile.TemporaryDirectory(prefix="pulsar-layouts-") as scratch:
            defs = definitions(a.mode, not a.no_encrypt, scratch)
            same_disk(a.disk, a.expect_size, a.expect_serial)
            plan = repart(a.mode, defs, a.disk, a.key_file, dry_run=True)
            check(a.mode, plan)
            if a.action == "apply":
                # again, just before writing: planning takes seconds, and a
                # drive can be swapped in them
                same_disk(a.disk, a.expect_size, a.expect_serial)
                plan = repart(a.mode, defs, a.disk, a.key_file, dry_run=False)
    except Refused as e:
        print(f"pulsar-install-disk: refused: {e}", file=sys.stderr)
        return REFUSED
    except WriteFailed as e:
        print(f"pulsar-install-disk: failed while writing the disk: {e}", file=sys.stderr)
        return WRITE_FAILED
    json.dump(plan, sys.stdout, indent=1)
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
