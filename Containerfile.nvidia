ARG FEDORA_VERSION=44
# Default base is the CI-built, attested image from ghcr. Override with
# BASE_IMAGE=localhost/pulsar to test against a local vanilla build.
ARG BASE_IMAGE=ghcr.io/arclight-digital/pulsar
FROM ${BASE_IMAGE}:${FEDORA_VERSION}

# ===========================================================================
# Pulsar + NVIDIA.
#
# The only artifact whose build NEEDS a Secure Boot signature -- and it is
# safe to publish, because the private key is never here. It stays on the
# signer host; phase 3 sends each module out and attaches the signature that
# comes back. What ships is the signed module plus the PUBLIC cert. The only
# secret this build holds is a bearer token, which buys an attacker
# signatures while they hold it, and nothing after it is revoked.
#
# NEVER install akmods-keys here. That RPM contains the private key itself,
# and installing it would put the key in a published layer. This is the one
# rule that actually matters in this file.
#
# RTX 5080 is Blackwell (GB203); the closed kmod does not support it, so
# nvidia-open is not a preference, it is the only option. It is also MIT/
# GPLv2 dual-licensed, which is why the interesting half of this image is
# open source and only the userspace is proprietary.
# ===========================================================================

# Phase 1: build toolchain, and neutralize the on-install build hook.
#
# akmod-nvidia-open's %post runs:
#     [ -x /usr/sbin/akmods-ostree-post ] && /usr/sbin/akmods-ostree-post ...
# and akmods-ostree-post calls akmodsbuild DIRECTLY as root -- no runuser,
# unlike /usr/bin/akmods which does drop privileges. akmodsbuild refuses to
# run anywhere `[[ -w /var ]]` is true, which is always the case for root in
# a container build. The scriptlet fails and dnf5 fails the whole transaction.
#
# Making the hook non-executable turns that `[ -x ] &&` into a clean no-op.
# We drive the build ourselves in phase 3. Restored at the end of this file.
# gcc-c++, elfutils-libelf-devel and the download command are here because
# phase 2 installs the akmod WITHOUT depsolving (see below) -- its build
# deps have to arrive explicitly.
# The koji fallback exists because the Fedora container compose can be AHEAD
# of the mirrors: the base image ships a kernel whose kernel-devel hasn't hit
# updates (or even updates-archive) metadata yet. Koji serves every RPM the
# moment it is built, no mirror sync involved, so a nightly landing in that
# window still builds.
RUN KV=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core) && \
    VER=$(rpm -q --qf '%{VERSION}' kernel-core) && \
    REL=$(rpm -q --qf '%{RELEASE}' kernel-core) && \
    echo "building against kernel ${KV}" && \
    { dnf5 install -y --enablerepo=updates-archive kernel-devel-${KV} akmods \
        gcc-c++ elfutils-libelf-devel 'dnf5-command(download)' || \
      { echo "kernel-devel ${KV} not on mirrors yet; fetching from koji directly" && \
        KOJI="https://kojipkgs.fedoraproject.org/packages/kernel/${VER}/${REL}/x86_64" && \
        curl -fL -o /tmp/kernel-devel.rpm "${KOJI}/kernel-devel-${KV}.rpm" && \
        curl -fL -o /tmp/kernel-devel-matched.rpm "${KOJI}/kernel-devel-matched-${KV}.rpm" && \
        dnf5 install -y /tmp/kernel-devel.rpm /tmp/kernel-devel-matched.rpm akmods \
          gcc-c++ elfutils-libelf-devel 'dnf5-command(download)' && \
        rm -f /tmp/kernel-devel*.rpm; }; } && \
    chmod -x /usr/sbin/akmods-ostree-post

# Phase 2: the akmod source package. Its %post is now inert.
#
# NOT `dnf5 install`. akmod-nvidia-open grew a hard Requires on
# nvidia-open-kmod-common, which only xorg-x11-drv-nvidia provides, which
# itself hard-requires nvidia-kmod -- and pre-build, the only providers of
# THAT are the closed prebuilt kmod or akmod-nvidia. Depsolving here is
# circular by construction, and when updates carry a newer closed akmod than
# -open (true right now: closed 610 vs -open 595), dnf "resolves" it by
# installing closed akmod-nvidia 610 plus a downgraded -open -- the exact
# poison phase 4 documents. So: fetch the bare RPM, install it dep-free.
# Its real build-time needs came in phase 1; the userspace dep heals in
# phase 4.
# --noscripts: the akmod's %post only invokes the hook phase 1 neutralized,
# so under dnf5 it "failed" as a tolerated non-critical error -- but plain
# rpm turns a failing scriptlet into a failing install. Skip it; phase 3 is
# the build.
# updates-testing, reluctantly: this image's kernel (7.1.x) dropped headers
# that nvidia-open <= 595 still includes (of_gpio.h), so stable's -open akmod
# cannot compile at all. The matching >= 610 -open build currently sits in
# updates-testing only. dnf picks the newest candidate across both repos, so
# this line keeps working -- and can lose the --enablerepo -- once it lands
# in stable.
RUN dnf5 download --enablerepo=rpmfusion-nonfree-updates-testing \
      --destdir /tmp/akmod-rpm akmod-nvidia-open && \
    rpm -Uvh --nodeps --noscripts /tmp/akmod-rpm/akmod-nvidia-open-*.rpm && \
    rm -rf /tmp/akmod-rpm

# Phase 3: build and sign, as the akmods user.
#
# The private key is NOT here. It stays on the signer host; this build sends
# each module out and gets a detached signature back. scripts/sign-file-oracle
# stands in for the kernel's scripts/sign-file, which is where signing already
# happened: kmodtool's %__kmodtool_modsign_install_post runs brp-kmodsign,
# which walks the buildroot and signs every uncompressed .ko before the RPM
# compresses them to .ko.xz. Swapping that one binary is the whole change --
# no forked akmods, no unpacking the built RPM, no rpmdb digest drift.
#
# The placeholder private key is load-bearing, unfortunately. That macro
# guards on `[ -e privkey ] && [ -e pubkey ]` and SILENTLY SKIPS signing when
# either is missing -- no error, just unsigned modules. So a file has to exist
# at the path akmods configures, even though nothing reads it. Phase 5 is what
# catches this if it ever regresses, which is why it is not optional.
#
# The cert comes from the signer rather than from the committed MOK.der. It
# has to: sign-file takes the signer identifier from whatever cert it is
# handed, so passing the committed cert would make phase 5 compare MOK.der
# against itself and pass even if the signer held a completely different key.
# Fetched, it asserts the signing key's cert IS the one users are told to
# enrol.
#
# The secrets are mounted at neutral paths and copied to akmods-owned files,
# because akmodsbuild runs unprivileged and cannot read a root-only mount.
# The copies are removed inside this same RUN, so they never reach the layer.
#
# The built kmod installs with --nodeps for the same reason phase 2 does:
# it now Requires nvidia-open-kmod-common (userspace), and userspace requires
# nvidia-kmod (this kmod) -- the two only close as a pair. Phase 4 installs
# the userspace half and heals this immediately; scriptlets stay ON here
# because the kmod's %post runs depmod, which we want.
#
# TRANSPORT TRUST IS NOT AMBIENT HERE. The signer serves TLS with a private,
# self-signed certificate -- it lives on a VPC address that no public CA will
# ever issue for. The build HOST is given that certificate, but this RUN is a
# container built from the Silverblue base with its own CA bundle, so nothing
# in here has heard of it: curl exits 60, "self-signed certificate", forty
# minutes into a build. The cert is mounted in and passed explicitly.
#
# It is a PUBLIC certificate, not a secret. It travels as a secret mount only
# because that is the mechanism that takes an absolute host path without
# dragging it into the build context or leaving it in a layer.
#
# Never -k. This connection carries the bearer token that buys kernel module
# signatures; accepting any certificate on it is the one shortcut that turns a
# private signer into an open one.
ARG PULSAR_SIGNER_URL
RUN --mount=type=secret,id=signer_token,target=/run/secrets/signer_token \
    --mount=type=secret,id=signer_ca,target=/run/secrets/signer_ca \
    --mount=type=bind,source=scripts/sign-file-oracle,target=/run/sign-file-oracle \
    set -eu; \
    test -n "${PULSAR_SIGNER_URL}" || { echo "FATAL: PULSAR_SIGNER_URL is unset; the build cannot sign"; exit 1; }; \
    KV=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core); \
    chmod 755 /var; \
    install -d -o akmods -g akmods /tmp/akmod-out; \
    install -o akmods -g akmods -m 0400 /run/secrets/signer_token \
        /etc/pki/akmods/signer-token; \
    CA=; \
    if [ -s /run/secrets/signer_ca ]; then \
      install -o akmods -g akmods -m 0444 /run/secrets/signer_ca \
          /etc/pki/akmods/signer-ca.pem; \
      CA=/etc/pki/akmods/signer-ca.pem; \
    fi; \
    printf 'placeholder: the private key lives on the signer host.\n' \
        > /etc/pki/akmods/private/private_key.priv; \
    chown akmods:akmods /etc/pki/akmods/private/private_key.priv; \
    curl -fsS --max-time 60 ${CA:+--cacert "${CA}"} \
        -H "Authorization: Bearer $(cat /run/secrets/signer_token)" \
        "${PULSAR_SIGNER_URL%/}/cert" \
        -o /etc/pki/akmods/certs/public_key.der; \
    test -s /etc/pki/akmods/certs/public_key.der; \
    chown akmods:akmods /etc/pki/akmods/certs/public_key.der; \
    chmod 0444 /etc/pki/akmods/certs/public_key.der; \
    mv "/usr/src/kernels/${KV}/scripts/sign-file" \
       "/usr/src/kernels/${KV}/scripts/sign-file.real"; \
    install -m 0755 /run/sign-file-oracle "/usr/src/kernels/${KV}/scripts/sign-file"; \
    runuser -s /bin/bash -c \
      "PULSAR_SIGNER_URL='${PULSAR_SIGNER_URL}' \
       PULSAR_SIGNER_TOKEN_FILE=/etc/pki/akmods/signer-token \
       PULSAR_SIGNER_CA_FILE='${CA}' \
       akmodsbuild --kernels ${KV} --outputdir /tmp/akmod-out \
       /usr/src/akmods/nvidia-open-kmod-*.src.rpm" akmods; \
    rm -f /etc/pki/akmods/private/private_key.priv \
          /etc/pki/akmods/certs/public_key.der \
          /etc/pki/akmods/signer-token \
          /etc/pki/akmods/signer-ca.pem \
          "/usr/src/kernels/${KV}/scripts/sign-file"; \
    mv "/usr/src/kernels/${KV}/scripts/sign-file.real" \
       "/usr/src/kernels/${KV}/scripts/sign-file"; \
    rpm -Uvh --nodeps $(find /tmp/akmod-out -name 'kmod-nvidia-open-*.rpm' ! -name '*debug*'); \
    rm -rf /tmp/akmod-out

# Phase 4: userspace.
#
# ORDER MATTERS, and so does the shim. xorg-x11-drv-nvidia hard-requires
# `nvidia-kmod`, and as of 610.57.04 NOTHING in the -open family provides it
# any more -- not the akmod, and not even the built kmod, which now provides
# only nvidia-open-kmod. The only repo providers are the closed akmod-nvidia
# / kmod-nvidia, which is exactly what must never land here: the closed kmod
# does not support Blackwell, and the akmod collision is how earlier builds
# silently downgraded -open (see phase 2). So the requirement is satisfied
# by assertion: an empty shim RPM, built on the spot, Provides nvidia-kmod
# at the pinned version on behalf of the real, signed nvidia-open module
# phase 3 already installed.
#
# --exclude makes a closed-akmod regression fail loudly instead of silently.
# Userspace is pinned to the akmod's exact epoch:version, because anything
# newer would require a newer nvidia-kmod than the shim asserts. Unpinned,
# this breaks the moment rpmfusion updates userspace ahead of -open.
# updates-testing here matches phase 2: the pin follows whatever version the
# akmod came from, and while that is a testing-only version its userspace is
# too.
RUN NVVER=$(rpm -q --qf '%{EPOCH}:%{VERSION}' akmod-nvidia-open) && \
    echo "pinning userspace to ${NVVER}" && \
    mkdir -p /tmp/shim && \
    printf '%s\n' \
      "Name: pulsar-nvidia-kmod-shim" \
      "Epoch: ${NVVER%%:*}" \
      "Version: ${NVVER#*:}" \
      "Release: 0" \
      "Summary: Provides nvidia-kmod on behalf of the signed nvidia-open kmod" \
      "License: MIT" \
      "BuildArch: noarch" \
      "Provides: nvidia-kmod = ${NVVER}" \
      "%description" \
      "Stand-in provide for the kmod-nvidia-open built and signed in this image." \
      "%files" > /tmp/shim/shim.spec && \
    rpmbuild -bb --define '_topdir /tmp/shim/rpmbuild' /tmp/shim/shim.spec && \
    dnf5 install -y --exclude=akmod-nvidia \
      --enablerepo=rpmfusion-nonfree-updates-testing \
      /tmp/shim/rpmbuild/RPMS/noarch/pulsar-nvidia-kmod-shim-*.rpm \
      "xorg-x11-drv-nvidia-${NVVER}*" \
      "xorg-x11-drv-nvidia-cuda-${NVVER}*" \
      "xorg-x11-drv-nvidia-power-${NVVER}*" \
      "nvidia-settings-${NVVER}*" \
      libva-nvidia-driver && \
    rm -rf /tmp/shim

# Phase 5: verify. Its own step so the message cannot lie about which failure
# occurred -- an earlier version chained this onto the build with && and
# reported "unsigned" for what was actually a failed dnf transaction.
#
# "Signed by something" is not the check that matters. What matters is that
# it was signed by the key whose PUBLIC cert this image tells the user to
# enroll (/etc/pki/pulsar/MOK.der). If those drift apart -- someone
# regenerates the akmods key and forgets to update the committed cert -- the
# user enrolls a cert that did not sign the module and Secure Boot rejects
# it at boot, which is exactly the black screen this phase exists to prevent.
# Comparing the module's sig_key against the cert catches that at build time.
#
# sig_key is whichever signer identifier sign-file embedded, and that is NOT
# always the Subject Key Identifier -- with the issuerAndSerialNumber form it
# is the cert's SERIAL. Accept either, or this rejects perfectly good builds.
# All values normalized to bare uppercase hex before comparing.
RUN KV=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core) && \
    KO="/lib/modules/${KV}/extra/nvidia-open/nvidia.ko.xz" && \
    { [ -f "$KO" ] || { echo "FATAL: ${KO} was never built"; exit 1; }; } && \
    SIGNER=$(modinfo -F signer "$KO") && \
    { [ -n "$SIGNER" ] || { echo "FATAL: nvidia.ko is unsigned; would black-screen under Secure Boot"; exit 1; }; } && \
    echo "nvidia.ko signed by: ${SIGNER}" && \
    SIGKEY=$(modinfo -F sig_key "$KO" | tr -d ': ' | tr 'a-f' 'A-F') && \
    CERT=/etc/pki/pulsar/MOK.der && \
    SERIAL=$(openssl x509 -inform der -in "$CERT" -noout -serial \
             | cut -d= -f2 | tr -d ': ' | tr 'a-f' 'A-F') && \
    SKI=$(openssl x509 -inform der -in "$CERT" -noout -ext subjectKeyIdentifier \
          | tail -n1 | tr -d ': ' | tr 'a-f' 'A-F') && \
    { [ -n "$SIGKEY" ] && [ -n "${SERIAL}${SKI}" ] || { echo "FATAL: could not read module sig_key or read ${CERT}"; exit 1; }; } && \
    { [ "$SIGKEY" = "$SERIAL" ] || [ "$SIGKEY" = "$SKI" ] || { \
        echo "FATAL: nvidia.ko was signed by key id ${SIGKEY}, which is neither the"; \
        echo "       serial (${SERIAL}) nor the SKI (${SKI}) of the cert this image"; \
        echo "       ships at ${CERT}. Enrolling that cert would NOT authorize this"; \
        echo "       module -- Secure Boot would refuse it. Update the committed cert."; exit 1; }; } && \
    echo "signing key matches the shipped MOK.der (${SIGKEY})" && \
    { rpm -q akmod-nvidia >/dev/null 2>&1 && { echo "FATAL: closed akmod-nvidia got pulled in"; exit 1; } || true; }

# Restore the hook so the shipped image matches stock Fedora behaviour.
RUN chmod +x /usr/sbin/akmods-ostree-post

# ---------------------------------------------------------------------------
# NVIDIA-specific overlay, then a second initramfs regen -- nvidia-pulsar.conf
# sets modprobe options that live in the initramfs, and the vanilla image's
# dracut run happened before this file existed.
# ---------------------------------------------------------------------------
COPY system_files.nvidia/ /

# --add ostree + assertion: same boot-critical reason as the base image's
# dracut run (see Containerfile) -- in a container dracut cannot tell it is
# building for an ostree system and silently drops the module that makes
# switch-root possible. /var/roothome and the log grep for the same reasons
# too: /var is empty HERE by the vanilla image's own cleanup, so /root is a
# dangling ostree symlink, and dracut logs module-install failures as
# dracut[E]: FAILED while exiting 0.
#
# DRACUT_NO_XATTR=1 for the same reason as well, and it belongs on BOTH runs:
# there are two dracut invocations in this build and fixing only the vanilla
# one bought a green vanilla image and a red nvidia one an hour later. The
# reasoning is written out in full next to the base image's run; the short
# version is that podman mounts the rootfs with a single mount-wide
# context=, so setxattr(security.selinux) answers EOPNOTSUPP and the copy
# dracut shells out to exits 1.
RUN KV=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core) && \
    install -d -m 0700 /var/roothome && \
    { DRACUT_NO_XATTR=1 dracut --force --no-hostonly --reproducible --add ostree \
        --kver ${KV} /usr/lib/modules/${KV}/initramfs.img >/tmp/dracut.log 2>&1 || \
      { cat /tmp/dracut.log; echo "FATAL: dracut exited nonzero"; exit 1; }; }; \
    cat /tmp/dracut.log; \
    if grep -q 'dracut\[E\]: FAILED' /tmp/dracut.log; then \
      echo "FATAL: dracut logged a module-install failure above and exited 0 anyway"; \
      exit 1; \
    fi; \
    lsinitrd /usr/lib/modules/${KV}/initramfs.img | grep -q ostree-prepare-root || \
      { echo "FATAL: initramfs is missing ostree-prepare-root; the image cannot switch root"; exit 1; }

# Same rule as the base image: /var is machine-local, ship it empty (plus
# the same sticky /var/tmp the base restores -- see Containerfile).
RUN dnf5 clean all && \
    rm -rf /tmp/* /var/* && \
    install -d -m 1777 /var/tmp && \
    bootc container lint

# The version stamp itself lives in the base image's /usr/lib/os-release, which
# this image inherits, so PRETTY_NAME and the boot entry are already correct
# here. Only the OCI label has to be restated -- labels do not inherit through
# FROM -- so that `bootc status` reports the same version for either variant.
ARG PULSAR_VERSION=""
LABEL org.opencontainers.image.version="${PULSAR_VERSION}"

# Manifest: inherited from the base image, then corrected for this variant.
# `pulsar doctor` reads .variant to decide whether a missing nvidia module is
# a failure or the expected state, and .nvidia_driver to notice when the
# running driver has drifted from what the image shipped -- so both have to be
# right here rather than describing the vanilla image this derives from.
#
# `rpm -qa` with globs, never `rpm -q <name>`, for two reasons that combined
# into a manifest reading `nvidia_driver: "package kmod-nvidia-open is not
# installed"`. First, kmod packages carry the kernel version IN the package
# name -- the installed one is kmod-nvidia-open-7.1.5-201.fc44.x86_64-610...
# so a bare `rpm -q kmod-nvidia-open` never matches. Second, rpm prints that
# "is not installed" line on STDOUT and exits 1, so `$(rpm -q ... || fallback)`
# captures the error text as the value. `rpm -qa` prints nothing and exits 0
# when a glob matches nothing, which is the behaviour a capture wants.
#
# Asserted, not defaulted: a nvidia image that cannot name its own driver
# should fail the build. Shipping "unknown" would make doctor warn on every
# single run -- comparing /sys/module/nvidia/version against garbage -- and a
# permanent false warning is how a health tool teaches you to ignore it.
RUN drv=$(rpm -qa --qf '%{VERSION}\n' 'kmod-nvidia-open*' 'akmod-nvidia-open' \
            2>/dev/null | sort -u | head -1); \
    case "${drv}" in \
      '' ) echo "FATAL: no kmod-nvidia-open/akmod-nvidia-open package found"; \
           rpm -qa | grep -i nvidia || true; exit 1 ;; \
      *[!0-9.]* ) echo "FATAL: nvidia driver version '${drv}' is not version-shaped"; \
           exit 1 ;; \
    esac; \
    echo "nvidia driver: ${drv}"; \
    jq --arg v "nvidia-open" --arg d "${drv}" \
       '.image = "pulsar-nvidia" | .variant = $v | .nvidia_driver = $d' \
       /usr/share/pulsar/manifest.json > /tmp/m.json && \
    mv /tmp/m.json /usr/share/pulsar/manifest.json && \
    jq -e '.variant == "nvidia-open" and (.nvidia_driver | test("^[0-9]+(\\.[0-9]+)+$"))' \
       /usr/share/pulsar/manifest.json >/dev/null && \
    cat /usr/share/pulsar/manifest.json
