---
// The hero: the mark, the wordmark, the tagline, and the one command. Its
// background is assets/shaders/pulsar.frag -- the same shader that renders
// the OS wallpapers -- running live in WebGL; src/scripts/sky.ts compiles it.
//
// The wordmark wears ARC's hero device: a blurred bloom twin behind it,
// breathing on the hero's own glow knob so the light theme stays calm. The
// wordmark itself stays solid star -- the brand draws it that way.
import Sky from './Sky.astro';
import { version } from '../data/build';
import { IMAGES, REPO } from '../data/site';

const switchTo = (image: string) => `sudo bootc switch ${image}:latest`;
---

<header class="hero">
  <Sky />

  <div class="inner">
    {/* data-spin is the easter egg's hook -- see src/scripts/spin.ts */}
    <img
      data-mark
      data-spin
      class="mark"
      src="/assets/pulsar-animated.svg"
      alt=""
      width="180"
      height="180"
    />
    <h1 class="wordmark">
      <span class="glow-wrap">
        <span class="word">PULSAR</span>
        <span class="word word-shadow" aria-hidden="true">PULSAR</span>
      </span>
    </h1>
    <p class="tagline">Your lighthouse in the sky.</p>
    <p class="sub">
      <span class="sent">An immutable Fedora for gaming and development.</span> Games get the
      panel&rsquo;s real resolution instead of a fractional-scaled one, the system is the same
      every&nbsp;boot, and rollback is just a&nbsp;reboot.
    </p>

    {/* The one number that proves the nightly is real, worn in the hero. It
        comes from the manifest the build host committed, so the chip, the
        manifest card and the changelog cannot name different builds -- until
        src/scripts/beacon.ts asks the build host what it has shipped since. */}
    <p class="buildline mono">
      <a class="build-chip" href="#changelog" id="build-chip">
        <span class="build-dot" aria-hidden="true"></span>
        latest build <strong id="build-version" data-build-version>{version}</strong>
      </a>
    </p>
    {/* Empty and hidden in the served HTML: with no beacon there is nothing
        to add, and the page keeps the build it was rendered from. */}
    <p class="buildnote hint" id="build-note" hidden></p>

    <div class="cmds">
      <arc-code-block
        class="theme-fixed-dark"
       
        language="bash"
        filename="standard"
        code={switchTo(IMAGES.vanilla)}
      ></arc-code-block>
      <arc-code-block
        class="theme-fixed-dark"
       
        language="bash"
        filename="nvidia"
        code={switchTo(IMAGES.nvidia)}
      ></arc-code-block>
    </div>

    <div class="actions">
      <arc-button href="/install" variant="primary" size="lg">Install</arc-button>
      <arc-button href="#changelog" variant="secondary" size="lg">What changed last night</arc-button>
      <a class="srclink" href={REPO}>Browse the source&nbsp;→</a>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: url('/assets/silk-still-dark.jpg') center / cover no-repeat var(--ink);
    color: var(--star);
    --glow-a: 1;
  }
  :global(:root[data-theme='light']) .hero {
    background-image: url('/assets/silk-still-light.jpg');
    color: var(--deep);
    --glow-a: 0.4;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .hero {
      background-image: url('/assets/silk-still-light.jpg');
      color: var(--deep);
      --glow-a: 0.4;
    }
  }

  .inner {
    position: relative;
    width: min(100% - 2 * var(--space-lg), 44rem);
    min-width: 0;
    /* the fixed bar above; below, room for the look picker pinned to the
       hero's bottom edge, which is absolutely positioned and would otherwise
       land on the buttons whenever the content outgrows the viewport */
    padding: var(--space-3xl) 0 calc(var(--space-3xl) + 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .mark {
    display: block;
    height: 180px;
    width: 180px;
    margin-bottom: var(--space-lg);
  }

  /* Easter egg: the mark takes a flick and spins down like a flywheel. The
     core sits dead centre and the arc is the only asymmetric part of the cut,
     so rotating the whole image reads as the arc orbiting the core.
     A WHOLE number of turns, so it comes to rest exactly where it started.

     The curve is the decay, and it was picked against numbers rather than by
     eye: it opens at ~3.6 turns/s (21 degrees a frame at 60fps -- fast, but
     short of the speed where a 145-segment arc starts to strobe), is about
     half way round after a second, and is still turning at 0.34 turns/s at
     3.5s. An ordinary ease-out spends ~80% of the travel in the first second
     and then creeps invisibly, which reads as a stall, not a decay.

     --spin-from lets a second click pick up from wherever the mark has got
     to instead of snapping back to zero; spin.ts sets it.

     The target is ABSOLUTE rather than --spin-from plus four turns, and that
     matters: a finished animation with no fill-mode leaves the mark at an
     untransformed 0deg. Landing on 1440deg -- a whole number of turns from
     zero, whatever angle the flick started at -- is what makes that handover
     invisible. A relative target would end at --spin-from and visibly snap. */
  .mark.is-spinning {
    animation: flywheel 4s cubic-bezier(0.07, 0.28, 0.45, 0.9);
  }
  @keyframes flywheel {
    from {
      transform: rotate(var(--spin-from, 0deg));
    }
    to {
      transform: rotate(1440deg);
    }
  }

  .wordmark {
    margin: 0 0 var(--space-sm);
    line-height: 1;
  }
  .glow-wrap {
    position: relative;
    display: block;
  }
  .word {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    line-height: 1;
    z-index: 1;
  }
  /* ARC's hero device: the word the page is named for emits. A blurred bloom
     twin behind the wordmark -- hot white core, accent halo, wide secondary
     falloff. Copied from arcui.dev's own headline. */
  .word-shadow {
    position: absolute;
    inset: 0;
    color: transparent;
    text-shadow:
      0 0 14px rgba(255, 255, 255, calc(0.2 * var(--glow-a))),
      0 0 32px rgba(var(--accent-primary-rgb), calc(0.38 * var(--glow-a))),
      0 0 70px rgba(var(--accent-primary-rgb), calc(0.26 * var(--glow-a))),
      0 0 130px rgba(var(--accent-secondary-rgb), calc(0.22 * var(--glow-a)));
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
    user-select: none;
    animation: breathe 5s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    from {
      opacity: 0.62;
    }
    to {
      opacity: 0.88;
    }
  }

  .tagline {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0 0 var(--space-md);
  }
  .sub {
    max-width: 52ch;
    font-size: var(--text-lg);
    line-height: var(--body-lh);
    opacity: 0.9;
    margin: 0 0 var(--space-lg);
  }

  .buildline {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }
  .build-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md) var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
    background: var(--chip);
    border: 1px solid var(--chip-line);
    color: var(--star);
    text-decoration: none;
    transition: box-shadow 0.2s var(--ease-out);
  }
  .build-chip:hover {
    box-shadow: var(--glow-hover);
  }
  .build-chip strong {
    font-weight: var(--font-mono-weight);
    color: var(--cyan);
  }
  .build-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--cyan);
    box-shadow: var(--glow-sm);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  .build-chip[data-stale] .build-dot {
    animation: none;
    background: var(--text-ghost);
    box-shadow: none;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  .buildnote {
    margin: var(--space-sm) 0 0;
    color: inherit;
    opacity: 0.8;
  }

  .cmds {
    width: 100%;
    min-width: 0;
    max-width: 40rem;
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-xl) 0 var(--space-lg);
    text-align: left;
  }
  .cmds arc-code-block {
    display: block;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .srclink {
    color: inherit;
    opacity: 0.85;
  }
  .srclink:hover {
    opacity: 1;
  }

  /* The belt to spin.ts's braces: the script never adds the class under
     reduced motion, and if it somehow did, this refuses to run it. */
  @media (prefers-reduced-motion: reduce) {
    .build-dot,
    .word-shadow,
    .mark.is-spinning {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .mark {
      height: 128px;
      width: 128px;
    }
    .inner {
      padding-bottom: calc(var(--space-2xl) + 5rem);
    }
  }
</style>
