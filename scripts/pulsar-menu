#!/usr/bin/python3
"""pulsar-menu -- apps, files and Pulsar's own actions, one search away
(Super+Space, or Super+/ in an account with several keyboard layouts).

Type to filter, Up/Down to choose, Enter to run, Esc to close. Pressing the
shortcut again also closes it. Ctrl+Enter on a file shows it in its folder.

  - apps, by name or what they are for, as GNOME's own search finds them
  - files and folders in your home, by name, from GNOME's file index
    (LocalSearch: nothing is indexed twice); off when file search is off in
    Settings > Search
  - sums, conversions, currency and dates typed into the search: "2^10",
    "15% of 80", "5 mi in km", "255 in hex", "100 usd in eur",
    "days until dec 25", "in 90 days"; Enter copies the answer
  - copy text or a QR code from the screen (pulsar-screen)
  - themes (the picker, or the next one)
  - updates and agent sessions in Pulsar Settings, and each running session
  - a health check, a checkpoint before a risky change, asking your agent

Commands that print run in a new terminal window that stays open; a
checkpoint asks for your password there, never here.
"""
import ast
import json
import math
import operator
import os
import re
import subprocess
import sys

PULSAR = os.environ.get("PULSAR_CLI", "/usr/bin/pulsar")
LIBEXEC = os.environ.get("PULSAR_LIBEXEC", "/usr/libexec/pulsar")
AGENT_NAMES = {"claude": "Claude Code", "codex": "Codex CLI", "gemini": "Gemini CLI",
               "opencode": "opencode", "aider": "aider"}


def terminal(*argv, hold=True):
    """A new Ptyxis window running argv. hold: it waits for a key afterwards,
    so what it printed can be read."""
    if hold:
        script = '"$@"; echo; read -rsn1 -p "Press any key to close this window."'
        return ["ptyxis", "--new-window", "--", "bash", "-c", script, "pulsar-menu", *argv]
    return ["ptyxis", "--new-window", "--", *argv]


class Item:
    def __init__(self, key, title, subtitle, icon, argv, words="", group=""):
        self.key, self.title, self.subtitle, self.icon, self.argv = key, title, subtitle, icon, argv
        self.group = group
        self.haystack = " ".join((title, subtitle, words)).lower()
        self.accel = ""
        # runs only once the menu is off the screen: the screen readers, whose
        # screenshot would otherwise catch the menu fading out over the text
        self.settle = False
        self.gicon = None       # an app's or a file's own icon, in place of icon
        self.full_color = False # an app icon: shown as it is, not in a tile
        self.launch = None      # launch(context) in place of argv: apps and files
        self.reveal = None      # a file's URI: Ctrl+Enter shows it in its folder

    def matches(self, query):
        return all(w in self.haystack for w in query.lower().split())


# how long the menu is gone before a screen reader starts: GNOME's
# close animation is 150 ms, and its screenshot UI freezes the frame it opens on
SETTLE_MS = 300


def base_items():
    items = [
        Item("screen-text", "Copy text from the screen", "Pick an area; its text goes on the clipboard",
             "edit-copy-symbolic", [f"{LIBEXEC}/pulsar-screen", "text"], "ocr read recognize screenshot", "Screen"),
        Item("screen-qr", "Read a QR code", "Pick an area with a QR code; what it says goes on the clipboard",
             "camera-photo-symbolic", [f"{LIBEXEC}/pulsar-screen", "qr"], "qr code barcode scan link url", "Screen"),
        Item("themes", "Themes", "Switch the whole desktop's colors",
             "applications-graphics-symbolic", [f"{LIBEXEC}/pulsar-theme-picker"],
             "theme color colour palette dark light wallpaper look appearance", "Look"),
        Item("theme-next", "Next theme", "Try the next theme in the list",
             "media-skip-forward-symbolic", [PULSAR, "theme", "next"], "theme color colour cycle", "Look"),
        Item("sessions", "Agent sessions", "The coding agents running in sessions, in Pulsar Settings",
             "utilities-terminal-symbolic", [f"{LIBEXEC}/pulsar-settings", "agents"],
             "agent claude codex tmux session usage undo", "Agents"),
        Item("updates", "Updates", "Check for a new Pulsar image, in Pulsar Settings",
             "software-update-available-symbolic", [f"{LIBEXEC}/pulsar-settings", "updates"],
             "update upgrade version release", "System"),
        Item("doctor", "Health check", "Run pulsar doctor in a terminal",
             "emblem-ok-symbolic", terminal(PULSAR, "doctor"), "doctor health status problem broken check", "System"),
        Item("checkpoint", "Make a checkpoint", "Snapshot /etc and your settings before a risky change (asks for your password)",
             "document-save-symbolic", terminal("sudo", PULSAR, "checkpoint"),
             "checkpoint snapshot backup restore undo etc", "System"),
        Item("settings", "Pulsar Settings", "Appearance, updates and agents",
             "preferences-system-symbolic", [f"{LIBEXEC}/pulsar-settings"], "settings preferences options", "System"),
    ]
    for it in items:
        it.settle = it.key in ("screen-text", "screen-qr")
    return items


def session_items(sessions):
    """One item per session that is running or waiting, from
    `pulsar agent sessions --json`; waiting ones first."""
    out = []
    live = [s for s in sessions if s.get("state") in ("running", "waiting") and s.get("agent")]
    for s in sorted(live, key=lambda s: (s["state"] != "waiting", s["name"])):
        agent = AGENT_NAMES.get(s["agent"], s["agent"])
        where = (s.get("dir") or "").replace(os.environ.get("HOME", "\0"), "~", 1)
        state = "Waiting for you" if s["state"] == "waiting" else "Running"
        out.append(Item(f"session:{s['name']}", f"Open session “{s['name']}”",
                        " · ".join(x for x in (agent, state, where) if x),
                        "utilities-terminal-symbolic",
                        terminal(PULSAR, "agent", "run", s["agent"], "--tmux", s["name"], hold=False),
                        f"agent session tmux attach {s['agent']}", "Agents"))
    return out


def round_half_away(v):
    """round() as a calculator does it: 2.5 is 3 and -2.5 is -3 (Python's
    own round goes to the even one, so 2.5 would be 2)."""
    import decimal
    if isinstance(v, int):
        return v
    if not math.isfinite(v):
        raise ValueError("not a number")
    return int(decimal.Decimal(v).to_integral_value(rounding=decimal.ROUND_HALF_UP))


# Arithmetic typed into the search: parsed, never eval'd. Numbers (0x1f in
# hex too), + - * / // and ^ or ** for powers, % for the remainder (10 % 3),
# x between numbers, parentheses, a few names and functions; "15% of 80",
# "80 + 15%"; "5 mi in km", "100 f in c", "2 GiB in MB"; "255 in hex", and
# "0xff" alone in decimal. Real answers only: (-8)^(1/3) is none.
CALC_NAMES = {"pi": math.pi, "e": math.e, "tau": math.tau}
CALC_FUNCS = {"sqrt": math.sqrt, "abs": abs, "round": round_half_away, "floor": math.floor, "ceil": math.ceil,
              "log": math.log10, "ln": math.log, "sin": math.sin, "cos": math.cos, "tan": math.tan}
# longer than any sum anyone types: a paste of a page is a search, and parsing
# thousands of brackets runs the parser out of memory
CALC_MAX = 200
# what working a sum out can raise: any of them means "not a sum"
CALC_ERRORS = (SyntaxError, ValueError, TypeError, ZeroDivisionError, OverflowError, RecursionError,
               MemoryError)
CALC_OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
            ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow}


def _calc(node):
    if isinstance(node, ast.Constant) and type(node.value) in (int, float):
        return node.value
    if isinstance(node, ast.Name) and node.id in CALC_NAMES:
        return CALC_NAMES[node.id]
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
        v = _calc(node.operand)
        return v if isinstance(node.op, ast.UAdd) else -v
    if isinstance(node, ast.BinOp) and type(node.op) in CALC_OPS:
        a, b = _calc(node.left), _calc(node.right)
        # 9^9^9 would take the machine with it
        if isinstance(node.op, ast.Pow) and (abs(b) > 1000 or abs(a) > 1e100):
            raise ValueError("too big")
        v = CALC_OPS[type(node.op)](a, b)
        # (-8)^(1/3) is a complex number in Python: real answers only
        if isinstance(v, complex):
            raise ValueError("not a real number")
        return v
    if (isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in CALC_FUNCS
            and len(node.args) == 1 and not node.keywords):
        return CALC_FUNCS[node.func.id](_calc(node.args[0]))
    raise ValueError("not arithmetic")


# Units, by dimension: how many of the dimension's base unit one of them is.
# Temperatures are not a factor apart, so they are worked out on their own.
UNITS = {
    "length": {"mm": .001, "cm": .01, "m": 1, "km": 1000, "in": .0254, "inch": .0254, "inches": .0254,
               "ft": .3048, "foot": .3048, "feet": .3048, "yd": .9144, "mi": 1609.344, "mile": 1609.344,
               "miles": 1609.344},
    "mass": {"mg": .001, "g": 1, "kg": 1000, "oz": 28.349523125, "lb": 453.59237, "lbs": 453.59237},
    "time": {"ms": .001, "s": 1, "sec": 1, "min": 60, "h": 3600, "hr": 3600, "hours": 3600,
             "day": 86400, "days": 86400, "week": 604800, "weeks": 604800},
    "data": {"b": 1, "kb": 1e3, "mb": 1e6, "gb": 1e9, "tb": 1e12,
             "kib": 1024, "mib": 1024 ** 2, "gib": 1024 ** 3, "tib": 1024 ** 4},
    "volume": {"ml": .001, "l": 1, "gal": 3.785411784, "floz": .0295735295625, "cup": .2365882365,
               "cups": .2365882365},
    "speed": {"m/s": 1, "km/h": 1 / 3.6, "kmh": 1 / 3.6, "kph": 1 / 3.6, "mph": .44704},
}
TEMPS = {"c": "c", "°c": "c", "celsius": "c", "f": "f", "°f": "f", "fahrenheit": "f", "k": "k", "kelvin": "k"}
BASES = {"hex": (16, "0x"), "bin": (2, "0b"), "binary": (2, "0b"), "oct": (8, "0o"), "octal": (8, "0o"),
         "dec": (10, ""), "decimal": (10, "")}
CONVERT = re.compile(r"^(.+?)\s*([a-z°/]+)\s+(?:in|to|as)\s+([a-z°/]+)$", re.I)
TO_BASE = re.compile(r"^(.+?)\s+(?:in|to|as)\s+(hex|bin|binary|oct|octal|dec|decimal)$", re.I)
PERCENT_OF = re.compile(r"^(.+?)\s*%\s*of\s+(.+)$", re.I)
PLUS_PERCENT = re.compile(r"^(.+?)\s*([+-])\s*([\d.]+)\s*%$")
HEX_OR_TIMES = re.compile(r"(?P<hex>(?<![\w.])0[xX][0-9a-fA-F]+)|(?<=[\d)])\s*x\s*(?=[\d(])")


def number(v):
    """A result as text: whole numbers exactly, the rest to 12 digits."""
    if isinstance(v, float):
        if v != v or v in (float("inf"), float("-inf")):
            raise ValueError("not a number")
        if v.is_integer() and abs(v) < 1e15:
            return str(int(v))
        return f"{v:.12g}"
    return str(v)


def evaluate(q):
    if len(q) > CALC_MAX:
        raise ValueError("too long")
    q = q.strip().replace("^", "**").replace("\u00d7", "*").replace("\u00f7", "/").replace(",", "")
    # "3x4", "3 x 4": x between numbers is a times sign; a hex number (0x1f,
    # wherever it is in the sum) is kept as it is
    q = HEX_OR_TIMES.sub(lambda m: m.group("hex") or "*", q)
    # 15% is 0.15 once it is part of a sum; % with a number after it is the
    # remainder (10 % 3)
    q = re.sub(r"(\d[\d.]*)\s*%(?!\s*[\w.(])", r"(\1/100)", q)
    return _calc(ast.parse(q, mode="eval").body)


def calc(query):
    """The answer to `query` as (shown, copied), or None when it is not a
    sum: a lone number, a word, or anything that does not work out."""
    q = query.strip()
    if not q or not any(c.isdigit() for c in q) or len(q) > CALC_MAX:
        return None
    try:
        m = TO_BASE.match(q)
        if m:
            v = evaluate(m.group(1))
            if not float(v).is_integer():
                return None
            base, prefix = BASES[m.group(2).lower()]
            digits = {16: "x", 2: "b", 8: "o", 10: "d"}[base]
            text = (("-" if v < 0 else "") + prefix + format(abs(int(v)), digits))
            return text, text
        m = CONVERT.match(q)
        if m:
            v, a, b = evaluate(m.group(1)), m.group(2).lower(), m.group(3).lower()
            if a in TEMPS and b in TEMPS:
                c = {"c": v, "f": (v - 32) * 5 / 9, "k": v - 273.15}[TEMPS[a]]
                out = {"c": c, "f": c * 9 / 5 + 32, "k": c + 273.15}[TEMPS[b]]
                n = number(out)
                return f"{n} {({'c': '°C', 'f': '°F', 'k': 'K'})[TEMPS[b]]}", n
            else:
                dim = next((d for d, u in UNITS.items() if a in u and b in u), None)
                if dim is None:
                    return None
                out = v * UNITS[dim][a] / UNITS[dim][b]
            n = number(out)
            return f"{n} {m.group(3)}", n
        m = PERCENT_OF.match(q)
        if m:
            n = number(evaluate(m.group(1)) / 100 * evaluate(m.group(2)))
            return n, n
        m = PLUS_PERCENT.match(q)
        if m:
            base, pct = evaluate(m.group(1)), float(m.group(3))
            n = number(base * (1 + (pct if m.group(2) == "+" else -pct) / 100))
            return n, n
        # "42" is a search, not a sum; "0xff" is a question (what is it in decimal)
        if re.fullmatch(r"[+-]?[\d.,]+", q):
            return None
        n = number(evaluate(q))
        return n, n
    except CALC_ERRORS:
        return None


# ---------------------------------------------------------------------------
# Currency: "100 usd in eur", "$100 to gbp". The European Central Bank's
# daily reference rates through Frankfurter (frankfurter.dev: free, no key,
# open source). Fetched only when a conversion is typed, at most twice a day,
# and kept in ~/.cache/pulsar/currency.json; offline, the last rates are
# used and their date is shown.
# ---------------------------------------------------------------------------
RATES_URL = os.environ.get("PULSAR_RATES_URL", "https://api.frankfurter.dev/v1/latest?base=EUR")
RATES_MAX_AGE = 12 * 3600
# the ones the ECB publishes (not BGN: Bulgaria has the euro since 2026)
CURRENCIES = set("AUD BRL CAD CHF CNY CZK DKK EUR GBP HKD HUF IDR ILS INR ISK JPY KRW MXN MYR "
                 "NOK NZD PHP PLN RON SEK SGD THB TRY USD ZAR".split())
CURRENCY_SIGNS = {"$": "USD", "\u20ac": "EUR", "\u00a3": "GBP", "\u00a5": "JPY", "\u20b9": "INR", "\u20a9": "KRW"}
CURRENCY = re.compile(r"^([$\u20ac\u00a3\u00a5\u20b9\u20a9])?\s*(.+?)\s*([a-z]{3})?\s+(?:in|to|as)\s+"
                      r"([a-z]{3}|[$\u20ac\u00a3\u00a5\u20b9\u20a9])$", re.I)


def rates_file():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.environ.get("HOME", "/nonexistent"), ".cache")
    return os.path.join(base, "pulsar", "currency.json")


def currency_parse(query):
    """(amount, from, to) for a currency conversion, else None."""
    if len(query) > CALC_MAX:
        return None
    m = CURRENCY.match(query.strip())
    if not m or bool(m.group(1)) == bool(m.group(3)):
        return None
    src = CURRENCY_SIGNS.get(m.group(1)) if m.group(1) else m.group(3).upper()
    dst = CURRENCY_SIGNS.get(m.group(4)) or m.group(4).upper()
    if src not in CURRENCIES or dst not in CURRENCIES:
        return None
    try:
        amount = evaluate(m.group(2))
    except CALC_ERRORS:
        return None
    return amount, src, dst


def currency_missing(parsed, rates):
    """Which of a conversion's two currencies `rates` has no rate for, or None."""
    have = set(rates["rates"]) | {"EUR"}
    return next((c for c in parsed[1:] if c not in have), None)


def currency_convert(parsed, rates):
    """(shown, copied) at `rates` ({"date", "rates": per EUR})."""
    amount, src, dst = parsed
    per_eur = dict(rates["rates"], EUR=1.0)
    if src not in per_eur or dst not in per_eur:
        return None
    out = amount / per_eur[src] * per_eur[dst]
    n = f"{out:,.2f}" if dst not in ("JPY", "KRW", "ISK", "HUF", "IDR") else f"{out:,.0f}"
    return f"{n} {dst}", n.replace(",", "")


def rates_ok(r):
    """Whether `r` is rates to convert with: a date, and a positive number for
    each currency. Anything else in the cache (or the feed) is as good as none."""
    return (isinstance(r, dict) and isinstance(r.get("date"), str) and isinstance(r.get("rates"), dict)
            and all(isinstance(k, str) and type(v) in (int, float) and math.isfinite(v) and v > 0
                    for k, v in r["rates"].items()))


def load_rates(now=None, fetch=True):
    """The rates: the cache if it is fresh, else fetched (and cached), else the
    stale cache, else None. Blocking: the window calls it off the main thread.
    A cache that is not rates is none; one fetched "in the future" (the clock
    was wrong, or went back) is stale."""
    import time
    now = now or time.time()
    path = rates_file()
    cached = None
    try:
        with open(path) as f:
            cached = json.load(f)
    except (OSError, ValueError):
        cached = None
    if not rates_ok(cached):
        cached = None
    else:
        fetched = cached.get("fetched")
        if type(fetched) in (int, float) and 0 <= now - fetched < RATES_MAX_AGE:
            return cached
    if fetch:
        import urllib.request
        try:
            req = urllib.request.Request(RATES_URL, headers={"User-Agent": "pulsar-menu"})
            with urllib.request.urlopen(req, timeout=8) as r:
                got = json.load(r)
            if rates_ok(got):
                fresh = {"date": got["date"], "rates": got["rates"], "fetched": now}
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path + ".tmp", "w") as f:
                    json.dump(fresh, f)
                os.replace(path + ".tmp", path)
                return fresh
        # a network can fail in more ways than OSError (http.client's own errors)
        except Exception:
            pass
    return cached


def fetch_then(report):
    """report(the rates, or None), whatever happens getting them: the answer
    row waits on it, and would say "Getting the exchange rates" for good."""
    got = None
    try:
        got = load_rates()
    except Exception as e:
        print(f"pulsar-menu: exchange rates: {e!r}", file=sys.stderr)
    finally:
        report(got)


# ---------------------------------------------------------------------------
# Dates: "in 90 days", "3 weeks ago", "2026-12-25 + 45 days", "6 months from
# dec 1", "days until dec 25", "days since mar 1", "2026-12-25 - 2026-11-05",
# or a date alone for its weekday. Dates: today, tomorrow, yesterday,
# 2026-12-25, dec 25, 25 december 2026, 12/25 or 12/25/2026 (month first).
# ---------------------------------------------------------------------------
MONTHS = {m: i + 1 for i, m in enumerate("jan feb mar apr may jun jul aug sep oct nov dec".split())}
# a month's name or its short form, not any word that starts like one
# ("octopath 2" is a game, "4 decks" is not December)
MONTH_RE = (r"(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|june?|july?|aug(?:ust)?"
            r"|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\.?")
DATE_UNITS = {"d": "days", "day": "days", "days": "days", "w": "weeks", "wk": "weeks", "week": "weeks",
              "weeks": "weeks", "month": "months", "months": "months", "mo": "months",
              "y": "years", "yr": "years", "year": "years", "years": "years"}
UNIT_RE = r"(d|days?|w|wks?|weeks?|mo|months?|y|yrs?|years?)"


def add_months(d, n):
    import calendar
    y, m = divmod(d.month - 1 + n, 12)
    y += d.year
    return d.replace(year=y, month=m + 1, day=min(d.day, calendar.monthrange(y, m + 1)[1]))


def shift(d, n, unit):
    import datetime
    unit = DATE_UNITS[unit.lower()]
    if unit == "days":
        return d + datetime.timedelta(days=n)
    if unit == "weeks":
        return d + datetime.timedelta(weeks=n)
    return add_months(d, n if unit == "months" else 12 * n)


def parse_date(text, today, prefer="next"):
    """A date, or None. A month and day with no year is the next one on or
    after today (prefer="next") or the last one on or before it ("last")."""
    import datetime
    t = text.strip().lower().rstrip(".")
    named = {"today": 0, "now": 0, "tomorrow": 1, "yesterday": -1}
    if t in named:
        return today + datetime.timedelta(days=named[t])
    y = None
    m = re.fullmatch(r"(\d{4})-(\d{1,2})-(\d{1,2})", t)
    if m:
        y, mo, d = (int(x) for x in m.groups())
    else:
        m = (re.fullmatch(r"(\d{1,2})/(\d{1,2})(?:/(\d{4}))?", t)
             or re.fullmatch(MONTH_RE + r" (\d{1,2})(?:st|nd|rd|th)?,?(?: (\d{4}))?", t))
        if m:
            mo, d, y = m.group(1), int(m.group(2)), m.group(3)
        else:
            m = re.fullmatch(r"(\d{1,2})(?:st|nd|rd|th)? " + MONTH_RE + r",?(?: (\d{4}))?", t)
            if not m:
                return None
            d, mo, y = int(m.group(1)), m.group(2), m.group(3)
        mo = int(mo) if mo.isdigit() else MONTHS[mo[:3]]
        y = int(y) if y else None
    try:
        if y is not None:
            return datetime.date(y, mo, d)
        datetime.date(2000, mo, d)   # a day some year has: Feb 29 is, Feb 30 is not
    except ValueError:
        return None
    if prefer not in ("next", "last"):
        try:
            return datetime.date(today.year, mo, d)
        except ValueError:
            return None
    # no year: the first on or after today ("next"), or the last on or before
    # it ("last"); a Feb 29 can be up to 8 years off (2096, then 2104)
    step = 1 if prefer == "next" else -1
    for n in range(9):
        try:
            when = datetime.date(today.year + n * step, mo, d)
        except ValueError:   # Feb 29 in a common year, or no such year
            continue
        if (when >= today) if step > 0 else (when <= today):
            return when
    return None


def long_date(d):
    return f"{d:%A}, {d:%B} {d.day}, {d.year}"


def days_text(n):
    return f"{n:,} day{'s' if abs(n) != 1 else ''}"


def date_calc(query, today=None):
    """(shown, copied) for date arithmetic, else None: also for a date past
    what Python's dates reach (year 9999), "in 9000 years"."""
    import datetime
    if len(query) > CALC_MAX:
        return None
    try:
        return _date_calc(" ".join(query.strip().split()), today or datetime.date.today())
    except (ValueError, OverflowError):
        return None


def _date_calc(q, today):
    import datetime
    m = re.fullmatch(r"days? (until|till|to|since|from) (.+)", q, re.I)
    if m:
        since = m.group(1).lower() in ("since", "from")
        d = parse_date(m.group(2), today, "last" if since else "next")
        if d is None:
            return None
        n = (today - d).days if since else (d - today).days
        return f"{days_text(n)} ({long_date(d)})", str(n)
    m = re.fullmatch(r"in (\d+) " + UNIT_RE, q, re.I) or re.fullmatch(r"(\d+) " + UNIT_RE + r" ago", q, re.I)
    if m:
        n = int(m.group(1)) * (-1 if q.lower().endswith(" ago") else 1)
        d = shift(today, n, m.group(2))
        return long_date(d), d.isoformat()
    m = re.fullmatch(r"(\d+) " + UNIT_RE + r" (from|after|before) (.+)", q, re.I)
    if m:
        base = parse_date(m.group(4), today, "next")
        if base is None:
            return None
        d = shift(base, int(m.group(1)) * (-1 if m.group(3).lower() == "before" else 1), m.group(2))
        return long_date(d), d.isoformat()
    m = re.fullmatch(r"(.+?) ?([+-]) ?(\d+) ?" + UNIT_RE, q, re.I)
    if m:
        base = parse_date(m.group(1), today, "this")
        if base is not None:
            d = shift(base, int(m.group(3)) * (1 if m.group(2) == "+" else -1), m.group(4))
            return long_date(d), d.isoformat()
    m = re.fullmatch(r"(.+?) - (.+)", q)
    if m:
        a, b = parse_date(m.group(1), today, "this"), parse_date(m.group(2), today, "this")
        if a is not None and b is not None:
            n = (a - b).days
            return days_text(n), str(n)
    # a date alone: its weekday, and how far off it is
    d = parse_date(q, today, "next") if re.search(r"\d{4}-\d|[a-z]{3}", q, re.I) else None
    if d is not None:
        n = (d - today).days
        when = "today" if n == 0 else (f"in {days_text(n)}" if n > 0 else f"{days_text(-n)} ago")
        return f"{long_date(d)} \u00b7 {when}", d.isoformat()
    return None


# A few things to type for no reason, answered in the answer row. Whole
# phrases only, matched ignoring case and punctuation, so an app's name
# typed on the way never trips one. Enter does nothing with them.
EGGS = {
    "someone set us up the bomb": "All your base are belong to Pulsar.",
    "my wife left me": "Pulsar can roll back an update. Not that.",
    "rm rf": "Nice try.",
    "sudo make me a sandwich": "Okay.",
    "do a barrel roll": "Press Z or R twice.",
    "the cake is a lie": "The cake is a nightly build.",
    "hello world": "Hello, world.",
    "i use arch btw": "We know.",
    "what is the meaning of life": "42",
    "have you tried turning it off and on again": "Have you tried rolling it back?",
    "up up down down left right left right b a": "+30 lives",
    "make it so": "Engage.",
    "open the pod bay doors": "I'm sorry, Dave.",
    "your lighthouse in the sky": "Keep it lit.",
}


def egg(query):
    """The reply to an easter-egg phrase, or None."""
    words = re.sub(r"[^a-z0-9]+", " ", query.lower()).split()
    return EGGS.get(" ".join(words))


class CalcItem(Item):
    """The answer row: there only while the search is a sum, a conversion or
    date arithmetic; Enter copies it. Currency rates come from want_rates,
    which the window sets: it fetches them off the main thread."""
    def __init__(self):
        super().__init__("calc", "", "", "accessories-calculator-symbolic", [], group="Math")
        self.rates = None
        self.rates_failed = False
        self.want_rates = None

    def _answer(self, shown, copied, note=""):
        self.group, self.icon = "Math", "accessories-calculator-symbolic"
        self.answer = copied
        self.title = f"= {shown}"
        self.subtitle = f"{note} \u00b7 Enter copies {copied}" if note else f"Enter copies {copied}"
        self.argv = ["wl-copy", "--", copied]
        return True

    def matches(self, query):
        # every row is asked on every key: a parser that raises would stop the
        # search halfway (stale rows, Enter failing). No answer, instead, and
        # none left over from the last search.
        try:
            if self._matches(query):
                return True
        except Exception:
            pass
        self.answer, self.argv = None, []
        return False

    def _matches(self, query):
        said = egg(query)
        if said is not None:
            self.group, self.icon = "", "face-smile-big-symbolic"
            self.answer, self.argv = None, []
            self.title, self.subtitle = said, ""
            return True
        self.group, self.icon = "Math", "accessories-calculator-symbolic"
        cur = currency_parse(query)
        if cur is not None:
            if self.rates is None:
                self.answer, self.argv = None, []
                if self.rates_failed:
                    self.title, self.subtitle = "= ?", "No exchange rates: offline, and none saved yet"
                    return True
                if self.want_rates:
                    self.want_rates()
                self.title, self.subtitle = "= \u2026", "Getting the exchange rates"
                return True
            missing = currency_missing(cur, self.rates)
            if missing is not None:
                # the ECB stops publishing a currency now and then (BGN, 2026)
                self.answer, self.argv = None, []
                self.title = "= ?"
                self.subtitle = f"No rate for {missing} in the ECB's rates of {self.rates['date']}"
                return True
            return self._answer(*currency_convert(cur, self.rates), note=f"ECB rate of {self.rates['date']}")
        got = date_calc(query)
        if got is None:
            got = calc(query)
        if got is None:
            return False
        return self._answer(*got)


def agent_item(name):
    agent = AGENT_NAMES.get(name, name)
    return Item("ask", f"Ask {agent} about this machine", "Starts it on a private report of this machine",
                "dialog-question-symbolic", terminal(PULSAR, "agent", "ask", hold=False),
                "agent ask help question report diagnose", "Agents")


# ---------------------------------------------------------------------------
# Apps and files: rows that belong to one search. Apps come from GNOME's own
# app search (Gio.DesktopAppInfo.search), files from LocalSearch, the file
# index GNOME already keeps; file names only, as Files' own search does
# first: matching file contents is seconds, not milliseconds, and finds
# words inside music tags.
# ---------------------------------------------------------------------------
APP_LIMIT = 5
# a chosen row's name too long to fit slides along to show the rest: after
# a moment on the row (not while arrowing past), at a reading pace, held at
# the end long enough to read, then back
SCRUB_DELAY_MS = 600
SCRUB_HOLD_MS = 1500
SCRUB_BACK_MS = 350
SCRUB_PX_PER_S = 110


def scrub_ms(overflow_px):
    """How long the slide to a name's end takes: the same pace for every
    name, a few letters over or a whole line (a floor made short ones crawl)."""
    return max(1, round(overflow_px / SCRUB_PX_PER_S * 1000))


FILE_LIMIT = 6
# Pulsar's own apps the menu already lists as actions, and the menu itself
APPS_LISTED = {"digital.arclight.Pulsar.Menu.desktop", "digital.arclight.Pulsar.Settings.desktop",
               "digital.arclight.Pulsar.ThemePicker.desktop"}
FILES_QUERY = """
SELECT DISTINCT ?url (fts:rank(?f) AS ?rank) ?modified {
  GRAPH tracker:FileSystem {
    ?f fts:match ~terms ; nie:url ?url ; nfo:fileLastModified ?modified .
  }
} ORDER BY DESC(?rank) DESC(?modified) LIMIT 200
"""


class Found(Item):
    """An app or a file found for one search: it matches that search only."""
    def __init__(self, query, key, title, subtitle, group):
        super().__init__(key, title, subtitle, "", [], group=group)
        self.for_query = query

    def matches(self, query):
        return query == self.for_query


def found_changes(shown, query, found):
    """What a search does to the list's rows (`shown`: their items): the
    found rows of other searches go, and of `found`, the ones not there yet
    for this search come. The same search again adds nothing twice."""
    gone = [it for it in shown if isinstance(it, Found) and it.for_query != query]
    have = {it.key for it in shown if isinstance(it, Found) and it.for_query == query}
    return gone, [it for it in found if it.key not in have]


def pick_apps(groups, shown, limit=APP_LIMIT):
    """App IDs from Gio.DesktopAppInfo.search's groups (best first), without
    repeats, hidden apps (shown(id) is False) or the ones listed already."""
    out = []
    for group in groups:
        for i in group:
            if i in out or i in APPS_LISTED or not shown(i):
                continue
            out.append(i)
            if len(out) == limit:
                return out
    return out


def file_terms(query):
    """The index's search for a typed query: each word as a prefix, all of
    them needed; "" for one letter, which would match half the disk. Only
    letters, digits and _: the index reads quotes, * and - as its own syntax."""
    words = re.findall(r"\w+", query.lower())
    if sum(len(w) for w in words) < 2:
        return ""
    return " ".join(w + "*" for w in words)


def files_allowed(disable_external, disabled):
    """File search, unless it is off in Settings > Search: all search there
    (disable-external), or Files' own row (the Nautilus provider)."""
    return not disable_external and "org.gnome.Nautilus.desktop" not in disabled


def rank_files(rows, query, home, own=(), limit=FILE_LIMIT):
    """The paths to show from the index's (path, rank, modified) rows.

    The index stems words ("settings" finds "Setup"), so every typed word
    must be in the name as typed. Inside a Wine prefix (drive_c) is
    Windows' own tree, not your files: left out. Then: the name itself
    (pulsar, pulsar.md), then a name that starts with the search, then one
    that only has it; your own folders (home,
    Documents, Downloads, Pictures...) before the rest, so ~/Pictures/
    Screenshots comes before a game's copy five folders down; nearer the
    top of home; newer."""
    words = re.findall(r"\w+", query.casefold())
    home = home.rstrip("/")

    def inside(path, folder):
        return bool(folder) and path.startswith(folder.rstrip("/") + "/")

    def key(row):
        path = row[0]
        name = os.path.basename(path).casefold()
        stem = os.path.splitext(name)[0] if not name.startswith(".") else name
        start = (0 if " ".join(re.findall(r"\w+", stem)) == " ".join(words) else
                 1 if words and name.startswith(words[0]) else 2)
        mine = 0 if os.path.dirname(path) == home or any(inside(path, d) for d in own) else 1
        rel = path[len(home):] if inside(path, home) else path
        return (start, mine, rel.strip("/").count("/"))

    out = []
    for path, _rank, _mod in sorted(sorted(rows, key=lambda r: r[2] or "", reverse=True), key=key):
        name = os.path.basename(path).casefold()
        if path in out or "/drive_c/" in path + "/" or not all(w in name for w in words):
            continue
        out.append(path)
        if len(out) == limit:
            break
    return out


def where(path, home):
    """A file's folder, with home as ~."""
    folder = os.path.dirname(path)
    if home and folder == home.rstrip("/"):
        return "Home folder"
    if home and (folder == home or folder.startswith(home.rstrip("/") + "/")):
        folder = "~" + folder[len(home.rstrip("/")):]
    return folder


def nothing_found(query):
    """The words over an empty list."""
    return (f"Nothing matches “{query.strip()}”",
            "Search by the name of an app, a file or a Pulsar action, "
            "or type a sum like 15% of 80")


# Shortcut hints, from pulsar-shortcuts' custom bindings (when the person kept them)
SHORTCUT_IDS = {"screen-text": "pulsar-screen-text"}


def accel_label(accel):
    mods = re.findall(r"<([^>]+)>", accel)
    key = re.sub(r"<[^>]+>", "", accel)
    key = {"slash": "/", "Print": "Print", "period": "."}.get(key, key.upper() if len(key) == 1 else key)
    return "+".join([m.capitalize() for m in mods] + [key])


