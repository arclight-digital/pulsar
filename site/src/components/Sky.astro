---
// The hero background: assets/shaders/pulsar.frag -- the same shader that
// renders the OS wallpapers -- running live in WebGL; src/scripts/sky.ts
// compiles it. The CI-rendered silk still sits underneath as the CSS ground:
// it is the no-WebGL fallback AND the first paint while the bundle loads, so
// the weakest degraded state is another output of the same pipeline.
//
// #skyfade holds a snapshot of the outgoing look so backdrop switches
// crossfade directly instead of sweeping u_look through the intermediate ones.
//
// The deck drives the SAME u_look uniform the OS wallpapers are rendered with:
// four looks x two themes = the shipped set. It is hidden until a GL context
// actually exists -- a visitor without WebGL must never see buttons that
// silently do nothing. Theme is the top bar's toggle, not the deck's.
const LOOKS = ['Silk', 'Leak', 'Satin', 'Holo'];
---

<canvas id="sky" aria-hidden="true"></canvas>
<canvas id="skyfade" aria-hidden="true"></canvas>

<div class="deck" role="group" aria-label="Backdrop" id="lookSeg" hidden>
  <span class="deck-note">the shipped wallpapers, live</span>
  <div class="picker">
    {
      LOOKS.map((name, index) => (
        <button type="button" data-look={index} aria-pressed={index === 0 ? 'true' : 'false'}>
          {name}
        </button>
      ))
    }
  </div>
</div>

<style>
  #sky,
  #skyfade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  #skyfade {
    pointer-events: none;
    opacity: 0;
  }

  .deck {
    position: absolute;
    /* above the hero's content block, whose bottom padding reserves this
       room and would otherwise sit on top of the buttons and eat the clicks */
    z-index: 2;
    left: 50%;
    bottom: var(--space-lg);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    white-space: nowrap;
  }
  .deck[hidden] {
    display: none;
  }
  .deck-note {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: 0.04em;
    color: var(--on-chip);
  }
  .picker {
    display: inline-flex;
    padding: var(--space-xs);
    gap: var(--space-xs);
    border-radius: var(--radius-full);
    background: var(--chip);
    border: 1px solid var(--chip-line);
    backdrop-filter: blur(12px);
  }
  .picker button {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--on-chip);
    font: inherit;
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    font-size: var(--label-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  .picker button:hover {
    color: var(--star);
  }
  .picker button[aria-pressed='true'] {
    color: var(--ink);
    background: var(--cyan);
    box-shadow: var(--glow-sm);
  }
  .picker button:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  @media (max-width: 40rem) {
    .deck {
      bottom: var(--space-md);
    }
    .deck-note {
      display: none;
    }
  }
</style>
