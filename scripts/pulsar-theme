#!/usr/bin/python3
"""pulsar-theme -- one-command whole-desktop theming for GNOME on Pulsar.

Installed as /usr/libexec/pulsar/pulsar-theme; `pulsar theme ...` execs it.


  pulsar-theme list                     themes on the search path
  pulsar-theme set <name> [--variant dark|light|both] [--only t1,t2] [--dry-run]
  pulsar-theme next | prev              cycle through themes
  pulsar-theme bg-next                  cycle the current theme's wallpapers
  pulsar-theme current                  what is applied, and what it touched
  pulsar-theme revert [--to stock|image] put back everything; default is upstream GNOME
  pulsar-theme init                     first login (run once by pulsar-theme-init.service)
  pulsar-theme audit [theme...]         WCAG contrast checks
  pulsar-theme restart-apps [--yes]     GTK apps still holding the old palette
  pulsar-theme config [key [value]]     e.g. restart-prompt on|off
  pulsar-theme render <name> <dir>      render every target into <dir>, touch nothing
  pulsar-theme import base16 <file|url> [--name slug]
  pulsar-theme targets                  list targets and whether each is available here

Stdlib only (python3 ships in the Pulsar image; there is no pip on an atomic
host). Every path comes from HOME / XDG_* and every setting goes through the
`dconf` CLI on the session bus, so pointing those at a scratch tree and a
private D-Bus sandboxes it completely -- tests/theme-gate/ does exactly that.

What it writes, and why each piece exists, is in docs/theming.md.
"""
import argparse
import colorsys
import datetime
import fcntl
import hashlib
import json
import math
import os
import pathlib
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
import xml.etree.ElementTree as ET
import urllib.request

HERE = pathlib.Path(__file__).resolve().parent
HOME = pathlib.Path(os.environ.get("HOME", "~")).expanduser()


def xdg(var, default):
    return pathlib.Path(os.environ.get(var) or (HOME / default))


CONFIG = xdg("XDG_CONFIG_HOME", ".config")
DATA = xdg("XDG_DATA_HOME", ".local/share")
STATE = xdg("XDG_STATE_HOME", ".local/state") / "pulsar-theme"

# Search path, highest priority first. A user theme with the same slug as an
# image-shipped one shadows it, the same layering as /usr vs /etc on the host.
# The last entries are the repo checkout, so scripts/pulsar-theme runs from a
# clone without installing anything.
REPO_SHARE = HERE.parent / "system_files" / "usr" / "share" / "pulsar"
THEME_PATH = [pathlib.Path(p) for p in os.environ.get("PULSAR_THEME_PATH", "").split(":") if p] or [
    DATA / "pulsar" / "themes",
    pathlib.Path("/usr/share/pulsar/themes"),
    REPO_SHARE / "themes",
]
TEMPLATE_PATH = [pathlib.Path(p) for p in os.environ.get("PULSAR_THEME_TEMPLATES", "").split(":") if p] or [
    pathlib.Path("/usr/share/pulsar/theme/templates"),
    REPO_SHARE / "theme" / "templates",
]
# What a theme falls back to when its own renders are absent (a
# --no-wallpapers build): the brand pair, which zz0 already points at.
BRAND_WALLPAPER = {"dark": pathlib.Path("/usr/share/backgrounds/pulsar/pulsar-nebula-dark.jxl"),
                   "light": pathlib.Path("/usr/share/backgrounds/pulsar/pulsar-nebula-light.jxl")}

# ---------------------------------------------------------------- colour ----


class Color:
    __slots__ = ("r", "g", "b")

    def __init__(self, r, g, b):
        self.r, self.g, self.b = (max(0.0, min(1.0, v)) for v in (r, g, b))

    @classmethod
    def parse(cls, s):
        s = str(s).strip().lstrip("#")
        if s.startswith("0x"):
            s = s[2:]
        if len(s) == 3:
            s = "".join(c * 2 for c in s)
        if not re.fullmatch(r"[0-9a-fA-F]{6}([0-9a-fA-F]{2})?", s):
            raise ValueError(f"not a color: {s!r}")
        return cls(*(int(s[i:i + 2], 16) / 255 for i in (0, 2, 4)))

    @property
    def hex(self):
        return "#%02x%02x%02x" % tuple(round(v * 255) for v in (self.r, self.g, self.b))

    @property
    def rgb(self):
        return "%d, %d, %d" % tuple(round(v * 255) for v in (self.r, self.g, self.b))

    def mix(self, other, t):
        return Color(*(a + (b - a) * t for a, b in zip((self.r, self.g, self.b), (other.r, other.g, other.b))))

    def lum(self):
        def lin(c):
            return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
        return 0.2126 * lin(self.r) + 0.7152 * lin(self.g) + 0.0722 * lin(self.b)

    def contrast(self, other):
        a, b = sorted((self.lum(), other.lum()), reverse=True)
        return (a + 0.05) / (b + 0.05)

    def oklab(self):
        def lin(c):
            return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
        r, g, b = lin(self.r), lin(self.g), lin(self.b)
        l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
        m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
        s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
        return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
                1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
                0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)

    def __str__(self):
        return self.hex


BLACK, WHITE = Color(0, 0, 0), Color(1, 1, 1)


def from_oklab(L, a, b):
    l_, m_, s_ = (L + 0.3963377774 * a + 0.2158037573 * b, L - 0.1055613458 * a - 0.0638541728 * b,
                  L - 0.0894841775 * a - 1.2914855480 * b)
    l, m, s = l_ ** 3, m_ ** 3, s_ ** 3
    lin = (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
           -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
           -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)
    f = lambda c: 12.92 * c if c <= 0.0031308 else 1.055 * max(c, 0) ** (1 / 2.4) - 0.055
    return Color(*(f(max(0.0, c)) for c in lin))


def fit_contrast(c, bg, target):
    """Move c's OKLab lightness away from bg -- hue and chroma kept -- until it
    clears `target` against bg. Returns c unchanged if it already does."""
    if c.contrast(bg) >= target:
        return c
    L, a, b = c.oklab()
    step = -0.01 if bg.lum() > 0.18 else 0.01
    for _ in range(100):
        L += step
        n = from_oklab(L, a, b)
        if n.contrast(bg) >= target or not 0 < L < 1:
            return n
    return n

# libadwaita's nine system accents (AdwAccentColor). The Shell and every
# Flatpak (through the settings portal) only ever see one of these, so the
# nearest one is always set alongside the exact hex that gtk.css carries.
GNOME_ACCENTS = {
    "blue": "#3584e4", "teal": "#2190a4", "green": "#3a944a", "yellow": "#c88800",
    "orange": "#ed5b00", "red": "#e62d42", "pink": "#d56199", "purple": "#9141ac",
    "slate": "#6f8396",
}


def nearest_gnome_accent(c):
    L, a, b = c.oklab()
    chroma = math.hypot(a, b)
    best, bd = None, 1e9
    for name, hx in GNOME_ACCENTS.items():
        L2, a2, b2 = Color.parse(hx).oklab()
        # hue matters far more than lightness here: weight L down
        d = (0.3 * (L - L2)) ** 2 + (a - a2) ** 2 + (b - b2) ** 2
        if chroma < 0.04 and name != "slate":
            d += 1  # a grey accent is slate, whatever its lightness
        if d < bd:
            best, bd = name, d
    return best


def readable_on(bg, *candidates):
    return max(candidates, key=lambda c: c.contrast(bg))


def ensure_contrast(fg, bg, target, toward):
    """Walk fg toward `toward` until it clears `target` against bg."""
    c = fg
    for i in range(21):
        if c.contrast(bg) >= target:
            return c
        c = fg.mix(toward, i / 20)
    return c

# ---------------------------------------------------------------- themes ----

# Pulsar's palette vocabulary: the ANSI hues, plus a tonal ramp named after
# DESIGN.md's (deep -> sunken -> background -> raised) and three text weights.
# base16/base24 map onto it slot by slot (see base16_to_palette). The optional
# GNOME surface keys are last.
PALETTE_KEYS = [
    "accent", "selection", "muted",
    "background", "background_sunken", "background_deep", "background_raised",
    "foreground", "foreground_dim", "foreground_bright",
    "red", "orange", "yellow", "green", "cyan", "blue", "magenta", "brown",
    "bright_red", "bright_yellow", "bright_green", "bright_cyan", "bright_blue", "bright_magenta",
]
SURFACE_KEYS = ["window", "view", "headerbar", "sidebar", "card", "popover"]


class Variant:
    """One resolved palette (dark or light) with every derived value filled in."""

    def __init__(self, mode, raw):
        self.mode = mode
        self.shell_glow = False     # set by Theme from its top-level key
        self.window_glass = False   # set by the gtk4 target from the Shell extension's switch
        self.glow = False           # set by the gtk4 target from the Shell extension's Glow switch
        self.glass_alpha = 0.65     # set by the shell target from the Glass tint slider
        p = {}
        for k, v in raw.items():
            if isinstance(v, str) and (v.startswith("#") or re.fullmatch(r"[0-9a-fA-F]{6}", v)):
                p[k] = Color.parse(v)
        need = {"background", "foreground"}
        if not need <= p.keys():
            raise ValueError(f"{mode} palette needs at least background and foreground")
        bg, fg = p["background"], p["foreground"]
        dark = mode == "dark"
        # "deeper" means darker in both modes: on dark toward black, on light
        # a step toward the ink (base24's base10/base11 read the same way).
        away = BLACK if dark else fg
        toward = fg                              # lifted toward the text
        d = p.setdefault
        d("background_sunken", bg.mix(away, 0.18 if dark else 0.04))
        d("background_deep", bg.mix(away, 0.34 if dark else 0.09))
        d("background_raised", bg.mix(toward, 0.08))
        d("selection", bg.mix(toward, 0.2))
        d("muted", bg.mix(toward, 0.45))
        d("foreground_dim", bg.mix(toward, 0.7))
        d("foreground_bright", fg.mix(WHITE if dark else BLACK, 0.4))
        defaults = {"red": "#e0535c", "orange": "#e8864a", "yellow": "#e0b44c", "green": "#5ab57a",
                    "cyan": "#4fb8c8", "blue": "#5a8ee6", "magenta": "#b877db", "brown": "#a0775a"}
        for k, v in defaults.items():
            d(k, Color.parse(v))
        for k in ("red", "yellow", "green", "cyan", "blue", "magenta"):
            d("bright_" + k, p[k].mix(WHITE if dark else BLACK, 0.12))
        d("accent", p["blue"])
        # GNOME surfaces: a tonal ladder derived from bg/fg unless the theme
        # pins them (Pulsar does; imported schemes usually do not).
        if dark:
            d("window", bg)
            d("view", bg.mix(BLACK, 0.2))
            d("headerbar", bg.mix(fg, 0.07))
            d("sidebar", bg.mix(fg, 0.05))
            d("card", bg.mix(fg, 0.05))
            d("popover", bg.mix(fg, 0.09))
        else:
            d("window", bg)
            d("view", bg.mix(WHITE, 0.65))
            d("headerbar", bg.mix(fg, 0.05))
            d("sidebar", bg.mix(fg, 0.035))
            d("card", bg.mix(WHITE, 0.75))
            d("popover", bg.mix(WHITE, 0.85))
        acc = p["accent"]
        d("accent_fg", readable_on(acc, WHITE, Color.parse("#101014")))
        d("accent_hover", acc.mix(WHITE if dark else BLACK, 0.12))
        # --accent-color is the accent used AS TEXT on the window ground: it
        # must clear 4.5:1 (libadwaita's own rule), so nudge it if needed.
        d("accent_text", ensure_contrast(acc, p["window"], 4.5, fg))
        # Legacy 16-colour terminal slots, unless the theme gives them.
        ansi = [p["selection"] if dark else p["foreground_dim"], p["red"], p["green"], p["yellow"],
                p["blue"], p["magenta"], p["cyan"], p["foreground"] if dark else p["selection"],
                p["muted"], p["bright_red"], p["bright_green"], p["bright_yellow"],
                p["bright_blue"], p["bright_magenta"], p["bright_cyan"],
                p["foreground_bright"] if dark else p["background_raised"]]
        for i, c in enumerate(ansi):
            d(f"color{i}", c)
        self.p = p
        self.gnome_accent = raw.get("gnome_accent") or nearest_gnome_accent(acc)

    def __getitem__(self, k):
        return self.p[k]

    def ctx(self):
        """Template context: name -> '#rrggbb', name_rgb -> 'r, g, b', name_strip -> 'rrggbb'."""
        c = {}
        for k, v in self.p.items():
            c[k] = v.hex
            c[k + "_rgb"] = v.rgb
            c[k + "_strip"] = v.hex[1:]
        c["mode"] = self.mode
        # The glass's inner cards: a faint lift of the text color on dark, a
        # frosted white on light (the Shell sheet's .pulsar-glass block).
        if self.mode == "dark":
            c["glass_card"] = f"rgba({self.p['foreground'].rgb}, 0.045)"
            c["glass_card_hover"] = f"rgba({self.p['foreground'].rgb}, 0.09)"
        else:
            c["glass_card"] = "rgba(255, 255, 255, 0.62)"
            c["glass_card_hover"] = "rgba(255, 255, 255, 0.82)"
        # The top bar's glass: the deep ground on dark; on light the ground
        # itself, lifted toward white (the deep one reads as flat grey there).
        c["glass_alpha"] = self.glass_alpha
        # The Shell's floating glass (menus, OSDs, banners, dialogs, the
        # dash) is clearer than the bar and the windows: what is behind
        # should read through as soft shapes, not only as color.
        c["surface_alpha"] = round(max(0.2, self.glass_alpha - 0.08), 3)
        if self.mode == "dark":
            c["glass_panel"] = f"rgba({self.p['background_deep'].rgb}, {self.glass_alpha})"
            c["panel_shadow"] = "rgba(0, 0, 0, 0.3)"
        else:
            c["glass_panel"] = f"rgba({self.p['background'].mix(WHITE, 0.35).rgb}, {self.glass_alpha})"
            c["panel_shadow"] = f"rgba({self.p['foreground'].rgb}, 0.1)"
        # The overview's ground: the wallpaper, blurred, under the deep ground
        # a step more opaque than the glass, so the app grid's labels and the
        # search results read on any wallpaper: 0.8 at the Glass tint
        # slider's default (0.65), 0.92 at most.
        c["glass_ground"] = (f"rgba({self.p['background_deep'].rgb}, "
                             f"{round(min(0.92, self.glass_alpha + 0.15), 3)})")
        # A CRT theme's text glows like its phosphor while Lighting is on
        # (the Shell sheet's .pulsar-lit block); every other theme's is an
        # empty rule.
        # Glass windows: the window ground goes translucent over the blur the
        # Shell extension puts behind GTK windows, and the header bar and
        # sidebar become tints over it (they paint on top of the window
        # ground, so their alpha compounds: 1 - 0.28 * 0.65 ~ 82% where they
        # are). Content -- views and cards -- stays opaque.
        g = self.window_glass
        def glass(k, a):
            return f"alpha({self.p[k].hex}, {a})" if g else self.p[k].hex
        # The window ground follows the Glass tint slider like the Shell's
        # glass does, a step more opaque for text read on it: 0.72 at the
        # slider's default (0.65), 0.95 at most.
        c["window_bg"] = glass("window", round(min(0.95, self.glass_alpha + 0.07), 3))
        c["headerbar_bg"] = glass("headerbar", 0.35)
        c["sidebar_bg"] = glass("sidebar", 0.35)
        c["window_backdrop"] = glass("window", 0.35)
        # Menus and popovers are windows of their own, and the extension blurs
        # what is beneath each one; so are dialogs that float (an alert, a
        # dialog with no parent window). Mostly text over an app's busy
        # content: a step more opaque again than the window ground.
        pa = round(min(0.95, self.glass_alpha + 0.12), 3)
        c["popover_bg"] = glass("popover", pa)
        c["dialog_bg"] = glass("popover", pa)
        # A libadwaita dialog inside its window (preferences, about, an alert)
        # is drawn into the window's own buffer, over the page it covers,
        # where the Shell's blur cannot reach: its sheet is a .background, at
        # the window ground's alpha, and the page read through it sharp. So
        # is a toast. Solid for every GTK; sheet_glass (see the gtk4 target)
        # gives GTK 4.22 and later, which can blur what is behind a widget
        # themselves (backdrop-filter), their glass back. GTK lays that blur
        # over the page rather than in its place, and the page is only as
        # opaque as the window ground, so the page stayed readable under it;
        # BACKDROP_SVG makes the blur opaque first.
        sheet = "dialog-host > dialog floating-sheet > sheet, dialog-host > dialog bottom-sheet > sheet"
        alert = "dialog-host > dialog.alert sheet"
        if g:
            c["glass_sheets"] = (f"{sheet} {{\n  background-color: {self.p['window'].hex};\n}}\n"
                                 f"{alert} {{\n  background-color: {self.p['popover'].hex};\n}}\n")
            c["sheet_glass"] = "".join(
                f"{sel} {{\n  background-color: alpha({self.p[k].hex}, {pa});\n"
                f"  backdrop-filter: blur(20px) url(\"{BACKDROP_SVG}#opaque\");\n}}\n"
                for sel, k in ((sheet, "window"), (alert, "popover"), ("toast", "popover")))
        else:
            c["glass_sheets"] = c["sheet_glass"] = ""
        # Over the blur the ground is close in value to the cards on it, and
        # they sank into it: a step lighter, and a hairline of light round
        # each (cards, boxed lists and their separate rows).
        card = self.p["card"]
        if g:
            dark = self.mode == "dark"
            card = card.mix(self.p["foreground"], 0.05) if dark else card.mix(WHITE, 0.6)
            edge = f"rgba({self.p['foreground'].rgb}, 0.09)" if dark else "rgba(255, 255, 255, 0.7)"
            drop = "rgba(0, 0, 6, 0.25)" if dark else "rgba(0, 0, 6, 0.08)"
            c["glass_cards"] = (".card, .boxed-list, .boxed-list-separate > row {\n"
                                f"  box-shadow: inset 0 0 0 1px {edge}, 0 1px 3px {drop};\n}}\n")
        else:
            c["glass_cards"] = ""
        c["card_bg"] = card.hex
        # Glow: whatever is filled with the accent glows softly in it. Weaker
        # on light, where a colored halo reads as a smudge rather than light.
        # The Shell's rules sit under .pulsar-glow (the extension's switch),
        # so they are always written; GTK has no such class, so its block is
        # written only while the switch is on.
        #
        # Each element's glow follows its size (GLOW_THICKNESS, below): a
        # small thing gets a short, slightly stronger halo, a big one a wider
        # and fainter one, so every lit control reads as equally lit.
        dark = self.mode == "dark"
        acc = self.p["accent"].rgb
        for key, t in GLOW_THICKNESS.items():
            blur, alpha = glow_for(t, dark)
            c[f"glow_{key}"] = f"0 0 {blur}px 0 rgba({acc}, {alpha})"
        # the slider's fill is drawn by glass.js, which sizes its own reach
        # by the same rule and takes only the color from here
        c["glow_slider_color"] = f"rgba({acc}, {glow_for(GLOW_THICKNESS['slider'], dark)[1]})"
        if self.glow:
            def rule(sel, key):
                blur, alpha = glow_for(GLOW_THICKNESS[key], dark)
                return f"{sel} {{\n  box-shadow: 0 0 {blur}px rgba({acc}, {alpha});\n}}\n"
            # the filled states, each only while the control can be used
            def lit(node):
                return [f"{node}:{st}:not(:disabled)" for st in ("checked", "indeterminate")]
            checks = lit("check") + lit("radio")
            # a list's cells clip what they draw, so a glow there is cut square
            # at the cell's edge: none. Each exclusion carries the same states,
            # or the plainer selector would lose to the glow on specificity.
            def unlit(views):
                return ", ".join(f"{v} {x}" for v in views for x in checks)
            common = (rule(",\n".join(checks), "gtk_check") +
                      rule("switch:checked:not(:disabled)", "gtk_switch") +
                      rule("button.suggested-action:not(:disabled)", "gtk_button"))
            c["glow"] = (
                "/* Glow: what is filled with the accent glows softly in it, each in\n"
                "   proportion to its size. */\n" + common +
                rule("scale:not(:disabled) > trough > highlight", "gtk_scale") +
                rule("progressbar:not(:disabled) > trough > progress", "gtk_progress") +
                unlit(("columnview", "listview")) + " { box-shadow: none; }\n")
            # GTK3: no bars. It clips a fill to its trough, which cuts the
            # glow to a sliver along the ends -- worse than none.
            c["glow3"] = (
                "/* Glow: what is filled with the accent glows softly in it, each in\n"
                "   proportion to its size. */\n" + common +
                unlit(("treeview",)) + " { box-shadow: none; }\n")
        else:
            c["glow"] = ""
            c["glow3"] = ""
        c["text_glow"] = (f"text-shadow: 0 0 6px rgba({self.p['accent'].rgb}, 0.55);"
                          if self.shell_glow else "")
        c["gnome_accent"] = self.gnome_accent
        return c


class Theme:
    def __init__(self, path):
        self.dir = path.parent
        self.file = path
        with open(path, "rb") as f:
            raw = tomllib.load(f)
        self.raw = raw
        self.slug = raw.get("slug") or self.dir.name
        self.name = raw.get("name", self.slug)
        self.author = raw.get("author", "")
        self.source = raw.get("source", "")
        self.variants = {m: Variant(m, raw[m]) for m in ("dark", "light") if m in raw}
        for v in self.variants.values():
            v.shell_glow = bool(raw.get("shell_glow", False))
        if not self.variants:
            raise ValueError(f"{path}: needs a [dark] and/or [light] palette")
        self.prefer = raw.get("prefer", "dark" if "dark" in self.variants else "light")
        if self.prefer not in self.variants:
            self.prefer = next(iter(self.variants))
        wp = raw.get("wallpaper", {})
        self.wallpapers = {}
        for m in ("dark", "light"):
            items = wp.get(m, [])
            items = [items] if isinstance(items, str) else items
            self.wallpapers[m] = [self._resolve(x) for x in items]

    def _resolve(self, p):
        p = pathlib.Path(os.path.expandvars(p))
        return p if p.is_absolute() else (self.dir / p)

    @property
    def both(self):
        return len(self.variants) == 2


def find_themes():
    seen = {}
    for root in THEME_PATH:
        if not root.is_dir():
            continue
        for t in sorted(root.glob("*/theme.toml")):
            slug = t.parent.name
            if slug not in seen:
                seen[slug] = t
    return seen


def ordered_themes():
    """(slug, Theme or None) in presentation order -- `list`, the picker,
    next/prev: the brand first, then themes that follow Dark Style, then
    dark-only, then light-only, each by name; anything that does not parse
    last. Dark first because that is this desktop's default. Each theme is
    parsed once, here."""
    rows = []
    for slug, path in find_themes().items():
        try:
            t = Theme(path)
            kind = 0 if t.both else (1 if t.prefer == "dark" else 2)   # both, dark-only, light-only
            rows.append(((slug not in ("pulsar", "pulsar-holo"), kind, t.name.lower()), slug, t))
        except Exception:
            rows.append(((True, 3, slug), slug, None))
    return [(slug, t) for _k, slug, t in sorted(rows, key=lambda r: r[0])]


def load_theme(name):
    themes = find_themes()
    if name in themes:
        return Theme(themes[name])
    p = pathlib.Path(name)
    if p.is_dir() and (p / "theme.toml").exists():
        return Theme(p / "theme.toml")
    if p.name == "theme.toml" and p.exists():
        return Theme(p)
    close = [s for s in themes if name.lower() in s.lower()]
    if len(close) == 1:
        return Theme(themes[close[0]])
    sys.exit(f"pulsar-theme: no theme '{name}'" + (f" (did you mean: {', '.join(close)})" if close else ""))

# --------------------------------------------------------------- dconf ----


# Tests point this at a JSON file and never reach a session bus, so a test
# can never write the real dconf of whoever runs it (tests/theme.bats).
FAKE_DCONF = os.environ.get("PULSAR_THEME_FAKE_DCONF")


def _fake():
    f = pathlib.Path(FAKE_DCONF)
    return json.loads(f.read_text()) if f.exists() else {}


def dconf_read(key):
    if FAKE_DCONF:
        return _fake().get(key)
    # no dconf binary (a build host, a container): the key has no value here,
    # which `render` and the audit must survive rather than crash on
    try:
        r = subprocess.run(["dconf", "read", key], capture_output=True, text=True)
    except FileNotFoundError:
        return None
    v = r.stdout.strip()
    return v or None


def dconf_write(key, value):
    if FAKE_DCONF:
        d = _fake()
        if value is None:
            d.pop(key, None)
        else:
            d[key] = value
        pathlib.Path(FAKE_DCONF).write_text(json.dumps(d, indent=1))
        return
    if value is None:
        subprocess.run(["dconf", "reset", key], check=True)
    else:
        subprocess.run(["dconf", "write", key, value], check=True, stderr=subprocess.DEVNULL)


def uread(p):
    """A user file as text, whatever its bytes. surrogateescape carries any
    non-UTF-8 byte through unchanged, and uwrite puts it back exactly --
    'replace' would have corrupted it on the way out."""
    p = pathlib.Path(p)
    return p.read_text(encoding="utf-8", errors="surrogateescape") if p.exists() else ""


def uenc(text):
    return text.encode("utf-8", errors="surrogateescape")


def gv_str(s):
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"

# ---------------------------------------------------------- transaction ----


class Transaction:
    """Stage everything, then commit. Each file is replaced with rename(2);
    each dconf key is written once. The first time any path or key is ever
    touched, its original state goes into the BASELINE, which `revert`
    restores. If the commit fails part-way, this transaction's own pre-images
    are put back, so a failed `set` leaves the desktop as it found it."""

    def __init__(self, dry=False):
        self.files = {}      # path -> bytes | None (None = delete)
        self.shared = {}     # path -> undo spec, for files the USER owns too
        self.keys = {}       # dconf key -> gvariant text | None (reset)
        self.after = []      # (description, callable) run after commit; failures are warnings
        self.dry = dry
        self.base_dir = STATE / "baseline"
        self.base_manifest = self.base_dir / "manifest.json"

    def write(self, path, content):
        """Stage a file. False when it is a symlink out of the home folder,
        which is left exactly as it is (see link_outside_home)."""
        real = link_outside_home(path)
        if real is not None:
            print(f"  skip {path}: it links outside your home folder ({real}); not writing through it",
                  file=sys.stderr)
            return False
        if isinstance(content, str):
            content = uenc(content)
        self.files[pathlib.Path(path)] = content
        return True

    def remove(self, path):
        self.files[pathlib.Path(path)] = None

    def edit(self, path, content, undo):
        """A file the user owns too (gtk.css, btop.conf, a keyfile). Revert
        takes back only what `undo` names -- the managed block, or these
        keys -- and leaves every other line, including edits made since."""
        if self.write(path, content):
            self.shared[pathlib.Path(path)] = undo

    def set(self, key, value):
        self.keys[key] = value

    def hook(self, desc, fn):
        self.after.append((desc, fn))

    def _load_baseline(self):
        if self.base_manifest.exists():
            return resolve_inflight(json.loads(self.base_manifest.read_text()))
        return {"created": datetime.datetime.now().isoformat(timespec="seconds"), "files": {}, "keys": {}}

    def commit(self):
        if self.dry:
            for p, c in self.files.items():
                print(f"  would write {p} ({'delete' if c is None else len(c)} bytes)")
            for k, v in self.keys.items():
                print(f"  would set   {k} = {v}")
            return
        base = self._load_baseline()
        (self.base_dir / "files").mkdir(parents=True, exist_ok=True)
        # 1. baseline: remember originals we have never seen before
        base.setdefault("shared", {})
        base.setdefault("wrote", {})
        for p, undo in self.shared.items():
            rec = base["shared"].setdefault(str(p), {"existed": p.exists(), **undo, "orig": {}})
            if undo["kind"] in ("conf", "keyfile", "json"):
                text = uread(p)
                for k in undo["keys"]:
                    if k not in rec["orig"]:
                        rec["orig"][k] = (conf_value(text, k) if undo["kind"] == "conf"
                                          else json_get(text, k) if undo["kind"] == "json"
                                          else _kf_get(text, undo["group"], k))
            elif undo["kind"] == "list":
                text = uread(p)
                had = [x for x in (_kf_get(text, undo["group"], undo["key"]) or "").split(";") if x]
                rec.setdefault("added", [])
                for it in undo["items"]:
                    if it not in had and it not in rec["added"]:
                        rec["added"].append(it)
        for p in self.files:
            sp = str(p)
            if p in self.shared:
                continue
            if sp not in base["files"]:
                if p.exists():
                    blob = self.base_dir / "files" / hashlib.sha256(sp.encode()).hexdigest()[:16]
                    # the content, not the link: revert writes it back
                    # through the link, which stays (atomic_write)
                    shutil.copy2(p, blob)
                    base["files"][sp] = {"existed": True, "backup": blob.name}
                else:
                    base["files"][sp] = {"existed": False}
        for k in self.keys:
            if k not in base["keys"]:
                base["keys"][k] = dconf_read(k)
        # In flight: what this commit is about to write. If the process dies
        # before `wrote` lands, the next run resolves it -- a key still at the
        # intended value is the engine's, not a user change.
        base["inflight"] = {k: v for k, v in self.keys.items() if v is not None}
        atomic_write(self.base_manifest, json.dumps(base, indent=1).encode())
        # 2. pre-images for rollback of THIS transaction
        pre_files = {p: (p.read_bytes() if p.is_file() else None) for p in self.files}
        pre_keys = {k: dconf_read(k) for k in self.keys}
        done_f, done_k = [], []
        try:
            for p, c in self.files.items():
                if c is None:
                    if p.exists():
                        p.unlink()
                else:
                    atomic_write(p, c)
                done_f.append(p)
            for k, v in self.keys.items():
                dconf_write(k, v)
                done_k.append(k)
        except Exception as e:
            print(f"pulsar-theme: commit failed ({e}); rolling back", file=sys.stderr)
            for p in done_f:
                if pre_files[p] is None:
                    p.unlink(missing_ok=True)
                else:
                    atomic_write(p, pre_files[p])
            for k in done_k:
                dconf_write(k, pre_keys[k])
            raise
        # What the engine last wrote, recorded only once it has landed, and as
        # read BACK (dconf's own printing, file values as they now stand), so
        # the comparison later is like with like. revert leaves anything the
        # user has changed since alone, and init tells its own writes from
        # the user's choices.
        base["wrote"].update({k: dconf_read(k) for k in self.keys})
        base.pop("inflight", None)
        for p, undo in self.shared.items():
            if undo["kind"] in ("conf", "keyfile", "json"):
                text = uread(p)
                rec = base["shared"][str(p)].setdefault("wrote", {})
                for k in undo["keys"]:
                    rec[k] = (conf_value(text, k) if undo["kind"] == "conf"
                              else json_get(text, k) if undo["kind"] == "json"
                              else _kf_get(text, undo["group"], k))
        atomic_write(self.base_manifest, json.dumps(base, indent=1).encode())
        for desc, fn in self.after:
            try:
                fn()
            except Exception as e:  # a reload hint failing never undoes a theme
                print(f"  note: {desc} failed: {e}", file=sys.stderr)


def in_home(p):
    """Whether a path, links resolved, is inside the home folder."""
    try:
        return pathlib.Path(p).resolve().is_relative_to(HOME.resolve())
    except (OSError, RuntimeError):   # a link loop
        return False


def link_outside_home(p):
    """A dotfile that is a symlink out of the home folder (a Nix store, a
    shared /etc file): the engine neither writes through it nor replaces the
    link. None when the path is not such a link."""
    p = pathlib.Path(p)
    return p.resolve() if p.is_symlink() and not in_home(p) else None


def atomic_write(path, data):
    path = pathlib.Path(path)
    # A dotfile symlinked into a dotfile repo (stow, chezmoi) is written
    # THROUGH: the repo gets the edit and the link stays a link. Replacing
    # the link with a file would cut the repo off without a word. Links out
    # of the home folder never get here (Transaction.write skips them).
    if path.is_symlink() and in_home(path):
        path = path.resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        # the file keeps its permissions; a new one gets the usual umask's
        mode = stat.S_IMODE(path.stat().st_mode)
    except FileNotFoundError:
        mask = os.umask(0)
        os.umask(mask)
        mode = 0o666 & ~mask
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


EXT_UUID = "pulsar-theme@arclight.digital"
# in STATE/shell: the one mode the applied theme has, for the extension
ONE_MODE = "one-mode.json"


def gsettings_get(schema, key, path=None):
    if FAKE_DCONF:
        return dconf_read((path or "/" + schema.replace(".", "/") + "/") + key)
    r = subprocess.run(["gsettings", "get", f"{schema}:{path}" if path else schema, key],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def key_schema(key):
    """dconf key -> (schema id, path or None, key name)."""
    d, _, name = key.rpartition("/")
    if d.startswith("/org/gnome/Ptyxis/Profiles/"):
        return "org.gnome.Ptyxis.Profile", d + "/", name
    return d.strip("/").replace("/", "."), None, name


def upstream_default(schema, name):
    """The default in the schema XML itself -- i.e. before any vendor
    override (Fedora's, Pulsar's zz0). That is what 'stock GNOME' means."""
    dirs = [pathlib.Path(p) / "glib-2.0" / "schemas"
            for p in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
    for d in dirs:
        for x in sorted(d.glob("*.gschema.xml")) if d.is_dir() else []:
            if f'id="{schema}"' not in x.read_text(errors="ignore"):
                continue
            for sch in ET.parse(x).getroot().iter("schema"):
                if sch.get("id") != schema:
                    continue
                for k in sch.iter("key"):
                    if k.get("name") == name and k.find("default") is not None:
                        return k.find("default").text.strip()
    return None


def gv_equal(a, b):
    """Two GVariant texts, compared as values: dconf prints its own
    normalised form, which is not always what was written."""
    if a is None or b is None:
        return a == b
    try:
        from gi.repository import GLib
        return GLib.Variant.parse(None, a, None, None).equal(GLib.Variant.parse(None, b, None, None))
    except Exception:
        return a.strip() == b.strip()


def resolve_inflight(base):
    for k, v in base.pop("inflight", {}).items():
        cur = dconf_read(k)
        if cur is not None and gv_equal(cur, v):
            base.setdefault("wrote", {})[k] = cur
    return base


def revert(to="stock"):
    """Put back everything the engine changed. Files come back byte-for-byte.
    Keys the user had set come back to their value. Keys that were unset --
    i.e. showing the IMAGE default, which on Pulsar is the Pulsar look -- are
    written to GNOME's upstream default (to="stock"), or just reset to the
    image default (to="image")."""
    man = STATE / "baseline" / "manifest.json"
    base = resolve_inflight(json.loads(man.read_text())) if man.exists() else {"files": {}, "keys": {}}
    # Files only the engine writes: back to exactly what was there.
    for sp, info in base["files"].items():
        p = pathlib.Path(sp)
        if info["existed"]:
            atomic_write(p, (STATE / "baseline" / "files" / info["backup"]).read_bytes())
            print(f"  restored {p}")
        elif p.exists():
            p.unlink()
            print(f"  removed  {p}")
    # Files the user owns too: take back only our part.
    for sp, rec in base.get("shared", {}).items():
        p = pathlib.Path(sp)
        if not p.exists():
            continue
        text = uread(p)
        if rec["kind"] == "block":
            text = strip_block(text)
        elif rec["kind"] in ("conf", "keyfile"):
            for k, v in rec["orig"].items():
                now = conf_value(text, k) if rec["kind"] == "conf" else _kf_get(text, rec["group"], k)
                if k in rec.get("wrote", {}) and now != rec["wrote"][k]:
                    print(f"  kept     {p}: {k} (changed since the theme set it)")
                    continue
                if rec["kind"] == "conf":
                    text = conf_unset(text, k) if v is None else conf_set_text(text, k, v)
                else:
                    text = (_kf_remove(text, rec["group"], k) if v is None
                            else _kf_edit(text, rec["group"], k, lambda _o, v=v: v))
        elif rec["kind"] == "json":
            for k, v in rec["orig"].items():
                if k in rec.get("wrote", {}) and json_get(text, k) != rec["wrote"][k]:
                    print(f"  kept     {p}: {k} (changed since the theme set it)")
                    continue
                try:
                    text = json_set(text, k, v)
                except ValueError:
                    print(f"  kept     {p}: not JSON any more, left as it is")
                    break
            # a file the engine created, now back to nothing: it goes
            if not rec["existed"] and text.strip() in ("{}", ""):
                text = ""
        elif rec["kind"] == "list":
            cur = [x for x in (_kf_get(text, rec["group"], rec["key"]) or "").split(";") if x]
            keep = [x for x in cur if x not in rec.get("added", [])]
            text = (_kf_edit(text, rec["group"], rec["key"], lambda _o: ";".join(keep) + ";") if keep
                    else _kf_remove(text, rec["group"], rec["key"]))
        if not rec["existed"] and not text.strip():
            p.unlink()
            print(f"  removed  {p}")
        else:
            atomic_write(p, uenc(text))
            print(f"  cleaned  {p}")
    wrote = base.get("wrote", {})
    # Ptyxis profiles are the user's once they exist: a profile the engine
    # created for a fresh account stays (its palette key is reset below),
    # and so does every profile made since.
    keys = {k: v for k, v in base["keys"].items()
            if k not in ("/org/gnome/Ptyxis/profile-uuids", "/org/gnome/Ptyxis/default-profile-uuid")}
    # A key the user has changed since the engine wrote it is theirs now.
    for k in list(keys):
        if k in wrote and dconf_read(k) != wrote[k]:
            print(f"  kept     {k} (changed since the theme set it)")
            del keys[k]
    if to == "stock":
        # image-default keys the engine never wrote still wear the Pulsar look
        for k in STOCK_KEYS:
            keys.setdefault(k, dconf_read(k))
    for k, v in keys.items():
        if k == "/org/gnome/shell/enabled-extensions":
            continue
        if v is not None:
            dconf_write(k, v)
            print(f"  restored {k} = {v}")
            continue
        dconf_write(k, None)
        if to != "stock":
            print(f"  reset    {k}")
            continue
        schema, path, name = key_schema(k)
        up, eff = upstream_default(schema, name), gsettings_get(schema, name, path)
        if up is not None and eff is not None and up.replace(" ", "") != eff.replace(" ", "").replace("@as", ""):
            up = "@as []" if up.replace(" ", "") == "[]" else up   # untyped [] is not valid GVariant text
            try:
                dconf_write(k, up)
                print(f"  stock    {k} = {up}  (image default was {eff})")
            except subprocess.CalledProcessError:
                print(f"  reset    {k}  (could not write upstream {up})")
        else:
            print(f"  reset    {k}")
    # The extension: keep whatever else is enabled, drop ours. Only if the
    # engine ever wrote the list: one it never touched is left as it is.
    ek = "/org/gnome/shell/enabled-extensions"
    if ek in base["keys"]:
        before, now = base["keys"][ek], dconf_read(ek)
        if now is not None and ek in wrote and not gv_equal(now, wrote[ek]):
            # extensions enabled (or disabled) since theming are the user's:
            # take out only ours, and only if it was not on before
            had = parse_gv_list(before) if before is not None else None
            drop = had is not None and EXT_UUID not in had
            keep = [x for x in parse_gv_list(now) if not (drop and x == EXT_UUID)]
            dconf_write(ek, "[" + ", ".join(gv_str(x) for x in keep) + "]" if keep else "@as []")
            print(f"  kept     {ek} (changed since the theme set it)" + (f", without {EXT_UUID}" if drop else ""))
        else:
            dconf_write(ek, before)
    eff = parse_gv_list(gsettings_get("org.gnome.shell", "enabled-extensions"))
    if to == "stock" and EXT_UUID in eff:
        dconf_write("/org/gnome/shell/enabled-extensions", "[" + ", ".join(gv_str(x) for x in eff if x != EXT_UUID) + "]")
        print(f"  disabled {EXT_UUID}")
    shutil.rmtree(STATE / "baseline", ignore_errors=True)
    (STATE / "current.json").unlink(missing_ok=True)
    (STATE / "notice.json").unlink(missing_ok=True)
    (STATE / "init.pending").unlink(missing_ok=True)
    # never re-apply at the next login: the user chose this
    atomic_write(STATE / "init.json", json.dumps({"result": "reverted", "to": to,
                 "at": datetime.datetime.now().isoformat(timespec="seconds")}).encode())
    reload_running()
    print(f"pulsar-theme: reverted to {'stock GNOME' if to == 'stock' else 'the image defaults'}")


# Keys the Pulsar IMAGE sets a default for (zz0: wallpaper, color-scheme);
# `revert` sends them to upstream GNOME even if the engine never wrote them.
STOCK_KEYS = [
    "/org/gnome/desktop/interface/accent-color",
    "/org/gnome/desktop/interface/color-scheme",
    "/org/gnome/desktop/background/picture-uri",
    "/org/gnome/desktop/background/picture-uri-dark",
    "/org/gnome/desktop/background/primary-color",
    "/org/gnome/TextEditor/style-scheme",
]

# -------------------------------------------------------------- render ----


TPL = re.compile(r"\{\{\s*([a-z0-9_]+)\s*\}\}")


def render_tpl(text, ctx, where="template"):
    def sub(m):
        k = m.group(1)
        if k not in ctx:
            raise KeyError(f"{where}: unknown placeholder {{{{ {k} }}}}")
        return str(ctx[k])
    return TPL.sub(sub, text)


def template(name):
    """User templates in $XDG_CONFIG_HOME/pulsar/themed/ beat the image's."""
    for d in [CONFIG / "pulsar" / "themed"] + TEMPLATE_PATH:
        if (d / name).exists():
            return (d / name).read_text()
    raise FileNotFoundError(name)


# The templates each target renders from. An image update that changes one
# leaves every account's rendered copy as it was until the theme is set
# again; templates_seen() is what `window-glass --if-stale` compares.
TEMPLATED = {
    "gtk4": ("gtk4.css",), "gtk3": ("gtk3.css",), "ptyxis": ("ptyxis.palette",),
    "gtksourceview": ("gtksourceview.xml",), "shell": ("gnome-shell.css", "gnome-shell-glow.css"),
    "btop": ("btop.theme",),
}


def templates_seen():
    """One hash of every template as template() resolves it (a user's own
    in $XDG_CONFIG_HOME/pulsar/themed/ included), for the rendered copies to
    be checked against."""
    h = hashlib.sha256()
    for name in sorted(n for names in TEMPLATED.values() for n in names):
        try:
            h.update(name.encode() + b"\0" + template(name).encode() + b"\0")
        except FileNotFoundError:
            h.update(name.encode() + b"\0-\0")
    return h.hexdigest()[:16]


def theme_override(theme, name):
    """A hand-written file in the theme dir beats the template."""
    p = theme.dir / name
    return p.read_text() if p.exists() else None


def variant_blocks(theme, variant_mode, tpl_name, wrap):
    """Render tpl once per variant. With both variants, `wrap(mode, body)`
    fences each one (e.g. in a CSS media query) so light/dark keeps working."""
    tpl = template(tpl_name)
    if variant_mode == "both" and theme.both:
        return "".join(wrap(m, render_tpl(tpl, theme.variants[m].ctx(), tpl_name)) for m in ("light", "dark"))
    v = theme.variants[variant_mode if variant_mode in theme.variants else theme.prefer]
    return wrap(None, render_tpl(tpl, v.ctx(), tpl_name))


MARK_BEGIN = "/* >>> pulsar-theme (managed; `pulsar-theme revert` removes it) >>> */"
MARK_END = "/* <<< pulsar-theme <<< */"


def managed(path, block):
    """Put our block at the END of a user-owned CSS file (later wins at equal
    priority) and leave everything else in it alone."""
    old = uread(path)
    old = re.sub(re.escape(MARK_BEGIN) + r".*?" + re.escape(MARK_END) + r"\n?", "", old, flags=re.S)
    old = old.rstrip() + ("\n\n" if old.strip() else "")
    return old + MARK_BEGIN + "\n" + block.rstrip() + "\n" + MARK_END + "\n"

def json_get(text, key):
    """A dotted key's value in a JSON document, or None. Unparseable text is
    treated as absent: the engine never rewrites a file it cannot read."""
    try:
        obj = json.loads(text) if text.strip() else {}
    except ValueError:
        return None
    for part in key.split("."):
        if not isinstance(obj, dict) or part not in obj:
            return None
        obj = obj[part]
    return obj


def json_text(obj):
    """JSON as the agents write it (UTF-8, not \\u-escaped), except any lone
    UTF-16 surrogate, which goes back as the \\u escape it came in as. A
    JavaScript app (Claude Code) writes one when it cuts an emoji in half; it
    parses, but a lone surrogate cannot be encoded as UTF-8, and writing it
    raw crashed every theme switch."""
    return re.sub("[\ud800-\udfff]", lambda m: f"\\u{ord(m.group()):04x}",
                  json.dumps(obj, indent=2, ensure_ascii=False)) + "\n"


def json_set(text, key, value):
    """Set (value not None) or remove a dotted key, keeping every other key
    and their order. Raises on text that is not a JSON object, so a file the
    user broke is left alone rather than replaced."""
    obj = json.loads(text) if text.strip() else {}
    if not isinstance(obj, dict):
        raise ValueError("not a JSON object")
    parts = key.split(".")
    chain = [obj]
    for part in parts[:-1]:
        if value is None and not isinstance(chain[-1].get(part), dict):
            return json_text(obj)
        chain.append(chain[-1].setdefault(part, {}))
    if value is None:
        chain[-1].pop(parts[-1], None)
        # and the parents it leaves empty ({"ui": {}} is not a setting)
        for parent, part in zip(reversed(chain[:-1]), reversed(parts[:-1])):
            if parent.get(part) == {}:
                parent.pop(part)
    else:
        chain[-1][parts[-1]] = value
    return json_text(obj)


# -------------------------------------------------------------- targets ----


class Target:
    name = ""
    desc = ""
    default = True        # part of `set` unless --only says otherwise
    live = ""             # how/if running apps pick the change up

    def available(self):
        return True

    def apply(self, tx, theme, vm):
        raise NotImplementedError


class Scheme(Target):
    name, desc, live = "scheme", "color-scheme + libadwaita system accent", "live everywhere (Shell, GTK4, Flatpaks via portal)"

    def apply(self, tx, theme, vm):
        # Dark Style is the user's switch. A two-variant theme follows it and
        # never writes it; only a theme with one variant, or an explicit
        # --variant, has a scheme to insist on.
        if vm == "both" and theme.both:
            mode = current_scheme()
        else:
            mode = theme.prefer if vm == "both" else vm
            tx.set("/org/gnome/desktop/interface/color-scheme", gv_str("prefer-dark" if mode == "dark" else "default"))
        v = theme.variants[mode if mode in theme.variants else theme.prefer]
        tx.set("/org/gnome/desktop/interface/accent-color", gv_str(v.gnome_accent))


def glass_tint():
    """The Shell extension's Glass tint slider, 0 (clear) to 1 (fully tinted),
    as the alpha of the glass surfaces' own tint: 0.35 to 0.95."""
    try:
        t = float(gsettings_get("org.gnome.shell.extensions.pulsar-theme", "glass-tint"))
    except (TypeError, ValueError):
        t = 0.5
    return round(0.35 + 0.6 * min(max(t, 0.0), 1.0), 3)


GLASS_MARK = "pulsar window-glass: "


def window_glass_written():
    """The glass state gtk4 was last written for: True, False, or None when
    unknown (never written, or written before the mark existed)."""
    try:
        text = (CONFIG / "gtk-4.0" / "gtk.css").read_text(errors="replace")
    except OSError:
        return None
    i = text.find(GLASS_MARK)
    if i < 0:
        return None
    return text[i + len(GLASS_MARK):].startswith("on")


def ext_turned_off():
    """Whether the user switched the extension off (the Extensions app or
    gnome-extensions disable). GNOME records that in disabled-extensions,
    which wins over enabled-extensions: a uuid in both stays off."""
    return EXT_UUID in parse_gv_list(gsettings_get("org.gnome.shell", "disabled-extensions"))


# Glow in proportion to size. t is an element's thickness -- its short
# side, in logical pixels -- measured where it renders: the Shell's in the
# theme gate's headless Shell (GNOME 50, the stock sheet under ours), GTK's
# from libadwaita / adw-gtk3's own sizes and checked against the gate's
# screenshots. A new element gets its thickness measured and a row here.
GLOW_THICKNESS = {
    # Shell
    "toggle": 52,           # a checked quick toggle, plain or split (152-192 x 52)
    "today": 39,            # today in the calendar (39 x 39)
    "button": 30,           # .button.default in a dialog's button row
    "icon_button": 43,      # .icon-button.default (a round 43)
    "switch": 26,           # a popup menu's toggle switch (46 x 26)
    "check": 20,            # a checked check box's box (20 x 20)
    "candidate": 34,        # the input method's selected candidate
    "osd_label": 89,        # the monitor-number label (96 x 89)
    "dot": 9,               # the top bar's active workspace dot (29 x 9)
    "ws_indicator": 6,      # the workspace switcher's active bar (94 x 6)
    "slider": 4,            # a slider's fill (the bar is 4; glass.js draws it)
    # GTK (4 and 3)
    "gtk_check": 20,        # check and radio: 14 + 2 x 3 padding
    "gtk_switch": 26,
    "gtk_button": 34,       # a suggested button: 24 + 2 x 5 padding
    "gtk_scale": 6,         # a scale's fill
    "gtk_progress": 8,      # a progress bar's
}


def glow_for(t, dark):
    """(blur px, alpha) for an element t logical pixels thick. Both grow
    with size: a big pill (a quick toggle, 52px) gets the widest, strongest
    halo, a thin bar a short faint one (Nick, 2026-09-28: "the big pill
    buttons should have a stronger wider glow and the bars should be shorter
    and weaker"). Reach 0.5 + 0.2 x t, 2.5 to 11px (the floor keeps a thin
    bar's glow from vanishing into a hairline); strength by the 0.35
    power of size against a 20px check box, 0.55x to 1.35x. Light themes a
    notch smaller and weaker: a colored halo on a light ground reads as a
    smudge. glass.js repeats the reach for sliders."""
    blur = min(max(0.5 + 0.2 * t, 2.5), 11.0) * (1.0 if dark else 0.85)
    alpha = (0.45 if dark else 0.3) * min(max((t / 20) ** 0.35, 0.55), 1.35)
    return round(blur, 1), round(alpha, 2)


def glow_on():
    """Whether the Glow effect is on, as window_glass() reads the rest: the
    Shell extension's switch, not high contrast, and the extension actually
    running. The Shell half follows the extension live; this is GTK's half."""
    sid = "org.gnome.shell.extensions.pulsar-theme"
    if gsettings_get(sid, "glow") != "true":
        return False
    if gsettings_get("org.gnome.desktop.a11y.interface", "high-contrast") == "true":
        return False
    if gsettings_get("org.gnome.shell", "disable-user-extensions") == "true":
        return False
    if ext_turned_off():
        return False
    return f"'{EXT_UUID}'" in (gsettings_get("org.gnome.shell", "enabled-extensions") or "")


def window_glass():
    """Whether GTK windows go translucent: only while the Shell extension is
    enabled and would draw its blur behind them -- Glass and Glass windows
    on, high contrast off. Otherwise translucent windows would show the
    desktop sharp. Off when the extension's schema is not installed."""
    sid = "org.gnome.shell.extensions.pulsar-theme"
    if gsettings_get(sid, "glass") != "true" or gsettings_get(sid, "window-glass") != "true":
        return False
    if gsettings_get("org.gnome.desktop.a11y.interface", "high-contrast") == "true":
        return False
    if gsettings_get("org.gnome.shell", "disable-user-extensions") == "true":
        return False
    # switched off: nothing draws the blur, whatever enabled-extensions says
    if ext_turned_off():
        return False
    return f"'{EXT_UUID}'" in (gsettings_get("org.gnome.shell", "enabled-extensions") or "")


# GTK 4.22 blurs what is behind a widget itself (backdrop-filter), so an
# in-window dialog can be glass there; older GTK -- a Flatpak on an older
# GNOME runtime reading the same gtk.css -- keeps it solid. The gate is
# reduced motion, the one @media feature that came in the same release: a
# GTK that does not know it drops the whole block, and either value is
# true on one that does. Top-level blocks of their own: an unknown feature
# nested inside a variant's block might take that block down with it.
MOTION = ("(prefers-reduced-motion: no-preference)", "(prefers-reduced-motion: reduce)")

# The filter sheet_glass runs after the blur: every pixel of it opaque, so it
# covers the page it was made from instead of being laid over it. Beside
# gtk.css, where its url() resolves, and where the Flatpak override reaches.
BACKDROP_SVG = "pulsar-backdrop.svg"
BACKDROP_SVG_TEXT = """<svg xmlns="http://www.w3.org/2000/svg">
  <!-- written by pulsar-theme: gtk.css's in-window glass needs it -->
  <filter id="opaque" color-interpolation-filters="sRGB">
    <feComponentTransfer>
      <feFuncA type="linear" slope="0" intercept="1"/>
    </feComponentTransfer>
  </filter>
</svg>
"""


def sheet_glass_blocks(theme, vm):
    if vm == "both" and theme.both:
        modes = ("light", "dark")
    else:
        modes = (vm if vm in theme.variants else theme.prefer,)
    out = ""
    for m in modes:
        body = theme.variants[m].ctx()["sheet_glass"]
        if not body:
            continue
        scheme = f"(prefers-color-scheme: {m}) and " if len(modes) == 2 else ""
        out += f"@media {', '.join(scheme + q for q in MOTION)} {{\n{body}}}\n"
    return out


class Gtk4(Target):
    name, desc, live = "gtk4", "libadwaita CSS variables in gtk-4.0/gtk.css", "new windows only: GTK reads gtk.css once at startup"

    def apply(self, tx, theme, vm):
        glass = window_glass()
        tint = glass_tint()
        glow = glow_on()
        for v in theme.variants.values():
            v.window_glass = glass
            v.glass_alpha = tint
            v.glow = glow
        def wrap(m, body):
            if m is None:
                return body
            return f"@media (prefers-color-scheme: {m}) {{\n{body}}}\n"
        # the glass state it was written for, which `window-glass --if-stale` reads
        block = (f"/* {css_comment(theme.name)} */\n/* {GLASS_MARK}{'on' if glass else 'off'} */\n" +
                 variant_blocks(theme, vm, "gtk4.css", wrap) + sheet_glass_blocks(theme, vm))
        # The filter before the sheet that names it (files commit in order):
        # GTK reads the url() as it parses, and without the file it drops the
        # blur and keeps the see-through tint.
        if glass:
            tx.write(CONFIG / "gtk-4.0" / BACKDROP_SVG, BACKDROP_SVG_TEXT)
        p = CONFIG / "gtk-4.0" / "gtk.css"
        tx.edit(p, managed(p, block), {"kind": "block"})


class Gtk3(Target):
    name, desc, live = "gtk3", "adw-gtk3 / Adwaita named colors in gtk-3.0/gtk.css", "new windows only"

    def apply(self, tx, theme, vm):
        # GTK3 has no media queries: it gets the variant for the scheme in
        # effect NOW. A later Dark Style flip is caught by the Shell
        # extension, which runs follow-scheme to redo just this target.
        mode = (current_scheme() if theme.both else theme.prefer) if vm == "both" else vm
        mode = mode if mode in theme.variants else theme.prefer
        v = theme.variants[mode]
        v.glow = glow_on()
        block = render_tpl(template("gtk3.css"), v.ctx(), "gtk3.css")
        p = CONFIG / "gtk-3.0" / "gtk.css"
        tx.edit(p, managed(p, f"/* {css_comment(theme.name)} ({mode}) */\n" + block), {"kind": "block"})
        if any(d.joinpath("themes", "adw-gtk3").is_dir() for d in (DATA, pathlib.Path("/usr/share"))):
            tx.set("/org/gnome/desktop/interface/gtk-theme", gv_str("adw-gtk3-dark" if mode == "dark" else "adw-gtk3"))


PTYXIS_GLASS_OPACITY = "0.85"


class Ptyxis(Target):
    name, desc, live = "ptyxis", "Ptyxis palette file + palette key on every profile", "live (Ptyxis watches its settings)"

    def available(self):
        return shutil.which("ptyxis") is not None or pathlib.Path("/usr/bin/ptyxis").exists()

    def apply(self, tx, theme, vm):
        pid = f"pulsar-{theme.slug}"
        lines = ["[Palette]", f"Name={theme.name}", ""]
        modes = ("light", "dark") if (vm == "both" and theme.both) else (theme.prefer if vm == "both" else vm,) * 2
        for section, m in zip(("Light", "Dark"), modes):
            lines.append(f"[{section}]")
            lines.append(render_tpl(template("ptyxis.palette"), theme.variants[m].ctx(), "ptyxis.palette").rstrip())
            lines.append("")
        tx.write(DATA / "org.gnome.Ptyxis" / "palettes" / f"{pid}.palette", "\n".join(lines))
        uuids = parse_gv_list(dconf_read("/org/gnome/Ptyxis/profile-uuids"))
        if not uuids:
            # Fresh user: Ptyxis has not created its default profile yet.
            u = hashlib.md5(os.urandom(16)).hexdigest()
            uuids = [u]
            tx.set("/org/gnome/Ptyxis/profile-uuids", "[" + gv_str(u) + "]")
            tx.set("/org/gnome/Ptyxis/default-profile-uuid", gv_str(u))
        glass = window_glass()
        for u in uuids:
            tx.set(f"/org/gnome/Ptyxis/Profiles/{u}/palette", gv_str(pid))
            # Glass windows: the terminal's background goes translucent over
            # the blur the Shell extension draws behind the window. Only a
            # profile at the default or at our own value: an opacity the user
            # picked is theirs.
            key = f"/org/gnome/Ptyxis/Profiles/{u}/opacity"
            try:
                cur = float(dconf_read(key) or 1.0)
            except ValueError:
                cur = None
            # (compared as numbers: dconf reads 0.80 back as 0.80000000000000004)
            if cur is not None and any(abs(cur - v) < 1e-6 for v in (1.0, float(PTYXIS_GLASS_OPACITY))):
                tx.set(key, PTYXIS_GLASS_OPACITY if glass else "1.0")
        # Ptyxis ships interface-style='dark' regardless of the desktop; a
        # two-variant theme only follows the Dark Style toggle with 'system'.
        tx.set("/org/gnome/Ptyxis/interface-style", gv_str("system" if (vm == "both" and theme.both) else
                                                            (theme.prefer if vm == "both" else vm)))


class SourceView(Target):
    name, desc, live = "gtksourceview", "GtkSourceView 5 scheme + GNOME Text Editor style-scheme", "live for the key; new scheme files need an app restart"

    def apply(self, tx, theme, vm):
        dirs = [DATA / "gtksourceview-5" / "styles"]
        flat = HOME / ".var" / "app" / "org.gnome.TextEditor"
        if flat.is_dir():  # Flatpak Text Editor looks in its own XDG_DATA_HOME
            dirs.append(flat / "data" / "gtksourceview-5" / "styles")
        base = f"pulsar-{theme.slug}"
        modes = ["light", "dark"] if theme.both else [theme.prefer]
        for m in modes:
            v = theme.variants[m]
            sid = base if (m == "light" or not theme.both) else base + "-dark"
            ctx = dict(v.ctx(), id=sid, name=xml_escape(theme.name + (" Dark" if sid.endswith("-dark") and theme.both else "")),
                       author=xml_escape(theme.author or "pulsar-theme"),
                       pair=(base + "-dark" if m == "light" else base) if theme.both else sid,
                       pair_key="dark-variant" if m == "light" else "light-variant")
            xml = render_tpl(template("gtksourceview.xml"), ctx, "gtksourceview.xml")
            for d in dirs:
                tx.write(d / f"{sid}.xml", xml)
        # Text Editor turns "<id>" into "<id>-dark" by itself when the style is dark.
        tx.set("/org/gnome/TextEditor/style-scheme", gv_str(base))
        if flat.is_dir():
            kf = flat / "config" / "glib-2.0" / "settings" / "keyfile"
            tx.edit(kf, keyfile_set(kf, "org/gnome/TextEditor", "style-scheme", gv_str(base)),
                    {"kind": "keyfile", "group": "org/gnome/TextEditor", "keys": ["style-scheme"]})


class Wallpaper(Target):
    name, desc, live = "wallpaper", "desktop + lock-screen background (light/dark pair)", "live"

    def apply(self, tx, theme, vm):
        idx = current_state().get("wallpaper_index", 0) if current_state().get("theme") == theme.slug else 0
        # Renders are build output; an image built with --no-wallpapers has
        # none, and pointing GNOME at a missing file shows a grey desktop.
        have = {m: [w for w in theme.wallpapers[m] if w.exists()] for m in ("dark", "light")}
        if not have["dark"] and not have["light"]:
            have = {m: [BRAND_WALLPAPER[m]] if BRAND_WALLPAPER[m].exists() else [] for m in ("dark", "light")}
        theme.wallpapers = have
        dark = pick(theme.wallpapers["dark"], idx) or pick(theme.wallpapers["light"], idx)
        light = pick(theme.wallpapers["light"], idx) or dark
        if vm in ("dark", "light") and not theme.both:
            light = dark = pick(theme.wallpapers[vm], idx) or dark
        if not dark:
            return
        tx.set("/org/gnome/desktop/background/picture-uri", gv_str(light.as_uri()))
        tx.set("/org/gnome/desktop/background/picture-uri-dark", gv_str(dark.as_uri()))
        tx.set("/org/gnome/desktop/background/picture-options", gv_str("zoom"))
        bg = theme.variants[theme.prefer]["background_deep"].hex
        tx.set("/org/gnome/desktop/background/primary-color", gv_str(bg))
        # No org.gnome.desktop.screensaver write: GNOME 50's unlock dialog
        # blurs the desktop background and never reads that key.


class Shell(Target):
    name, desc, live = "shell", "GNOME Shell stylesheet via the pulsar-theme extension", "live (extension watches the file)"

    def apply(self, tx, theme, vm):
        # one sheet per scheme; the extension swaps them when Dark Style flips
        for scheme in ("dark", "light"):
            mode = scheme if (vm == "both" and scheme in theme.variants) else (theme.prefer if vm == "both" else vm)
            theme.variants[mode].glass_alpha = glass_tint()
            ctx = theme.variants[mode].ctx()
            css = render_tpl(template("gnome-shell.css"), ctx, "gnome-shell.css")
            # the Glow effect's rules, keyed off the class the extension sets
            css += "\n" + render_tpl(template("gnome-shell-glow.css"), ctx, "gnome-shell-glow.css")
            tx.write(STATE / "shell" / f"gnome-shell-{scheme}.css", f"/* {css_comment(theme.name)} ({mode}) */\n" + css)
        # A theme with one mode (or one pinned with --variant) has nothing for
        # Dark Style to swap to: the extension greys the Quick Settings toggle
        # out while this file names the mode in effect. A file, not a key:
        # the extension already watches this directory, and it costs no
        # dconf write. Revert and a two-mode theme remove it.
        lock = STATE / "shell" / ONE_MODE
        if vm == "both" and theme.both:
            if lock.exists():
                tx.remove(lock)
        else:
            tx.write(lock, json.dumps({"mode": theme.prefer if vm == "both" else vm, "name": theme.name,
                                       "pinned": theme.both}) + "\n")
        # Enable it, unless the user switched it off: that choice is theirs,
        # and re-adding it to enabled-extensions would not turn it back on
        # anyway (disabled-extensions wins) -- only confuse window_glass().
        eff = gsettings_get("org.gnome.shell", "enabled-extensions")
        if EXT_UUID not in parse_gv_list(eff) and not ext_turned_off():
            tx.set("/org/gnome/shell/enabled-extensions",
                   "[" + ", ".join(gv_str(x) for x in parse_gv_list(eff) + [EXT_UUID]) + "]")


class Btop(Target):
    name, desc, live = "btop", "btop theme + color_theme in btop.conf", "live (SIGUSR2 reloads btop)"

    def apply(self, tx, theme, vm):
        # btop has one theme file and no light/dark notion, so like GTK3 it is
        # written for the scheme in effect and follow-scheme redoes it on a
        # flip. (Its built-in TTY theme would follow the terminal for free,
        # but draws its labels in ANSI white, pale gray on a light palette.)
        # No painted background: the terminal's own ground is right.
        conf = CONFIG / "btop" / "btop.conf"
        mode = (current_scheme() if theme.both else theme.prefer) if vm == "both" else vm
        mode = mode if mode in theme.variants else theme.prefer
        path = CONFIG / "btop" / "themes" / f"pulsar-{theme.slug}.theme"
        tx.write(path, render_tpl(template("btop.theme"), theme.variants[mode].ctx(), "btop.theme"))
        tx.edit(conf, conf_set_many(conf, {"color_theme": f'"{path}"', "theme_background": "False"}),
                {"kind": "conf", "keys": ["color_theme", "theme_background"]})
        tx.hook("signal btop", lambda: subprocess.run(["pkill", "-USR2", "-x", "btop"], check=False))


class Flatpak(Target):
    name, desc, live = "flatpak", "let Flatpak apps read the host gtk.css (global user override)", "per app launch"
    # On by default: most of the desktop's own apps (Calculator, Calendar,
    # Text Editor, Loupe, Papers...) are Flatpaks here, and without this they
    # keep stock colours under every theme. The grant is read-only and names
    # only the two gtk.css dirs; --without flatpak turns it off and it stays
    # off across later switches.
    default = True

    def apply(self, tx, theme, vm):
        p = DATA / "flatpak" / "overrides" / "global"
        text = uread(p)
        items = FLATPAK_ITEMS
        for fs in items:
            text = keyfile_list_add(text, "Context", "filesystems", fs)
        tx.edit(p, text, {"kind": "list", "group": "Context", "key": "filesystems", "items": items})


    def remove(self, tx):
        """Turn the widening off again: exactly the entries the engine added
        (per the baseline), the way revert does, and nothing the user had."""
        p = DATA / "flatpak" / "overrides" / "global"
        man = STATE / "baseline" / "manifest.json"
        if not p.exists() or not man.exists():
            return False
        rec = json.loads(man.read_text()).get("shared", {}).get(str(p))
        if not rec:
            return False
        text = uread(p)
        cur = [x for x in (_kf_get(text, "Context", "filesystems") or "").split(";") if x]
        keep = [x for x in cur if x not in rec.get("added", [])]
        text = (_kf_edit(text, "Context", "filesystems", lambda _o: ";".join(keep) + ";") if keep
                else _kf_remove(text, "Context", "filesystems"))
        undo = {"kind": "list", "group": "Context", "key": "filesystems", "items": []}
        if not rec["existed"] and not text.strip():
            tx.files[p] = None
            tx.shared[p] = undo
        else:
            tx.edit(p, text, undo)
        return True


class Agents(Target):
    """Terminal coding agents draw their own colors. Where one can draw with
    the terminal's 16 ANSI colors instead, it is set to, so it wears whatever
    Ptyxis wears -- which is this theme. Only agents that are already set up
    here: a config file is never created for an agent nobody installed.

      Claude Code  ~/.claude.json "theme": dark-ansi. Light gets Claude's own
                   "light": its light-ansi draws code in ANSI color 7, which
                   every light palette puts a shade off the background
                   (anthropics/claude-code#40905).
      Gemini CLI   ~/.gemini/settings.json ui.theme: "ANSI"; light gets
                   "Default Light", for the same reason until checked.
      opencode     ~/.config/opencode/tui.json theme: "system", which follows
                   the terminal in both variants.

    Like GTK3 it is written for the scheme in effect, and follow-scheme
    redoes it when Dark Style flips."""
    name, desc, live = "agents", "coding agents (Claude Code, Gemini CLI, opencode) use the terminal's colors", "next time the agent starts"

    def plan(self, mode):
        dark = mode == "dark"
        out = []
        if (HOME / ".claude.json").is_file():
            out.append((HOME / ".claude.json", "theme", "dark-ansi" if dark else "light"))
        if (HOME / ".gemini").is_dir():
            out.append((HOME / ".gemini" / "settings.json", "ui.theme", "ANSI" if dark else "Default Light"))
        if (CONFIG / "opencode").is_dir():
            out.append((CONFIG / "opencode" / "tui.json", "theme", "system"))
        return out

    def available(self):
        return bool(self.plan("dark"))

    def apply(self, tx, theme, vm):
        mode = (current_scheme() if theme.both else theme.prefer) if vm == "both" else vm
        mode = mode if mode in theme.variants else theme.prefer
        for path, key, value in self.plan(mode):
            text = uread(path) if path.exists() else ""
            try:
                new = json_set(text, key, value)
            except ValueError:
                print(f"pulsar-theme: {path} is not JSON; leaving it alone", file=sys.stderr)
                continue
            if json_get(text, key) != value:
                tx.edit(path, new, {"kind": "json", "keys": [key]})


FLATPAK_ITEMS = ["xdg-config/gtk-4.0:ro", "xdg-config/gtk-3.0:ro"]
TARGETS = [Scheme(), Gtk4(), Gtk3(), Ptyxis(), SourceView(), Wallpaper(), Shell(), Btop(), Flatpak(), Agents()]

# --------------------------------------------------------------- helpers ----


def current_scheme():
    """'dark' or 'light': what Dark Style says right now."""
    v = gsettings_get("org.gnome.desktop.interface", "color-scheme") or ""
    return "dark" if "dark" in v else "light"


def css_comment(s):
    return s.replace("*/", "* /")


def pick(lst, i):
    return lst[i % len(lst)] if lst else None


def xml_escape(s):
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
             .replace('"', "&quot;").replace("'", "&apos;"))


def parse_gv_list(s):
    return re.findall(r"'([^']*)'", s or "")


def conf_set(path, key, value):
    return conf_set_text(uread(path), key, value)


def conf_value(text, key):
    m = re.search(rf"^{re.escape(key)}\s*=\s*(.*)$", text, flags=re.M)
    return m.group(1).strip() if m else None


def conf_unset(text, key):
    return re.sub(rf"^{re.escape(key)}\s*=.*\n?", "", text, flags=re.M)


def conf_set_text(text, key, value):
    line = f"{key} = {value}"
    if re.search(rf"^{re.escape(key)}\s*=", text, flags=re.M):
        return re.sub(rf"^{re.escape(key)}\s*=.*$", lambda _m: line, text, flags=re.M)
    return text + ("" if text.endswith("\n") or not text else "\n") + line + "\n"


def strip_block(text):
    text = re.sub(re.escape(MARK_BEGIN) + r".*?" + re.escape(MARK_END) + r"\n?", "", text, flags=re.S)
    return text.rstrip() + "\n" if text.strip() else ""


def _kf_get(text, group, key):
    in_g = False
    for ln in text.splitlines():
        m = re.match(r"^\[(.*)\]\s*$", ln)
        if m:
            in_g = m.group(1) == group
        elif in_g and ln.split("=", 1)[0].strip() == key and "=" in ln:
            return ln.split("=", 1)[1]
    return None


def _kf_remove(text, group, key):
    """Remove one key from one group. If that removal left THAT group with
    nothing in it -- no keys and no comments -- its header goes too, so a
    keyfile the engine created can end up empty and be deleted. Every other
    group, empty or not, and every comment, is the user's and stays."""
    lines = text.splitlines()
    out, in_g, removed, start = [], False, False, None
    for ln in lines:
        m = re.match(r"^\[(.*)\]\s*$", ln)
        if m:
            in_g = m.group(1) == group
            if in_g:
                start = len(out)
        elif in_g and "=" in ln and ln.split("=", 1)[0].strip() == key:
            removed = True
            continue
        out.append(ln)
    if removed and start is not None:
        end = start + 1
        while end < len(out) and not re.match(r"^\[(.*)\]\s*$", out[end]):
            end += 1
        if not any(b.strip() for b in out[start + 1:end]):
            del out[start:end]
    while out and not out[-1].strip():
        out.pop()
    return "\n".join(out) + ("\n" if out else "")


def conf_set_many(path, kv):
    text = uread(path)
    for k, v in kv.items():
        text = conf_set_text(text, k, v)
    return text


def keyfile_set(path, group, key, value):
    text = uread(path)
    return _kf_edit(text, group, key, lambda old: value)


def keyfile_list_add(text, group, key, item):
    def f(old):
        items = [x for x in (old or "").split(";") if x]
        if item not in items:
            items.append(item)
        return ";".join(items) + ";"
    return _kf_edit(text, group, key, f)


def _kf_edit(text, group, key, fn):
    lines = text.splitlines()
    out, in_g, done, seen_g = [], False, False, False
    for ln in lines:
        m = re.match(r"^\[(.*)\]\s*$", ln)
        if m:
            if in_g and not done:
                out.append(f"{key}={fn(None)}")
                done = True
            in_g = m.group(1) == group
            seen_g = seen_g or in_g
        elif in_g and ln.split("=", 1)[0].strip() == key:
            out.append(f"{key}={fn(ln.split('=', 1)[1])}")
            done = True
            continue
        out.append(ln)
    if not done:
        if not seen_g:
            if out and out[-1].strip():
                out.append("")
            out.append(f"[{group}]")
        out.append(f"{key}={fn(None)}")
    return "\n".join(out) + "\n"


def current_state():
    p = STATE / "current.json"
    return json.loads(p.read_text()) if p.exists() else {}


def reload_running():
    subprocess.run(["pkill", "-USR2", "-x", "btop"], check=False, capture_output=True)

# ----------------------------------------------------------- config ----
# User preferences, not theme state: `revert` leaves this file alone.
CONF = CONFIG / "pulsar" / "theme.conf"
CONF_DEFAULTS = {"restart-prompt": "on"}


def conf_get(k):
    if CONF.exists():
        for ln in CONF.read_text().splitlines():
            kk, _, v = ln.partition("=")
            if kk.strip() == k and not ln.lstrip().startswith("#"):
                return v.strip()
    return CONF_DEFAULTS[k]


def conf_put(k, v):
    if k not in CONF_DEFAULTS:
        sys.exit(f"pulsar-theme: unknown setting {k} (known: {', '.join(CONF_DEFAULTS)})")
    atomic_write(CONF, conf_set(CONF, k, v).encode())

# ---------------------------------------------------------- restarts ----
# gtk.css is read once per process, so open GTK windows keep the old palette.
# The fix offered is a GRACEFUL restart only: activate the app's own
# `app.quit` (org.gtk.Actions), which is exactly what Ctrl+Q does -- an app
# with unsaved work raises its own "save changes?" dialog and stays open.
# Nothing is ever killed; only apps that actually exited are relaunched.

NOTE = "open apps pick up the new colors when they are relaunched"
# Terminals: quitting one ends every shell in it. Their palette is live anyway.
NEVER_RESTART = {"org.gnome.Ptyxis", "org.gnome.Ptyxis.Devel", "org.gnome.Console", "org.gnome.Terminal",
                 "digital.arclight.Pulsar.ThemePicker"}


def _gdbus(*args, dest=None, path=None, method=None):
    cmd = ["gdbus", "call", "--session"]
    if dest:
        cmd += ["--dest", dest, "--object-path", path, "--method", method]
    try:
        r = subprocess.run(cmd + list(args), capture_output=True, text=True, timeout=5)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    return r.stdout if r.returncode == 0 else None


def _bus(method, *args):
    return _gdbus(*args, dest="org.freedesktop.DBus", path="/org/freedesktop/DBus", method=f"org.freedesktop.DBus.{method}")


def desktop_file(app_id):
    roots = [DATA] + [pathlib.Path(x) for x in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
    roots += [DATA / "flatpak" / "exports" / "share", pathlib.Path("/var/lib/flatpak/exports/share")]
    for r in roots:
        f = r / "applications" / f"{app_id}.desktop"
        if f.exists():
            return f
    return None


def app_entry(n, flatpak_on):
    """One bus name -> ("restart"|"manual", entry), or None if it is not a GTK
    app on the host palette."""
    if n in NEVER_RESTART or n.startswith(("org.freedesktop.", "org.gtk.", "org.gnome.Shell", "org.gnome.SettingsDaemon",
                                           "org.a11y.", "ca.desrt.", "org.gnome.evolution", "org.gnome.OnlineAccounts")):
        return None
    df = desktop_file(n)
    if not df:
        return None                         # a service or helper, not an app
    path = "/" + n.replace(".", "/").replace("-", "_")
    intro = _gdbus(dest=n, path=path, method="org.freedesktop.DBus.Introspectable.Introspect")
    if not intro or "org.gtk.Application" not in intro:
        return None
    pid = re.search(r"uint32 (\d+)", _bus("GetConnectionUnixProcessID", n) or "")
    sandboxed = bool(pid) and pathlib.Path(f"/proc/{pid.group(1)}/root/.flatpak-info").exists()
    if sandboxed and not flatpak_on:
        return None
    label = next((ln.split("=", 1)[1] for ln in df.read_text(errors="replace").splitlines() if ln.startswith("Name=")), n)
    acts = _gdbus(dest=n, path=path, method="org.gtk.Actions.List") or ""
    entry = {"id": n, "path": path, "name": label, "flatpak": sandboxed, "desktop": str(df),
             "pid": int(pid.group(1)) if pid else None}
    return ("restart" if "'quit'" in acts else "manual"), entry


def open_gtk_apps(ids=None):
    """(restartable, manual) GApplications on the session bus that paint with
    the host gtk.css. Flatpaks count only if the flatpak target is on --
    otherwise they never read gtk.css and a restart changes nothing. With
    `ids`, only those names are looked at: no bus-wide scan."""
    names = ids if ids is not None else re.findall(r"'([A-Za-z][\w-]*(?:\.[\w-]+){2,})'", _bus("ListNames") or "")
    flatpak_on = "flatpak" in current_state().get("targets", [])
    restart, manual = [], []
    for n in sorted(set(names)):
        got = app_entry(n, flatpak_on)
        if got:
            (restart if got[0] == "restart" else manual).append(got[1])
    return restart, manual


def desktop_exec(path):
    """The [Desktop Entry] Exec line, field codes dropped. Run directly rather
    than through `gio launch`: for DBusActivatable apps that goes via D-Bus
    activation, which in testing raced the old instance's exit and came up
    windowless. Direct exec of a unique app is what the dash does anyway."""
    import shlex
    ex, in_main = None, False
    for ln in pathlib.Path(path).read_text(errors="ignore").splitlines():
        if ln.startswith("["):
            in_main = ln.strip() == "[Desktop Entry]"
        elif in_main and ln.startswith("Exec="):
            ex = ln[5:]
            break
    argv = [x for x in shlex.split(ex or "") if not re.fullmatch(r"%[a-zA-Z]", x)]
    return argv or ["gio", "launch", str(path)]


def _alive(pid):
    try:
        st = pathlib.Path(f"/proc/{pid}/stat").read_text()
    except (OSError, TypeError):
        return False
    return st.rsplit(")", 1)[1].split()[0] not in ("Z", "X")   # a zombie has exited


# Apps that stay resident in --gapplication-service mode and ignore their quit
# action there (measured: Files was still running 30 s after it), keeping the
# old palette until told to quit their own way. Whether one has a window open
# cannot be told reliably over D-Bus (Files keeps a hidden window object), so
# they are not relaunched: they start again on demand, in the new colours.
SERVICE_QUIT = {"org.gnome.Software": ["gnome-software", "--quit"],
                "org.gnome.Nautilus": ["nautilus", "--quit"]}


def restart_apps(apps, wait=6.0):
    """Ask each app to quit; relaunch the ones that did. Returns [(app, outcome)].

    Success is the OLD PROCESS being gone, not the bus name: a D-Bus-activated
    app (Files) is started again on demand the moment anything asks for it,
    so its name can be owned by a fresh instance before we look. That fresh
    instance already has the new palette, and is not launched a second time."""
    for a in apps:
        _gdbus("quit", "[]", "{}", dest=a["id"], path=a["path"], method="org.gtk.Actions.Activate")
        if a["id"] in SERVICE_QUIT:
            try:
                subprocess.run(SERVICE_QUIT[a["id"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=5, check=False)
            except (OSError, subprocess.TimeoutExpired):
                pass
    pending, out = {a["id"]: a for a in apps}, []
    end = time.time() + wait
    while pending and time.time() < end:
        time.sleep(0.25)
        for i in list(pending):
            # the process itself: relaunching while the old one is still
            # writing its session state races it (seen with Text Editor)
            if _alive(pending[i]["pid"]):
                continue
            a = pending.pop(i)
            if i in SERVICE_QUIT:
                out.append((a, "closed; reopen it and it is in the new colors"))
            elif "true" in (_bus("NameHasOwner", i) or ""):
                out.append((a, "restarted"))  # re-activated on demand already
            else:
                cmd = ["flatpak", "run", a["id"]] if a["flatpak"] else desktop_exec(a["desktop"])
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                out.append((a, "restarted"))
    out += [(a, "kept open: it is asking about unsaved work") for a in pending.values()]
    return out


def after_switch(policy="ask"):
    """policy: ask (prompt on a TTY if the user has not opted out), restart,
    or note (never prompt: scripts, first login)."""
    restart, manual = open_gtk_apps()
    if not restart and not manual:
        return
    ask = policy == "ask" and conf_get("restart-prompt") == "on" and sys.stdin.isatty() and sys.stdout.isatty()
    if policy != "restart" and not ask:
        print(f"pulsar-theme: {NOTE}" + (f" ({', '.join(a['name'] for a in restart + manual)})"))
        return
    if manual:
        print(f"  reopen these yourself (no graceful quit): {', '.join(a['name'] for a in manual)}")
    if not restart:
        return
    if ask:
        ans = input(f"Restart {len(restart)} open app{'s' if len(restart) != 1 else ''} to apply the theme? "
                    f"({', '.join(a['name'] for a in restart)})\n[R]estart  [l]ater  [d]on't ask again: ").strip().lower()
        if ans.startswith("l"):
            return
        if ans.startswith("d"):
            conf_put("restart-prompt", "off")
            print(f"  won't ask again ({CONF}); turn it back on with: pulsar-theme config restart-prompt on")
            print(f"pulsar-theme: {NOTE}")
            return
    for a, outcome in restart_apps(restart):
        print(f"  {a['name']}: {outcome}")

# ------------------------------------------------------------- audit ----
# Floors: WCAG 2.2 AA. Text 4.5:1, large/UI parts and comments 3:1; body
# text is held to 7:1 (AAA) because it is everything you read all day.


def audit_variant(v):
    """(label, ratio, floor, target): below floor fails, below target warns."""
    c = lambda a, b: v[a].contrast(v[b])
    checks = [("body text on window", c("foreground", "window"), 4.5, 7.0),
              ("body text on view", c("foreground", "view"), 4.5, 7.0),
              ("body text on card", c("foreground", "card"), 4.5, 7.0),
              ("body text on popover", c("foreground", "popover"), 4.5, 7.0),
              ("top bar text", c("foreground", "background_deep"), 4.5, 7.0),
              ("text on selection", c("foreground", "selection"), 4.5, 4.5),
              ("accent as text on window", c("accent_text", "window"), 4.5, 4.5),
              ("label on accent (toggles, buttons)", c("accent_fg", "accent"), 4.5, 4.5),
              ("accent toggle vs quick-settings card", c("accent", "popover"), 3.0, 3.0),
              ("dim text", c("foreground_dim", "background"), 4.5, 4.5),
              ("comments / muted", c("muted", "background"), 3.0, 3.0)]
    for k in ("red", "orange", "yellow", "green", "cyan", "blue", "magenta"):
        checks.append((f"syntax + ANSI {k}", c(k, "background"), 4.5, 4.5))
    for i in (8, 9, 10, 11, 12, 13, 14):
        checks.append((f"ANSI color{i} (ls --color, btop)", v[f"color{i}"].contrast(v["background"]), 3.0, 3.0))
    return checks


def cmd_audit(names, quiet=False):
    bad = 0
    for n in names:
        th = load_theme(n)
        for mode, v in th.variants.items():
            res = audit_variant(v)
            fails = [x for x in res if x[1] < x[2]]
            warns = [x for x in res if x[2] <= x[1] < x[3]]
            bad += len(fails)
            status = ("FAIL %d" % len(fails)) if fails else "PASS"
            lo = min(res[:5], key=lambda x: x[1])
            print(f"{th.slug:14} {mode:5} {status:7} body text >= {lo[1]:.1f}:1"
                  + (f"  (below AAA 7:1 on {len(warns)} surfaces -- upstream palette)" if warns else ""))
            for label, got, floor, _ in fails:
                print(f"    FAIL {label}: {got:.2f} < {floor}")
    return bad

# --------------------------------------------------------------- init ----


def engine_wrote():
    """Keys whose current value is what the engine itself last wrote."""
    man = STATE / "baseline" / "manifest.json"
    if not man.exists():
        return set()
    wrote = resolve_inflight(json.loads(man.read_text())).get("wrote", {})
    return {k for k, v in wrote.items() if dconf_read(k) == v}


def customised():
    """Reasons the user has made the look their own. Any one of them means
    first-login leaves the desktop alone and only says the themes exist.
    Values the engine wrote itself (an earlier, interrupted init) are not
    the user's and do not count."""
    why = []
    ours = engine_wrote()
    for f in (CONFIG / "gtk-4.0" / "gtk.css", CONFIG / "gtk-3.0" / "gtk.css"):
        if f.exists() and uread(f).strip() and MARK_BEGIN not in uread(f):
            why.append(f"own {f.relative_to(HOME)}")
    for k, label in [("/org/gnome/desktop/interface/accent-color", "chose an accent color"),
                     ("/org/gnome/desktop/interface/gtk-theme", "set a GTK theme"),
                     ("/org/gnome/desktop/background/picture-uri", "chose a wallpaper"),
                     ("/org/gnome/desktop/background/picture-uri-dark", "chose a wallpaper"),
                     ("/org/gnome/TextEditor/style-scheme", "chose an editor color scheme"),
                     ("/org/gnome/shell/extensions/user-theme/name", "uses a Shell theme")]:
        if dconf_read(k) is not None and k not in ours and label not in why:
            why.append(label)
    for u in parse_gv_list(dconf_read("/org/gnome/Ptyxis/profile-uuids")):
        pal = dconf_read(f"/org/gnome/Ptyxis/Profiles/{u}/palette")
        if pal and not pal.strip("'").startswith("pulsar-") and f"/org/gnome/Ptyxis/Profiles/{u}/palette" not in ours:
            why.append("chose a terminal palette")
            break
    bt = CONFIG / "btop" / "btop.conf"
    if bt.exists() and re.search(r'^color_theme\s*=\s*"(?!Default|TTY|.*pulsar-)', uread(bt), re.M):
        why.append("chose a btop theme")
    return why


def notify(summary, body):
    """Queue a notification for pulsar-theme-notice.service. `init` runs
    before the Shell exists, so there is nobody to hand it to yet; the notice
    unit delivers it once the session is up, and keeps it for the next login
    if delivery fails. One file, so it can never be shown twice."""
    atomic_write(STATE / "notice.json", json.dumps({"summary": summary, "body": body}).encode())


def cmd_notice():
    f = STATE / "notice.json"
    if not f.exists() or not login_account():
        return
    n = json.loads(f.read_text())
    out = _gdbus("pulsar-theme", "0", "digital.arclight.Pulsar.ThemePicker-symbolic", n["summary"], n["body"],
                 "[]", "{}", "15000", dest="org.freedesktop.Notifications", path="/org/freedesktop/Notifications",
                 method="org.freedesktop.Notifications.Notify")
    if out is None:
        sys.exit("pulsar-theme: notification service not reachable; keeping the notice for next login")
    f.unlink()


# The picker's shortcut: Super+T, T for themes. Free in stock GNOME 50
# (checked against every keybinding schema the Shell, mutter and
# settings-daemon ship), so the plain chord rather than a Shift variant;
# `init` still checks the ACCOUNT, because a user may have taken it.
PICKER_ACCEL = "<Super>t"
PICKER_CMD = "/usr/libexec/pulsar/pulsar-theme-picker"
LOCK = None  # the writer lock main() takes; see there
MK = "/org/gnome/settings-daemon/plugins/media-keys"
PICKER_PATH = f"{MK}/custom-keybindings/pulsar-theme-picker/"
KEYBINDING_SCHEMAS = ["org.gnome.desktop.wm.keybindings", "org.gnome.shell.keybindings",
                      "org.gnome.mutter.keybindings", "org.gnome.mutter.wayland.keybindings",
                      "org.gnome.settings-daemon.plugins.media-keys"]


def _accel_key(a):
    mods = frozenset(m.lower() for m in re.findall(r"<([^>]+)>", a))
    mods = frozenset({"primary": "control", "ctrl": "control"}.get(m, m) for m in mods)
    return mods, re.sub(r"<[^>]+>", "", a).lower()


def accel_taken(accel):
    """Who, if anyone, in THIS account already answers to `accel`."""
    want = _accel_key(accel)
    for schema in ([] if FAKE_DCONF else KEYBINDING_SCHEMAS):
        r = subprocess.run(["gsettings", "list-recursively", schema], capture_output=True, text=True)
        for ln in r.stdout.splitlines():
            for a in re.findall(r"'([^']*)'", ln):
                if a and _accel_key(a) == want:
                    return ln.split()[1]
    for path in parse_gv_list(gsettings_get("org.gnome.settings-daemon.plugins.media-keys", "custom-keybindings")):
        b = dconf_read(path.rstrip("/") + "/binding")
        if b and _accel_key(b.strip("'")) == want:
            return f"custom shortcut {path}"
    return None


def bind_picker(tx):
    """Add the picker shortcut through the same transaction, so `revert`
    removes it. Returns True if bound."""
    if not pathlib.Path(os.environ.get("PULSAR_THEME_PICKER", PICKER_CMD)).exists() or accel_taken(PICKER_ACCEL):
        return False
    cur = parse_gv_list(gsettings_get("org.gnome.settings-daemon.plugins.media-keys", "custom-keybindings"))
    if PICKER_PATH not in cur:
        tx.set(f"{MK}/custom-keybindings", "[" + ", ".join(gv_str(x) for x in cur + [PICKER_PATH]) + "]")
    tx.set(PICKER_PATH + "name", gv_str("Theme picker"))
    tx.set(PICKER_PATH + "command", gv_str(PICKER_CMD))
    tx.set(PICKER_PATH + "binding", gv_str(PICKER_ACCEL))
    return True


# The markers a desktop session leaves in an account the first time it runs:
# the Shell's own data dir (session state, app usage) and xdg-user-dirs'
# config, which an autostart writes on every GNOME login. init runs BEFORE
# gnome-session-pre.target, so on an account's very first desktop login
# neither exists yet; on any account that has ever had a GNOME session here,
# both do. gnome-initial-setup copies dconf, keyrings and monitors.xml into
# the account it creates, never these, so they hold on that path too.
SESSION_MARKERS = (DATA / "gnome-shell", CONFIG / "user-dirs.dirs")
WELCOME_PENDING = "welcome.pending"


# The login screen's own accounts. GDM runs its greeter as dynamic users
# (gdm-greeter, gdm-greeter-2, ...) from the UID range systemd reserves for
# greeters, and the global user units reach its session as well: its session
# target pulls in gnome-session.target. The journal once showed init theming
# the greeter's account and binding a shortcut there. ConditionUser=!@system
# in the units only catches the static gdm user (UID 42), so the engine asks
# itself too.
GREETER_UIDS = range(60578, 60706)


def login_account():
    """False for the login screen's own accounts: nothing here is for them."""
    uid = os.getuid()
    try:
        name = pwd.getpwuid(uid).pw_name
    except KeyError:
        name = os.environ.get("USER", "")
    return not (name == "gdm" or name.startswith("gdm-") or uid in GREETER_UIDS
                or os.environ.get("XDG_SESSION_CLASS") == "greeter")


def fresh_account():
    """True only for an account whose first desktop login this is. The
    welcome (pulsar-welcome.service) runs on exactly this and nothing else,
    so an existing account that meets init on the update that ships it --
    customised or not -- is never greeted as if it were new."""
    return not any(m.exists() for m in SESSION_MARKERS)


def cmd_init(theme="pulsar", force=False):
    """First login. Runs once (stamped); the user unit calls this before the
    Shell starts. A fresh account gets the full Pulsar theme through the
    engine; an account that has made its look its own is left alone."""
    stamp = STATE / "init.json"
    pending = STATE / "init.pending"
    if not login_account():
        # no stamp either: a greeter account is never a person's
        print("pulsar-theme: the login screen's account; nothing to do")
        return
    if stamp.exists() and not force:
        print(f"pulsar-theme: init already done ({json.loads(stamp.read_text()).get('result')})")
        return
    # An interrupted earlier run (killed at its timeout, a crash) left this.
    # What it wrote is the engine's, not the user's: finish the job rather
    # than mistake it for customisation.
    resumed = pending.exists()
    why = [] if resumed else customised()
    # Fresh is decided once, on the first run, before anything is written: a
    # resumed run reads the first run's answer rather than re-deciding. It
    # also requires "apply" -- a customised account is never new -- and never
    # holds for --force, which is someone re-running init by hand.
    if resumed:
        try:
            fresh = bool(json.loads(pending.read_text() or "{}").get("fresh"))
        except ValueError:
            fresh = False
    else:
        fresh = not why and not force and fresh_account()
    if not why:
        # the decision is "apply": only now does a crash mean "finish this"
        atomic_write(pending, json.dumps({"decision": "apply", "theme": theme, "fresh": fresh}).encode())
    rec = {"at": datetime.datetime.now().isoformat(timespec="seconds"), "resumed": resumed, "fresh": fresh}
    if why:
        rec.update(result="skipped", reasons=why)
        print(f"pulsar-theme: first login, but this account has its own look ({'; '.join(why)}); leaving it alone")
        notify("Pulsar themes are available",
               "Your own look was kept. Browse them from Themes in the app grid, or run: pulsar theme list")
    else:
        # restart_policy none: no app is open yet, and the D-Bus scans for open
        # apps are the slowest thing init could do
        cmd_set(load_theme(theme), restart_policy="none", gentle="init")
        bound = False
        try:
            tx = Transaction()
            bound = bind_picker(tx)
            if bound:
                tx.commit()
        except Exception as e:   # a shortcut is never worth an unfinished init
            print(f"pulsar-theme: picker shortcut not set: {e}", file=sys.stderr)
        rec.update(result="applied", theme=theme, shortcut=PICKER_ACCEL if bound else None)
        print("pulsar-theme: picker shortcut " + ("Super+T" if bound else "not set (taken in this account)"))
        if fresh:
            # A new account gets the welcome instead, which shows the themes
            # and the shortcut itself: one greeting, not a notification on
            # top of a window saying the same thing. Written before the
            # stamp, so a crash here leaves init.pending to finish the job.
            atomic_write(STATE / WELCOME_PENDING, json.dumps({"shortcut": rec["shortcut"]}).encode())
        else:
            notify("Pulsar theme applied",
                   ("Super+T" if bound else "Themes, in the app grid,") + " switches the whole desktop's colors. "
                   "pulsar theme revert puts stock GNOME back.")
    atomic_write(stamp, json.dumps(rec, indent=1).encode())
    pending.unlink(missing_ok=True)

# --------------------------------------------------------------- commands ----


def cmd_follow_scheme():
    """GTK3 has no media queries, so its gtk.css and gtk-theme are written for
    the scheme in effect at the switch, and so are btop's theme and the
    agents'; everything else follows Dark Style on its own. On a flip, redo
    just those. A no-op unless a two-variant
    theme is applied in "both" mode with gtk3 among its targets."""
    st = current_state()
    redo = [t for t in ("gtk3", "btop", "agents") if t in st.get("targets", [])]
    if not st.get("theme") or st.get("variant", "both") != "both" or not redo:
        return
    try:
        theme = load_theme(st["theme"])
    except SystemExit:
        return
    if theme.both:
        cmd_set(theme, "both", redo, restart_policy="none", gentle="follow")


def cmd_window_glass(if_stale=False):
    """The Shell extension's Glass windows switch changed: redo just the
    halves it touches -- GTK4 (apps opened from now on) and the terminal's
    background (live) -- never asking about open apps (the extension runs
    this in the background). With if_stale, only when gtk4 was written for
    the other state: the extension asks this each time it is enabled, since
    a theme set while it was off wrote opaque windows."""
    st = current_state()
    if if_stale:
        # An image update brought new templates: every templated target the
        # theme wrote is redone from them, quietly, the user's own changes
        # kept as a Dark Style flip keeps them. Without this, the Shell sheet
        # stayed the one the theme was first set with, and each surface the
        # sheet has learned about since drew untinted, lit in plain white.
        if st.get("theme") and st.get("templates") != templates_seen():
            redo = [t for t in TEMPLATED if t in st.get("targets", [])]
            try:
                theme = load_theme(st["theme"])
            except SystemExit:
                return
            if redo:
                cmd_set(theme, st.get("variant", "both"), redo, restart_policy="none", gentle="follow")
            st = current_state()
            st["templates"] = templates_seen()
            atomic_write(STATE / "current.json", json.dumps(st, indent=1).encode())
            return
        # Otherwise only gtk4's half can be stale. With no gtk4 among the
        # targets there is nothing to go stale, and redoing the rest on every
        # login and unlock (the extension asks each time it is enabled) only
        # restyles the Shell for nothing.
        if "gtk4" not in st.get("targets", []) or window_glass_written() == window_glass():
            return
    # gtk3 for Glow, whose GTK3 block this redoes too
    redo = [t for t in ("gtk4", "gtk3", "ptyxis", "shell") if t in st.get("targets", [])]
    if not st.get("theme") or not redo:
        return
    try:
        theme = load_theme(st["theme"])
    except SystemExit:
        return
    cmd_set(theme, st.get("variant", "both"), redo, restart_policy="none")


def shared_value(p, kind, k, group=None, text=None):
    text = uread(p) if text is None else text
    return (conf_value(text, k) if kind == "conf" else json_get(text, k) if kind == "json"
            else _kf_get(text, group, k))


def leave_users(tx, first_login=False):
    """Unstage what the user has chosen for themselves, for the runs nobody
    asked for. A full `set` is the user asking, and overwrites; these are not.

    follow-scheme (a Dark Style flip, in the background): a key, or a setting
    in a file the user shares with the engine (btop's color_theme, an agent's
    theme), that no longer holds what the engine last wrote there was changed
    since, by the user, and is left alone.

    First login: an agent's theme, or the Flatpak Text Editor's scheme, that
    is already set and was never written by the engine was chosen by the
    user before Pulsar's themes arrived. (The desktop's own keys decide
    between theming and leaving the account alone, in customised().)"""
    man = STATE / "baseline" / "manifest.json"
    base = resolve_inflight(json.loads(man.read_text())) if man.exists() else {}
    wrote = base.get("wrote", {})
    if not first_login:
        for k in list(tx.keys):
            if k in wrote and not gv_equal(dconf_read(k), wrote[k]):
                print(f"  kept {k} (yours: changed since the theme set it)")
                del tx.keys[k]
    kinds = ("json", "keyfile") if first_login else ("conf", "json", "keyfile")
    for p, undo in list(tx.shared.items()):
        if undo["kind"] not in kinds or not p.exists():
            continue
        was = base.get("shared", {}).get(str(p), {}).get("wrote", {})
        text = uread(p)
        for k in undo["keys"]:
            now = shared_value(p, undo["kind"], k, undo.get("group"), text)
            if now is not None and (k not in was or now != was[k]):
                print(f"  kept {p}: {k} (yours)")
                del tx.files[p], tx.shared[p]
                break


def cmd_set(theme, variant="both", only=None, dry=False, wallpaper_index=None, restart_policy="ask", extra=None,
            without=None, gentle=None):
    """`only` is a subset (bg-next is only=['wallpaper']): stale files and the
    recorded target list are left as they were. `extra` adds opt-in targets
    (--with flatpak) to a full switch, which is still a full switch. `gentle`
    marks a run nobody asked for, "follow" or "init": see leave_users()."""
    extra = list(extra or [])
    # a default target turned off with --without stays off across every
    # later full switch (the picker's included) until --with brings it back
    off = (set(current_state().get("off", [])) | set(without or [])) - set(extra)
    if only is None:
        # an opt-in target that is on stays on across any full switch (the
        # picker's included) until it is turned off with --without
        on = [t.name for t in TARGETS if not t.default and t.name in current_state().get("targets", [])]
        extra += [n for n in on if n not in extra and n not in (without or [])]
    selected = [t for t in TARGETS
                if (t.name in only if only else ((t.default and t.name not in off) or t.name in extra))]
    unknown = (set(only or []) | set(extra) | set(without or [])) - {t.name for t in TARGETS}
    if unknown:
        sys.exit(f"pulsar-theme: unknown target(s): {', '.join(sorted(unknown))}")
    if variant != "both" and variant not in theme.variants:
        print(f"  note: {theme.name} has no {variant} palette; using {theme.prefer}", file=sys.stderr)
        variant = theme.prefer
    tx = Transaction(dry=dry)
    applied = []
    # Render EVERYTHING before touching anything: a broken template or theme
    # aborts here with the desktop untouched.
    for t in selected:
        if not t.available():
            print(f"  skip {t.name}: not available here")
            continue
        t.apply(tx, theme, variant)
        applied.append(t.name)
    if gentle:
        leave_users(tx, first_login=gentle == "init")
    # Files the previous theme generated that this one does not (its palette,
    # scheme, btop theme) go, so switching never accumulates stale files.
    if only is None:
        for f in current_state().get("files", []):
            if pathlib.Path(f) not in tx.files:
                tx.remove(f)
        if "flatpak" in (without or []) and "flatpak" in current_state().get("targets", []):
            if Flatpak().remove(tx):
                print("  flatpak: the gtk.css override is off again")
    print(f"pulsar-theme: {theme.name} ({variant}) -> {', '.join(applied)}")
    tx.commit()
    if not dry:
        prev = current_state()
        st = {"theme": theme.slug, "name": theme.name, "variant": variant,
              "targets": applied if only is None else prev.get("targets", applied),
              "off": sorted(off) if only is None else prev.get("off", []),
              "applied": datetime.datetime.now().isoformat(timespec="seconds"),
              # engine-owned files only: shared ones (gtk.css, btop.conf) are
              # never deleted as "stale", only cleaned by revert. A redo of part
              # of the theme adds what it wrote (the Glass windows switch
              # writes gtk.css's filter) so revert still finds it.
              "files": sorted(({str(f) for f, c in tx.files.items() if c is not None and f not in tx.shared} |
                               (set() if only is None else set(prev.get("files", []))))),
              # what the templated targets were rendered from; a redo of part
              # of them leaves the rest as old as they were
              "templates": templates_seen() if only is None else prev.get("templates"),
              "wallpaper_index": wallpaper_index if wallpaper_index is not None else
              (current_state().get("wallpaper_index", 0) if current_state().get("theme") == theme.slug else 0)}
        atomic_write(STATE / "current.json", json.dumps(st, indent=1).encode())
        if {"gtk4", "gtk3"} & set(applied) and restart_policy != "none":
            # every write is done: the restart question can wait on a human
            # without holding up a follow-scheme behind it
            if LOCK:
                fcntl.flock(LOCK, fcntl.LOCK_UN)
            after_switch(restart_policy)


def cmd_render(theme, out):
    """Render every target's files into `out` (HOME-shaped), touching nothing.
    HOME moves too: the agents' configs and the Flatpak Text Editor's live
    under HOME itself, not under an XDG dir, and render once rewrote the real
    ones. Anything that still resolves outside `out` is refused, not written."""
    global HOME, CONFIG, DATA, STATE
    out = pathlib.Path(out).resolve()
    HOME, CONFIG, DATA, STATE = out, out / ".config", out / ".local/share", out / ".local/state/pulsar-theme"
    tx = Transaction(dry=True)
    for t in TARGETS:
        t.apply(tx, theme, "both")
    stray = [p for p, c in tx.files.items() if c is not None and not p.resolve().is_relative_to(out)]
    if stray:
        sys.exit(f"pulsar-theme: render would write {stray[0]}, outside {out}; refusing")
    for p, c in tx.files.items():
        if c is not None:
            atomic_write(p, c)
            print(p)
    for k, v in tx.keys.items():
        print(f"dconf {k} = {v}")


def cmd_cycle(step):
    themes = [(slug, t) for slug, t in ordered_themes() if t is not None]   # skip what does not parse
    slugs = [slug for slug, _t in themes]
    cur = current_state().get("theme")
    i = (slugs.index(cur) + step) % len(slugs) if cur in slugs else 0
    cmd_set(themes[i][1])


def cmd_bg_next():
    st = current_state()
    if not st:
        sys.exit("pulsar-theme: no theme applied")
    th = load_theme(st["theme"])
    idx = st.get("wallpaper_index", 0) + 1
    st["wallpaper_index"] = idx
    atomic_write(STATE / "current.json", json.dumps(st, indent=1).encode())
    cmd_set(th, st["variant"], only=["wallpaper"], wallpaper_index=idx, restart_policy="none")


def cmd_list():
    cur = current_state().get("theme")
    paths = find_themes()
    for slug, t in ordered_themes():
        try:
            if t is None:
                Theme(paths[slug])      # re-raise, for the reason
            vs = "+".join(m for m in ("dark", "light") if m in t.variants)
            sw = " ".join(ansi_swatch(t.variants[t.prefer][k]) for k in
                          ("background", "accent", "red", "green", "yellow", "blue", "magenta", "cyan"))
            print(f"{'*' if slug == cur else ' '} {slug:24} {sw}  {t.name} [{vs}]")
        except Exception as e:
            print(f"! {slug:24} broken: {e}")


def ansi_swatch(c):
    r, g, b = (round(v * 255) for v in (c.r, c.g, c.b))
    return f"\x1b[48;2;{r};{g};{b}m  \x1b[0m" if sys.stdout.isatty() else c.hex


def cmd_targets():
    for t in TARGETS:
        print(f"{t.name:14} {'on ' if t.default else 'opt'} {'ok  ' if t.available() else 'n/a '} {t.desc}\n{'':19}{t.live}")

# ---------------------------------------------------------------- import ----


def fetch(src):
    if re.match(r"https?://", src):
        with urllib.request.urlopen(src, timeout=20) as r:
            return r.read().decode()
    return pathlib.Path(src).read_text()


def parse_flat_yaml(text):
    """Enough YAML for base16/base24 schemes: scalars and one nested map."""
    out, nest = {}, None
    for ln in text.splitlines():
        if not ln.strip() or ln.lstrip().startswith("#"):
            continue
        m = re.match(r'^(\s*)([A-Za-z0-9_-]+)\s*:\s*("[^"]*"|\'[^\']*\'|[^#]*?)\s*(#.*)?$', ln)
        if not m:
            continue
        ind, k, v = len(m.group(1)), m.group(2), m.group(3).strip().strip('"').strip("'")
        if ind == 0:
            if v == "":
                nest = out.setdefault(k, {})
            else:
                out[k], nest = v, None
        elif nest is not None:
            nest[k] = v
    return out


def base16_to_palette(pal):
    """tinted-theming styling guidelines: which base slot means what."""
    h = {k.lower(): "#" + v.lstrip("#").lower() for k, v in pal.items() if re.fullmatch(r"base[0-9a-fA-F]{2}", k)}
    m = {"background": "base00", "background_raised": "base01", "selection": "base02", "muted": "base03",
         "foreground_dim": "base04", "foreground": "base05", "foreground_bright": "base07", "red": "base08", "orange": "base09", "yellow": "base0a",
         "green": "base0b", "cyan": "base0c", "blue": "base0d", "magenta": "base0e", "brown": "base0f",
         "accent": "base0d",
         # base24 extras
         "background_sunken": "base10", "background_deep": "base11", "bright_red": "base12",
         "bright_yellow": "base13", "bright_green": "base14", "bright_cyan": "base15",
         "bright_blue": "base16", "bright_magenta": "base17"}
    return {k: h[v] for k, v in m.items() if v in h}


def cmd_import_base16(src, slug=None, accent=None, out_root=None, overrides=None):
    y = parse_flat_yaml(fetch(src))
    pal = y.get("palette") if isinstance(y.get("palette"), dict) else y
    name = y.get("name") or y.get("scheme") or "Imported"
    author = y.get("author", "")
    p = base16_to_palette(pal)
    if len(p) < 16:
        sys.exit(f"pulsar-theme: {src} does not look like a base16/base24 scheme")
    for kv in overrides or []:
        k, _, v = kv.partition("=")
        p[k.strip()] = p.get(v.strip(), v.strip())
    if accent:
        p["accent"] = p.get(accent, accent)
    hue_audit(p, src)
    bg = Color.parse(p["background"])
    variant = y.get("variant") or ("light" if bg.lum() > 0.4 else "dark")
    slug = slug or re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    write_theme(slug, name, author, f"base16 import: {src}", {variant: p}, out_root)


EXPECTED_HUE = {"red": 20, "orange": 55, "yellow": 90, "green": 140, "cyan": 195, "blue": 255, "magenta": 310}


def hue_audit(p, src):
    """base16 slots are semantic only by convention, and popular schemes break
    it (Tokyo Night's base08 is a pale blue-white). Terminal red that is not
    red is a real usability bug, so say so and name the fix."""
    for k, want in EXPECTED_HUE.items():
        if k not in p:
            continue
        L, a, b = Color.parse(p[k]).oklab()
        chroma = math.hypot(a, b)
        hue = math.degrees(math.atan2(b, a)) % 360
        off = min(abs(hue - want), 360 - abs(hue - want))
        if chroma < 0.03 or off > 70:
            print(f"  warning: {k} is {p[k]} (oklch hue {hue:.0f}, chroma {chroma:.2f}) -- not {k}. "
                  f"Fix with --set {k}=#rrggbb", file=sys.stderr)


def write_theme(slug, name, author, source, variants, out_root=None, walls=None):
    root = pathlib.Path(out_root) if out_root else DATA / "pulsar" / "themes"
    d = root / slug
    d.mkdir(parents=True, exist_ok=True)
    wp = {}
    for mode, p in variants.items():
        files = []
        for i, w in enumerate(walls or []):
            dst = d / "backgrounds" / w.name
            dst.parent.mkdir(exist_ok=True)
            shutil.copy2(w, dst)
            files.append(f"backgrounds/{w.name}")
        # Always generate one wallpaper from the palette, so every theme is a
        # complete look out of the box: the wallpaper is most of what a theme feels like.
        v = Variant(mode, p)
        (d / f"wallpaper-{mode}.svg").write_text(generated_wallpaper(v))
        files.append(f"wallpaper-{mode}.svg")
        wp[mode] = files
    lines = [f"name = {toml_str(name)}", f"author = {toml_str(author)}", f"source = {toml_str(source)}",
             f"prefer = {toml_str(next(iter(variants)))}", ""]
    for mode, p in variants.items():
        lines.append(f"[{mode}]")
        for k in PALETTE_KEYS + SURFACE_KEYS:
            if k in p:
                lines.append(f"{k} = {toml_str(p[k])}")
        lines.append("")
    lines.append("[wallpaper]")
    for mode, files in wp.items():
        lines.append(f"{mode} = [{', '.join(json.dumps(f) for f in files)}]")
    (d / "theme.toml").write_text("\n".join(lines) + "\n")
    Theme(d / "theme.toml")  # validate
    print(f"pulsar-theme: imported {name} -> {d}")


def toml_str(s):
    """A TOML basic string. JSON's escaping is a subset TOML accepts."""
    return json.dumps(str(s), ensure_ascii=False)


def generated_wallpaper(v):
    """A resolution-independent SVG from the palette: deep ground, two soft
    blooms in the accent and magenta, and the palette read left to right as a
    thin spectrum line (the Pulsar footer motif). GNOME loads SVG wallpapers
    through gdk-pixbuf's librsvg loader."""
    bg, deep = v["background"].hex, v["background_deep"].hex
    a, m, c = v["accent"].hex, v["magenta"].hex, v["cyan"].hex
    stops = [v[k].hex for k in ("red", "orange", "yellow", "green", "cyan", "blue", "magenta")]
    grad = "".join(f'<stop offset="{i / (len(stops) - 1):.3f}" stop-color="{s}"/>' for i, s in enumerate(stops))
    return f"""<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160">
<defs>
 <radialGradient id="g" cx="50%" cy="45%" r="75%"><stop offset="0" stop-color="{bg}"/><stop offset="1" stop-color="{deep}"/></radialGradient>
 <radialGradient id="a" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="{a}" stop-opacity="0.55"/><stop offset="1" stop-color="{a}" stop-opacity="0"/></radialGradient>
 <radialGradient id="m" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="{m}" stop-opacity="0.40"/><stop offset="1" stop-color="{m}" stop-opacity="0"/></radialGradient>
 <radialGradient id="c" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="{c}" stop-opacity="0.22"/><stop offset="1" stop-color="{c}" stop-opacity="0"/></radialGradient>
 <linearGradient id="s" x1="0" x2="1" y1="0" y2="0">{grad}</linearGradient>
</defs>
<rect width="3840" height="2160" fill="url(#g)"/>
<ellipse cx="2750" cy="760" rx="1500" ry="1100" fill="url(#a)"/>
<ellipse cx="980" cy="1600" rx="1400" ry="900" fill="url(#m)"/>
<ellipse cx="1900" cy="1080" rx="900" ry="700" fill="url(#c)"/>
<rect x="0" y="2148" width="3840" height="12" fill="url(#s)" opacity="0.9"/>
</svg>
"""

# ------------------------------------------------------------------ main ----


def main(argv=None):
    ap = argparse.ArgumentParser(prog="pulsar-theme", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("set")
    s.add_argument("theme")
    s.add_argument("--variant", choices=["both", "dark", "light"], default="both")
    s.add_argument("--only", help="comma-separated targets")
    s.add_argument("--with", dest="extra", help="also apply these opt-in targets (e.g. flatpak); they stay on")
    s.add_argument("--without", help="turn these opt-in targets off again")
    s.add_argument("--dry-run", action="store_true")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--restart", dest="restart", action="store_const", const="restart",
                   help="gracefully restart open GTK apps without asking")
    g.add_argument("--no-restart", dest="restart", action="store_const", const="note", help="never ask; print the note")
    sub.add_parser("list")
    ra = sub.add_parser("restart-apps", help="list (or with --yes, gracefully restart) GTK apps holding the old palette")
    ra.add_argument("--yes", action="store_true")
    ra.add_argument("--json", action="store_true")
    ra.add_argument("--ids", help="only these app ids, comma-separated (the picker passes what the user confirmed)")
    cf = sub.add_parser("config", help="show or change preferences (~/.config/pulsar/theme.conf)")
    cf.add_argument("key", nargs="?")
    cf.add_argument("value", nargs="?")
    au = sub.add_parser("audit", help="WCAG contrast checks for themes (exit 1 on failure)")
    au.add_argument("themes", nargs="*")
    sub.add_parser("notice", help="deliver the notification init queued (pulsar-theme-notice.service)")
    it = sub.add_parser("init", help="first-login: apply the Pulsar theme once, unless the look is already customized")
    it.add_argument("--theme", default="pulsar")
    it.add_argument("--force", action="store_true")
    sub.add_parser("next")
    sub.add_parser("prev")
    sub.add_parser("bg-next")
    sub.add_parser("login-account", help="exit 0 for a person's account, 1 for the login screen's own "
                   "(the first-login units' ExecCondition)")
    sub.add_parser("follow-scheme", help="re-apply the GTK3 half after a Dark Style flip (the Shell extension calls this)")
    wg = sub.add_parser("window-glass", help="re-apply the GTK4 half after the Glass windows switch (the Shell extension calls this)")
    wg.add_argument("--if-stale", action="store_true", help="only when it was written for the other glass state")
    sub.add_parser("current")
    rv = sub.add_parser("revert")
    rv.add_argument("--to", choices=["stock", "image"], default="stock",
                    help="stock: upstream GNOME (default); image: Pulsar's image defaults")
    sub.add_parser("targets")
    r = sub.add_parser("render")
    r.add_argument("theme")
    r.add_argument("out")
    i = sub.add_parser("import")
    i.add_argument("kind", choices=["base16"])
    i.add_argument("src")
    i.add_argument("--name")
    i.add_argument("--accent", help="palette key or hex to use as accent (base16)")
    i.add_argument("--into", help="themes root to write into (default: user themes dir)")
    i.add_argument("--set", action="append", help="override a palette key: red=#f7768e (base16)")
    a = ap.parse_args(argv)
    # One writer at a time. Mostly this orders the extension's follow-scheme
    # behind a `set` that flips Dark Style itself (Dracula, Alucard): it
    # waits, then reads the NEW theme's state, instead of rewriting GTK3 for
    # the old one mid-switch. Held until exit; the fd closes with the process.
    if a.cmd in ("set", "next", "prev", "bg-next", "follow-scheme", "window-glass", "revert", "init") and \
            not getattr(a, "dry_run", False):
        STATE.mkdir(parents=True, exist_ok=True)
        global LOCK
        LOCK = open(STATE / ".lock", "a")
        fcntl.flock(LOCK, fcntl.LOCK_EX)

    if a.cmd == "set":
        only = a.only.split(",") if a.only else None
        extra = a.extra.split(",") if a.extra else None
        if only and extra:
            only = only + extra
            extra = None
        cmd_set(load_theme(a.theme), a.variant, only, a.dry_run, restart_policy=a.restart or "ask", extra=extra,
                without=a.without.split(",") if a.without else None)
    elif a.cmd == "restart-apps":
        restart, manual = open_gtk_apps(a.ids.split(",") if a.ids else None)
        if a.json and not a.yes:
            print(json.dumps({"restart": restart, "manual": manual}))
        elif a.yes:
            res = restart_apps(restart)
            if a.json:
                print(json.dumps([{"id": x["id"], "outcome": o} for x, o in res]))
            else:
                for x, o in res:
                    print(f"{x['name']}: {o}")
        else:
            for x in restart:
                print(f"restartable  {x['id']}  ({x['name']})")
            for x in manual:
                print(f"manual       {x['id']}  ({x['name']})")
    elif a.cmd == "config":
        if a.key and a.value:
            conf_put(a.key, a.value)
        for k in CONF_DEFAULTS:
            if not a.key or a.key == k:
                print(f"{k} = {conf_get(k)}")
        print(f"# {CONF}")
    elif a.cmd == "audit":
        sys.exit(1 if cmd_audit(a.themes or sorted(find_themes())) else 0)
    elif a.cmd == "init":
        cmd_init(a.theme, a.force)
    elif a.cmd == "notice":
        cmd_notice()
    elif a.cmd == "list":
        cmd_list()
    elif a.cmd in ("next", "prev"):
        cmd_cycle(1 if a.cmd == "next" else -1)
    elif a.cmd == "bg-next":
        cmd_bg_next()
    elif a.cmd == "login-account":
        sys.exit(0 if login_account() else 1)
    elif a.cmd == "follow-scheme":
        cmd_follow_scheme()
    elif a.cmd == "window-glass":
        cmd_window_glass(a.if_stale)
    elif a.cmd == "current":
        print(json.dumps(current_state(), indent=1) or "none")
    elif a.cmd == "revert":
        revert(a.to)
    elif a.cmd == "targets":
        cmd_targets()
    elif a.cmd == "render":
        cmd_render(load_theme(a.theme), a.out)
    elif a.cmd == "import":
        cmd_import_base16(a.src, a.name, a.accent, a.into, a.set)


if __name__ == "__main__":
    main()
