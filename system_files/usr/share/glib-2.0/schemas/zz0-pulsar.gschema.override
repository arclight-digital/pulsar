# 12, not GNOME's stock 11: Host Grotesk runs optically smaller than Inter
# (and than Cantarell, which the 11 default was set for), so it reads a size
# down at the same nominal pt. Mono matches at 12 rather than trailing at 11 --
# one size across the desktop, so terminal text and UI text agree.
[org.gnome.desktop.interface]
font-name='Host Grotesk 12'
document-font-name='Host Grotesk 12'
monospace-font-name='JetBrains Mono 12'
color-scheme='prefer-dark'
# Both keys are HiDPI decisions, not taste. The target panel is 2560x1600 at
# 16" (~189 DPI), where there are enough pixels that fitting glyphs TO the
# pixel grid costs more than it buys:
#
#   hinting=slight   vertical hinting only, outlines otherwise untouched.
#                    'full' snaps stems to the grid, which distorts shapes --
#                    and Host Grotesk is a VARIABLE font, so aggressive
#                    hinting fights the interpolated outlines it is given.
#   antialiasing=grayscale
#                    'rgba' assumes a known RGB stripe geometry AND a 1:1
#                    glyph-to-physical-pixel mapping. Neither holds once the
#                    compositor renders scaled and downsamples, so subpixel
#                    AA turns into colour fringing on glyph edges. Grayscale
#                    is what GNOME and Fedora default to for this reason.
font-antialiasing='grayscale'
font-hinting='slight'

[org.gnome.desktop.wm.preferences]
titlebar-font='Host Grotesk Bold 12'
button-layout='appmenu:minimize,maximize,close'

[org.gnome.mutter]
experimental-features=['scale-monitor-framebuffer']

# The gamescale indicator, on by default. It ships system-wide in
# /usr/share/gnome-shell/extensions, so this only has to switch it on.
#
# This sets the DEFAULT value of the list. GNOME replaces the whole list when
# a user enables anything through the Extensions app, so a user who turns on
# a second extension keeps gamescale (the app writes the current value back,
# which already contains it) -- but a user who has explicitly disabled it
# stays disabled, because their dconf value wins over this default.
[org.gnome.shell]
enabled-extensions=['gamescale@arclight.digital']

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
two-finger-scrolling-enabled=true

# silk is the default pair; GNOME flips between them with the style toggle.
# The other three pairs ship alongside and are registered for the Appearance
# panel via /usr/share/gnome-background-properties/pulsar.xml.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/pulsar/pulsar-silk-light.png'
picture-uri-dark='file:///usr/share/backgrounds/pulsar/pulsar-silk-dark.png'

# lock screen has no dark-variant key; silk-dark is the brand default
[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/pulsar/pulsar-silk-dark.png'
