---
// The supply chain, as a trail, and then the command that shows what is
// attached to an image. Honest about where it stands: every image carries its
// package list (an SPDX SBOM) and is diffed nightly; the NVIDIA module is
// signed for Secure Boot and the installer ISOs with the cosign release key;
// the images themselves are not signed yet. Image signing with that same key
// is coming -- until it lands, nothing here claims it.
import { IMAGES, REPO } from '../data/site';

interface Props {
  /** the home page shows the trail and the check; /provenance also explains */
  compact?: boolean;
}

const { compact = false } = Astro.props;

const STAGES = [
  { name: 'commit', detail: 'a change lands in the public repo; that night’s build picks it up' },
  { name: 'build', detail: 'both images, on a build machine created for the night and destroyed after' },
  { name: 'sign', detail: 'the NVIDIA kernel module, with the key Secure Boot is told to trust' },
  { name: 'record', detail: 'a full package list (SPDX SBOM), attached to the image and diffed against last night’s' },
  { name: 'boot', detail: 'your machine switches to the new image, and rolls back on its own if it fails its boot checks' },
];

const shown = `oras discover ${IMAGES.nvidia}:latest`;
---

<div class="pipe">
  <arc-timeline heading-level="3" class="trail">
    {
      STAGES.map((stage) => (
        <arc-timeline-item heading={stage.name}>{stage.detail}</arc-timeline-item>
      ))
    }
  </arc-timeline>

  <div class="check">
    <p class="check-cap">don't take the page's word for&nbsp;it</p>
    <arc-code-block
      class="theme-fixed-dark"
      language="bash"
      filename="what is attached to an image"
      code={shown}
    ></arc-code-block>
    {
      !compact && (
        <p class="hint">
          The installer ISOs are signed with Pulsar’s cosign release key; the images are not signed
          yet, and signing them with that same key is coming.{' '}
          Running someone else’s images is a trust decision —{' '}
          <a href={`${REPO}#two-variants-one-key`}>fork it and build your own</a> if that’s not a
          relationship you want.
        </p>
      )
    }
  </div>
</div>

<style>
  .pipe {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .trail {
    display: block;
    font-family: var(--font-mono);
  }
  .check-cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .check arc-code-block {
    display: block;
  }
  .check .hint {
    margin-top: var(--space-md);
  }
  @media (max-width: 56rem) {
    .pipe {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
