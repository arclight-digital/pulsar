# Never commit signing material. The key is passed to podman as a build
# secret from /etc/pki/akmods-keys and must never enter this repo.
*.priv
*.key
*.pem
cosign.key

# Shader render outputs. Generated by scripts/shader-preview.sh and by CI
# before the image build -- never committed, they are 4K PNGs.
.preview/
system_files/usr/share/backgrounds/pulsar/*.png
scripts/__pycache__/
# Theme wallpapers, rendered by scripts/render-theme-wallpapers.py on the
# builder and converted to JPEG XL inside the Containerfile.
system_files/usr/share/pulsar/themes/*/backgrounds/
