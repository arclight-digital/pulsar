# 12, not GNOME's stock 11: every face here runs optically smaller than the
# Adwaita Sans that GNOME's 11 was set for, so it reads a size down at the same
# nominal pt. x-height as a fraction of em, read off the font binaries:
#
#   Adwaita Sans  0.546      Nimbus Sans  0.516      Host Grotesk  0.496
#
# which puts Adwaita Sans 11 and Host Grotesk 12 within a rounding error of
# each other -- 6.01pt of x-height against 5.95pt -- and Nimbus Sans 12 just
# above both at 6.19pt, which is where body text wants to sit. Mono matches at
# 12 rather than trailing at 11 -- one size across the desktop, so terminal
# text and UI text agree.
#
# Documents get Nimbus Sans rather than the brand face. Host Grotesk is the
# interface and the chrome; a document set in the same face as the menu bar
# above it has nothing to distinguish it. Nimbus Sans ships Regular and Bold
# and nothing else, which is plenty for body copy and is precisely why it is
# not a candidate for font-name: libadwaita asks for weight 500 and 600 in
# places, and with no Medium or SemiBold to snap to, those labels would
# collapse back to Regular and lose their emphasis.
#
# Nimbus Sans comes from urw-base35-nimbus-sans-fonts, installed explicitly in
# the Containerfile. It was already present transitively (libgs pulls
# urw-base35-fonts), but an incidental dependency is not a guarantee -- and the
# failure is silent, because an unresolvable family substitutes rather than
# errors. The Containerfile asserts all three families resolve.
[org.gnome.desktop.interface]
font-name='Host Grotesk 12'
document-font-name='Nimbus Sans 12'
monospace-font-name='JetBrains Mono 12'
color-scheme='prefer-dark'
# Both keys are HiDPI decisions, not taste. The target panel is 2560x1600 at
# 16" (~189 DPI), where there are enough pixels that fitting glyphs TO the
# pixel grid costs more than it buys:
#
#   hinting=slight   vertical hinting only, outlines otherwise untouched.
#                    'full' snaps stems to the grid, which distorts shapes, and
#                    neither face here has hinting worth honouring: the image
#                    ships Host Grotesk as static cuts drawn for print-quality
#                    output, and Nimbus Sans is a PostScript-era CFF face with
#                    no TrueType instructions at all. At 'full' both get handed
#                    to FreeType's autohinter, which reshapes them.
#   antialiasing=grayscale
#                    'rgba' assumes a known RGB stripe geometry AND a 1:1
#                    glyph-to-physical-pixel mapping. Neither holds once the
#                    compositor renders scaled and downsamples, so subpixel
#                    AA turns into colour fringing on glyph edges. Grayscale
#                    is what GNOME and Fedora default to for this reason.
font-antialiasing='grayscale'
font-hinting='slight'

[org.gnome.desktop.wm.preferences]
titlebar-font='Host Grotesk Bold 12'
button-layout='appmenu:minimize,maximize,close'

[org.gnome.mutter]
experimental-features=['scale-monitor-framebuffer']

# The gamescale indicator, on by default. It ships system-wide in
# /usr/share/gnome-shell/extensions, so this only has to switch it on.
#
# This sets the DEFAULT value of the list. GNOME replaces the whole list when
# a user enables anything through the Extensions app, so a user who turns on
# a second extension keeps gamescale (the app writes the current value back,
# which already contains it) -- but a user who has explicitly disabled it
# stays disabled, because their dconf value wins over this default.
[org.gnome.shell]
enabled-extensions=['gamescale@arclight.digital']

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
two-finger-scrolling-enabled=true

# GNOME Software's first-run splash introduces the store and offers to set up
# repositories. The image already ships unfiltered Flathub in /etc, so the
# splash has nothing left to offer -- on a branded OS it reads as setup left
# undone.
#
# download-updates=false is the other half of a conclusion this image already
# reached and only half-shipped. The update-policy note in the Containerfile
# explains why GNOME Software cannot READ this image: on any deployment with a
# layered package its rpm-ostree plugin dies on a missing
# ostree.manifest-digest, reports success, and caches nothing. The unshipped
# half is that a tool which cannot read the image has no business WRITING it.
#
# Left enabled it does not simply sit at the empty cache -- it escalates to a
# real Upgrade transaction. On 2026-08-14 that pulled 946MB and froze the
# desktop for ~90s, 40 seconds after a resume from suspend, with nothing in the
# UI to say what was happening or any way to stop it. coreos/rpm-ostree#4470 is
# the same trigger on the same filesystem and was closed as not planned, with a
# worse ending than ours: btrfs corruption and a read-only remount.
#
# This is not "no update policy". pulsar-update-check.timer already does the
# reading half honestly and ends in a notification, and `pulsar update` does
# the applying half when the user asks. What this key removes is the third
# actor that did the applying half unasked and could not do the reading half
# at all.
[org.gnome.software]
first-run=false
download-updates=false

# GDM greeter logo. Fedora sets this same key in
# org.gnome.login-screen.gschema.override, pointing at
# /usr/share/pixmaps/fedora-gdm-logo.png; this file sorts after it ("zz0-"),
# so the later default wins and no file gdm owns has to be overwritten.
#
# The earlier approach replaced fedora-gdm-logo.png in place, on the theory
# that the path was baked into a binary. It is not -- that is true of the
# About-panel lockups, which really are compiled into gnome-control-center,
# but the greeter reads a settable key. Using the key is also what puts the
# logo low on the greeter the way stock Fedora looks, with no theme patch.
[org.gnome.login-screen]
logo='/usr/share/pulsar/pulsar-gdm-logo.png'

# silk is the default pair; GNOME flips between them with the style toggle.
# The other three pairs ship alongside and are registered for the Appearance
# panel via /usr/share/gnome-background-properties/pulsar.xml.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/pulsar/pulsar-silk-light.png'
picture-uri-dark='file:///usr/share/backgrounds/pulsar/pulsar-silk-dark.png'

# lock screen has no dark-variant key; silk-dark is the brand default
[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/pulsar/pulsar-silk-dark.png'
