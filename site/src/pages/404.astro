---
// Served for any path the build did not write (wrangler.jsonc sets
// not_found_handling to 404-page, so the Worker answers with this page and a
// real 404 status). noindex, out of the sitemap, and no canonical: it stands
// for no URL.
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Pulsar"
  description="Nothing lives at this address. The Pulsar home page, the install guide and last night's changelog are one link away."
  path="/404"
  noindex
>
  <main id="main" class="page">
    <arc-container size="lg">
      <arc-page-header border>
        <h1 slot="heading">Nothing here</h1>
        <p slot="description">This address does not lead anywhere. It may have moved, or it may never have existed.</p>
      </arc-page-header>

      <section class="chapter">
        <h2>Where to go instead</h2>
        <arc-divider class="h-rule" align="left" variant="line-gradient"></arc-divider>
        <ul class="ways">
          <li><a href="/">The Pulsar home page</a></li>
          <li><a href="/install">Install Pulsar</a></li>
          <li><a href="/changelog">What changed last night</a></li>
          <li><a href="/cli">The pulsar command</a></li>
        </ul>
      </section>
    </arc-container>
  </main>
</Base>

<style>
  .ways {
    display: grid;
    gap: var(--space-sm);
    padding-left: 1.25rem;
    font-size: var(--text-lg);
  }
</style>
