#!/usr/bin/python3
"""Install Pulsar onto a disk: everything after the user said yes. Root only.

    pulsar-install-system --mode erase|alongside --key-file FILE \\
        --source-imgref containers-storage:IMG --target-imgref REGISTRY/IMG DISK

  1. alongside: the disk's EFI system partition must have room for Pulsar's
     boot files (checked before anything is written)
  2. pulsar-install-disk lays out the disk (it refuses any plan but ours)
  3. the root is unlocked with the passphrase in FILE and mounted, with
     /boot and the ESP under it
  4. bootc installs the image. Its bootupd would delete EVERY firmware boot
     entry named like ours ("Fedora": a Fedora installed beside us lost
     its entry) before adding one, so it runs where efivarfs is read-only,
     which bootupd takes as "leave the firmware alone"
  5. if Windows is on the ESP, GRUB gets an entry for it
  6. the firmware gets a "Pulsar" entry, replacing only older "Pulsar"
     entries on this same ESP
  7. everything is unmounted and the root locked again, failed or not

Progress goes to stdout as one JSON object per line, for the installer app:
{"stage": "check" | "disk" | "unlock" | "install" | "boot"} as each step
starts, {"log": "..."} for each line bootc prints, then {"stage": "done",
...} or {"stage": "failed", "error": ..., "restored": true|false} (whether
the partitions this install made were taken back). --plan-only prints
{"stage": "plan", "plan": [...]} (pulsar-install-disk's dry run) and
writes nothing; it needs no key.

PULSAR_BOOTC_PREFIX, if set, runs bootc through a wrapper (the test bench
runs it in the image with podman); the default is the live system's own.
"""

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
DISK_TOOL = os.environ.get("PULSAR_INSTALL_DISK", os.path.join(HERE, "pulsar-install-disk"))
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
ESP_MIN_FREE = 32 * 2**20      # the install writes ~13.5 MiB; room for bootupd updates
WINDOWS_LOADER = "EFI/Microsoft/Boot/bootmgfw.efi"
LABEL = "Pulsar"
MAPPER = "pulsar-install-root"
SCRATCH = "/run/pulsar-install"      # mount points for the target


class Failed(Exception):
    pass


def emit(**event):
    print(json.dumps(event), flush=True)


def run_stream(*cmd):
    """run(), with each output line passed on as a progress event."""
    print("+ " + shlex.join(cmd), file=sys.stderr, flush=True)
    p = subprocess.Popen(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=1)
    tail = []
    for line in p.stdout:
        line = line.rstrip()
        if line:
            emit(log=line)
            tail = (tail + [line])[-8:]
    if p.wait() != 0:
        raise Failed(f"{cmd[0]} exited {p.returncode}: " + " | ".join(tail)[-500:])


def run(*cmd, **kw):
    print("+ " + shlex.join(cmd), file=sys.stderr, flush=True)
    r = subprocess.run(cmd, text=True, capture_output=True, **kw)
    if r.returncode != 0:
        raise Failed(f"{cmd[0]} exited {r.returncode}: {(r.stderr or r.stdout).strip()[-500:]}")
    return r.stdout


def partitions(disk):
    # lsblk lists flat or as a tree depending on the columns asked for:
    # take every device whose parent is this disk, whichever it gave
    real = os.path.realpath(disk)
    out = json.loads(run("lsblk", "-J", "-p", "-o", "PATH,PKNAME,PARTTYPE,PARTN,PARTUUID,UUID,FSTYPE", real))

    def walk(devs):
        for d in devs:
            yield d
            yield from walk(d.get("children", []))
    return [d for d in walk(out["blockdevices"]) if d.get("pkname") == real and d.get("partn")]


def esp_of(disk):
    esps = [p for p in partitions(disk) if (p.get("parttype") or "").lower() == ESP_TYPE]
    if len(esps) != 1:
        raise Failed(f"expected one EFI system partition on {disk}, found {len(esps)}")
    return esps[0]


def preflight_alongside(disk, scratch):
    esp = esp_of(disk)
    mnt = os.path.join(scratch, "esp-check")
    os.makedirs(mnt)
    run("mount", "-o", "ro", esp["path"], mnt)
    try:
        st = os.statvfs(mnt)
        free = st.f_bavail * st.f_frsize
    finally:
        run("umount", mnt)
    if free < ESP_MIN_FREE:
        raise Failed(f"the EFI system partition has {free // 2**20} MiB free; Pulsar needs "
                     f"{ESP_MIN_FREE // 2**20} MiB beside the system already on it")


def bootc_install(target, source, target_ref, kargs):
    # bootc mounts efivarfs itself (read-write) when it finds the path empty
    # and leaves it be when it is populated; bootupd skips the firmware when
    # it is read-only. So: mount it here as bootc would, read-write (it is
    # one superblock system-wide, and a read-only mount of it would turn the
    # host's read-only too), then make this one mount read-only with a bind
    # remount, which touches no other.
    v = "/sys/firmware/efi/efivars"
    body = (f"if [ -d /sys/firmware/efi ]; then "
            f"{{ [ -n \"$(ls -A {v} 2>/dev/null)\" ] || mount -t efivarfs efivarfs {v}; }} && "
            f"mount -o remount,bind,ro {v} && [ \"$(findmnt -no OPTIONS {v} | cut -d, -f1)\" = ro ] "
            f"|| {{ echo 'cannot make efivarfs read-only: not installing' >&2; exit 1; }}; fi; "
            'exec "$@"')
    cmd = ["bootc", "install", "to-filesystem", "--source-imgref", source, "--target-imgref", target_ref]
    for k in kargs:
        cmd += ["--karg", k]
    cmd.append(target)
    prefix = os.environ.get("PULSAR_BOOTC_PREFIX")
    if prefix:
        # the wrapper (podman run --privileged IMG) gives bootc its own mount
        # namespace already; the remount happens inside it
        run_stream(*shlex.split(prefix), "sh", "-c", body, "sh", *cmd)
    else:
        run_stream("unshare", "--mount", "--propagation", "private", "sh", "-c", body, "sh", *cmd)


def live_setting(path, key, default):
    """KEY's value in a KEY=value file of the live system, else default."""
    try:
        for line in open(path):
            k, _, v = line.strip().partition("=")
            if k == key and v.strip('"'):
                return v.strip('"')
    except OSError:
        pass
    return default


def write_locale(target, lang, keymap):
    """The installed system's language and console keyboard, in its
    deployment's /etc: without them it starts with none, and GNOME Initial
    Setup offers "Unspecified". Returns the /etc written to."""
    deploy = os.path.join(target, "ostree/deploy")
    etcs = [os.path.join(deploy, os_, "deploy", d, "etc")
            for os_ in os.listdir(deploy)
            for d in os.listdir(os.path.join(deploy, os_, "deploy"))
            if os.path.isdir(os.path.join(deploy, os_, "deploy", d, "etc"))]
    if len(etcs) != 1:
        raise Failed(f"expected one deployment's /etc under {deploy}, found {len(etcs)}")
    etc = etcs[0]
    with open(os.path.join(etc, "locale.conf"), "w") as f:
        f.write(f'LANG="{lang}"\n')
    with open(os.path.join(etc, "vconsole.conf"), "w") as f:
        f.write(f"KEYMAP={keymap}\n")
    return etc


def windows_entry(target, esp):
    efi = os.path.join(target, "boot/efi")
    if not os.path.isfile(os.path.join(efi, WINDOWS_LOADER)):
        return False
    with open(os.path.join(target, "boot/grub2/custom.cfg"), "a") as f:
        f.write(f"""
menuentry 'Windows' --class windows --class os {{
\tinsmod part_gpt
\tinsmod fat
\tinsmod chain
\tsearch --no-floppy --fs-uuid --set=root {esp['uuid']}
\tchainloader /{WINDOWS_LOADER}
}}
""")
    return True


def firmware_entry(disk, esp, target):
    if not os.path.isdir("/sys/firmware/efi/efivars"):
        return "not booted via EFI: no firmware entry"
    efi = os.path.join(target, "boot/efi/EFI")
    vendors = [d for d in os.listdir(efi) if d != "BOOT" and os.path.isfile(os.path.join(efi, d, "shimx64.efi"))]
    if len(vendors) != 1:
        raise Failed(f"expected one shim on the ESP, found {vendors}")
    partuuid = esp["partuuid"].lower()
    for line in run("efibootmgr", "-v").splitlines():
        m = re.match(r"Boot([0-9A-Fa-f]{4})\*?\s+(.*?)\s+HD\(\d+,GPT,([0-9a-fA-F-]+)", line)
        if m and m.group(2) == LABEL and m.group(3).lower() == partuuid:
            run("efibootmgr", "-b", m.group(1), "-B")
    run("efibootmgr", "--create", "--disk", disk, "--part", str(esp["partn"]),
        "--loader", f"\\EFI\\{vendors[0]}\\shimx64.efi", "--label", LABEL)
    return f"firmware entry {LABEL} -> \\EFI\\{vendors[0]}\\shimx64.efi"


def remove_made(disk, made):
    """Take back the partitions this install made, by the partition UUIDs
    repart reported for them and nothing else: a failed install must leave
    the disk as it found it (alongside) or blank (erase), never half-made,
    since a retry refuses a disk where Pulsar's partitions already exist."""
    if not made:
        return []
    table = json.loads(run("sfdisk", "-J", disk))["partitiontable"]
    gone = []
    for p in table.get("partitions", []):
        if p.get("uuid", "").lower() in made:
            n = re.search(r"(\d+)$", p["node"]).group(1)
            run("sfdisk", "--delete", disk, n)
            gone.append(p["uuid"].lower())
    subprocess.run(["udevadm", "settle"])
    return gone


def main():
    ap = argparse.ArgumentParser(prog="pulsar-install-system")
    ap.add_argument("--mode", required=True, choices=["erase", "alongside"])
    ap.add_argument("--plan-only", action="store_true", help="print the disk plan; write nothing")
    ap.add_argument("--key-file")
    ap.add_argument("--source-imgref")
    ap.add_argument("--target-imgref")
    ap.add_argument("--karg", action="append", default=[])
    ap.add_argument("--lang", help="the installed system's LANG (default: the live system's)")
    ap.add_argument("--keymap", help="its console keymap (default: the live system's)")
    ap.add_argument("disk")
    a = ap.parse_args()
    if os.geteuid() != 0:
        ap.error("needs root")
    if not a.plan_only and not (a.key_file and a.source_imgref and a.target_imgref):
        ap.error("installing needs --key-file, --source-imgref and --target-imgref")
    # not /tmp: bootc copies itself there to enter SELinux's install_t, and
    # a wrapper that shares /tmp for the target's sake breaks that
    os.makedirs(SCRATCH, mode=0o700, exist_ok=True)
    scratch = tempfile.mkdtemp(prefix="install-", dir=SCRATCH)
    target = os.path.join(scratch, "target")
    mounted, opened, made, ok, error = [], False, set(), False, None
    try:
        emit(stage="check")
        if a.mode == "alongside":
            preflight_alongside(a.disk, scratch)
        if a.plan_only:
            ok = True
            emit(stage="plan", plan=json.loads(run(DISK_TOOL, "plan", "--mode", a.mode, a.disk)))
            return 0
        emit(stage="disk")
        plan = json.loads(run(DISK_TOOL, "apply", "--mode", a.mode, "--key-file", a.key_file, a.disk))
        run("udevadm", "settle")
        # the partitions this install made, by the partition UUIDs repart
        # reports: never guessed from labels or order, which another system
        # on the disk could share
        made_by_type = {p["type"]: p["uuid"].lower() for p in plan if p["activity"] == "create"}
        made = set(made_by_type.values())
        by_uuid = {(p.get("partuuid") or "").lower(): p for p in partitions(a.disk)}
        root, boot = by_uuid.get(made_by_type.get("root-x86-64")), by_uuid.get(made_by_type.get("xbootldr"))
        if not (root and boot):
            raise Failed(f"cannot find the partitions just made ({made_by_type}) on {a.disk}")
        esp = esp_of(a.disk)
        emit(stage="unlock")
        run("cryptsetup", "open", "--key-file", a.key_file, root["path"], MAPPER)
        opened = True
        os.makedirs(target)
        for dev, sub in ((f"/dev/mapper/{MAPPER}", ""), (boot["path"], "boot"), (esp["path"], "boot/efi")):
            path = os.path.join(target, sub)
            os.makedirs(path, exist_ok=True)
            run("mount", dev, path)
            mounted.append(path)
        emit(stage="install")
        # rhgb quiet: Silverblue's graphical boot (and passphrase prompt)
        # comes from Anaconda's kickstart, not the image; without them the
        # prompt sat in the boot log's text
        bootc_install(target, a.source_imgref, a.target_imgref,
                      [f"rd.luks.uuid={root['uuid']}", "rhgb", "quiet"] + a.karg)
        # bootc finalizes the root read-only; GRUB's custom.cfg lives on /boot
        emit(stage="boot")
        run("mount", "-o", "remount,rw", os.path.join(target, "boot"))
        # bootc finalizes the root read-only too; its /etc takes the language
        run("mount", "-o", "remount,rw", target)
        write_locale(target, a.lang or live_setting("/etc/locale.conf", "LANG", "en_US.UTF-8"),
                     a.keymap or live_setting("/etc/vconsole.conf", "KEYMAP", "us"))
        win = windows_entry(target, esp)
        fw = firmware_entry(a.disk, esp, target)
        ok = True
        emit(stage="done", ok=True, windows_entry=win, firmware=fw)
        return 0
    except Failed as e:
        error = str(e)
        print(f"pulsar-install-system: {e}", file=sys.stderr)
        return 1
    except Exception as e:     # a bug: still unmount, take back, and say so
        error = f"{type(e).__name__}: {e}"
        raise
    finally:
        for path in reversed(mounted):
            subprocess.run(["umount", path])
        if opened:
            subprocess.run(["cryptsetup", "close", MAPPER])
        restored = not made
        if not ok and made:
            try:
                gone = remove_made(a.disk, made)
                restored = len(gone) == len(made)
                print(f"pulsar-install-system: removed the {len(gone)} partitions this install made", file=sys.stderr)
            except Failed as e:
                print(f"pulsar-install-system: could not remove the partitions this install made: {e}", file=sys.stderr)
        if not ok:
            emit(stage="failed", error=error or "interrupted", restored=restored)


if __name__ == "__main__":
    sys.exit(main())
