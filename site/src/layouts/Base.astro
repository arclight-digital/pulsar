---
// The document shell: what search and share cards read, the pre-paint theme
// restore, the direction contract, and the one script tag the site ships.
//
// Styles load in a fixed order that IS the theming mechanism: ARC UI's base
// (tokens and the FOUC guard), then Pulsar's tokens.css, which restates the
// accent and surface inputs at equal specificity and wins on cascade order.
import '@arclux/arc-ui/base.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteFooter from '../components/SiteFooter.astro';
import ThemePicker from '../components/ThemePicker.astro';
import SiteTopBar from '../components/SiteTopBar.astro';
import { manifest, version } from '../data/build';
import { APP_ID, ISO_BASE, ISOS, ORG_ID, REPO } from '../data/site';
import { cardFor, cardUrl } from '../og/cards';

interface Props {
  /** carries the keywords -- a search snippet and a share card have different jobs */
  title: string;
  description: string;
  /** og:title keeps the tagline, where there is room for a voice */
  ogTitle?: string;
  /** the route, for canonical and the top bar's active item */
  path?: string;
  /** the page's name in the breadcrumb trail; defaults to the title up to its dash */
  crumb?: string;
  /** the home page opens on the shader; its bar is transparent until scrolled */
  immersive?: boolean;
  /** extra JSON-LD objects for this page, merged into the graph */
  jsonLd?: Record<string, unknown>[];
  /** preview routes (the hero options) stay out of search and the sitemap */
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  path = '/',
  crumb = title.split(' — ')[0],
  immersive = false,
  jsonLd = [],
  noindex = false,
} = Astro.props;

// Absolute, always: crawlers resolve nothing relative.
const canonical = new URL(path, Astro.site).href;
// Rendered at build time by src/pages/og.jpg.ts, so the card is set from the
// same lockup and faces as the page rather than being an image someone
// remembered to regenerate.
const ogImage = new URL('/og.jpg', Astro.site).href;
// The page's own share card, looked up by route in src/og/cards.ts, which is
// also the list src/pages/og/[card].jpg.ts renders. cardFor throws on a route
// with no card, so a new page fails the build until it has one.
// noindex pages (the 404) are never shared on purpose: they borrow the
// home card rather than each needing an entry in the list.
const card = cardFor(noindex ? '/' : path);
const cardImage = new URL(cardUrl(card), Astro.site).href;

// Structured data, honest only: everything here is real and verifiable, and
// softwareVersion names the build the nightly actually published.
const home = new URL('/', Astro.site).href;
// One Organization node, referenced by id from everything it made or
// publishes, so the company has a single name in the graph: the legal one.
const org = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'Arclight Digital LLC',
  url: 'https://arclight.build',
  sameAs: ['https://github.com/arclight-digital'],
};

// No aggregateRating or review: there are none, and inventing them is exactly
// what this graph is not for. That rules out Google's software rich result,
// which is fine; the node still names the product, version, price and licence.
const app = {
  '@type': 'SoftwareApplication',
  '@id': APP_ID,
  name: 'Pulsar',
  alternateName: 'Pulsar Linux',
  applicationCategory: 'OperatingSystem',
  applicationSubCategory: 'Linux distribution',
  // it is the operating system; this names the family it belongs to
  operatingSystem: 'Linux',
  processorRequirements: 'x86_64',
  softwareVersion: version,
  ...(manifest.built ? { dateModified: manifest.built } : {}),
  description:
    'A stylish, atomic, agentic Linux. Sixteen desktop themes in one command, a system safe to hand to a coding agent, and games that just run, on nightly images with automatic rollback.',
  featureList: [
    'Sixteen desktop themes, switched in one command',
    'Immutable, image-based base with rollback one reboot away',
    'Coding agents set up in their own toolbox',
    'Steam, Gamescope, GameMode and MangoHud built in',
    'Open NVIDIA driver signed for Secure Boot',
    'Built every night, with automatic rollback of a bad update',
  ],
  url: home,
  image: ogImage,
  downloadUrl: `${ISO_BASE}/${ISOS.vanilla}`,
  installUrl: new URL('/install', Astro.site).href,
  releaseNotes: new URL('/changelog', Astro.site).href,
  license: `${REPO}/blob/main/LICENSE`,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
  sameAs: [REPO],
};

const site = {
  '@type': 'WebSite',
  '@id': `${home}#site`,
  name: 'Pulsar',
  url: home,
  inLanguage: 'en',
  publisher: { '@id': ORG_ID },
};

// Inner pages get a breadcrumb back to the home page, which is also how the
// result snippet learns the site's structure.
const breadcrumbs =
  path === '/' || noindex
    ? []
    : [
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Pulsar', item: home },
            { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
          ],
        },
      ];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [site, org, app, ...breadcrumbs, ...jsonLd],
};
// `<` escaped so no string in the graph can ever close the script element.
const ldJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* A noindex page (the 404, the hero previews) names no canonical: there
        is no indexed URL it stands for. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Pulsar" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardImage} />
    <meta property="og:image:secure_url" content={cardImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardImage} />
    <meta name="twitter:image:alt" content={card.alt} />

    <meta name="theme-color" content="#0B0E1A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#E9EDF7" media="(prefers-color-scheme: light)" />
    {/* SVG first for every browser that takes it; the PNGs are for the ones
        that do not (and for anything that scrapes a favicon by size). Each is
        drawn at its size rather than the SVG shrunk: the 16 drops the glow
        and thickens the trail, which a scaled SVG cannot do. */}
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/assets/favicon-48.png" type="image/png" sizes="48x48" />

    {/* The hero ground and the UI faces are the LCP path; preloads keep the
        first paint from waiting on discovery. Fonts need crossorigin even
        same-origin -- font fetches are CORS-mode, and a preload that does not
        match is a double download. */}
    {/* TODO(site-hero-follow): the silk stills are preloaded because
        Hero.astro still paints them as the hero's ground under the shader.
        When the hero goes live-only WebGL, nothing paints them and these two
        links become a wasted download competing with the fonts: delete them
        in the same change. (Measured 2026-09-26: the home page's LCP element
        is the wordmark text, not the still.) */}
    {
      immersive && (
        <>
          <link
            rel="preload"
            as="image"
            href="/assets/silk-still-dark.jpg"
            media="(prefers-color-scheme: dark)"
          />
          <link
            rel="preload"
            as="image"
            href="/assets/silk-still-light.jpg"
            media="(prefers-color-scheme: light)"
          />
        </>
      )
    }
    <link rel="preload" as="font" type="font/ttf" href="/assets/HostGrotesk-Regular.ttf" crossorigin />
    <link rel="preload" as="font" type="font/ttf" href="/assets/HostGrotesk-Bold.ttf" crossorigin />
    {/* The mono face too: every page opens on a command or a code block, and
        found late (through a stylesheet, then a shadow root) it held first
        paint back -- FCP 2.8-2.9 s without this preload, 2.3 s with it, on
        Lighthouse's mobile profile. */}
    <link rel="preload" as="font" type="font/ttf" href="/assets/JetBrainsMono-Regular.ttf" crossorigin />

    <script is:inline type="application/ld+json" set:html={ldJson} />

    {/* is:inline and before the stylesheets: a stored theme choice must not
        flash the system theme, so this cannot be bundled and deferred. The key
        and the attribute are ARC UI's -- arc-theme-toggle reads and writes the
        same ones, so the two never disagree. */}
    {/* Then the visitor's Pulsar theme, if they picked one: the finished
        stylesheet and any mode a single-mode theme forces, stored by
        src/scripts/sitetheme.ts, applied here so no page ever paints in
        Pulsar first. Its selectors outrank the stylesheets that load after. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('arc-theme');
        if (t === 'dark' || t === 'light' || t === 'auto') document.documentElement.dataset.theme = t;
      } catch {}
      try {
        const css = localStorage.getItem('pulsar-site-theme-css');
        if (css) {
          const s = document.createElement('style');
          s.id = 'pulsar-site-theme';
          s.textContent = css;
          document.head.appendChild(s);
          const m = localStorage.getItem('pulsar-site-theme-mode');
          if (m === 'dark' || m === 'light') document.documentElement.dataset.theme = m;
        }
      } catch {}
    </script>

    <noscript>
      <style>
        /* the backdrop picker drives a shader; without JS it drives nothing */
        .deck {
          display: none;
        }
      </style>
    </noscript>
  </head>

  <body>
    <!--
      THESIS: The nightly is the pitch, and the mark is the brand. The first
      viewport is the identity hero over the live shader with the install
      command in it; the first chapter under it is last night's real package
      diff, live-checked against the build host. (User decision 2026-09-12:
      the diff-first hero was built, seen, and rejected.)
      OWN-WORLD: Ink ground; cyan and periwinkle through ARC UI's two-color
      contract, violet on the pale theme. Host Grotesk for words, JetBrains
      Mono for anything a machine wrote. The wallpaper shader is the only
      image. Terminals stay dark in both themes. Glow over outline; no coloured
      left borders; tokens, never literals.
      STORY: this OS changed last night, the change is inspectable, the
      pipeline that made it is verifiable, and one command installs it.
      FIRST VIEWPORT: shader full-bleed, everything centred: the 180px
      animated mark (flick it), PULSAR with ARC's bloom twin behind it, the
      tagline, one sentence, the live build chip, the two bootc switch
      commands, then Install and What changed last night. Look picker
      bottom-left.
      FORM: identity hero over a diff-first body; candidate 4 of 7, seed
      a91dc502, revised by the user after the first build.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, and DESIGN.md.
    -->
    <arc-skip-link target="#main">Skip to content</arc-skip-link>
    <SiteTopBar path={path} immersive={immersive} />
    <slot />
    <SiteFooter />
    <ThemePicker />
    {/* bottom-left: the theme picker owns bottom-right */}
    <arc-scroll-to-top threshold="900" position="bottom-left"></arc-scroll-to-top>

    {/* One script block, and hydrate first inside it: Lit must adopt the
        server-rendered shadow roots rather than render over them, and the
        chunking rule in astro.config.mjs is what makes "first" true. Then the
        icon pack, then only the elements this site uses -- the full registry
        is 185 components and this site wears about twenty. */}
    <script>
      import '@arclux/arc-ui/hydrate';
      import '@arclux/arc-ui/icon';
      import '@arclux/arc-ui-icons/phosphor';
      import '@arclux/arc-ui/skip-link';
      import '@arclux/arc-ui/top-bar';
      import '@arclux/arc-ui/navigation-menu';
      import '@arclux/arc-ui/nav-item';
      import '@arclux/arc-ui/theme-toggle';
      import '@arclux/arc-ui/icon-button';
      import '@arclux/arc-ui/badge';
      import '@arclux/arc-ui/button';
      import '@arclux/arc-ui/link';
      import '@arclux/arc-ui/footer';
      import '@arclux/arc-ui/section';
      import '@arclux/arc-ui/container';
      import '@arclux/arc-ui/page-header';
      import '@arclux/arc-ui/code-block';
      import '@arclux/arc-ui/stepper';
      import '@arclux/arc-ui/step';
      import '@arclux/arc-ui/description-list';
      import '@arclux/arc-ui/description-item';
      import '@arclux/arc-ui/divider';
      import '@arclux/arc-ui/alert';
      import '@arclux/arc-ui/kbd';
      import '@arclux/arc-ui/time-ago';
      import '@arclux/arc-ui/scroll-to-top';
      import '@arclux/arc-ui/timeline';
      import '@arclux/arc-ui/timeline-item';
      import '@arclux/arc-ui/cta-banner';
      import '@arclux/arc-ui/sheet';
      import '@arclux/arc-ui/toast';
      import '../scripts/main';
    </script>
  </body>
</html>
