---
// The hero: the mark, the wordmark, the tagline, and the one command. Its
// background is assets/shaders/pulsar.frag -- the same shader that renders
// the OS wallpapers -- running live in WebGL; src/scripts/sky.ts compiles it.
//
// The wordmark wears ARC's hero device: a blurred bloom twin behind it,
// breathing on the hero's own glow knob so the light theme stays calm. The
// wordmark itself stays solid star -- the brand draws it that way.
//
// Options, for choosing between -- /preview/hero-a, -b, -c1 and -c2 render
// each on the full home page:
//   a  identity hero, and the sky itself shows the themes: every theme's
//      wallpaper still crossfades over the live shader, with a deck to step
//      through them in the spot the look picker used to hold.
//   b  identity hero unchanged; the theme gallery leads right under it.
//   c1 split: the identity on the left, the desktop screenshot on the right
//      with one quiet row of solid accent dots and the command as a caption.
//   c2 split, calmer still: the screenshot and a single ‹ theme › stepper,
//      no row at all; "all sixteen" jumps to the gallery.
//   On phones both c options drop to the stepper.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Sky from './Sky.astro';
import { version } from '../data/build';
import { IMAGES, REPO } from '../data/site';
import { THEMES, label, setCommand, tileAttrs, variant as themeVariant } from '../data/themes';

interface Props {
  variant?: 'a' | 'b' | 'c1' | 'c2';
}
const { variant = 'b' } = Astro.props;

// Where the flywheel pivots: the mark's CORE, read from the shipped SVG at
// build time rather than typed in as a percentage. Each logo drop moves the
// core inside its cropped viewBox (v16 put it at 46.83% 52.49%, v18 at
// 49.60% 52.24%), and a hard-coded origin left over from the last drop makes
// the core orbit instead of spin. The light mark is staged onto this file's
// box (stage-assets.mjs), so the one origin serves both themes. The build
// runs from site/, so the repo root is one level up.
const MARK_SVG = join(process.cwd(), '..', 'assets', 'brand', 'svg', 'pulsar-animated-large.svg');
function coreOrigin(svg: string): string {
  const box = svg.match(/<svg\b[^>]*\bviewBox="([^"]+)"/)?.[1]?.split(/[\s,]+/).map(Number);
  const core = svg.match(/<circle\b[^>]*\bclass="pl-core"[^>]*>/)?.[0];
  const cx = Number(core?.match(/\bcx="([^"]+)"/)?.[1]);
  const cy = Number(core?.match(/\bcy="([^"]+)"/)?.[1]);
  if (!box || box.length !== 4 || !Number.isFinite(cx) || !Number.isFinite(cy)) {
    throw new Error(`cannot find the viewBox and .pl-core circle in ${MARK_SVG}`);
  }
  const [x, y, w, h] = box;
  return `${(((cx - x) / w) * 100).toFixed(2)}% ${(((cy - y) / h) * 100).toFixed(2)}%`;
}
const markOrigin = coreOrigin(readFileSync(MARK_SVG, 'utf8'));

const switchTo = (image: string) => `sudo bootc switch ${image}:latest`;
const first = THEMES[0];
---

<header class={`hero hero-${variant}${variant.startsWith('c') ? ' hero-c' : ''}`} data-hero={variant}>
  <Sky deck={variant !== 'a'} />

  {
    variant === 'a' && (
      <div class="stills" aria-hidden="true">
        {/* Not the two brand themes: Pulsar is the live canvas itself, and
            Pulsar Holo's shipped wallpaper carries the mark, which would sit
            behind the hero's own. The deck still names them; the sky shows
            the live shader for both. */}
        {THEMES.filter((t) => !['pulsar', 'pulsar-holo'].includes(t.slug) && themeVariant(t, 'dark').wall).map((t) => (
          <div class="still" data-still={t.slug}>
            {t.variants.dark?.wall && <img class="w-dark" data-src={t.variants.dark.wall} alt="" />}
            {t.variants.light?.wall && <img class="w-light" data-src={t.variants.light.wall} alt="" />}
          </div>
        ))}
      </div>
    )
  }

  <div class="inner">
    {/* data-spin is the easter egg's hook -- see src/scripts/spin.ts */}
    <img
      data-mark
      data-spin
      data-dark="/assets/pulsar-animated-large.svg"
      data-light="/assets/pulsar-mark-light.svg"
      class="mark"
      src="/assets/pulsar-animated-large.svg"
      style={`--mark-origin: ${markOrigin}`}
      alt=""
      width="180"
      height="180"
    />
    <h1 class="wordmark">
      <span class="glow-wrap">
        <span class="word">PULSAR</span>
        <span class="word word-shadow" aria-hidden="true">PULSAR</span>
      </span>
    </h1>
    <p class="tagline">Your lighthouse in the sky.</p>
    <p class="sub">
      <strong class="kicker">Stylish, atomic, agentic Linux.</strong> Sixteen themes in one
      command, a machine you can hand to an agent, and games that just
      run.{' '}<span class="sent">A bad update is one reboot from&nbsp;undone.</span>
    </p>

    {/* The one number that proves the nightly is real, worn in the hero. It
        comes from the manifest the build host committed, so the chip, the
        manifest card and the changelog cannot name different builds -- until
        src/scripts/beacon.ts asks the build host what it has shipped since. */}
    <p class="buildline mono">
      <a class="build-chip" href="#changelog" id="build-chip">
        <span class="build-dot" aria-hidden="true"></span>
        latest build <strong id="build-version" data-build-version>{version}</strong>
      </a>
    </p>
    {/* Empty and hidden in the served HTML: with no beacon there is nothing
        to add, and the page keeps the build it was rendered from. */}
    <p class="buildnote hint" id="build-note" hidden></p>

    <div class="cmds">
      <arc-code-block
        class="theme-fixed-dark"
       
        language="bash"
        filename="standard"
        code={switchTo(IMAGES.vanilla)}
      ></arc-code-block>
      <arc-code-block
        class="theme-fixed-dark"
       
        language="bash"
        filename="nvidia"
        code={switchTo(IMAGES.nvidia)}
      ></arc-code-block>
    </div>

    {/* One button: installing is the action. The other two are places to
        read, so they are links, and a phone gets one pill instead of two
        stacked at different widths. */}
    <div class="actions">
      <arc-button href="/install" variant="primary" size="lg">Install</arc-button>
      <p class="links">
        <a href="#themes">See the themes&nbsp;↓</a>
        <a href={REPO}>Browse the source&nbsp;→</a>
      </p>
    </div>

    {
      variant === 'a' && (
        <p class="tnote">sixteen themes, one sky</p>
        <div class="tdeck" role="group" aria-label="Themes on the sky" data-tdeck>
          <button type="button" class="tstep" data-tstep="-1" aria-label="Previous theme">‹</button>
          <span class="tname">
            <span data-tdeck-name>{label(first)}</span>
            <code class="tcmd" data-tdeck-cmd>{setCommand(first)}</code>
          </span>
          <button type="button" class="tstep" data-tstep="1" aria-label="Next theme">›</button>
        </div>
      )
    }
  </div>

  {
    variant.startsWith('c') && (
      <aside class="switcher" aria-label="Try a theme">
        <div class="shot">
          <img
            data-preview
            src={themeVariant(first, 'dark').desktop}
            alt={`The Pulsar desktop in the ${label(first)} theme`}
            width="1600"
            height="1000"
          />
        </div>
        <div class="under">
          {variant === 'c1' && (
            <div class="dots" role="group" aria-label="Themes">
              {THEMES.map((t, i) => (
                <button
                  type="button"
                  class="dot"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-label={label(t)}
                  title={label(t)}
                  style={`--a:${themeVariant(t, t.prefer === 'light' ? 'light' : 'dark').accent}`}
                  {...tileAttrs(t)}
                />
              ))}
            </div>
          )}
          <div class={`cstep ${variant === 'c1' ? 'phone-only' : ''}`} role="group" aria-label="Themes" data-stepper>
            <button type="button" class="tstep" data-step="-1" aria-label="Previous theme">‹</button>
            <span class="cs-name" data-preview-name>{label(first)}</span>
            <button type="button" class="tstep" data-step="1" aria-label="Next theme">›</button>
          </div>
          <p class="cap">
            <code class="cap-cmd" data-preview-cmd>{setCommand(first)}</code>
            {variant === 'c2' && <a class="all" href="#themes">All sixteen&nbsp;↓</a>}
          </p>
        </div>
      </aside>
    )
  }
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: url('/assets/silk-still-dark.jpg') center / cover no-repeat var(--ink);
    color: var(--star);
    --glow-a: 1;
  }
  :global(:root[data-theme='light']) .hero {
    background-image: url('/assets/silk-still-light.jpg');
    color: var(--deep);
    --glow-a: 0.4;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .hero {
      background-image: url('/assets/silk-still-light.jpg');
      color: var(--deep);
      --glow-a: 0.4;
    }
  }

  .inner {
    position: relative;
    /* its own stacking context, so the readability wash below sits behind
       the words but above the live sky */
    isolation: isolate;
    width: min(100% - 2 * var(--space-lg), 44rem);
    min-width: 0;
    /* the fixed bar above; below, room for the look picker pinned to the
       hero's bottom edge, which is absolutely positioned and would otherwise
       land on the buttons whenever the content outgrows the viewport */
    padding: var(--space-3xl) 0 calc(var(--space-3xl) + 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* A soft wash of the page's deepest ground behind the text column. The live
     sky runs the wallpaper shader, whose luminous filaments are bright enough
     to fight the tagline and the pitch where they cross it; the wash calms the
     center and fades out long before the edges, so the sky still reads as
     alive around the words. --bg-deep follows the page theme (ink on dark,
     star on light) and the site-wide theme picker, so it never shows as a
     dark box on a light page. */
  .inner::before {
    content: '';
    position: absolute;
    inset: 4% -35% 4%;
    z-index: -1;
    pointer-events: none;
    /* closest-side: the ellipse ends inside the box on every side, so it has
       faded to nothing before the box's edge. A fixed 50% radius from a 55%
       center ran past the bottom edge while still dark, and the box cut it
       off as a hard line above the look picker. */
    background: radial-gradient(
      ellipse closest-side at 50% 55%,
      color-mix(in oklab, var(--bg-deep) 78%, transparent) 0%,
      color-mix(in oklab, var(--bg-deep) 52%, transparent) 45%,
      transparent 100%
    );
  }

  .mark {
    display: block;
    height: 180px;
    width: 180px;
    margin-bottom: var(--space-lg);
    /* The core, not the box center: the files are cropped to their art, so
       the core is off-center in its box and a spin about 50% 50% makes it
       orbit. --mark-origin is computed from the SVG at build time (see the
       frontmatter), so a new logo drop cannot leave it pointing at the old
       core. The light mark is staged on the same box, so one origin serves
       both themes. */
    transform-origin: var(--mark-origin, 50% 50%);
  }

  /* Easter egg: the mark takes a flick and spins down like a flywheel. The
     image turns about the core (transform-origin above) and the arc is the
     only asymmetric part of the cut, so it reads as the arc orbiting the core.
     The brand package suggests rotating the SVG's own #pl-spin group, but an
     <img> exposes nothing inside it to the page, so the page turns the image
     about the same point instead.
     A WHOLE number of turns, so it comes to rest exactly where it started.

     The curve is the decay, and it was picked against numbers rather than by
     eye: it opens at ~3.6 turns/s (21 degrees a frame at 60fps -- fast, but
     short of the speed where a 145-segment arc starts to strobe), is about
     half way round after a second, and is still turning at 0.34 turns/s at
     3.5s. An ordinary ease-out spends ~80% of the travel in the first second
     and then creeps invisibly, which reads as a stall, not a decay.

     --spin-from lets a second click pick up from wherever the mark has got
     to instead of snapping back to zero; spin.ts sets it.

     The target is ABSOLUTE rather than --spin-from plus four turns, and that
     matters: a finished animation with no fill-mode leaves the mark at an
     untransformed 0deg. Landing on 1440deg -- a whole number of turns from
     zero, whatever angle the flick started at -- is what makes that handover
     invisible. A relative target would end at --spin-from and visibly snap. */
  .mark.is-spinning {
    animation: flywheel 4s cubic-bezier(0.07, 0.28, 0.45, 0.9);
  }
  @keyframes flywheel {
    from {
      transform: rotate(var(--spin-from, 0deg));
    }
    to {
      transform: rotate(1440deg);
    }
  }

  .wordmark {
    margin: 0 0 var(--space-sm);
    line-height: 1;
  }
  .glow-wrap {
    position: relative;
    display: block;
  }
  .word {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    line-height: 1;
    z-index: 1;
  }
  /* ARC's hero device: the word the page is named for emits. A blurred bloom
     twin behind the wordmark -- hot white core, accent halo, wide secondary
     falloff. Copied from arcui.dev's own headline. */
  .word-shadow {
    position: absolute;
    inset: 0;
    color: transparent;
    text-shadow:
      0 0 14px rgba(255, 255, 255, calc(0.2 * var(--glow-a))),
      0 0 32px rgba(var(--accent-primary-rgb), calc(0.38 * var(--glow-a))),
      0 0 70px rgba(var(--accent-primary-rgb), calc(0.26 * var(--glow-a))),
      0 0 130px rgba(var(--accent-secondary-rgb), calc(0.22 * var(--glow-a)));
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
    user-select: none;
    animation: breathe 5s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    from {
      opacity: 0.62;
    }
    to {
      opacity: 0.88;
    }
  }

  .tagline {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0 0 var(--space-md);
  }
  .sub {
    max-width: 52ch;
    font-size: var(--text-lg);
    line-height: var(--body-lh);
    opacity: 0.9;
    margin: 0 0 var(--space-lg);
  }

  .buildline {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }
  .build-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md) var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
    background: var(--chip);
    border: 1px solid var(--chip-line);
    color: var(--star);
    text-decoration: none;
    transition: box-shadow 0.2s var(--ease-out);
  }
  .build-chip:hover {
    box-shadow: var(--glow-hover);
  }
  .build-chip strong {
    font-weight: var(--font-mono-weight);
    color: var(--cyan);
  }
  .build-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--cyan);
    box-shadow: var(--glow-sm);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  .build-chip[data-stale] .build-dot {
    animation: none;
    background: var(--text-ghost);
    box-shadow: none;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  .buildnote {
    margin: var(--space-sm) 0 0;
    color: inherit;
    opacity: 0.8;
  }

  .cmds {
    width: 100%;
    min-width: 0;
    max-width: 40rem;
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-xl) 0 var(--space-lg);
    text-align: left;
  }
  .cmds arc-code-block {
    display: block;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
  }
  .links a {
    color: inherit;
    opacity: 0.85;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-block: var(--space-xs);
    transition: opacity 0.2s var(--ease-out), text-shadow 0.2s var(--ease-out);
  }
  .links a:hover {
    opacity: 1;
    text-shadow: var(--glow-xs);
  }

  .kicker {
    font-weight: var(--font-display-weight);
    color: inherit;
  }

  /* ---- option (a): the sky shows the themes ---------------------------- */
  .stills {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .still {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .still[data-on] {
    opacity: 1;
  }
  .still img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .still .w-light {
    display: none;
  }
  /* not fetched until the deck first reaches it; an <img> with no src would
     otherwise draw the broken-image glyph */
  .still img:not([src]) {
    visibility: hidden;
  }
  :global(:root[data-theme='light']) .still .w-light {
    display: block;
  }
  :global(:root[data-theme='light']) .still .w-dark {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .still .w-light {
      display: block;
    }
    :global(:root[data-theme='auto']) .still .w-dark {
      display: none;
    }
  }
  .tdeck {
    position: absolute;
    left: 50%;
    bottom: var(--space-lg);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border-radius: var(--radius-full);
    background: var(--chip);
    border: 1px solid var(--chip-line);
    backdrop-filter: blur(12px);
    white-space: nowrap;
  }
  /* legible at a glance: the theme's name is the point of the deck */
  .tnote {
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-lg) + 4.25rem);
    transform: translateX(-50%);
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: 0.04em;
    color: var(--on-chip);
  }
  .tname {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 15rem;
    padding: var(--space-xs) var(--space-sm);
    color: var(--star);
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-md);
  }
  .tcmd {
    font-family: var(--font-mono);
    font-weight: var(--font-mono-weight);
    font-size: var(--text-xs);
    letter-spacing: 0;
    text-transform: none;
    color: var(--cyan);
    background: none;
    padding: 0;
  }
  .tstep {
    appearance: none;
    border: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--on-chip);
    font: inherit;
    font-size: var(--text-lg);
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), background-color 0.2s var(--ease-out);
  }
  .tstep:hover {
    color: var(--star);
    background: var(--chip-line);
  }
  .tstep:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  /* ---- options (c1, c2): split, the screenshot wins ------------------- */
  .hero-c {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    padding: 0 var(--space-lg);
  }
  .switcher {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    width: 100%;
    max-width: 44rem;
    margin: 0 auto calc(var(--space-2xl) + 4rem);
  }
  .switcher .shot {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--chip-line);
    background: var(--ink);
    aspect-ratio: 16 / 10;
    box-shadow: 0 0 60px rgba(var(--accent-primary-rgb), calc(0.22 * var(--glow-a)));
    transition: box-shadow 0.4s var(--ease-out);
  }
  .switcher .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .under {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
  }
  /* c1: one quiet row -- solid accent dots, one clear ring on the active one */
  .dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }
  .dot {
    appearance: none;
    width: 0.875rem;
    height: 0.875rem;
    padding: 0;
    margin: 5px;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--a);
    opacity: 0.7;
    cursor: pointer;
    transition: opacity 0.2s var(--ease-out);
  }
  .dot:hover {
    opacity: 1;
  }
  .dot[aria-pressed='true'] {
    opacity: 1;
    outline: 2px solid var(--a);
    outline-offset: 3px;
  }
  .dot:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 4px;
  }
  /* c2 (and c1 on phones): a single stepper */
  .cstep {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs);
    border-radius: var(--radius-full);
    background: var(--chip);
    border: 1px solid var(--chip-line);
    backdrop-filter: blur(12px);
  }
  .cs-name {
    min-width: 11rem;
    text-align: center;
    color: var(--star);
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-md);
  }
  .phone-only {
    display: none;
  }
  .cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
  }
  .cap-cmd {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: inherit;
    opacity: 0.85;
    background: none;
    padding: 0;
  }
  .all {
    color: inherit;
    opacity: 0.85;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .all:hover {
