#!/usr/bin/env bash
# pulsar -- the front door to a Pulsar system.
#
# Every subcommand is a thin wrapper over bootc, ostree, rpm-ostree, systemd or
# jq. That is deliberate: none of this needs logic of its own, and a compiled
# binary would add a build pipeline to hide five lines of shell. What it does
# add is a single place where the RIGHT question gets asked -- see `doctor`.
#
# Reads go through rpm-ostree, writes through bootc. Not a style preference:
# `bootc status` requires root even to READ, and a health check you cannot run
# without sudo is one you will not run. `rpm-ostree status --json` reports the
# same deployments unprivileged, so `pulsar status` and `pulsar doctor` work as
# any user, and only the commands that actually mutate the system ask for root.
#
# The one write that does not always go through bootc is `update` -- bootc owns
# the container image and nothing else, so on a system with layered packages it
# is the wrong tool. See cmd_update.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

# This file's own path: hooks, units and notifications run pulsar again by
# it (realpath "$SELF"), so it is the entry's, never a part's.
SELF=${BASH_SOURCE[0]}

# The rest of pulsar is in parts (cli/lib in a checkout), read in this order:
# a later part's globals may use an earlier one's. Beside this file when
# they are there (a checkout, or a copy made with its lib), else the image's.
# Never some from each: one folder holds them all.
PULSAR_LIB="$(dirname "$(realpath "$SELF")")/lib"
[ -d "$PULSAR_LIB" ] || PULSAR_LIB=/usr/lib/pulsar/cli
for _part in common doctor system update agents model sandbox sessions undo alerts messages disk image setup report desktop checkpoint job machine; do
    [ -r "${PULSAR_LIB}/${_part}.sh" ] || { printf 'pulsar: missing %s\n' "${PULSAR_LIB}/${_part}.sh" >&2; exit 1; }
done
unset _part
# shellcheck source=lib/common.sh
. "${PULSAR_LIB}/common.sh"
# shellcheck source=lib/doctor.sh
. "${PULSAR_LIB}/doctor.sh"
# shellcheck source=lib/system.sh
. "${PULSAR_LIB}/system.sh"
# shellcheck source=lib/update.sh
. "${PULSAR_LIB}/update.sh"
# shellcheck source=lib/agents.sh
. "${PULSAR_LIB}/agents.sh"
# shellcheck source=lib/model.sh
. "${PULSAR_LIB}/model.sh"
# shellcheck source=lib/sandbox.sh
. "${PULSAR_LIB}/sandbox.sh"
# shellcheck source=lib/sessions.sh
. "${PULSAR_LIB}/sessions.sh"
# shellcheck source=lib/undo.sh
. "${PULSAR_LIB}/undo.sh"
# shellcheck source=lib/alerts.sh
. "${PULSAR_LIB}/alerts.sh"
# shellcheck source=lib/messages.sh
. "${PULSAR_LIB}/messages.sh"
# shellcheck source=lib/disk.sh
. "${PULSAR_LIB}/disk.sh"
# shellcheck source=lib/image.sh
. "${PULSAR_LIB}/image.sh"
# shellcheck source=lib/setup.sh
. "${PULSAR_LIB}/setup.sh"
# shellcheck source=lib/report.sh
. "${PULSAR_LIB}/report.sh"
# shellcheck source=lib/desktop.sh
. "${PULSAR_LIB}/desktop.sh"
# shellcheck source=lib/checkpoint.sh
. "${PULSAR_LIB}/checkpoint.sh"
# shellcheck source=lib/job.sh
. "${PULSAR_LIB}/job.sh"
# shellcheck source=lib/machine.sh
. "${PULSAR_LIB}/machine.sh"

usage() {
    cat <<'EOF'
pulsar: manage a Pulsar system

Health
  pulsar doctor [check]    health checks; exit 1 if one fails. the default
                           command. see: pulsar doctor --help
  pulsar status            every deployment, marked booted, staged or pinned
  pulsar report            a diagnosis bundle to paste: doctor, status,
                           manifest, failed units, recent warnings, graphics,
                           Flatpak. JSON; --text for people. redacted
  pulsar crashes           this boot's crashes. ignore list | add | remove:
                           programs whose crashes and GPU faults are not
                           announced

This image
  pulsar manifest          what is in this image, and what it runs on
  pulsar changelog         packages upgraded, added and removed in the latest
                           published image
  pulsar sbom              this system's packages as SPDX 2.3
  pulsar verify            check the running image's signature

Updates and undo
  pulsar update            download and stage the newest image    (root)
  pulsar update --check    is a newer image published? exit 10 if so
  pulsar rollback          boot the previous deployment next      (root)
  pulsar pin [on|off]      keep the booted deployment when old ones
                           are cleaned up (on and off need root)
  pulsar checkpoint        snapshot /etc and your settings and pin the
                           booted deployment, to diff or restore later:
                           list | diff | restore | drop           (root)

Desktop
  pulsar theme <command>   recolor the desktop: list | set <theme> |
                           revert | ...
  pulsar setup <recipe>    apps | devbox | gamemode | quadlet | gamescale
  pulsar screen text|qr    the text or QR code in an area of the screen,
                           onto the clipboard (Super+Print: text, if the
                           shortcut was free)

Agents
  pulsar agent             the guide, installed agents, guard state:
                           guide | list | add | remove | default | run |
                           attach | sessions | diff | undo | usage | disk |
                           read | send | inbox | messages | whoami |
                           settings | sandbox [on|off] | guard [on|off]
  pulsar agent model on    a local model server for agents, on the GPU
                           when there is one
  pulsar agent ask         start your agent on a redacted report of this
                           machine; --crash latest for the last crash
  pulsar mcp               this machine's facts as MCP tools, for any agent
                           (agent add registers it)
  pulsar job               long commands (a training run, a build) in their own
                           tmux, with a log and a notification when they end:
                           run | list | log | wait | stop | rm | attach
  pulsar machine           your other Pulsar machines, over SSH: add | remove |
                           list | check | sessions | run | job | fetch |
                           shell | discover | announce [on|off] | exec

Options
  --json                   JSON output, anywhere on the line. A command
                           without it says so instead of printing text.
                           `manifest --json` puts host facts under "host", so
                           `jq 'del(.host)'` is the baked manifest
  --logo, --no-logo        force or suppress the mark in `manifest`
  --version, --help        pulsar help <command> for one command
EOF
}

# The lines of usage() for one command, for its --help when it has no help
# of its own. A command whose lines are missing gets the whole usage.
usage_for() {
    local lines
    lines=$(usage | awk -v c="$1" '
        /^  pulsar / { f = ($2 == c) }
        /^[^ ]/ || /^$/ { f = 0 }
        f')
    if [ -n "$lines" ]; then printf '%s\n' "$lines"; else usage; fi
}

cmd_help() {
    [ $# -le 1 ] || die "usage: pulsar help [command]"
    [ -n "${1:-}" ] || { usage; return 0; }
    exec "$SELF" "$1" --help
}

main() {
    # `theme` is found before the global flag loop, which would otherwise eat
    # --json and --help that belong to the engine. Global flags BEFORE it
    # (`pulsar --json theme current`) are this CLI's, and like every other
    # command that does not use them, theme ignores them; --help/--version
    # there still mean what they always did.
    local i=0 a pre_json=0
    for a in "$@"; do
        i=$((i + 1))
        case "$a" in
            -h|--help|-V|--version) break ;;
            --json) pre_json=1 ;;
            -*) continue ;;
            theme)
                shift "$i"
                # the engine owns --json; one given before `theme` is passed on
                if [ "$pre_json" = 1 ]; then set -- "$@" --json; fi
                cmd_theme "$@"; exit $? ;;
            *) break ;;
        esac
    done
    JSON=0
    local args=() seen_cmd=0 verbatim=0
    for a in "$@"; do
        # After a command's `--`, everything belongs to whatever it runs:
        # `pulsar agent run codex -- --version` is codex's --version.
        if [ "$verbatim" = 1 ]; then args+=("$a"); continue; fi
        case "$a" in
            --) if [ "$seen_cmd" = 1 ]; then verbatim=1; fi; args+=("$a") ;;
            --json) JSON=1 ;;
            --logo) LOGO=always ;;
            --no-logo) LOGO=never ;;
            # Once a subcommand has been seen, --help belongs to IT: otherwise
            # `pulsar setup --help` printed the top-level usage and never told
            # you what the recipes were.
            -h|--help)
                if [ "$seen_cmd" = 1 ]; then args+=("$a"); else usage; exit 0; fi ;;
            # likewise --version: after a command it may be a prompt's or a
            # title's text (`agent run --prompt --version`), not a question
            -V|--version)
                if [ "$seen_cmd" = 1 ]; then args+=("$a"); else printf 'pulsar %s\n' "$VERSION"; exit 0; fi ;;
            -*) args+=("$a") ;;
            *) seen_cmd=1; args+=("$a") ;;
        esac
    done
    set -- ${args[@]+"${args[@]}"}
    local cmd=${1:-doctor}
    shift || true
    # jq is needed by nearly everything -- but not by help, which is how you
    # find out what this is on a box that lacks jq.
    case " $* " in
        *" -h "*|*" --help "*) ;;
        *) case "$cmd" in help|agent) ;; *) need jq ;; esac ;;
    esac
    # Commands with JSON output handle --json themselves, per subcommand
    # where only some have it. The rest refuse it here.
    case "$cmd" in
        doctor|status|manifest|changelog|report|update|pin|checkpoint|agent|machine|job|help) ;;
        *) no_json "$cmd" ;;
    esac
    # Commands without subcommands or flags take no arguments and say so.
    case "$cmd" in
        doctor)     cmd_doctor "$@" ;;
        status)     no_args status "$@";    cmd_status ;;
        report)     cmd_report "$@" ;;
        manifest)   no_args manifest "$@";  cmd_manifest ;;
        changelog)  no_args changelog "$@"; cmd_changelog ;;
        sbom)       no_args sbom "$@";      cmd_sbom ;;
        verify)     no_args verify "$@";    cmd_verify ;;
        update)     cmd_update "$@" ;;
        rollback)   cmd_rollback "$@" ;;
        pin)        cmd_pin "$@" ;;
        checkpoint) cmd_checkpoint "$@" ;;
        crashes)    cmd_crashes "$@" ;;
        screen)     cmd_screen "$@" ;;
        setup)      cmd_setup "$@" ;;
        agent)      cmd_agent "$@" ;;
        mcp)        cmd_mcp "$@" ;;
        machine)    cmd_machine "$@" ;;
        job)        cmd_job "$@" ;;
        help)       cmd_help "$@" ;;
        *)          usage >&2; die "unknown command: ${cmd}" ;;
    esac
}

main "$@"
