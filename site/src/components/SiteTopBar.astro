---
// The one site bar. Anchors live in light DOM inside the nav items so the bar
// is a working link list with JS disabled and before the menu upgrades;
// arc-navigation-menu reads the href off the child anchor.
//
// The home page opens on the shader and gets the immersive bar -- transparent
// until scrolled, following the page theme. Inner pages open on prose and
// pin the bar dark, which on the pale theme lifts to a deep color derived
// from the accent rather than sitting there as a black slab.
import Mark from './Mark.astro';
import { version } from '../data/build';
import { REPO } from '../data/site';

interface Props {
  path: string;
  immersive: boolean;
}

const { path, immersive } = Astro.props;

// Two destinations, both on the right: the docs, and the install section the
// hero's "Get started" also lands on. Everything else the old nav listed is a
// section of the home page or a link in the footer.
const onDocs = path === '/docs' || path.startsWith('/docs/');
---

<arc-top-bar
  fixed
  contained="lg"
  immersive={immersive || undefined}
  home-href="/"
  class:list={['bar', { 'theme-fixed-dark': !immersive }]}
>
  <a slot="logo" class="lockup" href="/" aria-label="Pulsar home">
    <Mark kind="bar" size={28} class="bar-mark" />
    <span class="word">PULSAR</span>
  </a>
  {/* The build names the product; it is not something you can do, so it sits
      with the wordmark and the actions cluster stays purely interactive. The
      beacon may rewrite it -- see src/scripts/beacon.ts. */}
  <arc-badge slot="subtitle" variant="primary" size="sm" class="bar-build">
    <span data-build-version>{version}</span>
  </arc-badge>
  <div slot="actions" class="actions">
    <arc-button href="/docs" variant="secondary" size="sm" aria-current={onDocs ? 'page' : undefined}>Docs</arc-button>
    <arc-button href="/#install" variant="primary" size="sm">Install</arc-button>
    <arc-theme-toggle icon-only size="md"></arc-theme-toggle>
    <arc-icon-button
      href={REPO}
      name="github-logo"
      label="Source on GitHub"
      variant="ghost"
      size="md"
    ></arc-icon-button>
  </div>
</arc-top-bar>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: inherit;
    text-decoration: none;
  }
  .lockup :global(.bar-mark) {
    display: block;
  }
  .word {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    font-size: var(--text-sm);
    line-height: var(--glyph-lh);
  }
  .bar-build {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 48rem) {
    .bar-build {
      display: none;
    }
  }
  .actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }
  /* the two destinations, then a step, then the two icons */
  .actions arc-button + arc-theme-toggle {
    margin-left: var(--space-md);
  }
  .actions arc-button {
    display: inline-block;
  }
  /* No nav and no sidebar: ARC's bar still renders its hamburger on narrow
     screens, where it would toggle nothing. Hidden through its documented
     part -- a dead control removed, not a part restyled. */
  .bar::part(menu-btn) {
    display: none;
  }
  /* a phone keeps the mark, both buttons and the theme toggle; the word is
     the hero's first line, and the source link is also in the footer */
  @media (max-width: 30rem) {
    .actions arc-icon-button,
    .word {
      display: none;
    }
    .actions arc-button + arc-theme-toggle {
      margin-left: var(--space-sm);
    }
  }
</style>
