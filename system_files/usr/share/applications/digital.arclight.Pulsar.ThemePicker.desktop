[Desktop Entry]
Type=Application
Name=Themes
Comment=Switch the whole desktop's colours: apps, terminal, editor, top bar and wallpaper
Keywords=theme;colour;color;palette;dark;light;wallpaper;accent;
Exec=/usr/libexec/pulsar/pulsar-theme-picker
Icon=preferences-desktop-appearance
Categories=Settings;DesktopSettings;GTK;
StartupNotify=true
X-GNOME-UsesNotifications=false
